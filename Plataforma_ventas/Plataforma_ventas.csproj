<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>855178c8-2a59-40be-9ea9-4dece835987e</UserSecretsId>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
		<PackageReference Include="EPPlus" Version="8.4.2" />
		<PackageReference Include="MailKit" Version="4.17.0" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
		<PackageReference Include="QuestPDF" Version="2026.2.4" />
	</ItemGroup>

	<!--
		QuestPDF arrastra los binarios nativos de SkiaSharp para todas las
		plataformas (Linux, macOS, Windows). Cuando el destino es un App Service
		de Windows, los de las otras plataformas son peso muerto: alrededor de la
		mitad del paquete.

		Está APAGADO por defecto. Se activa solo al publicar, con:
		    dotnet publish ... -p:RecortarRuntimesNoWindows=true

		NO lo actives cuando el destino sea Linux (la producción prevista):
		QuestPDF se quedaría sin su biblioteca nativa y la generación de PDF
		fallaría en tiempo de ejecución.
	-->
	<Target Name="RecortarRuntimesNoWindows" AfterTargets="Publish"
	        Condition="'$(RecortarRuntimesNoWindows)' == 'true'">
		<ItemGroup>
			<_RuntimesAjenos Include="$(PublishDir)runtimes\**\*"
			                 Exclude="$(PublishDir)runtimes\win*\**\*" />
		</ItemGroup>
		<Message Importance="high"
		         Text="Recortando binarios nativos de plataformas no Windows del paquete de publicación." />
		<Delete Files="@(_RuntimesAjenos)" ContinueOnError="true" />
	</Target>
</Project>