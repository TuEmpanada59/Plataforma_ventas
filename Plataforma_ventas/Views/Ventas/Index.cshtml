@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Londoño Gómez — Ventas";
    ViewBag.ActiveNav = "ventas";
    ViewBag.TbBread   = "Ventas";

    var nombre     = ViewBag.Nombre   as string ?? "Admin";
    var apellido   = ViewBag.Apellido as string ?? "";
    var proyActivo = ViewBag.ProyectoActivo as string ?? "Sin proyecto";
    var ventas     = ViewBag.Ventas as List<dynamic> ?? new List<dynamic>();
    int total      = ViewBag.TotalVentas != null ? (int)ViewBag.TotalVentas : 0;
    long totalValor= ViewBag.TotalValor  != null ? (long)ViewBag.TotalValor : 0;
    var iniciales = ((nombre.Length >= 1 ? nombre.Substring(0, 1) : "") + (apellido.Length >= 1 ? apellido.Substring(0, 1) : "")).ToUpper();
    ViewBag.Iniciales = iniciales;
    var proyectos = ViewBag.Proyectos as List<(int Id, string Nombre)>;
}
@section Styles {
<style>
    @@keyframes fu{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    .kpi-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
    .kpi{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:18px;padding:16px;box-shadow:var(--sh);animation:fu 0.35s ease both;}
    .kpi:nth-child(1){animation-delay:.05s}.kpi:nth-child(2){animation-delay:.1s}.kpi:nth-child(3){animation-delay:.15s}
    .kpi-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;}
    .kpi-ico{width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:17px;}
    .kpi-tag{font-size:11px;font-weight:600;padding:3px 8px;border-radius:20px;}
    .kpi-num{font-size:28px;font-weight:300;letter-spacing:-1.5px;line-height:1;margin-bottom:3px;}
    .kpi-lbl{font-size:12px;color:var(--label2);}
    .kpi.k1 .kpi-ico{background:rgba(230,57,70,0.1)}.kpi.k1 .kpi-tag{background:rgba(230,57,70,0.1);color:var(--rojo)}.kpi.k1 .kpi-num{color:var(--rojo)}
    .kpi.k2 .kpi-ico{background:rgba(0,118,227,0.1)}.kpi.k2 .kpi-tag{background:rgba(0,118,227,0.1);color:var(--blue)}.kpi.k2 .kpi-num{color:var(--azul)}
    .kpi.k3 .kpi-ico{background:rgba(52,199,89,0.1)}.kpi.k3 .kpi-tag{background:rgba(52,199,89,0.1);color:#1EA851}.kpi.k3 .kpi-num{color:#1EA851;font-size:18px;}
    .card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:18px;overflow:hidden;box-shadow:var(--sh);animation:fu 0.35s ease 0.2s both;}
    .card-head{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--sep2);flex-wrap:wrap;gap:8px;}
    .card-title{font-size:15px;font-weight:600;color:var(--label);}
    .tbl-wrap{overflow-x:auto;}
    .tbl{width:100%;border-collapse:collapse;}
    .tbl thead{position:sticky;top:0;z-index:2;background:rgba(255,255,255,0.95);backdrop-filter:blur(10px);}
    .tbl th{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--label3);padding:10px 14px;text-align:left;border-bottom:1px solid var(--sep2);}
    .tbl td{padding:10px 14px;font-size:13px;color:var(--label);border-bottom:1px solid var(--sep2);}
    .tbl tr:last-child td{border-bottom:none;}
    .tbl tr:hover td{background:var(--fill3);}
    .bdg{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:600;}
    .bdg.A{background:rgba(52,199,89,0.12);color:#1EA851}
    .ios-btn{display:inline-flex;align-items:center;gap:6px;background:var(--blue);color:white;border:none;padding:7px 13px;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;box-shadow:0 4px 12px rgba(0,118,227,0.28);transition:all 0.2s;text-decoration:none;}
    .ios-btn:hover{background:var(--mid);}
    .ios-btn.verde{background:#1EA851;box-shadow:0 4px 12px rgba(52,199,89,0.28);}
    .ios-btn.verde:hover{background:#167A3D;}
    .filter-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
    .search-wrap{position:relative;max-width:220px;}
    .search-wrap input{width:100%;padding:7px 12px 7px 30px;background:var(--fill3);border:1px solid var(--sep);border-radius:10px;font-size:13px;color:var(--label);outline:none;}
    .search-wrap input:focus{background:white;border-color:var(--blue);}
    .search-ico{position:absolute;left:9px;top:50%;transform:translateY(-50%);font-size:12px;color:var(--label3);pointer-events:none;}
    .empty{padding:60px;text-align:center;}
    .empty-ico{font-size:40px;opacity:0.3;margin-bottom:8px;}
    .empty-txt{font-size:15px;font-weight:600;color:var(--label2);}
    @@media(max-width:700px){.tbl{min-width:700px!important;}.kpi-row{grid-template-columns:1fr!important;}}
</style>
}

<div class="kpi-row">
    <div class="kpi k1"><div class="kpi-top"><div class="kpi-ico">&#128178;</div><span class="kpi-tag">Total ventas</span></div><div class="kpi-num">@total</div><div class="kpi-lbl">Registros</div></div>
    <div class="kpi k2"><div class="kpi-top"><div class="kpi-ico">&#128176;</div><span class="kpi-tag">Valor total</span></div><div class="kpi-num">$@string.Format("{0:N0}", totalValor)</div><div class="kpi-lbl">En ventas</div></div>
    <div class="kpi k3"><div class="kpi-top"><div class="kpi-ico">&#128202;</div><span class="kpi-tag">Mapa Excel</span></div>
        <div style="margin-top:8px"><a href="/Ventas/GenerarMapa" class="ios-btn verde">&#8595; Descargar mapa</a></div>
        <div class="kpi-lbl" style="margin-top:8px">Mapa de ventas con colores</div>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <span class="card-title">Registro de ventas &#8212; todos los asesores</span>
        <div class="filter-bar">
            <div class="search-wrap"><span class="search-ico">&#128269;</span><input type="text" id="buscar" placeholder="Buscar asesor, apto, cliente..." oninput="filtrar()"/></div>
        </div>
    </div>
    @if (ventas.Count > 0) {
        <div class="tbl-wrap">
            <table class="tbl" id="tablaVentas">
                <thead>
                    <tr>
                        <th>#</th><th>Apto</th><th>Torre</th><th>Piso</th><th>Tipo</th>
                        <th>Cliente</th><th>Documento</th><th>Celular</th><th>Asesor</th>
                        <th>Destino</th><th>Lista</th><th>Precio venta</th><th>Fecha y hora</th><th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int idx = 1; }
                    @foreach (var v in ventas) {
                        var dest    = v.Destino as string ?? "&#8212;";
                        var destIco = dest == "Vivienda" ? "&#127968;" :
                                      dest == "Inversión para reventa" ? "&#128200;" :
                                      dest == "Inversión para arriendo" ? "&#128273;" :
                                      dest == "Cesión de derechos" ? "&#128203;" : "&#8212;";
                        var destBg  = dest == "Vivienda"                 ? "rgba(0,118,227,0.08)"   :
                                      dest == "Inversión para reventa"   ? "rgba(52,199,89,0.1)"    :
                                      dest == "Inversión para arriendo"  ? "rgba(255,149,0,0.1)"    :
                                      dest == "Cesión de derechos"       ? "rgba(90,90,200,0.1)"    :
                                                                           "rgba(120,120,128,0.08)";
                        var destFg  = dest == "Vivienda"                 ? "var(--blue)"   :
                                      dest == "Inversión para reventa"   ? "#1EA851"       :
                                      dest == "Inversión para arriendo"  ? "#CC7700"       :
                                      dest == "Cesión de derechos"       ? "#5A5AC8"       :
                                                                           "var(--label3)";
                        <tr>
                            <td style="color:var(--label3)">@idx</td>
                            <td style="font-weight:600">@v.Apto</td>
                            <td>@v.Torre</td>
                            <td>@v.Piso</td>
                            <td>@v.Tipo</td>
                            <td style="font-weight:500">@v.Cliente</td>
                            <td style="color:var(--label2)">@v.Documento</td>
                            <td style="color:var(--label2)">@v.Celular</td>
                            <td style="color:var(--blue);font-weight:500">@v.Asesor</td>
                            <td>
                                <div style="display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:20px;background:@destBg;color:@destFg;font-size:11px;font-weight:600;white-space:nowrap;">
                                    @Html.Raw(destIco) @dest
                                </div>
                            </td>
                            <td style="text-align:center">@v.Lista</td>
                            <td style="font-weight:600;color:var(--azul)">$@string.Format("{0:N0}", long.TryParse(v.PrecioVenta?.ToString(), out long pv) ? pv : 0)</td>
                            <td style="color:var(--label2);font-size:12px">@v.FechaVenta</td>
                            <td><span class="bdg A">@v.Estado</span></td>
                        </tr>
                        idx++;
                    }
                </tbody>
            </table>
        </div>
        @if (ViewBag.TotalPages != null && (int)ViewBag.TotalPages > 1) {
            <div class="paginator" style="padding:12px 16px;">
                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++) {
                    <a href="?page=@i" class="page-btn @(i == (int)(ViewBag.Page ?? 1) ? "active" : "")">@i</a>
                }
            </div>
        }
    } else {
        <div class="empty">
            <div class="empty-ico">&#128178;</div>
            <div class="empty-txt">No hay ventas registradas en @proyActivo</div>
        </div>
    }
</div>

@section Scripts {
<script>
    function filtrar(){
        const q=document.getElementById('buscar').value.toLowerCase();
        document.querySelectorAll('#tablaVentas tbody tr').forEach(tr=>{
            tr.style.display=tr.innerText.toLowerCase().includes(q)?'':'none';
        });
    }
</script>
}
