@{
    Layout = null;
    bool hayError = !ViewData.ModelState.IsValid;
    string token = ViewBag.Token as string ?? "";
}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Lanzamientos - Londoño Gómez</title>
<link rel="icon" type="image/svg+xml" href="~/favicon.svg"/>
<link rel="alternate icon" href="~/favicon.ico"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --lg-blue-mid:#0055A5;--lg-blue:#0077C8;--lg-red:#E63946;--lg-green:#34C759;
  --lg-label:rgba(0,0,0,0.85);--lg-label-2:rgba(60,60,67,0.60);
  --lg-sep:rgba(60,60,67,0.12);--lg-fill-3:rgba(120,120,128,0.08);
  --r-lg:12px;--r-3xl:28px;
  --ease-ios:cubic-bezier(.4,0,.2,1);
  --font-sans:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;-webkit-font-smoothing:antialiased;font-family:var(--font-sans);}
body{background:#07254a;display:flex;align-items:center;justify-content:center;overflow:auto;}
@@keyframes lg-tile-idle{0%,100%{filter:brightness(.84)}50%{filter:brightness(1.05)}}
@@keyframes lg-fade-up{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.dwall{position:fixed;inset:-2% 0;z-index:0;display:grid;
  grid-template-columns:repeat(8,1fr);grid-template-rows:repeat(6,1fr);gap:8px;}
.dt{border-radius:7px;background:linear-gradient(150deg,#0d3a6e 0%,#082a54 100%);
  box-shadow:inset 0 0 0 1px rgba(130,195,255,.09),inset 0 1px 0 rgba(165,212,255,.13);
  animation:lg-tile-idle 6.5s ease-in-out infinite;
  animation-delay:calc((var(--col) + var(--row)) * -.5s);position:relative;overflow:hidden;}
.dt::before{content:'';position:absolute;inset:0;
  background:linear-gradient(138deg,rgba(160,210,255,.16) 0%,transparent 46%);opacity:.7;}
.scrim{position:fixed;inset:0;z-index:1;pointer-events:none;
  background:radial-gradient(ellipse 60% 70% at 50% 50%,rgba(2,18,42,.20),rgba(3,20,48,.62) 90%);}
.card{position:relative;z-index:5;width:min(92vw,400px);margin:24px;
  background:#fff;border:1px solid rgba(0,40,90,.06);border-radius:var(--r-3xl);
  box-shadow:0 50px 110px rgba(0,26,66,.42),0 8px 28px rgba(0,30,70,.12);
  padding:34px 34px 30px;animation:lg-fade-up .5s var(--ease-ios) both;}
.accent{height:4px;width:46px;border-radius:4px;margin-bottom:18px;
  background:linear-gradient(90deg,var(--lg-blue),#46b3ff);}
h1{font-size:23px;font-weight:700;letter-spacing:-.6px;color:var(--lg-label);margin:0 0 6px;}
.sub{font-size:13.5px;color:var(--lg-label-2);margin:0 0 20px;line-height:1.55;}
.flabel{display:block;font-size:11px;font-weight:700;text-transform:uppercase;
  letter-spacing:.06em;color:rgba(0,0,0,.62);margin-bottom:5px;}
.wrap{position:relative;display:flex;align-items:center;margin-bottom:14px;}
.ico{position:absolute;left:13px;color:rgba(0,0,0,.4);display:flex;pointer-events:none;}
input{width:100%;padding:11px 40px 11px 38px;font-family:var(--font-sans);
  font-size:14px;color:var(--lg-label);background:#fff;
  border:1px solid var(--lg-sep);border-radius:var(--r-lg);outline:none;
  transition:border-color .2s,box-shadow .2s;}
input:focus{border-color:var(--lg-blue);box-shadow:0 0 0 3px rgba(0,119,200,.11);}
input::placeholder{color:rgba(0,0,0,.32);}
.alerta{display:flex;align-items:flex-start;gap:8px;
  background:rgba(230,57,70,.07);border:1px solid rgba(230,57,70,.22);
  border-radius:var(--r-lg);padding:10px 13px;margin-bottom:14px;
  color:var(--lg-red);font-size:13px;font-weight:500;line-height:1.45;}
.alerta::before{content:'⚠';flex-shrink:0;}
.medidor{height:4px;border-radius:4px;background:var(--lg-fill-3);margin:-6px 0 14px;overflow:hidden;}
.medidor div{height:100%;width:0;border-radius:4px;background:var(--lg-red);transition:width .25s,background .25s;}
.cta{width:100%;display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:12px 18px;font-family:var(--font-sans);font-size:14.5px;font-weight:600;
  color:#fff;border:none;border-radius:var(--r-lg);cursor:pointer;
  background:linear-gradient(135deg,var(--lg-blue-mid),var(--lg-blue));
  box-shadow:0 4px 12px rgba(0,119,200,.28);transition:box-shadow .2s,transform .12s;}
.cta:hover{box-shadow:0 6px 20px rgba(0,119,200,.40);}
.cta:active{transform:scale(.98);}
.btn-ojo{position:absolute;right:8px;display:flex;align-items:center;justify-content:center;
  width:30px;height:30px;border-radius:8px;color:rgba(0,0,0,.42);
  background:none;border:none;cursor:pointer;transition:background .15s,color .15s;}
.btn-ojo:hover{background:var(--lg-fill-3);color:var(--lg-blue);}
.volver{display:block;text-align:center;font-size:12.5px;color:var(--lg-blue);
  font-weight:500;margin-top:16px;text-decoration:none;}
.volver:hover{text-decoration:underline;}
</style>
</head>
<body>
<div class="dwall" aria-hidden="true">
  @for (int row = 0; row < 6; row++)
  {
    for (int col = 0; col < 8; col++)
    {
      <div class="dt" style="--col:@col;--row:@row;"></div>
    }
  }
</div>
<div class="scrim"></div>

<div class="card">
  <div class="accent"></div>
  <h1>Nueva contraseña</h1>
  <p class="sub">Crea una contraseña segura de al menos 8 caracteres.</p>

  @if (hayError) {
    foreach (var entry in ViewData.ModelState.Values)
      foreach (var err in entry.Errors) { <div class="alerta">@err.ErrorMessage</div> }
  }

  <form asp-action="RestablecerPassword" asp-controller="Account" method="post" id="resetForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="token" value="@token" />

    <label class="flabel" for="pass1">Nueva contraseña</label>
    <div class="wrap">
      <span class="ico">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </span>
      <input type="password" id="pass1" name="contrasena" placeholder="Mínimo 8 caracteres"
             required minlength="8" maxlength="128" autocomplete="new-password" autofocus
             oninput="medir(this.value)" />
      <button type="button" class="btn-ojo" onclick="toggleVer()" aria-label="Mostrar contraseña">
        <svg id="eyeIco" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
      </button>
    </div>
    <div class="medidor"><div id="barra"></div></div>

    <label class="flabel" for="pass2">Confirmar contraseña</label>
    <div class="wrap">
      <span class="ico">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </span>
      <input type="password" id="pass2" name="confirmar" placeholder="Repite la contraseña"
             required minlength="8" maxlength="128" autocomplete="new-password" />
    </div>

    <button type="submit" class="cta">
      Guardar contraseña
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    </button>
  </form>

  <a class="volver" href="/Account/Login">← Volver a iniciar sesión</a>
</div>

<script>
  function toggleVer() {
    var i1 = document.getElementById('pass1'), i2 = document.getElementById('pass2');
    var ico = document.getElementById('eyeIco');
    var visible = i1.type === 'text';
    i1.type = i2.type = visible ? 'password' : 'text';
    ico.innerHTML = visible
      ? '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>'
      : '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';
  }
  function medir(v) {
    var pts = 0;
    if (v.length >= 8) pts++;
    if (v.length >= 12) pts++;
    if (/[A-Z]/.test(v) && /[a-z]/.test(v)) pts++;
    if (/\d/.test(v)) pts++;
    if (/[^A-Za-z0-9]/.test(v)) pts++;
    var barra = document.getElementById('barra');
    var pct = Math.min(100, pts * 20);
    barra.style.width = pct + '%';
    barra.style.background = pts <= 2 ? '#E63946' : pts <= 3 ? '#FF9500' : '#34C759';
  }
  document.getElementById('resetForm').addEventListener('submit', function (e) {
    var p1 = document.getElementById('pass1').value, p2 = document.getElementById('pass2').value;
    if (p1 !== p2) {
      e.preventDefault();
      alert('Las contraseñas no coinciden.');
    }
  });
</script>
</body>
</html>
