@model Plataforma_ventas.ViewModels.LoginViewModel
@{
    Layout = null;

    // Los errores del servidor se pintan en el párrafo .ml-error de la tarjeta,
    // que es donde login.js pone también los suyos. Un solo sitio para el error,
    // venga de donde venga: el usuario no tiene por qué saber cuál es cuál.
    var errores = ViewData.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .ToList();

    // El aviso de recuperación de contraseña llega por TempData y también
    // termina en la tarjeta, para no abrir una segunda zona de mensajes.
    var aviso = (TempData["Exito"] ?? TempData["Info"]) as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  <meta name="theme-color" content="#1e222b"/>
  <title>Mercurio — Iniciar sesión</title>
  <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true"/>
  <link rel="icon" href="~/favicon.ico" sizes="any"/>
  <link rel="stylesheet" href="~/mercurio-login/login.css" asp-append-version="true"/>
  <style>
    /* Aviso de la plataforma —"revisa tu correo", "contraseña actualizada"—, en
       menta para distinguirlo del error, que es rojo. Va aquí y no en login.css
       a propósito: ese archivo llega hecho desde el paquete de diseño y se va a
       volver a recibir actualizado; lo que agreguemos ahí se perdería. */
    .ml-note {
      margin: 0 0 4px; padding: 10px 12px; border-radius: 10px;
      font-size: 13px; line-height: 1.45; color: #bff3e4;
      background: rgba(0, 212, 161, 0.12);
      border: 1px solid rgba(0, 212, 161, 0.35);
    }
  </style>
</head>
<body style="margin:0;background:#1e222b">

@* data-base apunta a la carpeta pública donde están texturas/. Sin data-autoinit:
   se inicializa abajo a mano para poder pedir que la intro se vea una sola vez
   por sesión. *@
<div class="ml-root" id="mercurio-login" data-base="/mercurio-login/">
  <canvas class="ml-canvas" aria-hidden="true"></canvas>
  <div class="ml-lift" aria-hidden="true"></div>
  <div class="ml-vignette" aria-hidden="true"></div>

  <header class="ml-header">
    <div class="ml-brand">
      <svg width="38" height="38" viewBox="0 0 38 38" aria-hidden="true">
        <ellipse cx="19" cy="19" rx="17" ry="6.5" transform="rotate(-18 19 19)" fill="none" stroke="#00c9ff" stroke-opacity="0.8" stroke-width="1.3"></ellipse>
        <circle cx="19" cy="19" r="7.5" fill="#c3cfdb"></circle>
      </svg>
      <div class="ml-brand-text">
        <span class="ml-brand-name">Mercurio</span>
        <span class="ml-brand-sub">por Londoño Gómez</span>
      </div>
    </div>
    @* El crédito de las texturas es obligatorio por su licencia (CC BY 4.0). *@
    <span class="ml-credit">Texturas planetarias: Solar System Scope · CC BY 4.0 · datos NASA</span>
  </header>

  <main class="ml-main">
    <section class="ml-hero ml-ui">
      <span class="ml-badge"><span class="ml-dot"></span>Lanzamientos en tiempo real</span>
      <h1>Cada metro,<br>bajo control.</h1>
      <p>El inventario de todos tus proyectos, vivo, en una sola plataforma.</p>
    </section>

    <div class="ml-card ml-ui" data-no-orbit>
      <div class="ml-accent"></div>
      <h2>Iniciar sesión</h2>
      <p class="ml-card-sub">Bienvenido de vuelta. Ingresa para continuar.</p>

      @* POST clásico: con action y sin onSubmit, login.js valida que no estén
         vacíos, muestra la animación de carga y deja que el formulario se envíe
         solo. Así el token antiforgery, el bloqueo por intentos y los mensajes
         siguen resolviéndose en el servidor, como hasta ahora. *@
      <form class="ml-form" data-ml="form" method="post"
            asp-controller="Account" asp-action="Login" novalidate>
        @Html.AntiForgeryToken()

        <div class="ml-group">
          <label class="ml-label" for="ml-user">Usuario</label>
          <div class="ml-field">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 4-6 8-6s8 2 8 6"></path></svg>
            <input id="ml-user" name="usuario" type="text" value="@Model?.Usuario"
                   autocomplete="username" autocapitalize="none" spellcheck="false"
                   maxlength="60" placeholder="tu.usuario" required>
          </div>
        </div>

        <div class="ml-group">
          <label class="ml-label" for="ml-pass">Contraseña</label>
          <div class="ml-field ml-field--pass">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
            <input id="ml-pass" name="contrasena" type="password" autocomplete="current-password" placeholder="••••••••" required>
            <button type="button" class="ml-icon-btn" data-ml="toggle-pass" aria-label="Mostrar contraseña">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            </button>
          </div>
        </div>

        <div class="ml-row">
          <label class="ml-check"><input type="checkbox" name="recordarme">Recordarme</label>
          @* Enlace de verdad, no un gancho de JavaScript: sin onForgot, login.js
             no intercepta el clic y el navegador navega normal. Así funciona
             también con el botón central del ratón y con el teclado. *@
          <a class="ml-link" data-ml="forgot" asp-controller="Account" asp-action="RecuperarPassword">¿Olvidaste tu contraseña?</a>
        </div>

        <p class="ml-error @(errores.Count > 0 ? "is-visible" : "")" data-ml="error" role="alert">@string.Join(" ", errores)</p>
        @if (!string.IsNullOrEmpty(aviso))
        {
          <p class="ml-note" role="status">@aviso</p>
        }

        <button type="submit" class="ml-submit" data-ml="submit">
          <span class="ml-when-idle">Ingresar<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
          <span class="ml-when-loading"><span class="ml-spinner" aria-hidden="true"></span>Entrando en órbita…</span>
        </button>
      </form>
      <p class="ml-foot">Acceso exclusivo para colaboradores de Londoño Gómez.</p>
    </div>
  </main>

  <div class="ml-caption" data-ml="caption" aria-live="polite"></div>

  <div class="ml-controls">
    <span class="ml-hint">Arrastra para girar 360° · rueda o pellizco para acercar / alejar</span>
    <div class="ml-zoom" role="group" aria-label="Zoom">
      <button type="button" data-ml="zoom-out" aria-label="Alejar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"></path></svg></button>
      <button type="button" data-ml="zoom-reset" aria-label="Volver a la vista inicial"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path></svg></button>
      <button type="button" data-ml="zoom-in" aria-label="Acercar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg></button>
    </div>
  </div>
  <div class="ml-introbtn">
    <button type="button" class="ml-ghost ml-skip" data-ml="skip">Saltar intro</button>
    <button type="button" class="ml-ghost ml-replay" data-ml="replay">Repetir intro</button>
  </div>
  <p class="ml-credit-m">Texturas: Solar System Scope · CC BY 4.0 · datos NASA</p>
</div>

@* Este orden no es negociable: three.js define THREE, espacio.js lo usa para
   construir la escena y login.js conecta la escena con el formulario. *@
<script src="~/mercurio-login/vendor/three.min.js" asp-append-version="true"></script>
<script src="~/mercurio-login/espacio.js" asp-append-version="true"></script>
<script src="~/mercurio-login/login.js" asp-append-version="true"></script>
<script>
  MercurioLogin.init(document.getElementById('mercurio-login'), {
    base: '/mercurio-login/',
    // El viaje desde Neptuno dura un rato. Verlo una vez es bonito; verlo en
    // cada intento fallido, en mitad de un lanzamiento, es un estorbo.
    introUnaVezPorSesion: true
    // Sin onSubmit ni onForgot a propósito: el formulario se envía al servidor
    // como siempre y el enlace de recuperación navega solo.
  });
</script>

</body>
</html>
