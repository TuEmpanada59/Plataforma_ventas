@model Plataforma_ventas.ViewModels.LoginViewModel
@{
    Layout = null;
    bool hayError = !ViewData.ModelState.IsValid;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Londoño Gómez — Iniciar sesión</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
        :root{
            --azul:#0076e3;--celeste:#00c9ff;--negro:#1e222b;--plata:#c3cfdb;--menta:#00d4a1;
            --azul-m:#0060bb;--navy:#07254a;--navy2:#0a2747;
            --rojo:#E63946;--verde:#34C759;
            --label:rgba(0,0,0,0.85);--label2:rgba(60,60,67,0.6);--label3:rgba(0,0,0,0.55);
            --sep:rgba(60,60,67,0.14);
        }
        html,body{height:100%;}
        body{margin:0;background:var(--navy);overflow:hidden;font-family:'Inter',system-ui,sans-serif;-webkit-font-smoothing:antialiased;}

        /* ── Fondo mosaico reactivo (canvas) ── */
        #mosaico{position:fixed;inset:0;display:block;}

        /* ── Titular editorial (izquierda) ── */
        .f-headline{position:fixed;left:6vw;top:50%;transform:translateY(-50%);z-index:2;max-width:520px;pointer-events:none;}
        .f-headline .kicker{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:var(--celeste);margin-bottom:18px;}
        .f-headline .kicker::before{content:'';width:28px;height:2px;background:var(--celeste);border-radius:2px;}
        .f-headline h1{font-size:clamp(2rem,4.2vw,3.4rem);font-weight:800;color:#fff;letter-spacing:-1.5px;line-height:1.08;margin-bottom:18px;}
        .f-headline h1 em{font-style:normal;color:var(--celeste);}
        .f-headline p{font-size:1rem;color:rgba(255,255,255,0.55);line-height:1.7;max-width:420px;}

        /* ── Tarjeta sólida (derecha) ── */
        .fin-card{position:fixed;right:7vw;top:50%;transform:translateY(-50%);z-index:3;width:400px;background:#fff;border-radius:22px;box-shadow:0 40px 90px rgba(2,16,38,0.55),0 4px 18px rgba(2,16,38,0.3);padding:2.3rem 2.4rem 2.4rem;animation:cardIn 0.55s cubic-bezier(.3,.9,.3,1) both;}
        @@keyframes cardIn{from{opacity:0;transform:translateY(calc(-50% + 22px));}to{opacity:1;transform:translateY(-50%);}}
        .fin-card.shake{animation:shake 0.45s cubic-bezier(.36,.07,.19,.97) both;}
        @@keyframes shake{10%,90%{transform:translate(-2px,-50%)}20%,80%{transform:translate(4px,-50%)}30%,50%,70%{transform:translate(-6px,-50%)}40%,60%{transform:translate(6px,-50%)}100%{transform:translate(0,-50%)}}

        .card-logo{display:flex;align-items:center;gap:12px;margin-bottom:1.6rem;}
        .card-logo img{height:44px;object-fit:contain;mix-blend-mode:multiply;}
        .card-title{font-size:1.45rem;font-weight:800;color:var(--negro);letter-spacing:-0.6px;margin-bottom:0.3rem;}
        .card-sub{font-size:0.85rem;color:var(--label2);margin-bottom:1.5rem;}

        .campo{margin-bottom:14px;}
        .campo label{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:var(--label3);margin-bottom:5px;}
        .input-wrap{position:relative;}
        .input-wrap .ico{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:15px;height:15px;color:var(--label3);pointer-events:none;}
        .campo input{width:100%;padding:11px 40px 11px 36px;background:#f4f7fb;border:1.5px solid transparent;border-radius:12px;font-family:'Inter',system-ui,sans-serif;font-size:14px;color:var(--label);outline:none;transition:border-color 0.2s,box-shadow 0.2s,background 0.2s;}
        .campo input::placeholder{color:var(--label3);}
        .campo input:focus{border-color:var(--azul);background:#fff;box-shadow:0 0 0 4px rgba(0,118,227,0.12);}
        .btn-ojo{position:absolute;right:11px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--label3);display:flex;align-items:center;border-radius:5px;padding:3px;transition:color 0.15s;}
        .btn-ojo:hover{color:var(--negro);}
        .btn-ojo svg{width:15px;height:15px;}

        .alerta{display:flex;align-items:flex-start;gap:8px;background:rgba(230,57,70,0.07);border:1px solid rgba(230,57,70,0.22);border-radius:12px;padding:10px 13px;margin-bottom:14px;color:var(--rojo);font-size:13px;font-weight:500;line-height:1.45;}
        .alerta::before{content:'⚠';flex-shrink:0;}
        .exito{display:flex;align-items:center;gap:8px;background:rgba(52,199,89,0.08);border:1px solid rgba(52,199,89,0.22);border-radius:12px;padding:10px 13px;margin-bottom:14px;color:#1A7A35;font-size:13px;font-weight:500;}
        .exito::before{content:'✓';flex-shrink:0;}
        .error-msg{display:block;font-size:11px;color:var(--rojo);margin-top:4px;padding-left:3px;}

        .btn-submit{margin-top:8px;width:100%;padding:13px;background:linear-gradient(135deg,var(--azul-m),var(--azul));color:#fff;border:none;border-radius:13px;font-family:'Inter',system-ui,sans-serif;font-size:15px;font-weight:700;letter-spacing:-0.2px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 6px 18px rgba(0,118,227,0.35);transition:transform 0.15s,box-shadow 0.2s,filter 0.2s;}
        .btn-submit:hover{filter:brightness(1.07);box-shadow:0 8px 24px rgba(0,118,227,0.45);transform:translateY(-1px);}
        .btn-submit:active{transform:translateY(0);}
        .btn-submit svg{width:16px;height:16px;}
        .card-foot{margin-top:1.4rem;text-align:center;font-size:11.5px;color:var(--label3);display:flex;align-items:center;justify-content:center;gap:6px;}
        .card-foot svg{width:12px;height:12px;flex-shrink:0;}

        @@media (max-width:820px){
            .f-headline{display:none;}
            .fin-card{right:50%;transform:translate(50%,-50%);width:min(92vw,400px);}
            @@keyframes cardIn{from{opacity:0;transform:translate(50%,calc(-50% + 22px));}to{opacity:1;transform:translate(50%,-50%);}}
            @@keyframes shake{10%,90%{transform:translate(calc(50% - 2px),-50%)}20%,80%{transform:translate(calc(50% + 4px),-50%)}30%,50%,70%{transform:translate(calc(50% - 6px),-50%)}40%,60%{transform:translate(calc(50% + 6px),-50%)}100%{transform:translate(50%,-50%)}}
        }
    </style>
</head>
<body>

<canvas id="mosaico" aria-hidden="true"></canvas>

<div class="f-headline">
    <span class="kicker">Londoño Gómez</span>
    <h1>Gestiona tus <em>lanzamientos</em> inmobiliarios</h1>
    <p>Inventario, ventas y reportes de todos tus proyectos en una sola plataforma.</p>
</div>

<div class="fin-card @(hayError ? "shake" : "")" id="finCard">
    <div class="card-logo">
        <img src="~/Images/Logo azul 2.jpg" alt="Londoño Gómez" />
    </div>
    <div class="card-title">Iniciar sesión</div>
    <div class="card-sub">Ingresa tus credenciales para continuar</div>

    @if (TempData["Exito"] != null) { <div class="exito">@TempData["Exito"]</div> }
    @if (hayError) {
        foreach (var entry in ViewData.ModelState.Values)
            foreach (var error in entry.Errors) { <div class="alerta">@error.ErrorMessage</div> }
    }

    <form asp-action="Login" asp-controller="Account" method="post" autocomplete="on">
        @Html.AntiForgeryToken()
        <div class="campo">
            <label for="inputUser">Usuario</label>
            <div class="input-wrap">
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <input asp-for="Usuario" id="inputUser" type="text" placeholder="Tu usuario" autofocus
                       autocomplete="username" maxlength="60" autocapitalize="off" spellcheck="false" />
            </div>
            <span asp-validation-for="Usuario" class="error-msg"></span>
        </div>
        <div class="campo">
            <label for="inputPass">Contraseña</label>
            <div class="input-wrap">
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <input asp-for="Password" id="inputPass" type="password" placeholder="••••••••"
                       autocomplete="current-password" maxlength="128" />
                <button type="button" class="btn-ojo" id="togglePass" title="Mostrar contraseña" aria-label="Mostrar contraseña">
                    <svg id="iconOjo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
            </div>
            <span asp-validation-for="Password" class="error-msg"></span>
        </div>
        <button type="submit" class="btn-submit" id="btnSubmit">
            Ingresar
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
    </form>

    <div class="card-foot">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Conexión segura · Acceso solo para personal autorizado
    </div>
</div>

<script>
    // ── Fondo mosaico reactivo con efecto lupa ──
    (function () {
        const canvas = document.getElementById('mosaico');
        const ctx = canvas.getContext('2d');
        const TILE = 34, GAP = 7, RADIO = 200;
        let cols = 0, rows = 0, dpr = 1;
        let mx = -9999, my = -9999;      // posición real del mouse
        let lx = -9999, ly = -9999;      // posición suavizada (lerp)

        function resize() {
            dpr = window.devicePixelRatio || 1;
            canvas.width = innerWidth * dpr;
            canvas.height = innerHeight * dpr;
            canvas.style.width = innerWidth + 'px';
            canvas.style.height = innerHeight + 'px';
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            cols = Math.ceil(innerWidth / (TILE + GAP)) + 1;
            rows = Math.ceil(innerHeight / (TILE + GAP)) + 1;
        }

        function rr(x, y, w, h, r) {
            ctx.beginPath();
            ctx.moveTo(x + r, y);
            ctx.arcTo(x + w, y, x + w, y + h, r);
            ctx.arcTo(x + w, y + h, x, y + h, r);
            ctx.arcTo(x, y + h, x, y, r);
            ctx.arcTo(x, y, x + w, y, r);
            ctx.closePath();
        }

        function draw() {
            lx += (mx - lx) * 0.12;
            ly += (my - ly) * 0.12;
            ctx.clearRect(0, 0, innerWidth, innerHeight);
            for (let i = 0; i < cols; i++) {
                for (let j = 0; j < rows; j++) {
                    const x = i * (TILE + GAP), y = j * (TILE + GAP);
                    const cx = x + TILE / 2, cy = y + TILE / 2;
                    const d = Math.hypot(cx - lx, cy - ly);
                    // intensidad de lupa: 1 en el centro del cursor → 0 fuera del radio
                    const t = Math.max(0, 1 - d / RADIO);
                    const ease = t * t * (3 - 2 * t);
                    const alpha = 0.05 + ease * 0.5;
                    const grow = ease * 5;
                    if (ease > 0.02) {
                        ctx.fillStyle = 'rgba(0,201,255,' + alpha.toFixed(3) + ')';
                    } else {
                        ctx.fillStyle = 'rgba(0,118,227,' + alpha.toFixed(3) + ')';
                    }
                    rr(x - grow / 2, y - grow / 2, TILE + grow, TILE + grow, 5 + grow / 2);
                    ctx.fill();
                }
            }
            requestAnimationFrame(draw);
        }

        addEventListener('resize', resize);
        addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; });
        addEventListener('mouseleave', () => { mx = -9999; my = -9999; });
        resize();
        draw();
    })();

    // ── Mostrar/ocultar contraseña ──
    document.getElementById('togglePass').addEventListener('click', function () {
        const input = document.getElementById('inputPass'), icono = document.getElementById('iconOjo'), visible = input.type === 'text';
        input.type = visible ? 'password' : 'text';
        icono.innerHTML = visible
            ? '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>'
            : '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';
    });

    // ── Doble envío: deshabilitar el botón al enviar ──
    document.querySelector('form').addEventListener('submit', function () {
        const btn = document.getElementById('btnSubmit');
        btn.disabled = true;
        btn.style.opacity = '0.7';
        btn.firstChild.textContent = 'Verificando… ';
    });
</script>
</body>
</html>
