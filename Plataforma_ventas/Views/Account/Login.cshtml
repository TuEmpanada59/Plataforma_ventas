@model Plataforma_ventas.ViewModels.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Londoño Gómez · Acceso</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
        :root{--azul:#0076e3;--celeste:#00c9ff;--negro:#1e222b;--plata:#c3cfdb;--menta:#00d4a1;--azul-m:#0060bb;--azul-b:#0076e3;--rojo:#E63946;--verde:#34C759;--label:rgba(0,0,0,0.85);--label2:rgba(60,60,67,0.6);--label3:rgba(0,0,0,0.65);--sep:rgba(60,60,67,0.12);--fill3:rgba(120,120,128,0.08);--glass:rgba(255,255,255,0.82);--gb:rgba(255,255,255,0.6);--error:#E63946;}
        html,body{height:100%;font-family:'Inter',system-ui,sans-serif;-webkit-font-smoothing:antialiased;display:flex;align-items:center;justify-content:center;}
        body::before{content:'';position:fixed;inset:0;z-index:0;background:radial-gradient(ellipse 90% 70% at 5% 0%,rgba(0,118,227,0.18) 0%,transparent 55%),radial-gradient(ellipse 70% 60% at 95% 10%,rgba(0,118,227,0.12) 0%,transparent 50%),#EEF2F7;pointer-events:none;}
        body::after{content:'';position:fixed;inset:0;z-index:0;background-image:radial-gradient(circle,rgba(0,118,227,0.05) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;}
        .wrap{position:relative;z-index:1;width:480px;border-radius:28px;overflow:hidden;box-shadow:0 40px 100px rgba(0,40,100,0.18),0 8px 30px rgba(0,0,0,0.07),0 0 0 1px rgba(255,255,255,0.55) inset;animation:wrapIn 0.5s cubic-bezier(.4,0,.2,1) both;background:var(--glass);backdrop-filter:blur(40px) saturate(180%);-webkit-backdrop-filter:blur(40px) saturate(180%);}
        @@keyframes wrapIn{from{opacity:0;transform:translateY(18px) scale(0.97)}to{opacity:1;transform:translateY(0) scale(1)}}
        .card-header{background:linear-gradient(145deg,var(--azul) 0%,var(--azul-m) 50%,var(--celeste) 100%);padding:2.2rem 2.6rem 1.8rem;display:flex;flex-direction:column;align-items:center;gap:1rem;position:relative;overflow:hidden;}
        .card-header::before{content:'';position:absolute;top:-60px;right:-60px;width:200px;height:200px;border-radius:50%;background:rgba(255,255,255,0.07);pointer-events:none;}
        .card-header::after{content:'';position:absolute;bottom:-80px;left:-50px;width:220px;height:220px;border-radius:50%;background:rgba(0,0,0,0.07);pointer-events:none;}
        .app-icon{position:relative;z-index:1;width:64px;height:64px;background:rgba(255,255,255,0.18);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.3);border-radius:18px;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 24px rgba(0,0,0,0.14);overflow:hidden;}
        .app-icon img{width:100%;height:100%;object-fit:cover;}
        .card-header h1{position:relative;z-index:1;font-size:1.45rem;font-weight:700;color:white;letter-spacing:-0.5px;margin:0;text-align:center;}
        .card-header p{position:relative;z-index:1;font-size:0.83rem;color:rgba(255,255,255,0.72);margin:0;text-align:center;}
        .card-body{padding:2rem 2.6rem 2.2rem;}
        .campo{margin-bottom:14px;}
        .campo label{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--label3);margin-bottom:4px;}
        .input-wrap{position:relative;}
        .input-wrap .ico{position:absolute;left:11px;top:50%;transform:translateY(-50%);width:14px;height:14px;color:var(--label3);pointer-events:none;}
        .campo input{width:100%;padding:10px 14px 10px 34px;background:rgba(255,255,255,0.65);border:1px solid var(--sep);border-radius:12px;font-family:'Inter',system-ui,sans-serif;font-size:14px;color:var(--label);outline:none;transition:border-color 0.2s,box-shadow 0.2s,background 0.2s;}
        .campo input::placeholder{color:var(--label3);}
        .campo input:focus{border-color:var(--azul-b);background:white;box-shadow:0 0 0 3px rgba(0,118,227,0.11);}
        .btn-ojo{position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--label3);display:flex;align-items:center;border-radius:5px;padding:2px;transition:color 0.15s;}
        .btn-ojo:hover{color:var(--label2);}
        .btn-ojo svg{width:14px;height:14px;}
        .alerta{display:flex;align-items:center;gap:7px;background:rgba(230,57,70,0.08);border:1px solid rgba(230,57,70,0.18);border-radius:12px;padding:9px 13px;margin-bottom:14px;color:var(--error);font-size:13px;font-weight:500;}
        .alerta::before{content:'⚠';flex-shrink:0;}
        .exito{display:flex;align-items:center;gap:7px;background:rgba(52,199,89,0.08);border:1px solid rgba(52,199,89,0.2);border-radius:12px;padding:9px 13px;margin-bottom:14px;color:#1A7A35;font-size:13px;font-weight:500;}
        .exito::before{content:'✓';flex-shrink:0;}
        .btn-submit{margin-top:6px;width:100%;padding:13px;background:linear-gradient(135deg,var(--azul-m),var(--azul-b));color:white;border:none;border-radius:14px;font-size:15px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:7px;box-shadow:0 4px 16px rgba(0,118,227,0.3);transition:all 0.2s;}
        .btn-submit:hover{background:linear-gradient(135deg,var(--azul),var(--azul-m));box-shadow:0 6px 20px rgba(0,118,227,0.4);transform:translateY(-1px);}
        .btn-submit svg{width:15px;height:15px;}
    </style>
</head>
<body>
<div class="wrap">
    <div class="card-header">
        <div class="app-icon">
            <img src="~/Images/Logo azul 2.jpg" alt="Londoño Gómez" style="mix-blend-mode:multiply;"/>
        </div>
        <div>
            <h1>Londoño Gómez</h1>
            <p>Plataforma de gestión de ventas</p>
        </div>
    </div>
    <div class="card-body">
        @if (TempData["Exito"] != null) { <div class="exito">@TempData["Exito"]</div> }
        @if (!ViewData.ModelState.IsValid) {
            foreach (var entry in ViewData.ModelState.Values)
                foreach (var error in entry.Errors) { <div class="alerta">@error.ErrorMessage</div> }
        }
        <form asp-action="Login" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <div class="campo">
                <label>Usuario</label>
                <div class="input-wrap">
                    <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <input asp-for="Usuario" type="text" placeholder="Tu usuario" autofocus autocomplete="username"/>
                </div>
                <span asp-validation-for="Usuario" style="font-size:11px;color:var(--error);display:block;margin-top:3px;padding-left:3px;"></span>
            </div>
            <div class="campo">
                <label>Contraseña</label>
                <div class="input-wrap">
                    <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    <input asp-for="Password" type="password" id="inputPass" placeholder="••••••••" autocomplete="current-password"/>
                    <button type="button" class="btn-ojo" id="togglePass" title="Mostrar contraseña">
                        <svg id="iconOjo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
                <span asp-validation-for="Password" style="font-size:11px;color:var(--error);display:block;margin-top:3px;padding-left:3px;"></span>
            </div>
            <button type="submit" class="btn-submit">
                Ingresar
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
        </form>
    </div>
</div>
<script>
    document.getElementById('togglePass').addEventListener('click', function () {
        const input = document.getElementById('inputPass'), icono = document.getElementById('iconOjo'), visible = input.type === 'text';
        input.type = visible ? 'password' : 'text';
        icono.innerHTML = visible
            ? '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>'
            : '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';
    });
</script>
</body>
</html>
