@{
    Layout = null;
    bool hayError = !ViewData.ModelState.IsValid;
}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Londoño Gómez — Recuperar contraseña</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --lg-blue-mid:#0055A5;--lg-blue:#0077C8;--lg-red:#E63946;
  --lg-label:rgba(0,0,0,0.85);--lg-label-2:rgba(60,60,67,0.60);
  --lg-sep:rgba(60,60,67,0.12);--lg-fill-3:rgba(120,120,128,0.08);
  --r-lg:12px;--r-3xl:28px;
  --ease-ios:cubic-bezier(.4,0,.2,1);
  --font-sans:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;-webkit-font-smoothing:antialiased;font-family:var(--font-sans);}
body{background:#07254a;display:flex;align-items:center;justify-content:center;overflow:auto;}
@@keyframes lg-tile-idle{0%,100%{filter:brightness(.84)}50%{filter:brightness(1.05)}}
@@keyframes lg-fade-up{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.dwall{position:fixed;inset:-2% 0;z-index:0;display:grid;
  grid-template-columns:repeat(8,1fr);grid-template-rows:repeat(6,1fr);gap:8px;}
.dt{border-radius:7px;background:linear-gradient(150deg,#0d3a6e 0%,#082a54 100%);
  box-shadow:inset 0 0 0 1px rgba(130,195,255,.09),inset 0 1px 0 rgba(165,212,255,.13);
  animation:lg-tile-idle 6.5s ease-in-out infinite;
  animation-delay:calc((var(--col) + var(--row)) * -.5s);position:relative;overflow:hidden;}
.dt::before{content:'';position:absolute;inset:0;
  background:linear-gradient(138deg,rgba(160,210,255,.16) 0%,transparent 46%);opacity:.7;}
.scrim{position:fixed;inset:0;z-index:1;pointer-events:none;
  background:radial-gradient(ellipse 60% 70% at 50% 50%,rgba(2,18,42,.20),rgba(3,20,48,.62) 90%);}
.card{position:relative;z-index:5;width:min(92vw,400px);margin:24px;
  background:#fff;border:1px solid rgba(0,40,90,.06);border-radius:var(--r-3xl);
  box-shadow:0 50px 110px rgba(0,26,66,.42),0 8px 28px rgba(0,30,70,.12);
  padding:34px 34px 30px;animation:lg-fade-up .5s var(--ease-ios) both;}
.accent{height:4px;width:46px;border-radius:4px;margin-bottom:18px;
  background:linear-gradient(90deg,var(--lg-blue),#46b3ff);}
h1{font-size:23px;font-weight:700;letter-spacing:-.6px;color:var(--lg-label);margin:0 0 6px;}
.sub{font-size:13.5px;color:var(--lg-label-2);margin:0 0 20px;line-height:1.55;}
.flabel{display:block;font-size:11px;font-weight:700;text-transform:uppercase;
  letter-spacing:.06em;color:rgba(0,0,0,.62);margin-bottom:5px;}
.wrap{position:relative;display:flex;align-items:center;margin-bottom:16px;}
.ico{position:absolute;left:13px;color:rgba(0,0,0,.4);display:flex;pointer-events:none;}
input{width:100%;padding:11px 14px 11px 38px;font-family:var(--font-sans);
  font-size:14px;color:var(--lg-label);background:#fff;
  border:1px solid var(--lg-sep);border-radius:var(--r-lg);outline:none;
  transition:border-color .2s,box-shadow .2s;}
input:focus{border-color:var(--lg-blue);box-shadow:0 0 0 3px rgba(0,119,200,.11);}
input::placeholder{color:rgba(0,0,0,.32);}
.alerta{display:flex;align-items:flex-start;gap:8px;
  background:rgba(230,57,70,.07);border:1px solid rgba(230,57,70,.22);
  border-radius:var(--r-lg);padding:10px 13px;margin-bottom:14px;
  color:var(--lg-red);font-size:13px;font-weight:500;line-height:1.45;}
.alerta::before{content:'⚠';flex-shrink:0;}
.cta{width:100%;display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:12px 18px;font-family:var(--font-sans);font-size:14.5px;font-weight:600;
  color:#fff;border:none;border-radius:var(--r-lg);cursor:pointer;
  background:linear-gradient(135deg,var(--lg-blue-mid),var(--lg-blue));
  box-shadow:0 4px 12px rgba(0,119,200,.28);transition:box-shadow .2s,transform .12s;}
.cta:hover{box-shadow:0 6px 20px rgba(0,119,200,.40);}
.cta:active{transform:scale(.98);}
.volver{display:block;text-align:center;font-size:12.5px;color:var(--lg-blue);
  font-weight:500;margin-top:16px;text-decoration:none;}
.volver:hover{text-decoration:underline;}
</style>
</head>
<body>
<div class="dwall" aria-hidden="true">
  @for (int row = 0; row < 6; row++)
  {
    for (int col = 0; col < 8; col++)
    {
      <div class="dt" style="--col:@col;--row:@row;"></div>
    }
  }
</div>
<div class="scrim"></div>

<div class="card">
  <div class="accent"></div>
  <h1>Recuperar contraseña</h1>
  <p class="sub">Escribe el correo asociado a tu cuenta. Si está registrado, te enviaremos un enlace para restablecer tu contraseña.</p>

  @if (hayError) {
    foreach (var entry in ViewData.ModelState.Values)
      foreach (var err in entry.Errors) { <div class="alerta">@err.ErrorMessage</div> }
  }

  <form asp-action="RecuperarPassword" asp-controller="Account" method="post">
    @Html.AntiForgeryToken()
    <label class="flabel" for="correo">Correo electrónico</label>
    <div class="wrap">
      <span class="ico">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      </span>
      <input type="email" id="correo" name="correo" placeholder="correo@ejemplo.com"
             required maxlength="100" autocomplete="email" autofocus />
    </div>
    <button type="submit" class="cta">
      Enviar enlace
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </button>
  </form>

  <a class="volver" href="/Account/Login">← Volver a iniciar sesión</a>
</div>
</body>
</html>
