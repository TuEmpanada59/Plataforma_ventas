@{
    Layout = "~/Views/Shared/_VendedorLayout.cshtml";
    ViewData["Title"] = "Londoño Gómez — Inicio";
    ViewBag.ActiveNav = "vendedor-inicio";
    ViewBag.TbBread   = "Inicio";

    int total      = ViewBag.Total       != null ? (int)ViewBag.Total       : 0;
    int disponibles= ViewBag.Disponibles != null ? (int)ViewBag.Disponibles : 0;
    int reservados = ViewBag.Reservados  != null ? (int)ViewBag.Reservados  : 0;
    int vendidos   = ViewBag.Vendidos    != null ? (int)ViewBag.Vendidos    : 0;
    int misVentas  = ViewBag.MisVentas   != null ? (int)ViewBag.MisVentas   : 0;
    int misClientes= ViewBag.MisClientes != null ? (int)ViewBag.MisClientes : 0;
    var proyActivo = ViewBag.ProyectoActivo as string ?? "Sin proyecto";
    bool sinProyecto = ViewBag.SinProyecto != null ? (bool)ViewBag.SinProyecto : false;
    var errorCodigo  = ViewBag.ErrorCodigo as string ?? "";
    var nombre = ViewBag.Nombre as string ?? "";
}
@section Styles {
<style>
    @@keyframes fu{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    .welcome-banner{background:linear-gradient(135deg,var(--azul) 0%,var(--blue) 100%);border-radius:20px;padding:20px 24px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 8px 24px rgba(0,118,227,0.25);animation:fu 0.35s ease both;position:relative;overflow:hidden;}
    .welcome-banner::before{content:'';position:absolute;top:-30px;right:-30px;width:140px;height:140px;border-radius:50%;background:rgba(255,255,255,0.07);}
    .welcome-banner::after{content:'';position:absolute;bottom:-40px;right:100px;width:100px;height:100px;border-radius:50%;background:rgba(255,255,255,0.05);}
    .wb-txt h2{font-size:20px;font-weight:700;color:white;letter-spacing:-0.5px;margin-bottom:4px;}
    .wb-txt p{font-size:13px;color:rgba(255,255,255,0.7);}
    .wb-ico{font-size:48px;position:relative;z-index:1;}
    .kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
    .kpi{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:18px;padding:16px;box-shadow:var(--sh);transition:transform 0.2s,box-shadow 0.2s;animation:fu 0.35s ease both;}
    .kpi:nth-child(1){animation-delay:.05s}.kpi:nth-child(2){animation-delay:.1s}.kpi:nth-child(3){animation-delay:.15s}.kpi:nth-child(4){animation-delay:.2s}
    .kpi:hover{transform:translateY(-2px);}
    .kpi-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;}
    .kpi-ico{width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:17px;}
    .kpi.k1 .kpi-ico{background:rgba(0,118,227,0.1)}.kpi.k2 .kpi-ico{background:rgba(52,199,89,0.1)}.kpi.k3 .kpi-ico{background:rgba(255,149,0,0.1)}.kpi.k4 .kpi-ico{background:rgba(230,57,70,0.1)}
    .kpi-tag{font-size:11px;font-weight:600;padding:3px 8px;border-radius:20px;}
    .kpi.k1 .kpi-tag{background:rgba(0,118,227,0.1);color:var(--blue)}.kpi.k2 .kpi-tag{background:rgba(52,199,89,0.1);color:#1EA851}.kpi.k3 .kpi-tag{background:rgba(255,149,0,0.1);color:#CC7700}.kpi.k4 .kpi-tag{background:rgba(230,57,70,0.1);color:var(--rojo)}
    .kpi-num{font-size:32px;font-weight:300;letter-spacing:-1.5px;line-height:1;margin-bottom:3px;}
    .kpi.k1 .kpi-num{color:var(--azul)}.kpi.k2 .kpi-num{color:#1EA851}.kpi.k3 .kpi-num{color:#CC7700}.kpi.k4 .kpi-num{color:var(--rojo)}
    .kpi-lbl{font-size:12px;color:var(--label2);}
    .action-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
    .action-card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:18px;padding:20px;box-shadow:var(--sh);animation:fu 0.35s ease 0.25s both;display:flex;flex-direction:column;gap:12px;}
    .ac-head{display:flex;align-items:center;justify-content:space-between;}
    .ac-title{font-size:15px;font-weight:600;color:var(--label);}
    .ac-ico{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;}
    .ios-btn{display:inline-flex;align-items:center;gap:6px;background:var(--blue);color:white;border:none;padding:8px 14px;border-radius:11px;font-size:13px;font-weight:600;cursor:pointer;box-shadow:0 4px 12px rgba(0,118,227,0.28);transition:all 0.2s;text-decoration:none;}
    .ios-btn:hover{background:var(--mid);transform:scale(0.98);}
    .ac-stat{font-size:36px;font-weight:200;letter-spacing:-2px;}
    .ac-sub{font-size:12px;color:var(--label2);}
    .sin-proy-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1;padding:40px 20px;gap:24px;animation:fu 0.4s ease both;}
    .sin-proy-ico{width:80px;height:80px;border-radius:24px;background:linear-gradient(145deg,var(--mid),var(--blue));display:flex;align-items:center;justify-content:center;font-size:36px;box-shadow:0 8px 24px rgba(0,96,187,0.25);}
    .sin-proy-title{font-size:22px;font-weight:700;color:var(--azul);letter-spacing:-0.5px;text-align:center;}
    .sin-proy-sub{font-size:14px;color:var(--label2);text-align:center;max-width:320px;line-height:1.5;}
    .codigo-card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:20px;padding:28px;width:100%;max-width:380px;box-shadow:var(--sh);}
    .codigo-lbl{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--label2);margin-bottom:6px;}
    .codigo-input{width:100%;padding:12px 16px;background:var(--fill3);border:2px solid var(--sep);border-radius:12px;font-size:16px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--azul);outline:none;transition:all 0.2s;text-align:center;}
    .codigo-input:focus{background:white;border-color:var(--blue);box-shadow:0 0 0 3px rgba(0,118,227,0.1);}
    .codigo-input::placeholder{font-weight:400;letter-spacing:0;text-transform:none;color:var(--label3);}
    .btn-codigo{width:100%;padding:13px;background:linear-gradient(135deg,var(--azul),var(--celeste));color:white;border:none;border-radius:12px;font-size:15px;font-weight:600;cursor:pointer;box-shadow:0 4px 16px rgba(0,118,227,0.3);transition:all 0.2s;margin-top:12px;}
    .btn-codigo:hover{background:linear-gradient(135deg,var(--azul),var(--mid));transform:translateY(-1px);}
    .error-codigo{background:rgba(230,57,70,0.08);border:1px solid rgba(230,57,70,0.2);border-radius:10px;padding:10px 14px;color:var(--rojo);font-size:13px;font-weight:500;margin-top:10px;text-align:center;}
    @@media(max-width:1200px){.kpi-row{grid-template-columns:repeat(3,1fr)!important;}}
    @@media(max-width:1024px){.kpi-row{grid-template-columns:repeat(2,1fr)!important;}.action-row{grid-template-columns:1fr!important;}}
    @@media(max-width:700px){
        .kpi-row{grid-template-columns:1fr 1fr!important;gap:8px!important;}
        .action-row{grid-template-columns:1fr!important;}
        .welcome-banner{flex-direction:column!important;gap:10px!important;}
        .wb-ico{display:none!important;}
    }
</style>
}

<div class="view-inner" style="@(sinProyecto ? "display:flex;justify-content:center" : "")">
@if (sinProyecto) {
    <div class="sin-proy-wrap">
        <div class="sin-proy-ico">🏗</div>
        <div>
            <div class="sin-proy-title">Sin proyecto asignado</div>
            <div class="sin-proy-sub">Ingresa el código de acceso que te dio tu administrador para unirte a un proyecto.</div>
        </div>
        <div class="codigo-card">
            <form action="/Vendedor/AsignarProyecto" method="post">
                @Html.AntiForgeryToken()
                <div class="codigo-lbl">Código de acceso</div>
                <input type="text" name="codigo" class="codigo-input" placeholder="Ej: PRIM-X7K2" maxlength="20" autocomplete="off" autofocus/>
                @if (!string.IsNullOrEmpty(errorCodigo)) {
                    <div class="error-codigo">❌ @errorCodigo</div>
                }
                <button type="submit" class="btn-codigo">Unirme al proyecto →</button>
            </form>
        </div>
    </div>
} else {
    <div class="welcome-banner">
        <div class="wb-txt">
            <h2>¡Hola, @nombre! 👋</h2>
            <p>Proyecto activo: <strong style="color:white">@proyActivo</strong> · @disponibles inmuebles disponibles</p>
        </div>
        <div class="wb-ico">🏗</div>
    </div>

    <div class="kpi-row">
        <div class="kpi k1"><div class="kpi-top"><div class="kpi-ico">🏠</div><span class="kpi-tag">Total</span></div><div class="kpi-num">@total</div><div class="kpi-lbl">Inmuebles proyecto</div></div>
        <div class="kpi k2"><div class="kpi-top"><div class="kpi-ico">✅</div><span class="kpi-tag">Libre</span></div><div class="kpi-num">@disponibles</div><div class="kpi-lbl">Disponibles</div></div>
        <div class="kpi k3"><div class="kpi-top"><div class="kpi-ico">💲</div><span class="kpi-tag">Yo</span></div><div class="kpi-num">@misVentas</div><div class="kpi-lbl">Mis ventas</div></div>
        <div class="kpi k4"><div class="kpi-top"><div class="kpi-ico">👤</div><span class="kpi-tag">Yo</span></div><div class="kpi-num">@misClientes</div><div class="kpi-lbl">Mis clientes</div></div>
    </div>

    <div class="action-row">
        <div class="action-card">
            <div class="ac-head">
                <span class="ac-title">Inmuebles disponibles</span>
                <div class="ac-ico" style="background:rgba(52,199,89,0.1)">🏢</div>
            </div>
            <div class="ac-stat" style="color:#1EA851">@disponibles</div>
            <div class="ac-sub">inmuebles listos para vender en @proyActivo</div>
            <a href="/Vendedor/Inmuebles" class="ios-btn">Ver inmuebles →</a>
        </div>
        <div class="action-card">
            <div class="ac-head">
                <span class="ac-title">Mis ventas</span>
                <div class="ac-ico" style="background:rgba(0,118,227,0.1)">💲</div>
            </div>
            <div class="ac-stat" style="color:var(--blue)">@misVentas</div>
            <div class="ac-sub">ventas registradas por ti en este proyecto</div>
            <a href="/Vendedor/MisVentas" class="ios-btn">Ver mis ventas →</a>
        </div>
    </div>
}
</div>
