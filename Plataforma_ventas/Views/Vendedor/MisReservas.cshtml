@{
    Layout = null;
    var nombre = ViewBag.Nombre as string ?? "";
    var apellido = ViewBag.Apellido as string ?? "";
    var proyActivo = ViewBag.ProyectoActivo as string ?? "Sin proyecto";
    var iniciales = ((nombre.Length >= 1 ? nombre.Substring(0, 1) : "") + (apellido.Length >= 1 ? apellido.Substring(0, 1) : "")).ToUpper();
    var reservas = ViewBag.Reservas as List<dynamic> ?? new List<dynamic>();
    int total = ViewBag.TotalReservas != null ? (int)ViewBag.TotalReservas : 0;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>Mis Reservas · Londoño Gómez</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --azul: #0076e3; --celeste: #00c9ff; --negro: #1e222b; --plata: #c3cfdb; --menta: #00d4a1;
                --mid: #0060bb;
                --blue: #0076e3;
                --rojo: #E63946;
                --verde: #34C759;
                --oro: #FF9500;
                --label: rgba(0,0,0,0.85);
                --label2: rgba(60,60,67,0.6);
                --label3: rgba(60,60,67,0.3);
                --sep: rgba(60,60,67,0.12);
                --sep2: rgba(60,60,67,0.06);
                --fill2: rgba(120,120,128,0.12);
                --fill3: rgba(120,120,128,0.08);
                --glass: rgba(255,255,255,0.75);
                --gb: rgba(255,255,255,0.6);
                --sh: 0 8px 32px rgba(0,0,0,0.08),0 2px 8px rgba(0,0,0,0.04);
            }

            html, body {
                background: #EEF2F7;
                color: var(--label);
                overflow-x: hidden;
            }

            * {
                font-family: 'Inter',system-ui,sans-serif;
                -webkit-font-smoothing: antialiased;
            }

            body::before {
                content: '';
                position: fixed;
                inset: 0;
                z-index: 0;
                background: radial-gradient(ellipse 80% 60% at 10% 0%,rgba(0,118,227,0.12) 0%,transparent 55%),#EEF2F7;
                pointer-events: none;
            }

            .app {
                display: flex;
                min-height: 100vh;
                position: relative;
                z-index: 1;
            }

            .sidebar {
                width: 230px;
                flex-shrink: 0;
                background: var(--glass);
                backdrop-filter: blur(40px) saturate(180%);
                border-right: 1px solid var(--gb);
                display: flex;
                flex-direction: column;
                position: sticky;
                top: 0;
                height: 100vh;
                overflow-y: auto;
            }

            .sb-app {
                font-size: 17px;
                font-weight: 700;
                color: var(--label);
                letter-spacing: -0.4px;
            }

            .sb-sub {
                font-size: 11px;
                color: var(--label3);
                margin-top: 1px;
            }

            .sb-vendedor {
                margin: 14px 10px 4px;
                background: linear-gradient(145deg,var(--azul),var(--blue));
                border-radius: 16px;
                padding: 14px;
                position: relative;
                overflow: hidden;
            }

                .sb-vendedor::before {
                    content: '';
                    position: absolute;
                    top: -20px;
                    right: -20px;
                    width: 80px;
                    height: 80px;
                    border-radius: 50%;
                    background: rgba(255,255,255,0.08);
                }

            .sv-av {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                background: rgba(255,255,255,0.2);
                border: 2px solid rgba(255,255,255,0.4);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 12px;
                font-weight: 700;
                color: white;
                margin-bottom: 6px;
                position: relative;
                z-index: 1;
            }

            .sv-nombre {
                font-size: 13px;
                font-weight: 700;
                color: white;
                position: relative;
                z-index: 1;
            }

            .sv-rol {
                font-size: 10px;
                color: rgba(255,255,255,0.65);
                position: relative;
                z-index: 1;
            }

            .sb-proy {
                margin: 8px 10px 0;
                background: rgba(0,118,227,0.08);
                border: 1px solid rgba(0,118,227,0.18);
                border-radius: 12px;
                padding: 8px 12px;
            }

            .sb-proy-lbl {
                font-size: 9px;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                color: var(--label3);
                font-weight: 600;
                margin-bottom: 2px;
            }

            .sb-proy-name {
                font-size: 13px;
                font-weight: 700;
                color: var(--azul);
            }

            .pulse {
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: #34C759;
                flex-shrink: 0;
                animation: pring 2.5s ease infinite;
                display: inline-block;
            }

            @@keyframes pring {
                0% {
                    box-shadow: 0 0 0 0 rgba(52,199,89,.4)
                }

                70% {
                    box-shadow: 0 0 0 5px rgba(52,199,89,0)
                }

                100% {
                    box-shadow: 0 0 0 0 rgba(52,199,89,0)
                }
            }

            .sb-sec {
                padding: 14px 16px 4px;
                font-size: 10px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.07em;
                color: var(--label3);
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 12px;
                margin: 1px 6px;
                border-radius: 11px;
                font-size: 14px;
                color: var(--label2);
                text-decoration: none;
                transition: all 0.2s;
            }

                .nav-item:hover {
                    background: var(--fill3);
                    color: var(--label);
                }

                .nav-item.active {
                    background: var(--blue);
                    color: white;
                    font-weight: 600;
                    box-shadow: 0 4px 12px rgba(0,118,227,0.28);
                }

            .nav-ico {
                width: 26px;
                height: 26px;
                border-radius: 7px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                background: var(--fill3);
                flex-shrink: 0;
            }

            .nav-item.active .nav-ico {
                background: rgba(255,255,255,0.2);
            }

            .sb-footer {
                margin-top: auto;
                padding: 10px 12px 20px;
                border-top: 1px solid var(--sep2);
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .sb-av2 {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                background: linear-gradient(135deg,var(--azul),var(--celeste));
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 11px;
                font-weight: 700;
                color: white;
            }

            .sb-logout {
                margin-left: auto;
                width: 26px;
                height: 26px;
                border-radius: 7px;
                background: var(--fill3);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                color: var(--label2);
                text-decoration: none;
            }

                .sb-logout:hover {
                    background: rgba(230,57,70,0.1);
                    color: var(--rojo);
                }

            .main {
                flex: 1;
                display: flex;
                flex-direction: column;
                min-width: 0;
            }

            .topbar {
                height: 50px;
                flex-shrink: 0;
                background: var(--glass);
                backdrop-filter: blur(40px) saturate(180%);
                border-bottom: 1px solid var(--sep);
                padding: 0 18px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                position: sticky;
                top: 0;
                z-index: 50;
            }

            .tb-bread {
                font-size: 13px;
                color: var(--label2);
            }

                .tb-bread strong {
                    color: var(--label);
                    font-weight: 600;
                }

                .tb-bread a {
                    color: var(--label2);
                    text-decoration: none;
                }

            .tb-right {
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .tb-chip {
                display: flex;
                align-items: center;
                gap: 5px;
                background: var(--fill3);
                border: 1px solid var(--sep);
                padding: 4px 10px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 600;
                color: var(--blue);
            }

            .tb-ibtn {
                width: 30px;
                height: 30px;
                border-radius: 9px;
                background: var(--fill3);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 14px;
                text-decoration: none;
                color: var(--label);
            }

            .view {
                flex: 1;
                padding: 18px;
                display: flex;
                flex-direction: column;
                gap: 14px;
            }

            @@keyframes fu {
                from {
                    opacity: 0;
                    transform: translateY(10px)
                }

                to {
                    opacity: 1;
                    transform: translateY(0)
                }
            }

            .card {
                background: var(--glass);
                backdrop-filter: blur(20px) saturate(180%);
                border: 1px solid var(--gb);
                border-radius: 18px;
                overflow: hidden;
                box-shadow: var(--sh);
            }

            .card-head {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 12px 16px;
                border-bottom: 1px solid var(--sep2);
                flex-wrap: wrap;
                gap: 8px;
            }

            .card-title {
                font-size: 15px;
                font-weight: 600;
                color: var(--label);
            }

            .tbl-wrap {
                overflow-x: auto;
            }

            .tbl {
                width: 100%;
                border-collapse: collapse;
            }

                .tbl th {
                    font-size: 11px;
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 0.06em;
                    color: var(--label3);
                    padding: 10px 16px;
                    text-align: left;
                    border-bottom: 1px solid var(--sep2);
                }

                .tbl td {
                    padding: 11px 16px;
                    font-size: 13px;
                    color: var(--label);
                    border-bottom: 1px solid var(--sep2);
                }

                .tbl tr:last-child td {
                    border-bottom: none;
                }

                .tbl tr:hover td {
                    background: var(--fill3);
                }

            .bdg {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                padding: 3px 9px;
                border-radius: 20px;
                font-size: 11px;
                font-weight: 600;
            }

            .ios-btn {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                background: var(--blue);
                color: white;
                border: none;
                padding: 9px 18px;
                border-radius: 11px;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                box-shadow: 0 4px 12px rgba(0,118,227,0.28);
                transition: all 0.2s;
                text-decoration: none;
            }

                .ios-btn:hover {
                    background: var(--mid);
                }

                .ios-btn.ghost {
                    background: var(--fill3);
                    color: var(--label);
                    box-shadow: none;
                    border: 1px solid var(--sep);
                }

                .ios-btn.rojo {
                    background: rgba(230,57,70,0.1);
                    color: var(--rojo);
                    box-shadow: none;
                    border: 1px solid rgba(230,57,70,0.2);
                }

                    .ios-btn.rojo:hover {
                        background: rgba(230,57,70,0.2);
                    }

            .precio-blq {
                display: inline-block;
                background: rgba(52,199,89,0.12);
                color: #1EA851;
                font-size: 13px;
                font-weight: 700;
                padding: 4px 10px;
                border-radius: 8px;
            }

            .alerta-exito {
                background: rgba(52,199,89,0.1);
                border: 1px solid rgba(52,199,89,0.3);
                border-radius: 12px;
                padding: 10px 16px;
                font-size: 13px;
                font-weight: 600;
                color: #1EA851;
            }

            .alerta-error {
                background: rgba(230,57,70,0.1);
                border: 1px solid rgba(230,57,70,0.3);
                border-radius: 12px;
                padding: 10px 16px;
                font-size: 13px;
                font-weight: 600;
                color: var(--rojo);
            }

            .res-banner {
                background: linear-gradient(135deg,var(--azul),var(--blue));
                border-radius: 18px;
                padding: 16px 22px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                box-shadow: 0 8px 24px rgba(0,118,227,0.25);
                animation: fu 0.3s ease both;
                flex-wrap: wrap;
                gap: 12px;
            }

            .res-banner-title {
                font-size: 20px;
                font-weight: 700;
                color: white;
                letter-spacing: -0.5px;
            }

            .res-banner-sub {
                font-size: 12px;
                color: rgba(255,255,255,0.7);
                margin-top: 2px;
            }

            .res-count {
                background: rgba(255,255,255,0.15);
                border: 1px solid rgba(255,255,255,0.25);
                border-radius: 10px;
                padding: 8px 18px;
                text-align: center;
            }

            .res-count-num {
                font-size: 24px;
                font-weight: 300;
                color: white;
                letter-spacing: -1px;
            }

            .res-count-lbl {
                font-size: 10px;
                color: rgba(255,255,255,0.7);
            }

            .empty {
                padding: 48px;
                text-align: center;
            }

            .empty-ico {
                font-size: 40px;
                opacity: 0.4;
                margin-bottom: 8px;
            }

            .empty-txt {
                font-size: 15px;
                font-weight: 600;
                color: var(--label2);
            }

            .hamburger {
                display: none;
                flex-direction: column;
                gap: 5px;
                cursor: pointer;
                padding: 6px;
                border-radius: 8px;
                background: var(--fill3);
                border: none;
            }

                .hamburger span {
                    display: block;
                    width: 18px;
                    height: 2px;
                    background: var(--label);
                    border-radius: 2px;
                }

            @@media(max-width:700px) {
                html, body {
                    height: auto !important;
                    overflow: auto !important;
                }

                .app {
                    flex-direction: column !important;
                }

                .sidebar {
                    position: fixed !important;
                    top: 0 !important;
                    left: -270px !important;
                    width: 260px !important;
                    height: 100vh !important;
                    z-index: 100 !important;
                    overflow-y: auto !important;
                    transition: left 0.3s !important;
                }

                    .sidebar.open {
                        left: 0 !important;
                    }

                .main {
                    width: 100% !important;
                }

                .hamburger {
                    display: flex !important;
                }

                .tb-chip {
                    display: none !important;
                }

                .tbl {
                    min-width: 600px !important;
                }
        }
        /* ── Sidebar blanco corporativo ── */
        .sidebar{background:#fff!important;border-right:1px solid rgba(0,0,0,0.07)!important;backdrop-filter:none!important;box-shadow:2px 0 12px rgba(0,0,0,0.04)!important;}
        .sb-logo-area{padding:16px 14px 12px;border-bottom:1px solid rgba(0,0,0,0.06);margin-bottom:4px;}
        .sb-logo-area img{width:100%;max-height:52px;object-fit:contain;display:block;mix-blend-mode:multiply;filter:contrast(1.05);}
        .sb-app{color:#1e222b!important;font-weight:700!important;}
        .sb-sub{color:rgba(30,34,43,0.45)!important;}
        .sb-proy{background:rgba(0,118,227,0.06)!important;border-color:rgba(0,118,227,0.18)!important;}
        .sb-proy:hover{background:rgba(0,118,227,0.10)!important;}
        .sb-proy-lbl{color:rgba(30,34,43,0.45)!important;font-size:9px!important;}
        .sb-proy-name{color:#0076e3!important;font-weight:700!important;}
        .sb-proy-meta{color:rgba(30,34,43,0.5)!important;}
        .proy-drop{background:#fff!important;border-color:rgba(0,0,0,0.09)!important;box-shadow:0 8px 24px rgba(0,0,0,0.1)!important;}
        .proy-drop-item{color:#1e222b!important;}
        .proy-drop-item:hover{background:rgba(0,118,227,0.06)!important;color:#0076e3!important;}
        .proy-drop-link{color:#0076e3!important;background:rgba(0,118,227,0.04)!important;}
        .sb-sec{color:rgba(30,34,43,0.38)!important;letter-spacing:0.08em!important;}
        .nav-item{color:rgba(30,34,43,0.65)!important;}
        .nav-item:hover{background:rgba(0,118,227,0.07)!important;color:#0076e3!important;}
        .nav-item.active{background:#0076e3!important;color:#fff!important;}
        .nav-item.active .nav-ico{background:rgba(255,255,255,0.22)!important;}
        .nav-ico{background:rgba(30,34,43,0.06)!important;color:inherit!important;}
        .sb-footer{border-top-color:rgba(0,0,0,0.07)!important;}
        .sb-logout{background:rgba(30,34,43,0.05)!important;color:rgba(30,34,43,0.45)!important;}
        .sb-logout:hover{background:rgba(230,57,70,0.08)!important;color:#E63946!important;}
        .nav-item{display:flex!important;align-items:center!important;gap:10px!important;padding:9px 12px!important;margin:1px 6px!important;border-radius:11px!important;font-size:14px!important;min-height:40px!important;text-decoration:none!important;transition:all 0.18s!important;}
        .nav-ico{width:26px!important;height:26px!important;border-radius:8px!important;display:flex!important;align-items:center!important;justify-content:center!important;font-size:14px!important;flex-shrink:0!important;}
        .sb-sec{padding:14px 18px 4px!important;font-size:10px!important;font-weight:600!important;text-transform:uppercase!important;}
    </style>
    </head>
    <body>
        <div class="app">
            <div class="sidebar" id="sidebar">
        <div class="sb-logo-area">
            <img src="~/Images/Logo azul 2.jpg" alt="Londoño Gómez" style="width:100%;max-height:56px;object-fit:contain;display:block;mix-blend-mode:multiply;" />
        </div>
                <div class="sb-vendedor">
                    <div class="sv-av">@iniciales</div>
                    <div class="sv-nombre">@nombre @apellido</div>
                    <div class="sv-rol">Vendedor</div>
                </div>
                <div class="sb-proy"><div class="sb-proy-lbl"><span class="pulse"></span> Proyecto activo</div><div class="sb-proy-name">@proyActivo</div></div>
                <div class="sb-sec">Mi espacio</div>
                <a class="nav-item" href="/Vendedor"><div class="nav-ico">⊞</div>Inicio</a>
                <a class="nav-item" href="/Vendedor/Inmuebles"><div class="nav-ico">🏢</div>Inmuebles</a>
                <a class="nav-item" href="/Vendedor/MisVentas"><div class="nav-ico">💲</div>Mis ventas</a>
                <a class="nav-item active" href="/Vendedor/MisReservas"><div class="nav-ico">🔒</div>Mis reservas</a>
                <a class="nav-item" href="/Vendedor/Perfil"><div class="nav-ico">👤</div>Mi perfil</a>

                <div class="sb-footer">
                    <div class="sb-av2">@iniciales</div>
                    <div><div style="font-size:12px;font-weight:600">@nombre</div><div style="font-size:10px;color:var(--label3)">Vendedor</div></div>
                    <a class="sb-logout" href="/Account/Logout">↩</a>
                </div>
            </div>
            <div class="main">
                <div class="topbar">
                    <div style="display:flex;align-items:center;gap:10px;">
                        <button class="hamburger" onclick="toggleSidebar()"><span></span><span></span><span></span></button>
                        <span class="tb-bread"><strong>Mis reservas</strong></span>
                    </div>
                    <div class="tb-right"><div class="tb-chip"><span class="pulse"></span>@proyActivo</div><a class="tb-ibtn" href="/Account/Logout">↩</a></div>
                </div>
                <div class="view">
                    @if (TempData["Exito"] != null)
                    {
                        <div class="alerta-exito">✅ @TempData["Exito"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alerta-error">❌ @TempData["Error"]</div>
                    }

                    <div class="res-banner">
                        <div>
                            <div class="res-banner-title">🔒 Mis reservas</div>
                            <div class="res-banner-sub">Inmuebles que reservaste con precio bloqueado</div>
                        </div>
                        <div class="res-count">
                            <div class="res-count-num">@total</div>
                            <div class="res-count-lbl">Reservadas</div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-head">
                            <span class="card-title">Inmuebles reservados por mí</span>
                        </div>
                        @if (reservas.Count > 0)
                        {
                            <div class="tbl-wrap">
                                <table class="tbl">
                                    <thead>
                                        <tr>
                                            <th>Apto</th>
                                            <th>Área / Tipo</th>
                                            <th>Torre · Piso</th>
                                            <th>Precio bloqueado</th>
                                            <th>Fecha reserva</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in reservas)
                                        {
                                            <tr>
                                                <td style="font-weight:700">@r.Apto</td>
                                                <td>
                                                    <div style="font-weight:600">@r.Metros m²</div>
                                                    <div style="font-size:11px;color:var(--label3)">@r.Tipo</div>
                                                </td>
                                                <td>
                                                    <div>@r.Torre</div>
                                                    <div style="font-size:11px;color:var(--label3)">Piso @r.Piso</div>
                                                </td>
                                                <td><span class="precio-blq">$@string.Format("{0:N0}", r.PrecioReserva)</span></td>
                                                <td style="font-size:12px;color:var(--label3)">@r.FechaReserva</td>
                                                <td style="display:flex;gap:6px;flex-wrap:wrap;">
                                                    <a href="/Vendedor/ContinuarVenta?idInmueble=@r.Id" class="ios-btn" style="font-size:12px;padding:6px 14px;">
                                                        ✓ Continuar venta
                                                    </a>
                                                    <form action="/Vendedor/LiberarReserva" method="post" style="margin:0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="idInmueble" value="@r.Id" />
                                                        <button type="submit" class="ios-btn rojo" style="font-size:12px;padding:6px 12px;"
                                                                onclick="return confirm('¿Liberar la reserva del apto @r.Apto?')">
                                                            ✕ Liberar
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="empty">
                                <div class="empty-ico">🔒</div>
                                <div class="empty-txt">No tienes inmuebles reservados</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div id="sbOverlay" onclick="closeSidebar()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:99;backdrop-filter:blur(2px);"></div>
        <script>
                function toggleSidebar(){var sb=document.getElementById('sidebar'),ov=document.getElementById('sbOverlay');if(!sb)return;var o=sb.classList.toggle('open');if(ov)ov.style.display=o?'block':'none';}
            function closeSidebar(){var sb=document.getElementById('sidebar'),ov=document.getElementById('sbOverlay');if(sb)sb.classList.remove('open');if(ov)ov.style.display='none';}</script>
        </body>
    </html>