@{
    Layout = "~/Views/Shared/_VendedorLayout.cshtml";
    ViewData["Title"] = "Londoño Gómez — Registrar venta";
    ViewBag.ActiveNav = "vendedor-ventas";
    ViewBag.TbBread   = "Registrar venta";

    var inm        = ViewBag.Inmueble;
    var clientes   = ViewBag.Clientes as List<dynamic> ?? new List<dynamic>();
    int listaActual  = ViewBag.ListaActual  != null ? (int)ViewBag.ListaActual  : 1;
    int aptsPorLista = ViewBag.AptsPorLista != null ? (int)ViewBag.AptsPorLista : 0;
    var precios      = new object[]{ inm.Lista1, inm.Lista2, inm.Lista3, inm.Lista4, inm.Lista5 };
    var precioRaw    = precios[listaActual - 1]?.ToString() ?? "0";
    var precioLimpio = precioRaw.Replace("$","").Replace(".","").Replace(",","").Replace(" ","").Trim();
    long precioFinal = long.TryParse(precioLimpio, out long pf) ? pf : 0;
}
@section Styles {
<style>
    @@keyframes fu{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    .inm-card{background:linear-gradient(135deg,var(--azul),var(--blue));border-radius:18px;padding:18px 22px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 8px 24px rgba(0,118,227,0.25);animation:fu 0.3s ease both;}
    .inm-info h2{font-size:22px;font-weight:300;color:white;letter-spacing:-1px;}
    .inm-info p{font-size:13px;color:rgba(255,255,255,0.7);margin-top:3px;}
    .inm-datos{display:flex;gap:16px;}
    .inm-dato{text-align:center;}
    .inm-dato-val{font-size:15px;font-weight:600;color:white;}
    .inm-dato-lbl{font-size:10px;color:rgba(255,255,255,0.6);}
    .form-card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:18px;overflow:hidden;box-shadow:var(--sh);animation:fu 0.3s ease 0.1s both;}
    .form-card-head{padding:14px 18px;border-bottom:1px solid var(--sep2);display:flex;align-items:center;gap:10px;}
    .form-card-title{font-size:15px;font-weight:600;color:var(--label);}
    .form-body{padding:18px;}
    .tab-row{display:flex;background:var(--fill3);border-radius:11px;padding:3px;gap:2px;margin-bottom:16px;}
    .tab-btn{flex:1;padding:8px;border-radius:8px;border:none;background:none;font-size:13px;font-weight:600;color:var(--label2);cursor:pointer;transition:all 0.2s;}
    .tab-btn.active{background:white;color:var(--label);box-shadow:0 1px 4px rgba(0,0,0,0.1);}
    .tab-pane{display:none;}.tab-pane.active{display:block;}
    .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
    .form-grid.cols3{grid-template-columns:1fr 1fr 1fr;}
    .field{display:flex;flex-direction:column;gap:5px;}
    .field.full{grid-column:1/-1;}
    .field label{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--label3);}
    .field input,.field select{padding:9px 12px;background:var(--fill3);border:1px solid var(--sep);border-radius:10px;font-size:14px;color:var(--label);outline:none;transition:all 0.2s;}
    .field input:focus,.field select:focus{background:white;border-color:var(--blue);box-shadow:0 0 0 3px rgba(0,118,227,0.1);}
    .listas-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-bottom:16px;}
    .lista-opt{border:2px solid var(--sep);border-radius:12px;padding:10px 8px;text-align:center;cursor:pointer;transition:all 0.2s;background:white;}
    .lista-opt:hover{border-color:var(--blue);background:rgba(0,118,227,0.04);}
    .lista-opt.selected{border-color:var(--blue);background:rgba(0,118,227,0.08);}
    .lista-opt-num{font-size:10px;font-weight:600;text-transform:uppercase;color:var(--label3);margin-bottom:3px;}
    .lista-opt-val{font-size:13px;font-weight:600;color:var(--azul);}
    .precio-final{background:rgba(0,118,227,0.06);border:1px solid rgba(0,118,227,0.2);border-radius:12px;padding:14px 16px;display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;}
    .pf-lbl{font-size:12px;color:var(--label2);font-weight:500;}
    .pf-val{font-size:20px;font-weight:600;color:var(--azul);}
    .destino-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:4px;}
    .destino-opt{border:2px solid var(--sep);border-radius:12px;padding:12px 14px;cursor:pointer;transition:all 0.2s;background:white;display:flex;align-items:center;gap:10px;}
    .destino-opt:hover{border-color:var(--blue);background:rgba(0,118,227,0.03);}
    .destino-opt.sel{border-color:var(--blue);background:rgba(0,118,227,0.07);}
    .destino-ico{font-size:20px;flex-shrink:0;}
    .destino-txt{font-size:13px;font-weight:600;color:var(--label);}
    .destino-sub{font-size:11px;color:var(--label3);margin-top:1px;}
    .btn-row{display:flex;gap:10px;justify-content:flex-end;}
    .ios-btn{display:inline-flex;align-items:center;gap:6px;background:var(--blue);color:white;border:none;padding:10px 20px;border-radius:11px;font-size:14px;font-weight:600;cursor:pointer;box-shadow:0 4px 12px rgba(0,118,227,0.28);transition:all 0.2s;text-decoration:none;}
    .ios-btn:hover{background:var(--mid);}
    .ios-btn.ghost{background:var(--fill3);color:var(--label);box-shadow:none;border:1px solid var(--sep);}
    .ios-btn.ghost:hover{background:rgba(120,120,128,0.14);}
    .alerta-exito{background:rgba(52,199,89,0.1);border:1px solid rgba(52,199,89,0.3);border-radius:12px;padding:10px 16px;font-size:13px;font-weight:600;color:#1EA851;}
    .alerta-error{background:rgba(230,57,70,0.1);border:1px solid rgba(230,57,70,0.3);border-radius:12px;padding:10px 16px;font-size:13px;font-weight:600;color:var(--rojo);}
    .cc-card{display:flex;align-items:center;gap:10px;background:rgba(0,118,227,0.06);border:1px solid rgba(0,118,227,0.2);border-radius:10px;padding:10px 14px;margin-top:10px;}
    .cc-ico{font-size:20px;}
    .cc-nombre{font-size:14px;font-weight:600;color:var(--label);}
    .cc-doc{font-size:12px;color:var(--label2);}
    @@media(max-width:700px){.destino-grid{grid-template-columns:1fr!important;}.form-grid{grid-template-columns:1fr!important;}}
</style>
}

@if (TempData["Exito"] != null) { <div class="alerta-exito">@TempData["Exito"]</div> }
@if (TempData["Error"] != null) { <div class="alerta-error">@TempData["Error"]</div> }
<!-- Info del inmueble -->
<div class="inm-card">
    <div class="inm-info">
        <h2>Apto @inm.Apto</h2>
        <p>Torre @inm.Torre · Piso @inm.Piso · @inm.Tipo · @inm.Metros m²</p>
    </div>
    <div class="inm-datos">
        <div class="inm-dato"><div class="inm-dato-val">@inm.Torre</div><div class="inm-dato-lbl">Torre</div></div>
        <div class="inm-dato"><div class="inm-dato-val">@inm.Piso</div><div class="inm-dato-lbl">Piso</div></div>
        <div class="inm-dato"><div class="inm-dato-val">@inm.Metros m²</div><div class="inm-dato-lbl">Área</div></div>
    </div>
</div>

<form action="/Vendedor/ConfirmarVenta" method="post" id="mainForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="idInmueble"   value="@inm.Id"/>
    <input type="hidden" name="tipoCliente"   id="tipoCliente" value="existente"/>
    <input type="hidden" name="listaAplicada" value="@listaActual"/>
    <input type="hidden" name="precioVenta"   value="@precioFinal"/>

    <!-- Lista activa — solo lectura -->
    <div class="form-card" style="margin-bottom:14px">
        <div class="form-card-head"><span class="form-card-title">Precio de venta</span></div>
        <div class="form-body">
            <div style="background:linear-gradient(135deg,rgba(0,118,227,0.08),rgba(0,118,227,0.05));border:2px solid rgba(0,118,227,0.25);border-radius:14px;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
                <div style="display:flex;align-items:center;gap:14px;">
                    <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,var(--azul),var(--celeste));display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;color:white;box-shadow:0 4px 12px rgba(0,96,187,0.25);flex-shrink:0;">@listaActual</div>
                    <div>
                        <div style="font-size:10px;text-transform:uppercase;letter-spacing:0.06em;color:var(--label3);font-weight:600;margin-bottom:2px;">Lista activa del proyecto</div>
                        <div style="font-size:16px;font-weight:700;color:var(--azul);">Lista @listaActual</div>
                        <div style="font-size:11px;color:var(--label2);margin-top:2px;">
                            @if (aptsPorLista > 0) { <span>Sube automáticamente cada @aptsPorLista vendidos</span> }
                            else { <span>Configurada manualmente por el administrador</span> }
                        </div>
                    </div>
                </div>
                <div style="text-align:right;">
                    <div style="font-size:10px;color:var(--label3);font-weight:600;text-transform:uppercase;margin-bottom:3px;">Precio de venta</div>
                    <div style="font-size:24px;font-weight:300;color:var(--azul);letter-spacing:-1px;">$@precioFinal.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Destino del inmueble -->
    <div class="form-card" style="margin-bottom:14px">
        <div class="form-card-head"><span class="form-card-title">Destino del inmueble</span></div>
        <div class="form-body">
            <input type="hidden" name="destino" id="destinoInput" value="Vivienda"/>
            <div class="destino-grid">
                <div class="destino-opt sel" onclick="selDestino('Vivienda',this)">
                    <div><div class="destino-txt">Vivienda</div><div class="destino-sub">Para uso habitacional</div></div>
                </div>
                <div class="destino-opt" onclick="selDestino('Inversión para reventa',this)">
                    <div><div class="destino-txt">Inversión para reventa</div><div class="destino-sub">Plusvalía a futuro</div></div>
                </div>
                <div class="destino-opt" onclick="selDestino('Inversión para arriendo',this)">
                    <div><div class="destino-txt">Inversión para arriendo</div><div class="destino-sub">Renta mensual</div></div>
                </div>
                <div class="destino-opt" onclick="selDestino('Cesión de derechos',this)">
                    <div><div class="destino-txt">Cesión de derechos</div><div class="destino-sub">Transferencia de contrato</div></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cliente -->
    <div class="form-card">
        <div class="form-card-head"><span class="form-card-title">Cliente</span></div>
        <div class="form-body">
            <div class="tab-row">
                <button type="button" class="tab-btn active" onclick="setTab('existente',this)">Cliente existente</button>
                <button type="button" class="tab-btn" onclick="setTab('nuevo',this)">Nuevo cliente</button>
            </div>
            <!-- Cliente existente -->
            <div class="tab-pane active" id="tab-existente">
                <div class="field" style="margin-bottom:10px">
                    <label>Buscar por cédula o nombre</label>
                    <input type="text" id="buscaCedula" placeholder="Escribe cédula o nombre..." oninput="filtrarClientes(this.value)" autocomplete="off"/>
                </div>
                <div class="field">
                    <label>Seleccionar cliente</label>
                    <select name="idClienteExistente" id="selCliente" onchange="mostrarTarjetaCliente()">
                        <option value="0">— Selecciona un cliente —</option>
                        @foreach (var c in clientes)
                        {
                            <option value="@c.Id">@c.Nombre — @c.Documento</option>
                        }
                    </select>
                </div>
                <div id="clienteCard" class="cc-card" style="display:none">
                    <div class="cc-ico"></div>
                    <div><div class="cc-nombre"></div><div class="cc-doc"></div></div>
                </div>
            </div>
            <!-- Nuevo cliente -->
            <div class="tab-pane" id="tab-nuevo">
                <div class="form-grid">
                    <div class="field"><label>Nombre</label><input type="text" name="clienteNombre" placeholder="Nombre"/></div>
                    <div class="field"><label>Apellido</label><input type="text" name="clienteApellido" placeholder="Apellido"/></div>
                    <div class="field"><label>Documento</label><input type="text" name="clienteDocumento" placeholder="CC / NIT"/></div>
                    <div class="field"><label>Celular</label><input type="text" name="clienteCelular" placeholder="Celular"/></div>
                    <div class="field full"><label>Correo</label><input type="email" name="clienteCorreo" placeholder="correo@email.com"/></div>
                </div>
            </div>
        </div>
    </div>

</form>

<div id="errClienteContenedor" style="display:none;margin-bottom:10px">
    <div id="errCliente" class="alerta-error"></div>
</div>

<div class="btn-row">
    <form action="/Vendedor/CancelarProceso" method="post" style="margin:0">
        @Html.AntiForgeryToken()
        <input type="hidden" name="idInmueble" value="@inm.Id"/>
        <button type="submit" class="ios-btn ghost" onclick="return confirm('¿Cancelar? El inmueble volverá a estar disponible.')">Cancelar</button>
    </form>
    <button type="submit" form="mainForm" class="ios-btn">✓ Confirmar venta</button>
</div>

@section Scripts {
<script>
    let _optsCliente = [];
    document.addEventListener('DOMContentLoaded', function() {
        const sel = document.getElementById('selCliente');
        if (sel) _optsCliente = Array.from(sel.options).map(o => ({val: o.value, txt: o.text}));
        document.getElementById('mainForm').addEventListener('submit', function(e) {
            const tipo = document.getElementById('tipoCliente').value;
            if (tipo === 'existente') {
                const s = document.getElementById('selCliente');
                if (!s || s.value === '0') { e.preventDefault(); mostrarErrorCliente(); }
            } else {
                const n = document.querySelector('[name="clienteNombre"]');
                const d = document.querySelector('[name="clienteDocumento"]');
                if (!n?.value?.trim() || !d?.value?.trim()) { e.preventDefault(); mostrarErrorCliente(); }
            }
        });
    });
    function filtrarClientes(q) {
        const sel = document.getElementById('selCliente');
        const lower = q.toLowerCase();
        sel.innerHTML = '';
        const filtered = _optsCliente.filter(o => o.val === '0' || o.txt.toLowerCase().includes(lower));
        filtered.forEach(o => sel.add(new Option(o.txt, o.val)));
        const real = filtered.filter(o => o.val !== '0');
        sel.value = real.length === 1 ? real[0].val : '0';
        mostrarTarjetaCliente();
    }
    function mostrarTarjetaCliente() {
        const sel = document.getElementById('selCliente');
        const card = document.getElementById('clienteCard');
        if (!card) return;
        if (!sel || sel.value === '0') { card.style.display = 'none'; return; }
        const txt = sel.options[sel.selectedIndex].text;
        const idx = txt.indexOf(' — ');
        card.querySelector('.cc-nombre').textContent = idx > -1 ? txt.substring(0, idx) : txt;
        card.querySelector('.cc-doc').textContent = idx > -1 ? txt.substring(idx + 3) : '';
        card.style.display = 'flex';
        document.getElementById('errClienteContenedor').style.display = 'none';
    }
    function mostrarErrorCliente() {
        const wrapper = document.getElementById('errClienteContenedor');
        const div = document.getElementById('errCliente');
        div.textContent = 'Por favor ingrese los datos del cliente para continuar con la venta.';
        wrapper.style.display = 'block';
        wrapper.scrollIntoView({behavior:'smooth', block:'center'});
    }
    function selDestino(val, el) {
        document.getElementById('destinoInput').value = val;
        document.querySelectorAll('.destino-opt').forEach(x=>x.classList.remove('sel'));
        el.classList.add('sel');
    }
    function setTab(tab, btn) {
        document.querySelectorAll('.tab-btn').forEach(x=>x.classList.remove('active'));
        document.querySelectorAll('.tab-pane').forEach(x=>x.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('tab-'+tab).classList.add('active');
        document.getElementById('tipoCliente').value = tab;
        if(tab==='existente') document.getElementById('selCliente').name='idClienteExistente';
        else document.getElementById('selCliente').name='idClienteExistente_disabled';
        document.getElementById('errClienteContenedor').style.display = 'none';
    }
</script>
}
