        .sb-logout{background:rgba(30,34,43,0.05)!important;color:rgba(30,34,43,0.45)!important;}
        .sb-logout:hover{background:rgba(230,57,70,0.08)!important;color:#E63946!important;}
        .nav-item{display:flex!important;align-items:center!important;gap:10px!important;padding:9px 12px!important;margin:1px 6px!important;border-radius:11px!important;font-size:14px!important;min-height:40px!important;text-decoration:none!important;transition:all 0.18s!important;}
        .nav-ico{width:26px!important;height:26px!important;border-radius:8px!important;display:flex!important;align-items:center!important;justify-content:center!important;font-size:14px!important;flex-shrink:0!important;}
        .sb-sec{padding:14px 18px 4px!important;font-size:10px!important;font-weight:600!important;text-transform:uppercase!important;}
    </style>
</head>
<body>
    <div class="app">
        <div class="sidebar" id="sidebar">
        <div class="sb-logo-area">
            <img src="~/Images/Logo azul 2.jpg" alt="Londoño Gómez" style="width:100%;max-height:56px;object-fit:contain;display:block;mix-blend-mode:multiply;" />
        </div>
            <div class="sb-vendedor">
                <div class="sv-av">@iniciales</div>
                <div class="sv-nombre">@nombre @apellido</div>
                <div class="sv-rol">Vendedor</div>
            </div>
            <div class="sb-sec">Mi espacio</div>
            <a class="nav-item" href="/Vendedor"><div class="nav-ico">⊞</div>Inicio</a>
            <a class="nav-item" href="/Vendedor/Inmuebles"><div class="nav-ico">🏢</div>Inmuebles</a>
            <a class="nav-item" href="/Vendedor/MisVentas"><div class="nav-ico">💲</div>Mis ventas</a>
            <a class="nav-item active" href="/Vendedor/MisReservas"><div class="nav-ico">🔒</div>Mis reservas</a>
            <a class="nav-item" href="/Vendedor/Perfil"><div class="nav-ico">👤</div>Mi perfil</a>

            <div class="sb-footer">
                <div class="sb-av2">@iniciales</div>
                <div><div style="font-size:12px;font-weight:600">@nombre</div><div style="font-size:10px;color:var(--label3)">Vendedor</div></div>
                <a class="sb-logout" href="/Account/Logout">↩</a>
            </div>
        </div>
        <div class="main">
            <div class="topbar">
                <div style="display:flex;align-items:center;gap:10px;">
                    <button class="hamburger" onclick="toggleSidebar()"><span></span><span></span><span></span></button>
                    <span class="tb-bread"><a href="/Vendedor/MisReservas">Mis reservas</a> › <strong>Continuar venta · Apto @apto</strong></span>
                </div>
                <div class="tb-right"><div class="tb-chip"><span class="pulse"></span>@proyActivo</div><a class="tb-ibtn" href="/Account/Logout">↩</a></div>
            </div>
            <div class="view">
                @if (TempData["Error"] != null)
                {
                    <div class="alerta-error">❌ @TempData["Error"]</div>
                }

                <div class="inm-card">
                    <div class="inm-info">
                        <h2>Apto @apto</h2>
                        <p>Torre @torre · @tipo · @metros m²</p>
                    </div>
                    <div class="inm-datos">
                        <div class="inm-dato"><div class="inm-dato-val">@torre</div><div class="inm-dato-lbl">Torre</div></div>
                        <div class="inm-dato"><div class="inm-dato-val">@metros m²</div><div class="inm-dato-lbl">Área</div></div>
                        <div class="inm-dato"><div class="inm-dato-val">@tipo</div><div class="inm-dato-lbl">Tipo</div></div>
                    </div>
                </div>

                <form action="/Vendedor/ConfirmarVentaReserva" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idInmueble" value="@idInmueble" />
                    <input type="hidden" name="precioVenta" value="@precioReserva" />
                    <input type="hidden" name="tipoCliente" id="tipoCliente" value="existente" />
                    <input type="hidden" name="destino" id="destinoInput" value="Vivienda" />

                    <div class="form-card">
                        <div class="form-card-head"><span style="font-size:18px">🔒</span><span class="form-card-title">Precio bloqueado al reservar</span></div>
                        <div class="form-body">
                            <div class="precio-lock-card">
                                <div class="pl-left">
                                    <div class="pl-badge">🔒</div>
                                    <div>
                                        <div class="pl-info-lbl">Precio garantizado</div>
                                        <div class="pl-info-val">Precio comprometido con el cliente</div>
                                        <div class="pl-info-sub">No puede modificarse — fue bloqueado al momento de la reserva</div>
                                    </div>
                                </div>
                                <div>
                                    <div style="font-size:10px;color:var(--label3);font-weight:600;text-transform:uppercase;margin-bottom:2px;text-align:right;">Precio final</div>
                                    <div class="pl-precio-val">$@precioReserva.ToString("N0")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-card">
                        <div class="form-card-head"><span style="font-size:18px">🏷️</span><span class="form-card-title">Destino del inmueble</span></div>
                        <div class="form-body">
                            <div class="destino-grid">
                                <div class="destino-opt sel" onclick="selDestino('Vivienda',this)">
                                    <span class="destino-ico">🏠</span>
                                    <div><div class="destino-txt">Vivienda</div><div class="destino-sub">Para uso habitacional</div></div>
                                </div>
                                <div class="destino-opt" onclick="selDestino('Inversión para reventa',this)">
                                    <span class="destino-ico">📈</span>
                                    <div><div class="destino-txt">Inversión para reventa</div><div class="destino-sub">Plusvalía a futuro</div></div>
                                </div>
                                <div class="destino-opt" onclick="selDestino('Inversión para arriendo',this)">
                                    <span class="destino-ico">🔑</span>
                                    <div><div class="destino-txt">Inversión para arriendo</div><div class="destino-sub">Renta mensual</div></div>
                                </div>
                                <div class="destino-opt" onclick="selDestino('Cesión de derechos',this)">
                                    <span class="destino-ico">📋</span>
                                    <div><div class="destino-txt">Cesión de derechos</div><div class="destino-sub">Transferencia de contrato</div></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-card">
                        <div class="form-card-head"><span style="font-size:18px">👤</span><span class="form-card-title">Cliente</span></div>
                        <div class="form-body">
                            <div class="tab-row">
                                <button type="button" class="tab-btn active"
                                        onclick="document.getElementById('tipoCliente').value='existente';setTab('existente',this)">
                                    Cliente existente
                                </button>
                                <button type="button" class="tab-btn"
                                        onclick="document.getElementById('tipoCliente').value='nuevo';setTab('nuevo',this)">
                                    Nuevo cliente
                                </button>
                            </div>
                            <div class="tab-pane active" id="tab-existente">
                                <div class="field">
                                    <label>Seleccionar cliente</label>
                                    <select name="idClienteExistente">
                                        <option value="0">— Selecciona un cliente —</option>
                                        @foreach (var c in clientes)
                                        {
                                            <option value="@c.Id">@c.Nombre — @c.Documento</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="tab-pane" id="tab-nuevo">
                                <div class="form-grid">
                                    <div class="field"><label>Nombre</label><input type="text" name="clienteNombre" placeholder="Nombre" /></div>
                                    <div class="field"><label>Apellido</label><input type="text" name="clienteApellido" placeholder="Apellido" /></div>
                                    <div class="field"><label>Documento</label><input type="text" name="clienteDocumento" placeholder="CC / NIT" /></div>
                                    <div class="field"><label>Celular</label><input type="text" name="clienteCelular" placeholder="Celular" /></div>
                                    <div class="field full"><label>Correo</label><input type="email" name="clienteCorreo" placeholder="correo@email.com" /></div>
                                    <div class="field full"><label>Dirección</label><input type="text" name="clienteDireccion" placeholder="Dirección" /></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="btn-row">
                        <a href="/Vendedor/MisReservas" class="ios-btn ghost">← Volver</a>
                        <button type="submit" class="ios-btn">✓ Confirmar venta</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div id="sbOverlay" onclick="closeSidebar()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:99;backdrop-filter:blur(2px);"></div>
    <script>
            function selDestino(val,el){document.getElementById('destinoInput').value=val;document.querySelectorAll('.destino-opt').forEach(x=>x.classList.remove('sel'));el.classList.add('sel');}
            function setTab(tab,btn){document.querySelectorAll('.tab-btn').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.tab-pane').forEach(x=>x.classList.remove('active'));btn.classList.add('active');document.getElementById('tab-'+tab).classList.add('active');}
                function toggleSidebar(){var sb=document.getElementById('sidebar'),ov=document.getElementById('sbOverlay');if(!sb)return;var o=sb.classList.toggle('open');if(ov)ov.style.display=o?'block':'none';}
            function closeSidebar(){var sb=document.getElementById('sidebar'),ov=document.getElementById('sbOverlay');if(sb)sb.classList.remove('open');if(ov)ov.style.display='none';}
    </script>
</body>
</html>