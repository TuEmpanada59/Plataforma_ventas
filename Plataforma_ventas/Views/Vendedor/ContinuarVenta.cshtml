@{
    Layout = "~/Views/Shared/_VendedorLayout.cshtml";
    ViewData["Title"] = "Londoño Gómez — Continuar venta";
    ViewBag.ActiveNav = "vendedor-ventas";
    ViewBag.TbBread   = "Continuar venta";

    int idInmueble = ViewBag.IdInmueble != null ? (int)ViewBag.IdInmueble : 0;
    string apto = ViewBag.Apto as string ?? "";
    string metros = ViewBag.Metros as string ?? "";
    string tipo = ViewBag.Tipo as string ?? "";
    string torre = ViewBag.Torre as string ?? "";
    long precioReserva = ViewBag.PrecioReserva != null ? (long)ViewBag.PrecioReserva : 0;
    var clientes = ViewBag.Clientes as List<dynamic> ?? new List<dynamic>();
}
@section Styles {
<style>
    @@keyframes fu{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    .inm-card{background:linear-gradient(135deg,var(--azul),var(--blue));border-radius:18px;padding:18px 22px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 8px 24px rgba(0,118,227,0.25);animation:fu 0.3s ease both;flex-wrap:wrap;gap:12px;}
    .inm-info h2{font-size:22px;font-weight:300;color:white;letter-spacing:-1px;}
    .inm-info p{font-size:13px;color:rgba(255,255,255,0.7);margin-top:3px;}
    .inm-datos{display:flex;gap:16px;}
    .inm-dato{text-align:center;}
    .inm-dato-val{font-size:15px;font-weight:600;color:white;}
    .inm-dato-lbl{font-size:10px;color:rgba(255,255,255,0.6);}
    .precio-lock-card{background:linear-gradient(135deg,rgba(52,199,89,0.08),rgba(30,168,81,0.05));border:2px solid rgba(52,199,89,0.3);border-radius:14px;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;}
    .pl-left{display:flex;align-items:center;gap:12px;}
    .pl-badge{width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#1EA851,#34C759);display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;}
    .pl-info-lbl{font-size:11px;text-transform:uppercase;letter-spacing:0.06em;color:#1EA851;font-weight:600;margin-bottom:2px;}
    .pl-info-val{font-size:15px;font-weight:700;color:var(--azul);}
    .pl-info-sub{font-size:11px;color:var(--label2);margin-top:2px;}
    .pl-precio-val{font-size:26px;font-weight:300;color:#1EA851;letter-spacing:-1px;}
    .form-card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:18px;overflow:hidden;box-shadow:var(--sh);margin-bottom:14px;}
    .form-card-head{padding:14px 18px;border-bottom:1px solid var(--sep2);display:flex;align-items:center;gap:10px;}
    .form-card-title{font-size:15px;font-weight:600;color:var(--label);}
    .form-body{padding:18px;}
    .destino-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;}
    .destino-opt{border:2px solid var(--sep);border-radius:12px;padding:12px 14px;cursor:pointer;transition:all 0.2s;background:white;display:flex;align-items:center;gap:10px;}
    .destino-opt:hover{border-color:var(--blue);background:rgba(0,118,227,0.03);}
    .destino-opt.sel{border-color:var(--blue);background:rgba(0,118,227,0.07);}
    .destino-ico{font-size:20px;flex-shrink:0;}
    .destino-txt{font-size:13px;font-weight:600;color:var(--label);}
    .destino-sub{font-size:11px;color:var(--label3);margin-top:1px;}
    .tab-row{display:flex;background:var(--fill3);border-radius:11px;padding:3px;gap:2px;margin-bottom:16px;}
    .tab-btn{flex:1;padding:8px;border-radius:8px;border:none;background:none;font-size:13px;font-weight:600;color:var(--label2);cursor:pointer;transition:all 0.2s;}
    .tab-btn.active{background:white;color:var(--label);box-shadow:0 1px 4px rgba(0,0,0,0.1);}
    .tab-pane{display:none;}
    .tab-pane.active{display:block;}
    .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
    .field{display:flex;flex-direction:column;gap:5px;}
    .field.full{grid-column:1/-1;}
    .field label{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--label3);}
    .field input,.field select{padding:9px 12px;background:var(--fill3);border:1px solid var(--sep);border-radius:10px;font-size:14px;color:var(--label);outline:none;transition:all 0.2s;}
    .field input:focus,.field select:focus{background:white;border-color:var(--blue);box-shadow:0 0 0 3px rgba(0,118,227,0.1);}
    .btn-row{display:flex;gap:10px;justify-content:flex-end;}
    .ios-btn{display:inline-flex;align-items:center;gap:6px;background:var(--blue);color:white;border:none;padding:9px 18px;border-radius:11px;font-size:13px;font-weight:600;cursor:pointer;box-shadow:0 4px 12px rgba(0,118,227,0.28);transition:all 0.2s;text-decoration:none;}
    .ios-btn:hover{background:var(--mid);}
    .ios-btn.ghost{background:var(--fill3);color:var(--label);box-shadow:none;border:1px solid var(--sep);}
    .alerta-exito{background:rgba(52,199,89,0.1);border:1px solid rgba(52,199,89,0.3);border-radius:12px;padding:10px 16px;font-size:13px;font-weight:600;color:#1EA851;}
    .alerta-error{background:rgba(230,57,70,0.1);border:1px solid rgba(230,57,70,0.3);border-radius:12px;padding:10px 16px;font-size:13px;font-weight:600;color:var(--rojo);}
    .cc-card{display:flex;align-items:center;gap:10px;background:rgba(0,118,227,0.06);border:1px solid rgba(0,118,227,0.2);border-radius:10px;padding:10px 14px;margin-top:10px;}
    .cc-ico{font-size:20px;}
    .cc-nombre{font-size:14px;font-weight:600;color:var(--label);}
    .cc-doc{font-size:12px;color:var(--label2);}
    .disabled-block{opacity:0.45;pointer-events:none;filter:grayscale(0.25);transition:opacity 0.2s;}
    @@media(max-width:700px){.destino-grid{grid-template-columns:1fr!important;}.form-grid{grid-template-columns:1fr!important;}}
</style>
}

@if (TempData["Error"] != null)
{
    <div class="alerta-error">@TempData["Error"]</div>
}

<div class="inm-card">
    <div class="inm-info">
        <h2>Apto @apto</h2>
        <p>Torre @torre · @tipo · @metros m²</p>
    </div>
    <div class="inm-datos">
        <div class="inm-dato"><div class="inm-dato-val">@torre</div><div class="inm-dato-lbl">Torre</div></div>
        <div class="inm-dato"><div class="inm-dato-val">@metros m²</div><div class="inm-dato-lbl">Área</div></div>
        <div class="inm-dato"><div class="inm-dato-val">@tipo</div><div class="inm-dato-lbl">Tipo</div></div>
    </div>
</div>

<form action="/Vendedor/ConfirmarVentaReserva" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="idInmueble" value="@idInmueble" />
    <input type="hidden" name="precioVenta" value="@precioReserva" />
    <input type="hidden" name="tipoCliente" id="tipoCliente" value="existente" />
    <input type="hidden" name="destino" id="destinoInput" value="Vivienda" />

    <div class="form-card">
        <div class="form-card-head">@Iconos.Candado("#1EA851", 20) <span class="form-card-title">Precio bloqueado al reservar</span></div>
        <div class="form-body">
            <div class="precio-lock-card">
                <div class="pl-left">
                    <div class="pl-badge">@Iconos.Candado("#ffffff", 22, 0.3)</div>
                    <div>
                        <div class="pl-info-lbl">Precio garantizado</div>
                        <div class="pl-info-val">Precio comprometido con el cliente</div>
                        <div class="pl-info-sub">No puede modificarse — fue bloqueado al momento de la reserva</div>
                    </div>
                </div>
                <div>
                    <div style="font-size:10px;color:var(--label3);font-weight:600;text-transform:uppercase;margin-bottom:2px;text-align:right;">Precio final</div>
                    <div class="pl-precio-val">$@precioReserva.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="form-card">
        <div class="form-card-head">@Iconos.Mapa("#1EA851", 20) <span class="form-card-title">Destino del inmueble</span></div>
        <div class="form-body">
            <div class="destino-grid">
                <div class="destino-opt sel" onclick="selDestino('Vivienda',this)">
                    <div class="destino-ico">@Iconos.Casa("#0076E3", 20)</div>
                    <div><div class="destino-txt">Vivienda</div><div class="destino-sub">Para uso habitacional</div></div>
                </div>
                <div class="destino-opt" onclick="selDestino('Inversión para reventa',this)">
                    <div class="destino-ico">@Iconos.Grafico("#1EA851", 20)</div>
                    <div><div class="destino-txt">Inversión para reventa</div><div class="destino-sub">Plusvalía a futuro</div></div>
                </div>
                <div class="destino-opt" onclick="selDestino('Inversión para arriendo',this)">
                    <div class="destino-ico">@Iconos.Llave("#E08600", 20)</div>
                    <div><div class="destino-txt">Inversión para arriendo</div><div class="destino-sub">Renta mensual</div></div>
                </div>
                <div class="destino-opt" onclick="selDestino('Cesión de derechos',this)">
                    <div class="destino-ico">@Iconos.Lista("#5A5AC8", 20)</div>
                    <div><div class="destino-txt">Cesión de derechos</div><div class="destino-sub">Transferencia de contrato</div></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Verificación SAGRILAFT -->
    <div class="form-card">
        <div class="form-card-head">@Iconos.Documento("#CC7700", 20) <span class="form-card-title">Verificación SAGRILAFT</span></div>
        <div class="form-body">
            <p style="font-size:13px;color:var(--label2);margin-bottom:12px">¿Ya fue consultado el cliente en SAGRILAFT?</p>
            <div style="display:flex;gap:10px;flex-wrap:wrap">
                <button type="button" class="ios-btn" onclick="sagrilaftRespuesta(true)">Sí, ya fue consultado</button>
                <button type="button" class="ios-btn ghost" onclick="sagrilaftRespuesta(false)">No, aún no</button>
            </div>
            <div id="sagrilaftAviso" class="alerta-error" style="display:none;margin-top:12px">
                Por favor, consulte el cliente y recargue la página para realizar el nuevo registro.
            </div>
        </div>
    </div>
    <input type="hidden" name="sagrilaftConsultado" id="sagrilaftConsultado" value="false"/>

    <div class="form-card disabled-block" id="clienteCardWrap">
        <div class="form-card-head">@Iconos.Persona("#0076E3", 20) <span class="form-card-title">Cliente</span></div>
        <div class="form-body">
            <div class="tab-row">
                <button type="button" class="tab-btn active"
                        onclick="document.getElementById('tipoCliente').value='existente';setTab('existente',this)">
                    Cliente existente
                </button>
                <button type="button" class="tab-btn"
                        onclick="document.getElementById('tipoCliente').value='nuevo';setTab('nuevo',this)">
                    Nuevo cliente
                </button>
            </div>
            <div class="tab-pane active" id="tab-existente">
                <div class="field" style="margin-bottom:10px">
                    <label>Buscar por cédula o nombre</label>
                    <input type="text" id="buscaCedula" placeholder="Escribe cédula o nombre..." oninput="filtrarClientes(this.value)" autocomplete="off"/>
                </div>
                <div class="field">
                    <label>Seleccionar cliente</label>
                    <select name="idClienteExistente" id="selCliente" onchange="mostrarTarjetaCliente()">
                        <option value="0">— Selecciona un cliente —</option>
                        @foreach (var c in clientes)
                        {
                            <option value="@c.Id">@c.Nombre — @c.Documento</option>
                        }
                    </select>
                </div>
                <div id="clienteCard" class="cc-card" style="display:none">
                    <div class="cc-ico">@Iconos.Persona("#0076E3", 20)</div>
                    <div><div class="cc-nombre"></div><div class="cc-doc"></div></div>
                </div>
            </div>
            <div class="tab-pane" id="tab-nuevo">
                <div class="form-grid">
                    <div class="field"><label>Nombre</label><input type="text" name="clienteNombre" placeholder="Nombre" /></div>
                    <div class="field"><label>Apellido</label><input type="text" name="clienteApellido" placeholder="Apellido" /></div>
                    <div class="field"><label>Documento</label><input type="text" name="clienteDocumento" placeholder="CC / NIT" inputmode="numeric" maxlength="15" oninput="this.value=this.value.replace(/[^0-9]/g,'')" /></div>
                    <div class="field"><label>Celular</label><input type="text" name="clienteCelular" placeholder="Celular" /></div>
                    <div class="field full"><label>Correo</label><input type="email" name="clienteCorreo" placeholder="correo@email.com" /></div>
                    <div class="field full"><label>Dirección</label><input type="text" name="clienteDireccion" placeholder="Dirección" /></div>
                </div>
            </div>
        </div>
    </div>

    <div id="errClienteContenedor" style="display:none;margin-bottom:10px">
        <div id="errCliente" class="alerta-error"></div>
    </div>
    <div class="btn-row">
        <a href="/Vendedor/MisReservas" class="ios-btn ghost">← Volver</a>
        <button type="submit" id="btnConfirmarVenta" class="ios-btn" disabled>✓ Confirmar venta</button>
    </div>
</form>

@section Scripts {
<script>
    let _optsCliente = [];
    document.addEventListener('DOMContentLoaded', function() {
        const sel = document.getElementById('selCliente');
        if (sel) _optsCliente = Array.from(sel.options).map(o => ({val: o.value, txt: o.text}));
        document.querySelector('form').addEventListener('submit', function(e) {
            if (document.getElementById('sagrilaftConsultado').value !== 'true') {
                e.preventDefault();
                document.getElementById('sagrilaftAviso').style.display = 'block';
                return;
            }
            const tipo = document.getElementById('tipoCliente').value;
            if (tipo === 'existente') {
                const s = document.getElementById('selCliente');
                if (!s || s.value === '0') { e.preventDefault(); mostrarErrorCliente(); }
            } else {
                const n = document.querySelector('[name="clienteNombre"]');
                const d = document.querySelector('[name="clienteDocumento"]');
                if (!n?.value?.trim() || !d?.value?.trim()) { e.preventDefault(); mostrarErrorCliente(); }
            }
        });
    });
    function filtrarClientes(q) {
        const sel = document.getElementById('selCliente');
        const lower = q.toLowerCase();
        sel.innerHTML = '';
        const filtered = _optsCliente.filter(o => o.val === '0' || o.txt.toLowerCase().includes(lower));
        filtered.forEach(o => sel.add(new Option(o.txt, o.val)));
        const real = filtered.filter(o => o.val !== '0');
        sel.value = real.length === 1 ? real[0].val : '0';
        mostrarTarjetaCliente();
    }
    function mostrarTarjetaCliente() {
        const sel = document.getElementById('selCliente');
        const card = document.getElementById('clienteCard');
        if (!card) return;
        if (!sel || sel.value === '0') { card.style.display = 'none'; return; }
        const txt = sel.options[sel.selectedIndex].text;
        const idx = txt.indexOf(' — ');
        card.querySelector('.cc-nombre').textContent = idx > -1 ? txt.substring(0, idx) : txt;
        card.querySelector('.cc-doc').textContent = idx > -1 ? txt.substring(idx + 3) : '';
        card.style.display = 'flex';
        document.getElementById('errClienteContenedor').style.display = 'none';
    }
    function mostrarErrorCliente() {
        const wrapper = document.getElementById('errClienteContenedor');
        document.getElementById('errCliente').textContent = 'Por favor ingrese los datos del cliente para continuar con la venta.';
        wrapper.style.display = 'block';
        wrapper.scrollIntoView({behavior:'smooth', block:'center'});
    }
    function sagrilaftRespuesta(si) {
        document.getElementById('sagrilaftConsultado').value = si ? 'true' : 'false';
        document.getElementById('clienteCardWrap').classList.toggle('disabled-block', !si);
        document.getElementById('btnConfirmarVenta').disabled = !si;
        document.getElementById('sagrilaftAviso').style.display = si ? 'none' : 'block';
    }
    function selDestino(val,el){document.getElementById('destinoInput').value=val;document.querySelectorAll('.destino-opt').forEach(x=>x.classList.remove('sel'));el.classList.add('sel');}
    function setTab(tab,btn){
        document.querySelectorAll('.tab-btn').forEach(x=>x.classList.remove('active'));
        document.querySelectorAll('.tab-pane').forEach(x=>x.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('tab-'+tab).classList.add('active');
        document.getElementById('errClienteContenedor').style.display = 'none';
    }
</script>
}
