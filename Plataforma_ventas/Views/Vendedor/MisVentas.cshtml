@{
    Layout = "~/Views/Shared/_VendedorLayout.cshtml";
    ViewData["Title"] = "Londoño Gómez — Mis ventas";
    ViewBag.ActiveNav = "vendedor-ventas";
    ViewBag.TbBread   = "Mis ventas";

    var ventas     = ViewBag.Ventas as List<dynamic> ?? new List<dynamic>();
    int totalVentas= ViewBag.TotalVentas != null ? (int)ViewBag.TotalVentas : 0;
}
@section Styles {
<style>
    @@keyframes fu{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    .stat-banner{background:linear-gradient(135deg,var(--azul),var(--blue));border-radius:18px;padding:20px 24px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 8px 24px rgba(0,118,227,0.2);animation:fu 0.35s ease both;}
    .sb2-num{font-size:48px;font-weight:200;color:white;letter-spacing:-2px;}
    .sb2-lbl{font-size:13px;color:rgba(255,255,255,0.7);margin-top:2px;}
    .sb2-ico{font-size:44px;opacity:0.6;}
    .card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:18px;overflow:hidden;box-shadow:var(--sh);animation:fu 0.35s ease 0.2s both;}
    .card-head{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--sep2);}
    .card-title{font-size:15px;font-weight:600;color:var(--label);}
    .tbl{width:100%;border-collapse:collapse;}
    .tbl th{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--label3);padding:10px 16px;text-align:left;border-bottom:1px solid var(--sep2);}
    .tbl td{padding:11px 16px;font-size:13px;color:var(--label);border-bottom:1px solid var(--sep2);}
    .tbl tr:last-child td{border-bottom:none;}
    .tbl tr:hover td{background:var(--fill3);}
    .bdg{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:600;}
    .bdg.AC{background:rgba(52,199,89,0.12);color:#1EA851}
    .bdg.AN{background:rgba(230,57,70,0.12);color:var(--rojo)}
    .empty{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:60px;text-align:center;gap:10px;}
    .empty-ico{font-size:44px;opacity:0.35;}.empty-txt{font-size:16px;font-weight:600;color:var(--label2);}.empty-sub{font-size:13px;color:var(--label3);}
    @@media(max-width:700px){
        .tbl{min-width:500px!important;}
    }
</style>
}

<div class="stat-banner">
    <div><div class="sb2-num">@totalVentas</div><div class="sb2-lbl">ventas registradas por ti</div></div>
    <div class="sb2-ico">💲</div>
</div>
<div class="card">
    <div class="card-head"><span class="card-title">Historial de mis ventas</span></div>
    @if (ventas.Count > 0)
    {
        <div style="overflow-x:auto">
            <table class="tbl">
                <thead><tr><th>Apto</th><th>Torre</th><th>Cliente</th><th>Destino</th><th>Precio venta</th><th>Lista</th><th>Fecha y hora</th><th>Estado</th></tr></thead>
                <tbody>
                    @foreach (var v in ventas)
                    {
                        var cls = v.Estado == "ACTIVA" ? "AC" : "AN";
                        var dest = v.Destino as string ?? "—";
                        var destIco = dest == "Vivienda" ? "🏠" : dest == "Inversión para reventa" ? "📈" : dest == "Inversión para arriendo" ? "🔑" : dest == "Cesión de derechos" ? "📋" : "—";
                        var destCol = dest == "Vivienda" ? "rgba(0,118,227,0.08);color:var(--blue)" : dest == "Inversión para reventa" ? "rgba(52,199,89,0.1);color:#1EA851" : dest == "Inversión para arriendo" ? "rgba(255,149,0,0.1);color:#CC7700" : dest == "Cesión de derechos" ? "rgba(90,90,200,0.1);color:#5A5AC8" : "rgba(120,120,128,0.08);color:var(--label3)";
                        <tr>
                            <td style="font-weight:600">@v.Apto</td>
                            <td>@v.Torre</td>
                            <td>@v.Cliente</td>
                            <td><div style="display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:20px;background:@destCol;font-size:11px;font-weight:600;white-space:nowrap;">@destIco @dest</div></td>
                            <td style="font-weight:500;color:var(--azul)">$@(string.Format("{0:N0}", long.TryParse(v.PrecioVenta, out long pv) ? pv : 0))</td>
                            <td>Lista @v.Lista</td>
                            <td style="color:var(--label2);font-size:12px">@v.FechaVenta</td>
                            <td><span class="bdg @cls">@v.Estado</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty">
            <div class="empty-ico">💲</div>
            <div class="empty-txt">Aún no tienes ventas registradas</div>
            <div class="empty-sub">Tus ventas aparecerán aquí una vez que las registres</div>
        </div>
    }
</div>
