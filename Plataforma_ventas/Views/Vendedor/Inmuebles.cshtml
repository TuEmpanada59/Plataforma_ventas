@{
    Layout = "~/Views/Shared/_VendedorLayout.cshtml";
    ViewData["Title"] = "Londoño Gómez — Inmuebles";
    ViewBag.ActiveNav = "vendedor-inmuebles";
    ViewBag.TbBread   = "Inmuebles";

    var inmuebles   = ViewBag.Inmuebles  as List<dynamic> ?? new List<dynamic>();
    int total       = ViewBag.Total       != null ? (int)ViewBag.Total       : 0;
    int disponibles = ViewBag.Disponibles != null ? (int)ViewBag.Disponibles : 0;
    int reservados  = ViewBag.Reservados  != null ? (int)ViewBag.Reservados  : 0;
    int vendidos    = ViewBag.Vendidos    != null ? (int)ViewBag.Vendidos    : 0;
    int enProceso   = ViewBag.EnProceso   != null ? (int)ViewBag.EnProceso   : 0;
    int la          = ViewBag.ListaActual != null ? (int)ViewBag.ListaActual  : 1;
    int miId        = ViewBag.IdUsuario   != null ? (int)ViewBag.IdUsuario    : 0;
    int proyId      = ViewBag.ProyectoId  != null ? (int)ViewBag.ProyectoId   : 0;
    var proyActivo  = ViewBag.ProyectoActivo as string ?? "Sin proyecto";
    var areaActual  = ViewBag.AreaActual  as string ?? "";
    var grupos      = ViewBag.Grupos      as List<dynamic> ?? new List<dynamic>();
    var vendedores  = ViewBag.Vendedores  as Dictionary<int,string> ?? new Dictionary<int,string>();
    var listasXArea = ViewBag.ListasXArea as Dictionary<string,int> ?? new Dictionary<string,int>();

    Func<object, long> ParsePrecio = raw => {
        var s = (raw?.ToString() ?? "0").Replace("$","").Replace(".","").Replace(",","").Replace(" ","").Trim();
        return long.TryParse(s, out long v) ? v : 0;
    };
}
@section Styles {
<style>
    @@keyframes fu{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    .kpi-row{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;}
    .kpi{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:18px;padding:16px;box-shadow:var(--sh);transition:transform 0.2s;animation:fu 0.35s ease both;}
    .kpi:nth-child(1){animation-delay:.05s}.kpi:nth-child(2){animation-delay:.1s}.kpi:nth-child(3){animation-delay:.15s}.kpi:nth-child(4){animation-delay:.2s}.kpi:nth-child(5){animation-delay:.25s}
    .kpi:hover{transform:translateY(-2px);}
    .kpi-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;}
    .kpi-ico{width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:17px;}
    .kpi.k1 .kpi-ico{background:rgba(0,118,227,0.1)}.kpi.k2 .kpi-ico{background:rgba(52,199,89,0.1)}.kpi.k3 .kpi-ico{background:rgba(90,90,200,0.1)}.kpi.k4 .kpi-ico{background:rgba(255,149,0,0.1)}.kpi.k5 .kpi-ico{background:rgba(230,57,70,0.1)}
    .kpi-tag{font-size:11px;font-weight:600;padding:3px 8px;border-radius:20px;}
    .kpi.k1 .kpi-tag{background:rgba(0,118,227,0.1);color:var(--blue)}.kpi.k2 .kpi-tag{background:rgba(52,199,89,0.1);color:#1EA851}.kpi.k3 .kpi-tag{background:rgba(90,90,200,0.1);color:#5A5AC8}.kpi.k4 .kpi-tag{background:rgba(255,149,0,0.1);color:#CC7700}.kpi.k5 .kpi-tag{background:rgba(230,57,70,0.1);color:var(--rojo)}
    .kpi-num{font-size:28px;font-weight:300;letter-spacing:-1.5px;line-height:1;margin-bottom:3px;}
    .kpi.k1 .kpi-num{color:var(--azul)}.kpi.k2 .kpi-num{color:#1EA851}.kpi.k3 .kpi-num{color:#5A5AC8}.kpi.k4 .kpi-num{color:#CC7700}.kpi.k5 .kpi-num{color:var(--rojo)}
    .kpi-lbl{font-size:12px;color:var(--label2);}
    .areas-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:14px;animation:fu 0.35s ease both;}
    .area-card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:2px solid var(--gb);border-radius:20px;padding:20px;cursor:pointer;transition:all 0.2s;box-shadow:var(--sh);text-decoration:none;display:block;}
    .area-card:hover{border-color:var(--blue);transform:translateY(-3px);}
    .area-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;}
    .area-metros{font-size:22px;font-weight:700;color:var(--azul);letter-spacing:-0.5px;}
    .area-tipo-ext{background:rgba(255,149,0,0.12);color:#CC7700;font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;}
    .area-tipo-int{background:rgba(0,118,227,0.1);color:var(--blue);font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;}
    .area-precio-lbl{font-size:10px;color:var(--label3);font-weight:600;text-transform:uppercase;margin-bottom:2px;}
    .area-precio{font-size:17px;font-weight:600;color:var(--azul);margin-bottom:10px;}
    .area-listas{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px;}
    .prog-wrap{margin-bottom:4px;}
    .prog-bar{height:6px;border-radius:10px;background:var(--fill2);overflow:hidden;}
    .prog-fill{height:100%;border-radius:10px;background:linear-gradient(90deg,var(--verde),#1EA851);}
    .prog-fill.naranja{background:linear-gradient(90deg,var(--oro),#CC7700);}
    .prog-fill.rojo{background:linear-gradient(90deg,var(--rojo),#B02030);}
    .prog-lbl{display:flex;justify-content:space-between;font-size:11px;color:var(--label2);margin-top:3px;}
    .card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:18px;overflow:hidden;box-shadow:var(--sh);animation:fu 0.35s ease 0.1s both;}
    .card-head{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--sep2);flex-wrap:wrap;gap:8px;}
    .card-title{font-size:15px;font-weight:600;color:var(--label);}
    .tbl-wrap{overflow-x:auto;}
    .tbl{width:100%;border-collapse:collapse;min-width:560px;}
    .tbl thead{position:sticky;top:0;z-index:2;background:rgba(255,255,255,0.95);}
    .tbl th{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--label3);padding:10px 16px;text-align:left;border-bottom:1px solid var(--sep2);}
    .tbl td{padding:11px 16px;font-size:13px;color:var(--label);border-bottom:1px solid var(--sep2);}
    .tbl tr:last-child td{border-bottom:none;}
    .tbl tr:hover td{background:var(--fill3);}
    .bdg{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:600;}
    .bdg::before{content:'';width:5px;height:5px;border-radius:50%;flex-shrink:0;}
    .bdg.D{background:rgba(52,199,89,0.12);color:#1EA851}.bdg.D::before{background:#34C759}
    .bdg.V{background:rgba(230,57,70,0.12);color:var(--rojo)}.bdg.V::before{background:var(--rojo)}
    .bdg.R{background:rgba(255,149,0,0.12);color:#CC7700}.bdg.R::before{background:var(--oro)}
    .bdg.P{background:rgba(90,90,200,0.12);color:#5A5AC8}.bdg.P::before{background:#5A5AC8}
    .filter-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
    .search-wrap{position:relative;max-width:220px;}
    .search-wrap input{width:100%;padding:7px 12px 7px 30px;background:var(--fill3);border:1px solid var(--sep);border-radius:10px;font-size:13px;color:var(--label);outline:none;}
    .search-wrap input:focus{background:white;border-color:var(--blue);}
    .search-ico{position:absolute;left:9px;top:50%;transform:translateY(-50%);font-size:12px;color:var(--label3);pointer-events:none;}
    .seg{display:flex;background:var(--fill3);border-radius:10px;padding:3px;gap:2px;}
    .seg-btn{padding:5px 10px;border-radius:7px;font-size:12px;font-weight:600;color:var(--label2);cursor:pointer;border:none;background:none;transition:all 0.2s;}
    .seg-btn.active{background:white;color:var(--label);box-shadow:0 1px 4px rgba(0,0,0,0.1);}
    .btn-vender{background:var(--blue);color:white;border:none;padding:5px 12px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;transition:all 0.2s;}
    .btn-vender:hover{background:var(--mid);}
    .btn-reservar{background:rgba(255,149,0,0.12);color:#CC7700;border:none;padding:5px 10px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;margin-left:4px;}
    .btn-cancelar{background:rgba(230,57,70,0.1);color:var(--rojo);border:none;padding:5px 10px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;}
    .tag-yo{font-size:11px;color:#5A5AC8;font-weight:600;margin-right:4px;}
    .tag-otro{font-size:11px;color:var(--label3);}
    .area-volver{display:inline-flex;align-items:center;gap:6px;background:var(--fill3);border:1px solid var(--sep);color:var(--label);padding:7px 14px;border-radius:10px;font-size:13px;font-weight:600;text-decoration:none;}
    .area-volver:hover{background:var(--fill2);}
    .alerta-exito{background:rgba(52,199,89,0.1);border:1px solid rgba(52,199,89,0.3);border-radius:12px;padding:10px 16px;font-size:13px;font-weight:600;color:#1EA851;}
    .alerta-error{background:rgba(230,57,70,0.1);border:1px solid rgba(230,57,70,0.3);border-radius:12px;padding:10px 16px;font-size:13px;font-weight:600;color:var(--rojo);}
    .empty{padding:48px;text-align:center;}
    .empty-ico{font-size:40px;opacity:0.4;margin-bottom:8px;}
    .empty-txt{font-size:15px;font-weight:600;color:var(--label2);}
    @@media(max-width:1200px){.kpi-row{grid-template-columns:repeat(3,1fr)!important;}.areas-grid{grid-template-columns:repeat(3,1fr)!important;}}
    @@media(max-width:1024px){.kpi-row{grid-template-columns:repeat(2,1fr)!important;}.areas-grid{grid-template-columns:repeat(2,1fr)!important;}}
    @@media(max-width:700px){
        .kpi-row{grid-template-columns:1fr 1fr!important;gap:8px!important;}
        .areas-grid{grid-template-columns:1fr 1fr!important;}
    }
</style>
}

@if (TempData["Exito"] != null) { <div class="alerta-exito">@TempData["Exito"]</div> }
@if (TempData["Error"] != null) { <div class="alerta-error">@TempData["Error"]</div> }

<!-- KPIs globales -->
<div class="kpi-row">
    <div class="kpi k1"><div class="kpi-top"><div class="kpi-ico">@Iconos.Edificio("#0076E3")</div><span class="kpi-tag">Total</span></div><div class="kpi-num" id="kpi-total">@total</div><div class="kpi-lbl">Inmuebles</div></div>
    <div class="kpi k2"><div class="kpi-top"><div class="kpi-ico">@Iconos.Check("#1EA851")</div><span class="kpi-tag">Disponibles</span></div><div class="kpi-num" id="kpi-disp">@disponibles</div><div class="kpi-lbl">Para venta</div></div>
    <div class="kpi k3"><div class="kpi-top"><div class="kpi-ico">@Iconos.Reloj("#5A5AC8")</div><span class="kpi-tag">En proceso</span></div><div class="kpi-num" id="kpi-proc">@enProceso</div><div class="kpi-lbl">Gestionando</div></div>
    <div class="kpi k4"><div class="kpi-top"><div class="kpi-ico">@Iconos.Candado("#E08600")</div><span class="kpi-tag">Reservados</span></div><div class="kpi-num" id="kpi-res">@reservados</div><div class="kpi-lbl">Bloqueados</div></div>
    <div class="kpi k5"><div class="kpi-top"><div class="kpi-ico">@Iconos.Llave("#E63946")</div><span class="kpi-tag">Vendidos</span></div><div class="kpi-num" id="kpi-vend">@vendidos</div><div class="kpi-lbl">Cerrados</div></div>
</div>

@if (string.IsNullOrEmpty(areaActual)) {
    <!-- PANTALLA DE ÁREAS -->
    <div style="font-size:15px;font-weight:600;color:var(--label)">Selecciona un área para ver los inmuebles</div>
    <div class="areas-grid">
        @foreach (var g in grupos) {
            var porcVend  = g.Total > 0 ? (int)Math.Round((double)g.Vendidos / g.Total * 100) : 0;
            var fillCls   = porcVend >= 80 ? "rojo" : porcVend >= 50 ? "naranja" : "";
            var tipoLabel = g.Tipo?.ToString() ?? "";
            var tipoClass = tipoLabel == "EXT" ? "area-tipo-ext" : "area-tipo-int";
            var metrosStr = g.Metros.ToString();
            var laArea    = listasXArea.ContainsKey(metrosStr) ? listasXArea[metrosStr] : la;
            long p1=(long)g.PrecioL1; long p2=(long)g.PrecioL2; long p3=(long)g.PrecioL3;
            long p4=(long)g.PrecioL4; long p5=(long)g.PrecioL5;
            long precActArea = laArea==1?p1:laArea==2?p2:laArea==3?p3:laArea==4?p4:p5;
            if (precActArea == 0) precActArea = (long)g.PrecioActivo;
            <a href="/Vendedor/Inmuebles?area=@Uri.EscapeDataString(g.Metros)" class="area-card"
               data-metros="@g.Metros" data-lista-activa="@laArea"
               data-l1="@p1" data-l2="@p2" data-l3="@p3" data-l4="@p4" data-l5="@p5"
               data-disp="@g.Disponibles" data-vend="@g.Vendidos"
               data-proc="@g.EnProceso" data-res="@g.Reservados" data-total="@g.Total">
                <div class="area-top">
                    <div class="area-metros">@g.Metros <span style="font-size:13px;font-weight:400;color:var(--label2)">m²</span></div>
                    <span class="@tipoClass">@tipoLabel</span>
                </div>
                <div class="area-precio-lbl">Precio</div>
                <div class="area-precio">$@string.Format("{0:N0}", precActArea)</div>
                <div class="prog-wrap">
                    <div class="prog-bar"><div class="prog-fill @fillCls" style="width:@(porcVend)%"></div></div>
                    <div class="prog-lbl">
                        <span>@g.Disponibles disp · @g.Vendidos vend</span>
                        <span>@(porcVend)%</span>
                    </div>
                </div>
            </a>
        }
    </div>
} else {
    <!-- TABLA FILTRADA POR ÁREA -->
    var laEstaArea = listasXArea.ContainsKey(areaActual) ? listasXArea[areaActual] : la;
    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        <a href="/Vendedor/Inmuebles" class="area-volver">← Todas las áreas</a>
        <span style="font-size:15px;font-weight:600;color:var(--label)">@areaActual m² · @inmuebles.Count inmuebles</span>
    </div>
    <div class="card">
        <div class="card-head">
            <span class="card-title">@areaActual m²</span>
            <div class="filter-bar">
                <div class="search-wrap"><span class="search-ico"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg></span><input type="text" id="buscar" placeholder="Buscar apto, piso..." oninput="filtrar()"/></div>
                <div class="seg">
                    <button class="seg-btn active" onclick="setFiltro('todos',this)">Todos</button>
                    <button class="seg-btn" onclick="setFiltro('DISPONIBLE',this)">Disponibles</button>
                    <button class="seg-btn" onclick="setFiltro('RESERVADO',this)">Reservados</button>
                </div>
            </div>
        </div>
        @if (inmuebles.Count > 0) {
            <div class="tbl-wrap">
                <table class="tbl" id="tablaInmuebles">
                    <thead><tr>
                        <th>Apto</th><th>Tipo</th><th>Piso</th><th>Metros</th>
                        <th class="precio-th">Precio</th><th>Torre</th><th>Estado</th><th>Acción</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var i in inmuebles) {
                        var cls = i.Estado == "DISPONIBLE" ? "D" : i.Estado == "VENDIDO" ? "V" : i.Estado == "EN PROCESO" ? "P" : "R";
                        long dl1 = ParsePrecio(i.Lista1);
                        long dl2 = ParsePrecio(i.Lista2);
                        long dl3 = ParsePrecio(i.Lista3);
                        long dl4 = ParsePrecio(i.Lista4);
                        long dl5 = ParsePrecio(i.Lista5);
                        long precioActivo = laEstaArea==1?dl1:laEstaArea==2?dl2:laEstaArea==3?dl3:laEstaArea==4?dl4:dl5;
                        <tr data-estado="@i.Estado" data-id="@i.Id" data-metros="@i.Metros"
                            data-lista-activa="@laEstaArea"
                            data-l1="@dl1" data-l2="@dl2" data-l3="@dl3" data-l4="@dl4" data-l5="@dl5">
                            <td style="font-weight:600">@i.Apto</td>
                            <td>
                                @if (i.Tipo == "EXT") {
                                    <span style="background:rgba(255,149,0,0.12);color:#CC7700;font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px">EXT</span>
                                } else if (i.Tipo == "INT") {
                                    <span style="background:rgba(0,118,227,0.1);color:var(--blue);font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px">INT</span>
                                } else { <span>@i.Tipo</span> }
                            </td>
                            <td>@i.Piso</td>
                            <td>@i.Metros m²</td>
                            <td class="precio-col" style="font-weight:500;color:var(--azul)">$@string.Format("{0:N0}", precioActivo)</td>
                            <td>@i.Torre</td>
                            <td class="estado-td">
                                <span class="bdg @cls">@i.Estado</span>
                                @if (i.Estado == "EN PROCESO" && i.IdVendedorEnProceso > 0) {
                                    var nomVend = vendedores.ContainsKey(i.IdVendedorEnProceso) ? vendedores[i.IdVendedorEnProceso] : "Vendedor";
                                    <br/><span style="font-size:11px;color:#5A5AC8;font-weight:600">@nomVend</span>
                                }
                            </td>
                            <td class="accion-td">
                                @if (i.Estado == "DISPONIBLE") {
                                    <form action="/Vendedor/TomarInmueble" method="post" style="margin:0;display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idInmueble" value="@i.Id"/>
                                        <button type="submit" class="btn-vender">Vender</button>
                                    </form>
                                    <form action="/Vendedor/ReservarInmueble" method="post" style="margin:0;display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idInmueble" value="@i.Id"/>
                                        <button type="submit" class="btn-reservar" onclick="return confirm('¿Reservar?')">Reservar</button>
                                    </form>
                                } else if (i.Estado == "EN PROCESO" && i.IdVendedorEnProceso == miId) {
                                    <a href="/Vendedor/RegistrarVenta?idInmueble=@i.Id" class="btn-vender" style="display:inline-flex;align-items:center;padding:5px 12px;border-radius:8px;font-size:12px;font-weight:600;text-decoration:none;margin-right:4px">Continuar</a>
                                    <form action="/Vendedor/CancelarProceso" method="post" style="margin:0;display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idInmueble" value="@i.Id"/>
                                        <button type="submit" class="btn-cancelar" onclick="return confirm('¿Cancelar? El inmueble volverá a estar disponible.')">Cancelar</button>
                                    </form>
                                } else if (i.Estado == "EN PROCESO") {
                                    var nomVend2 = vendedores.ContainsKey(i.IdVendedorEnProceso) ? vendedores[i.IdVendedorEnProceso] : "Otro vendedor";
                                    <span class="tag-otro">@nomVend2</span>
                                } else if (i.Estado == "RESERVADO" && i.IdVendedorReserva == miId) {
                                    <span class="tag-yo">Tú lo reservaste</span>
                                    <form action="/Vendedor/LiberarReserva" method="post" style="margin:0;display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idInmueble" value="@i.Id"/>
                                        <button type="submit" class="btn-cancelar" onclick="return confirm('¿Liberar reserva?')">Liberar</button>
                                    </form>
                                } else {
                                    <span style="color:var(--label3);font-size:12px">—</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        } else {
            <div class="empty"><div class="empty-ico">@Iconos.Edificio("#8E8E93", 40, 0.18)</div><div class="empty-txt">No hay inmuebles disponibles en esta área</div></div>
        }
    </div>
}

@section Scripts {
<script>
    let filtroActual = 'todos';
    function setFiltro(f,btn){
        filtroActual=f;
        document.querySelectorAll('.seg-btn').forEach(b=>b.classList.remove('active'));
        btn.classList.add('active');
        filtrar();
    }
    function filtrar(){
        const q=document.getElementById('buscar')?.value.toLowerCase()||'';
        document.querySelectorAll('#tablaInmuebles tbody tr').forEach(tr=>{
            const matchF=filtroActual==='todos'||tr.dataset.estado===filtroActual;
            tr.style.display=matchF&&tr.innerText.toLowerCase().includes(q)?'':'none';
        });
    }
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    const proyIdSR = @proyId;
    const miIdSR   = @miId;
    let kpiDisp = @disponibles;
    let kpiProc = @enProceso;
    let kpiRes  = @reservados;
    let kpiVend = @vendidos;

    // id → metros mapping for KPI updates in areas grid
    const inmueblesMetros = {
        @foreach (var i in inmuebles) {
            @:@i.Id: "@i.Metros",
        }
    };

    function fmtPrecio(n) {
        return '$' + parseInt(n || 0).toLocaleString('es-CO');
    }
    function getToken() {
        var inp = document.querySelector('input[name="__RequestVerificationToken"]');
        return inp ? inp.value : '';
    }
    function actualizarKpisDOM() {
        var el;
        el = document.getElementById('kpi-disp'); if (el) el.textContent = kpiDisp;
        el = document.getElementById('kpi-proc'); if (el) el.textContent = kpiProc;
        el = document.getElementById('kpi-res');  if (el) el.textContent = kpiRes;
        el = document.getElementById('kpi-vend'); if (el) el.textContent = kpiVend;
    }

    /* Cuando un área sube de lista, aquí solo se actualizan los precios.
       El número de lista se consulta en Mi perfil → Listas por área. */
    function actualizarLista(nuevaLista, filtroMetros) {
        // Precio de cada tarjeta de área
        document.querySelectorAll('.area-card').forEach(function(card) {
            if (filtroMetros && card.dataset.metros !== filtroMetros) return;
            var precio = parseInt(card.dataset['l' + nuevaLista] || 0);
            var priceEl = card.querySelector('.area-precio');
            if (priceEl) priceEl.textContent = fmtPrecio(precio);
        });
        // Precio de cada fila de la tabla
        document.querySelectorAll('#tablaInmuebles tbody tr').forEach(function(tr) {
            if (filtroMetros && tr.dataset.metros !== filtroMetros) return;
            var precio = parseInt(tr.dataset['l' + nuevaLista] || 0);
            var td = tr.querySelector('.precio-col');
            if (td) td.textContent = fmtPrecio(precio);
        });
    }

    const conn = new signalR.HubConnectionBuilder().withUrl("/ventasHub").withAutomaticReconnect().build();

    conn.on("ListaActualizada", function(proyIdEvt, nuevaLista) {
        if (proyIdEvt !== proyIdSR) return;
        document.querySelectorAll('.area-card').forEach(function(c){ c.dataset.listaActiva = nuevaLista; });
        document.querySelectorAll('#tablaInmuebles tbody tr').forEach(function(r){ r.dataset.listaActiva = nuevaLista; });
        actualizarLista(nuevaLista, null);
        mostrarToast('Lista del proyecto actualizada a ' + nuevaLista, 'info');
    });

    conn.on("ListaAreaActualizada", function(proyIdEvt, metros, nuevaLista) {
        if (proyIdEvt !== proyIdSR) return;
        document.querySelectorAll('.area-card[data-metros="' + metros + '"]').forEach(function(c){ c.dataset.listaActiva = nuevaLista; });
        document.querySelectorAll('#tablaInmuebles tbody tr[data-metros="' + metros + '"]').forEach(function(r){ r.dataset.listaActiva = nuevaLista; });
        actualizarLista(nuevaLista, metros);
        mostrarToast('Área ' + metros + ' m² → Lista ' + nuevaLista, 'info');
    });

    conn.on("PrecioAreaActualizado", function(proyIdEvt, metros, numLista, nuevoPrecio) {
        if (proyIdEvt !== proyIdSR) return;
        document.querySelectorAll('.area-card[data-metros="' + metros + '"]').forEach(function(card) {
            card.dataset['l' + numLista] = nuevoPrecio;
            if (parseInt(card.dataset.listaActiva || 1) === numLista) {
                var priceEl = card.querySelector('.area-precio');
                if (priceEl) priceEl.textContent = fmtPrecio(nuevoPrecio);
            }
        });
        document.querySelectorAll('#tablaInmuebles tbody tr[data-metros="' + metros + '"]').forEach(function(tr) {
            tr.dataset['l' + numLista] = nuevoPrecio;
            if (parseInt(tr.dataset.listaActiva || 1) === numLista) {
                var td = tr.querySelector('.precio-col');
                if (td) td.textContent = fmtPrecio(nuevoPrecio);
            }
        });
        mostrarToast('Precio Lista ' + numLista + ' actualizado en ' + metros + ' m²', 'info');
    });

    conn.on("InmuebleActualizado", function(proyIdEvt, idInmueble, nuevoEstado, quien) {
        if (proyIdEvt !== proyIdSR) return;

        // Update table row (detail/area view)
        var tr = document.querySelector('#tablaInmuebles tbody tr[data-id="' + idInmueble + '"]');
        if (tr) {
            var estadoAnterior = tr.dataset.estado;
            // Adjust KPI counters
            if (estadoAnterior === 'DISPONIBLE')  kpiDisp--;
            else if (estadoAnterior === 'EN PROCESO') kpiProc--;
            else if (estadoAnterior === 'RESERVADO')  kpiRes--;
            else if (estadoAnterior === 'VENDIDO')    kpiVend--;
            if (nuevoEstado === 'DISPONIBLE')   kpiDisp++;
            else if (nuevoEstado === 'EN PROCESO') kpiProc++;
            else if (nuevoEstado === 'RESERVADO')  kpiRes++;
            else if (nuevoEstado === 'VENDIDO')    kpiVend++;
            actualizarKpisDOM();

            tr.dataset.estado = nuevoEstado;
            var cls = nuevoEstado==='DISPONIBLE'?'D':nuevoEstado==='VENDIDO'?'V':nuevoEstado==='EN PROCESO'?'P':'R';

            // Update estado badge
            var estadoTd = tr.querySelector('.estado-td');
            if (estadoTd) {
                estadoTd.innerHTML = '<span class="bdg ' + cls + '">' + nuevoEstado + '</span>' +
                    (nuevoEstado === 'EN PROCESO' ? '<br/><span style="font-size:11px;color:#5A5AC8;font-weight:600">En proceso</span>' : '');
            }

            // Update action cell
            var accionTd = tr.querySelector('.accion-td');
            if (accionTd) {
                if (nuevoEstado === 'DISPONIBLE') {
                    var tok = getToken();
                    accionTd.innerHTML =
                        '<form action="/Vendedor/TomarInmueble" method="post" style="margin:0;display:inline">' +
                        '<input type="hidden" name="__RequestVerificationToken" value="' + tok + '"/>' +
                        '<input type="hidden" name="idInmueble" value="' + idInmueble + '"/>' +
                        '<button type="submit" class="btn-vender">Vender</button></form>' +
                        '<form action="/Vendedor/ReservarInmueble" method="post" style="margin:0;display:inline">' +
                        '<input type="hidden" name="__RequestVerificationToken" value="' + tok + '"/>' +
                        '<input type="hidden" name="idInmueble" value="' + idInmueble + '"/>' +
                        '<button type="submit" class="btn-reservar" onclick="return confirm(\'¿Reservar?\')">Reservar</button></form>';
                } else if (nuevoEstado === 'EN PROCESO') {
                    accionTd.innerHTML = '<span class="tag-otro">En proceso</span>';
                } else {
                    accionTd.innerHTML = '<span style="color:var(--label3);font-size:12px">—</span>';
                }
            }

            // Flash the updated row
            tr.style.transition = 'background 0.4s';
            tr.style.background = 'rgba(0,118,227,0.07)';
            setTimeout(function(){ tr.style.background = ''; tr.style.transition = ''; }, 1400);
        } else {
            // In the areas grid: only update global KPIs
            var metros = inmueblesMetros[idInmueble];
            var estadoViejo = null;
            // We don't track per-property state in grid mode, so just nudge global KPIs
            // (full per-area counts update on next page load or area visit)
        }

        mostrarToast('Inmueble actualizado: ' + nuevoEstado, 'info');
    });

    conn.start().catch(function(err){ console.error('SignalR:', err); });

    function mostrarToast(msg, tipo) {
        var t = document.createElement('div');
        t.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:9999;background:'+(tipo==='exito'?'#1EA851':'var(--blue)')+';color:white;padding:12px 20px;border-radius:12px;font-size:13px;font-weight:600;box-shadow:0 8px 24px rgba(0,0,0,0.2);transition:opacity 0.3s;';
        t.textContent = msg;
        document.body.appendChild(t);
        setTimeout(function(){ t.style.opacity='0'; setTimeout(function(){ t.remove(); }, 300); }, 3200);
    }
</script>
}
