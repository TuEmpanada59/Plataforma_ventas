@{
    Layout = "~/Views/Shared/_VendedorLayout.cshtml";
    ViewData["Title"] = "Londoño Gómez — Mi perfil";
    ViewBag.ActiveNav = "vendedor-perfil";
    ViewBag.TbBread   = "Mi perfil";

    var proyActivo = ViewBag.ProyectoActivo as string ?? "Sin proyecto";
    var pNombre    = ViewBag.PerfilNombre   as string ?? "";
    var pApellido  = ViewBag.PerfilApellido as string ?? "";
    var pUsuario   = ViewBag.PerfilUsuario  as string ?? "";
    var pCorreo    = ViewBag.PerfilCorreo   as string ?? "";
    var pDoc       = ViewBag.PerfilDocumento as string ?? "—";
    var pCel       = ViewBag.PerfilCelular  as string ?? "—";
    var iniciales  = ((pNombre.Length>=1?pNombre.Substring(0,1):"") + (pApellido.Length>=1?pApellido.Substring(0,1):"")).ToUpper();
}
@section Styles {
<style>
    @@keyframes fu{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    .perfil-card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:24px;padding:32px;width:100%;max-width:500px;box-shadow:var(--sh);animation:fu 0.35s ease both;}
    .perfil-av{width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,var(--azul),var(--celeste));display:flex;align-items:center;justify-content:center;font-size:26px;font-weight:700;color:white;margin:0 auto 12px;box-shadow:0 6px 20px rgba(0,96,187,0.3);}
    .perfil-nombre{font-size:20px;font-weight:700;color:var(--label);text-align:center;letter-spacing:-0.5px;}
    .perfil-rol{font-size:12px;color:var(--label3);text-align:center;margin-top:3px;margin-bottom:24px;}
    .perfil-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
    .perfil-campo{background:var(--fill3);border-radius:14px;padding:14px;}
    .perfil-campo.full{grid-column:1/-1;}
    .pc-lbl{font-size:10px;text-transform:uppercase;letter-spacing:0.08em;color:var(--label3);font-weight:600;margin-bottom:4px;}
    .pc-val{font-size:14px;font-weight:500;color:var(--label);}
    .alerta-exito{background:rgba(52,199,89,0.1);border:1px solid rgba(52,199,89,0.3);border-radius:12px;padding:12px 16px;font-size:13px;font-weight:600;color:#1EA851;display:flex;align-items:center;gap:8px;}
    .alerta-error{background:rgba(230,57,70,0.1);border:1px solid rgba(230,57,70,0.3);border-radius:12px;padding:12px 16px;font-size:13px;font-weight:600;color:var(--rojo);display:flex;align-items:center;gap:8px;}
    .view-center{display:flex;align-items:center;justify-content:center;}
    @@media(max-width:700px){.perfil-grid{grid-template-columns:1fr!important;}.perfil-card{max-width:100%!important;}}
</style>
}

<div class="view-center">
    <div class="perfil-card">
        <div class="perfil-av">@iniciales</div>
        <div class="perfil-nombre">@pNombre @pApellido</div>
        <div class="perfil-rol">Vendedor · Londoño Gómez</div>
        <div class="perfil-grid">
            <div class="perfil-campo"><div class="pc-lbl">Usuario</div><div class="pc-val">@pUsuario</div></div>
            <div class="perfil-campo"><div class="pc-lbl">Correo</div><div class="pc-val">@pCorreo</div></div>
            <div class="perfil-campo"><div class="pc-lbl">Documento</div><div class="pc-val">@(string.IsNullOrEmpty(pDoc) ? "—" : pDoc)</div></div>
            <div class="perfil-campo"><div class="pc-lbl">Celular</div><div class="pc-val">@(string.IsNullOrEmpty(pCel) ? "—" : pCel)</div></div>
            <div class="perfil-campo full"><div class="pc-lbl">Proyecto activo</div><div class="pc-val">@proyActivo</div></div>
        </div>
    </div>
</div>
