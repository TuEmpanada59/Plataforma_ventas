@{
    Layout = null;
    var nombre     = ViewBag.Nombre   as string ?? "Admin";
    var apellido   = ViewBag.Apellido as string ?? "";
    var proyActivo = ViewBag.ProyectoActivo as string ?? "Sin proyecto";
    var cli        = ViewBag.Cliente;
    var compras    = ViewBag.Compras as List<dynamic> ?? new List<dynamic>();
    int totalC     = ViewBag.TotalCompras != null ? (int)ViewBag.TotalCompras : 0;
    long valorT    = ViewBag.ValorTotal   != null ? (long)ViewBag.ValorTotal  : 0;
    var iniciales = ((nombre.Length >= 1 ? nombre.Substring(0, 1) : "") + (apellido.Length >= 1 ? apellido.Substring(0, 1) : "")).ToUpper();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
    <title>@cli.Nombre @cli.Apellido · Clientes</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
        :root{--azul:#0076e3;--celeste:#00c9ff;--negro:#1e222b;--plata:#c3cfdb;--menta:#00d4a1;--mid:#0060bb;--blue:#0076e3;--rojo:#E63946;--verde:#34C759;--oro:#FF9500;--label:rgba(0,0,0,0.85);--label2:rgba(60,60,67,0.6);--label3:rgba(60,60,67,0.3);--sep:rgba(60,60,67,0.12);--sep2:rgba(60,60,67,0.06);--fill3:rgba(120,120,128,0.08);--glass:rgba(255,255,255,0.75);--gb:rgba(255,255,255,0.6);--sh:0 8px 32px rgba(0,0,0,0.08),0 2px 8px rgba(0,0,0,0.04);}
        html,body{background:#EEF2F7;color:var(--label);}
        *{font-family:'Inter',system-ui,sans-serif;-webkit-font-smoothing:antialiased;}
        body::before{content:'';position:fixed;inset:0;z-index:0;background:radial-gradient(ellipse 80% 60% at 10% 0%,rgba(0,118,227,0.12) 0%,transparent 55%),#EEF2F7;pointer-events:none;}
        .app{display:flex;min-height:100vh;position:relative;z-index:1;}
        .sidebar{width:230px;flex-shrink:0;background:var(--glass);backdrop-filter:blur(40px) saturate(180%);border-right:1px solid var(--gb);display:flex;flex-direction:column;}
        .sb-top{padding:20px 14px 0;}
        .sb-icon{width:42px;height:42px;border-radius:12px;background:linear-gradient(145deg,var(--mid),var(--blue));display:flex;align-items:center;justify-content:center;font-size:18px;margin-bottom:10px;box-shadow:0 4px 12px rgba(0,96,187,0.25);}
        .sb-app{font-size:17px;font-weight:700;color:var(--label);letter-spacing:-0.4px;}
        .sb-sub{font-size:11px;color:var(--label3);margin-top:1px;}
        .sb-proy{margin:14px 10px 0;background:rgba(0,118,227,0.08);border:1px solid rgba(0,118,227,0.18);border-radius:14px;padding:10px 12px;}
        .sb-proy-lbl{font-size:9px;text-transform:uppercase;letter-spacing:0.1em;color:var(--label3);font-weight:600;margin-bottom:2px;}
        .sb-proy-name{font-size:14px;font-weight:700;color:var(--azul);}
        .pulse{width:5px;height:5px;border-radius:50%;background:#34C759;flex-shrink:0;animation:pring 2.5s ease infinite;display:inline-block;}
        @@keyframes pring{0%{box-shadow:0 0 0 0 rgba(52,199,89,.4)}70%{box-shadow:0 0 0 5px rgba(52,199,89,0)}100%{box-shadow:0 0 0 0 rgba(52,199,89,0)}}
        .sb-sec{padding:16px 16px 4px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:var(--label3);}
        .nav-item{display:flex;align-items:center;gap:10px;padding:9px 12px;margin:1px 6px;border-radius:11px;font-size:14px;color:var(--label2);text-decoration:none;transition:all 0.2s;}
        .nav-item:hover{background:var(--fill3);color:var(--label);}
        .nav-item.active{background:var(--blue);color:white;font-weight:600;box-shadow:0 4px 12px rgba(0,118,227,0.28);}
        .nav-ico{width:26px;height:26px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:13px;background:var(--fill3);flex-shrink:0;}
        .nav-item.active .nav-ico{background:rgba(255,255,255,0.2);}
        .sb-footer{margin-top:auto;padding:10px 12px 20px;border-top:1px solid var(--sep2);display:flex;align-items:center;gap:8px;}
        .sb-av{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,var(--azul),var(--celeste));display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:white;}
        .sb-logout{margin-left:auto;width:26px;height:26px;border-radius:7px;background:var(--fill3);display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--label2);text-decoration:none;}
        .sb-logout:hover{background:rgba(230,57,70,0.1);color:var(--rojo);}
        .main{flex:1;display:flex;flex-direction:column;min-width:0;}
        .topbar{height:50px;flex-shrink:0;background:var(--glass);backdrop-filter:blur(40px) saturate(180%);border-bottom:1px solid var(--sep);padding:0 18px;display:flex;align-items:center;justify-content:space-between;}
        .tb-bread{font-size:13px;color:var(--label2);}.tb-bread strong{color:var(--label);font-weight:600;}
        .tb-right{display:flex;align-items:center;gap:8px;}
        .tb-chip{display:flex;align-items:center;gap:5px;background:var(--fill3);border:1px solid var(--sep);padding:4px 10px;border-radius:20px;font-size:12px;font-weight:600;color:var(--blue);}
        .tb-ibtn{width:30px;height:30px;border-radius:9px;background:var(--fill3);display:flex;align-items:center;justify-content:center;font-size:14px;text-decoration:none;color:var(--label);}
        .view{flex:1;overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:14px;}
        .view::-webkit-scrollbar{width:0;}
        @@keyframes fu{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
        .hero{background:linear-gradient(135deg,var(--azul),var(--blue));border-radius:18px;padding:20px 24px;display:flex;align-items:center;gap:18px;box-shadow:0 8px 24px rgba(0,118,227,0.25);animation:fu 0.3s ease both;}
        .hero-av{width:56px;height:56px;border-radius:50%;background:rgba(255,255,255,0.2);border:2px solid rgba(255,255,255,0.4);display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;color:white;flex-shrink:0;}
        .hero-info h2{font-size:20px;font-weight:600;color:white;letter-spacing:-0.5px;}
        .hero-info p{font-size:13px;color:rgba(255,255,255,0.7);margin-top:2px;}
        .hero-stats{margin-left:auto;display:flex;gap:20px;}
        .hero-stat{text-align:center;}
        .hero-stat-val{font-size:20px;font-weight:300;color:white;letter-spacing:-0.5px;}
        .hero-stat-lbl{font-size:10px;color:rgba(255,255,255,0.6);margin-top:1px;}
        .row2{display:grid;grid-template-columns:340px 1fr;gap:14px;flex:1;min-height:0;}
        .card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:18px;overflow:hidden;box-shadow:var(--sh);animation:fu 0.35s ease 0.1s both;display:flex;flex-direction:column;}
        .card-head{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--sep2);flex-shrink:0;}
        .card-title{font-size:14px;font-weight:600;color:var(--label);}
        .card-body{padding:16px;flex:1;overflow-y:auto;}
        .card-body::-webkit-scrollbar{width:0;}
        .field-row{margin-bottom:14px;}
        .field-lbl{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--label3);margin-bottom:4px;}
        .field-val{font-size:14px;color:var(--label);font-weight:500;}
        .field-input{width:100%;padding:8px 12px;background:var(--fill3);border:1px solid var(--sep);border-radius:10px;font-size:14px;color:var(--label);outline:none;transition:all 0.2s;}
        .field-input:focus{background:white;border-color:var(--blue);box-shadow:0 0 0 3px rgba(0,118,227,0.1);}
        .ios-btn{display:inline-flex;align-items:center;gap:6px;background:var(--blue);color:white;border:none;padding:8px 16px;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;box-shadow:0 4px 12px rgba(0,118,227,0.28);transition:all 0.2s;text-decoration:none;}
        .ios-btn:hover{background:var(--mid);}
        .ios-btn.ghost{background:var(--fill3);color:var(--label);box-shadow:none;border:1px solid var(--sep);}
        .tbl-wrap{overflow-y:auto;flex:1;}
        .tbl{width:100%;border-collapse:collapse;}
        .tbl thead{position:sticky;top:0;z-index:2;background:rgba(255,255,255,0.95);}
        .tbl th{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--label3);padding:10px 14px;text-align:left;border-bottom:1px solid var(--sep2);}
        .tbl td{padding:10px 14px;font-size:13px;color:var(--label);border-bottom:1px solid var(--sep2);}
        .tbl tr:last-child td{border-bottom:none;}
        .tbl tr:hover td{background:var(--fill3);}
        .bdg{display:inline-flex;align-items:center;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:600;}
        .bdg.A{background:rgba(52,199,89,0.12);color:#1EA851}
        .alerta-exito{background:rgba(52,199,89,0.1);border:1px solid rgba(52,199,89,0.3);border-radius:12px;padding:10px 16px;font-size:13px;font-weight:600;color:#1EA851;}
        .empty{padding:40px;text-align:center;color:var(--label3);}

        /* ═══ RESPONSIVE ═══ */
        html,body{overflow-x:hidden;}
        .app{min-height:100vh;height:auto;}
        .main{min-width:0;overflow:visible;}
        .view{height:auto;}
        .sidebar{position:sticky;top:0;height:100vh;overflow-y:auto;}
        .hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:6px;border-radius:8px;background:var(--fill3);border:none;}
        .hamburger span{display:block;width:18px;height:2px;background:var(--label);border-radius:2px;}
        @@media(max-width:1200px){.sidebar{width:185px!important;}.row2{grid-template-columns:280px 1fr!important;}}
        @@media(max-width:1024px){.sidebar{width:175px!important;}.row2{grid-template-columns:1fr!important;}}
        @@media(max-width:700px){
            html,body{height:auto!important;overflow:auto!important;}
            .app{flex-direction:column!important;height:auto!important;}
            .sidebar{position:fixed!important;top:0!important;left:-270px!important;width:260px!important;height:100vh!important;z-index:100!important;overflow-y:auto!important;transition:left 0.3s!important;}
            .sidebar.open{left:0!important;}
            .main{width:100%!important;overflow:visible!important;}
            .topbar{position:sticky!important;top:0!important;z-index:50!important;}
            .hamburger{display:flex!important;}
            .view{overflow-y:visible!important;padding:12px!important;height:auto!important;}
            .tb-chip{display:none!important;}
            .hero{flex-direction:column!important;align-items:flex-start!important;}
            .hero-stats{margin-left:0!important;margin-top:10px!important;}
            .row2{grid-template-columns:1fr!important;}
            .tbl-wrap{overflow-x:auto!important;}
            .tbl{min-width:500px!important;}
        }
    
        /* ── Sidebar blanco corporativo ── */
        .sidebar{background:#fff!important;border-right:1px solid rgba(0,0,0,0.07)!important;backdrop-filter:none!important;box-shadow:2px 0 12px rgba(0,0,0,0.04)!important;}
        .sb-logo-area{padding:16px 14px 12px;border-bottom:1px solid rgba(0,0,0,0.06);margin-bottom:4px;}
        .sb-logo-area img{width:100%;max-height:52px;object-fit:contain;display:block;mix-blend-mode:multiply;filter:contrast(1.05);}
        .sb-app{color:#1e222b!important;font-weight:700!important;}
        .sb-sub{color:rgba(30,34,43,0.45)!important;}
        .sb-proy{background:rgba(0,118,227,0.06)!important;border-color:rgba(0,118,227,0.18)!important;}
        .sb-proy:hover{background:rgba(0,118,227,0.10)!important;}
        .sb-proy-lbl{color:rgba(30,34,43,0.45)!important;font-size:9px!important;}
        .sb-proy-name{color:#0076e3!important;font-weight:700!important;}
        .sb-proy-meta{color:rgba(30,34,43,0.5)!important;}
        .proy-drop{background:#fff!important;border-color:rgba(0,0,0,0.09)!important;box-shadow:0 8px 24px rgba(0,0,0,0.1)!important;}
        .proy-drop-item{color:#1e222b!important;}
        .proy-drop-item:hover{background:rgba(0,118,227,0.06)!important;color:#0076e3!important;}
        .proy-drop-link{color:#0076e3!important;background:rgba(0,118,227,0.04)!important;}
        .sb-sec{color:rgba(30,34,43,0.38)!important;letter-spacing:0.08em!important;}
        .nav-item{color:rgba(30,34,43,0.65)!important;}
        .nav-item:hover{background:rgba(0,118,227,0.07)!important;color:#0076e3!important;}
        .nav-item.active{background:#0076e3!important;color:#fff!important;}
        .nav-item.active .nav-ico{background:rgba(255,255,255,0.22)!important;}
        .nav-ico{background:rgba(30,34,43,0.06)!important;color:inherit!important;}
        .sb-footer{border-top-color:rgba(0,0,0,0.07)!important;}
        .sb-logout{background:rgba(30,34,43,0.05)!important;color:rgba(30,34,43,0.45)!important;}
        .sb-logout:hover{background:rgba(230,57,70,0.08)!important;color:#E63946!important;}
        .nav-item{display:flex!important;align-items:center!important;gap:10px!important;padding:9px 12px!important;margin:1px 6px!important;border-radius:11px!important;font-size:14px!important;min-height:40px!important;text-decoration:none!important;transition:all 0.18s!important;}
        .nav-ico{width:26px!important;height:26px!important;border-radius:8px!important;display:flex!important;align-items:center!important;justify-content:center!important;font-size:14px!important;flex-shrink:0!important;}
        .sb-sec{padding:14px 18px 4px!important;font-size:10px!important;font-weight:600!important;text-transform:uppercase!important;}
    </style>
</head>
<body>
<div class="app">
    <div class="sidebar" id="sidebar">
        <div class="sb-logo-area">
            <img src="~/Images/Logo azul 2.jpg" alt="Londoño Gómez" style="width:100%;max-height:56px;object-fit:contain;display:block;mix-blend-mode:multiply;" />
        </div>
        <div class="sb-proy"><div class="sb-proy-lbl"><span class="pulse"></span> Proyecto activo</div><div class="sb-proy-name">@proyActivo</div></div>
        <div class="sb-sec">Principal</div>
        <a class="nav-item" href="/Dashboard"><div class="nav-ico">⊞</div>Inicio</a>
        <a class="nav-item" href="/Inmuebles"><div class="nav-ico">🏢</div>Proyectos</a>
        <a class="nav-item" href="/Ventas"><div class="nav-ico">💲</div>Ventas</a>
        <a class="nav-item active" href="/Clientes"><div class="nav-ico">👤</div>Clientes</a>
        <div class="sb-sec">General</div>
        <a class="nav-item" href="/Reportes"><div class="nav-ico">📊</div>Reportes</a>
        <a class="nav-item" href="/Carga/Index"><div class="nav-ico">📂</div>Cargar Excel</a>
        <a class="nav-item" href="/Usuarios"><div class="nav-ico">👥</div>Usuarios</a>
        <div class="sb-footer">
                <div class="sb-av">@iniciales</div>
            <div><div style="font-size:12px;font-weight:600">@nombre @apellido</div><div style="font-size:10px;color:var(--label3)">Administrador</div></div>
            <a class="sb-logout" href="/Account/Logout">↩</a>
        </div>
    </div>
    <div class="main">
        <div class="topbar">
            <div style="display:flex;align-items:center;gap:10px;"><button class="hamburger" onclick="toggleSidebar()"><span></span><span></span><span></span></button><span class="tb-bread"><a href="/Clientes" style="color:var(--label2);text-decoration:none">Clientes</a> › <strong>@cli.Nombre @cli.Apellido</strong></span></div>
            <div class="tb-right"><div class="tb-chip"><span class="pulse"></span>@proyActivo</div><a class="tb-ibtn" href="/Account/Logout">↩</a></div>
        </div>
        <div class="view">
            @if (TempData["Exito"] != null) { <div class="alerta-exito">✅ @TempData["Exito"]</div> }

            <!-- Hero -->
            <div class="hero">
                <div class="hero-av">@iniciales</div>
                <div class="hero-info">
                    <h2>@cli.Nombre @cli.Apellido</h2>
                    <p>CC @cli.Documento · @cli.Celular</p>
                </div>
                <div class="hero-stats">
                    <div class="hero-stat"><div class="hero-stat-val">@totalC</div><div class="hero-stat-lbl">Compras</div></div>
                    <div class="hero-stat"><div class="hero-stat-val">$@string.Format("{0:N0}", valorT)</div><div class="hero-stat-lbl">Valor total</div></div>
                </div>
            </div>

            <div class="row2">
                <!-- Panel editar -->
                <div class="card">
                    <div class="card-head"><span class="card-title">✏️ Editar información</span></div>
                    <div class="card-body">
                        <form action="/Clientes/Editar" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idCliente" value="@cli.Id"/>
                            <div class="field-row"><div class="field-lbl">Nombre</div><input class="field-input" type="text" name="nombre" value="@cli.Nombre"/></div>
                            <div class="field-row"><div class="field-lbl">Apellido</div><input class="field-input" type="text" name="apellido" value="@cli.Apellido"/></div>
                            <div class="field-row"><div class="field-lbl">Documento</div><input class="field-input" type="text" name="documento" value="@cli.Documento"/></div>
                            <div class="field-row"><div class="field-lbl">Celular</div><input class="field-input" type="text" name="celular" value="@cli.Celular"/></div>
                            <div class="field-row"><div class="field-lbl">Correo</div><input class="field-input" type="email" name="correo" value="@cli.Correo"/></div>
                            <div class="field-row"><div class="field-lbl">Dirección</div><input class="field-input" type="text" name="direccion" value="@cli.Direccion"/></div>
                            <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:6px">
                                <a href="/Clientes" class="ios-btn ghost">Volver</a>
                                <button type="submit" class="ios-btn">Guardar cambios</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Historial compras -->
                <div class="card">
                    <div class="card-head"><span class="card-title">🏠 Historial de compras</span><span style="background:rgba(0,118,227,0.1);color:var(--blue);font-size:12px;font-weight:700;padding:3px 10px;border-radius:20px">@totalC</span></div>
                    @if (compras.Count > 0) {
                        <div class="tbl-wrap">
                            <table class="tbl">
                                <thead><tr><th>Apto</th><th>Torre</th><th>Proyecto</th><th>Asesor</th><th>Lista</th><th>Precio</th><th>Fecha</th><th>Estado</th></tr></thead>
                                <tbody>
                                @foreach (var co in compras) {
                                    <tr>
                                        <td style="font-weight:600">@co.Apto</td>
                                        <td>@co.Torre</td>
                                        <td>@co.Proyecto</td>
                                        <td style="color:var(--blue)">@co.Asesor</td>
                                        <td style="text-align:center">@co.Lista</td>
                                        <td style="font-weight:600;color:var(--azul)">$@string.Format("{0:N0}", co.PrecioVenta)</td>
                                        <td style="color:var(--label2)">@co.FechaVenta</td>
                                        <td><span class="bdg A">@co.Estado</span></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    } else {
                        <div class="empty">Sin compras registradas</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<div id="sbOverlay" onclick="closeSidebar()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:99;backdrop-filter:blur(2px);"></div>
<script>
    function toggleSidebar(){var sb=document.getElementById('sidebar')||document.querySelector('.sidebar'),ov=document.getElementById('sbOverlay');if(!sb)return;var o=sb.classList.toggle('open');if(ov)ov.style.display=o?'block':'none';}
    function closeSidebar(){var sb=document.getElementById('sidebar')||document.querySelector('.sidebar'),ov=document.getElementById('sbOverlay');if(sb)sb.classList.remove('open');if(ov)ov.style.display='none';}
</script>
</body>
</html>
