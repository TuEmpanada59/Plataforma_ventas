@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Londoño Gómez — Detalle cliente";
    ViewBag.ActiveNav = "clientes";
    ViewBag.TbBread   = "Detalle cliente";

    var cli        = ViewBag.Cliente;
    var compras    = ViewBag.Compras as List<dynamic> ?? new List<dynamic>();
    int totalC     = ViewBag.TotalCompras != null ? (int)ViewBag.TotalCompras : 0;
    long valorT    = ViewBag.ValorTotal   != null ? (long)ViewBag.ValorTotal  : 0;
}
@section Styles {
<style>
    @@keyframes fu{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    .hero{background:linear-gradient(135deg,var(--azul),var(--blue));border-radius:18px;padding:20px 24px;display:flex;align-items:center;gap:18px;box-shadow:0 8px 24px rgba(0,118,227,0.25);animation:fu 0.3s ease both;}
    .hero-av{width:56px;height:56px;border-radius:50%;background:rgba(255,255,255,0.2);border:2px solid rgba(255,255,255,0.4);display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;color:white;flex-shrink:0;}
    .hero-info h2{font-size:20px;font-weight:600;color:white;letter-spacing:-0.5px;}
    .hero-info p{font-size:13px;color:rgba(255,255,255,0.7);margin-top:2px;}
    .hero-stats{margin-left:auto;display:flex;gap:20px;}
    .hero-stat{text-align:center;}
    .hero-stat-val{font-size:20px;font-weight:300;color:white;letter-spacing:-0.5px;}
    .hero-stat-lbl{font-size:10px;color:rgba(255,255,255,0.6);margin-top:1px;}
    .row2{display:grid;grid-template-columns:340px 1fr;gap:14px;flex:1;min-height:0;}
    .card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:18px;overflow:hidden;box-shadow:var(--sh);animation:fu 0.35s ease 0.1s both;display:flex;flex-direction:column;}
    .card-head{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--sep2);flex-shrink:0;}
    .card-title{font-size:14px;font-weight:600;color:var(--label);}
    .card-body{padding:16px;flex:1;overflow-y:auto;}
    .card-body::-webkit-scrollbar{width:0;}
    .field-row{margin-bottom:14px;}
    .field-lbl{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--label3);margin-bottom:4px;}
    .field-val{font-size:14px;color:var(--label);font-weight:500;}
    .field-input{width:100%;padding:8px 12px;background:var(--fill3);border:1px solid var(--sep);border-radius:10px;font-size:14px;color:var(--label);outline:none;transition:all 0.2s;}
    .field-input:focus{background:white;border-color:var(--blue);box-shadow:0 0 0 3px rgba(0,118,227,0.1);}
    .ios-btn{display:inline-flex;align-items:center;gap:6px;background:var(--blue);color:white;border:none;padding:8px 16px;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;box-shadow:0 4px 12px rgba(0,118,227,0.28);transition:all 0.2s;text-decoration:none;}
    .ios-btn:hover{background:var(--mid);}
    .ios-btn.ghost{background:var(--fill3);color:var(--label);box-shadow:none;border:1px solid var(--sep);}
    .tbl-wrap{overflow-y:auto;flex:1;}
    .tbl{width:100%;border-collapse:collapse;}
    .tbl thead{position:sticky;top:0;z-index:2;background:rgba(255,255,255,0.95);}
    .tbl th{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--label3);padding:10px 14px;text-align:left;border-bottom:1px solid var(--sep2);}
    .tbl td{padding:10px 14px;font-size:13px;color:var(--label);border-bottom:1px solid var(--sep2);}
    .tbl tr:last-child td{border-bottom:none;}
    .tbl tr:hover td{background:var(--fill3);}
    .bdg{display:inline-flex;align-items:center;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:600;}
    .bdg.A{background:rgba(52,199,89,0.12);color:#1EA851}
    .alerta-exito{background:rgba(52,199,89,0.1);border:1px solid rgba(52,199,89,0.3);border-radius:12px;padding:10px 16px;font-size:13px;font-weight:600;color:#1EA851;}
    .empty{padding:40px;text-align:center;color:var(--label3);}
    @@media(max-width:1024px){.row2{grid-template-columns:1fr!important;}}
    @@media(max-width:700px){
        .hero{flex-direction:column!important;align-items:flex-start!important;}
        .hero-stats{margin-left:0!important;margin-top:10px!important;}
        .row2{grid-template-columns:1fr!important;}
        .tbl-wrap{overflow-x:auto!important;}
        .tbl{min-width:500px!important;}
    }
</style>
}

@if (TempData["Exito"] != null) { <div class="alerta-exito">@TempData["Exito"]</div> }

<!-- Hero -->
<div class="hero">
    <div class="hero-av">@(((cli.Nombre as string ?? "").Length >= 1 ? (cli.Nombre as string)[0].ToString() : "") + ((cli.Apellido as string ?? "").Length >= 1 ? (cli.Apellido as string)[0].ToString() : ""))</div>
    <div class="hero-info">
        <h2>@cli.Nombre @cli.Apellido</h2>
        <p>CC @cli.Documento · @cli.Celular</p>
    </div>
    <div class="hero-stats">
        <div class="hero-stat"><div class="hero-stat-val">@totalC</div><div class="hero-stat-lbl">Compras</div></div>
        <div class="hero-stat"><div class="hero-stat-val">$@string.Format("{0:N0}", valorT)</div><div class="hero-stat-lbl">Valor total</div></div>
    </div>
</div>

<div class="row2">
    <!-- Panel editar -->
    <div class="card">
        <div class="card-head"><span class="card-title">Editar información</span></div>
        <div class="card-body">
            <form action="/Clientes/Editar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idCliente" value="@cli.Id"/>
                <div class="field-row"><div class="field-lbl">Nombre</div><input class="field-input" type="text" name="nombre" value="@cli.Nombre"/></div>
                <div class="field-row"><div class="field-lbl">Apellido</div><input class="field-input" type="text" name="apellido" value="@cli.Apellido"/></div>
                <div class="field-row"><div class="field-lbl">Documento</div><input class="field-input" type="text" name="documento" value="@cli.Documento"/></div>
                <div class="field-row"><div class="field-lbl">Celular</div><input class="field-input" type="text" name="celular" value="@cli.Celular"/></div>
                <div class="field-row"><div class="field-lbl">Correo</div><input class="field-input" type="email" name="correo" value="@cli.Correo"/></div>
                <div class="field-row"><div class="field-lbl">Dirección</div><input class="field-input" type="text" name="direccion" value="@cli.Direccion"/></div>
                <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:6px">
                    <a href="/Clientes" class="ios-btn ghost">Volver</a>
                    <button type="submit" class="ios-btn">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Historial compras -->
    <div class="card">
        <div class="card-head"><span class="card-title">Historial de compras</span><span style="background:rgba(0,118,227,0.1);color:var(--blue);font-size:12px;font-weight:700;padding:3px 10px;border-radius:20px">@totalC</span></div>
        @if (compras.Count > 0) {
            <div class="tbl-wrap">
                <table class="tbl">
                    <thead><tr><th>Apto</th><th>Torre</th><th>Proyecto</th><th>Asesor</th><th>Lista</th><th>Precio</th><th>Fecha</th><th>Estado</th></tr></thead>
                    <tbody>
                    @foreach (var co in compras) {
                        <tr>
                            <td style="font-weight:600">@co.Apto</td>
                            <td>@co.Torre</td>
                            <td>@co.Proyecto</td>
                            <td style="color:var(--blue)">@co.Asesor</td>
                            <td style="text-align:center">@co.Lista</td>
                            <td style="font-weight:600;color:var(--azul)">$@string.Format("{0:N0}", co.PrecioVenta)</td>
                            <td style="color:var(--label2)">@co.FechaVenta</td>
                            <td><span class="bdg A">@co.Estado</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        } else {
            <div class="empty">Sin compras registradas</div>
        }
    </div>
</div>
