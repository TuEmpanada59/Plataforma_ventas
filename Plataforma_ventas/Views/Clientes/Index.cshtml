@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Londoño Gómez — Clientes";
    ViewBag.ActiveNav = "clientes";
    ViewBag.TbBread   = "Clientes";

    var nombre     = ViewBag.Nombre   as string ?? "Admin";
    var apellido   = ViewBag.Apellido as string ?? "";
    var proyActivo = ViewBag.ProyectoActivo as string ?? "Sin proyecto";
    var clientes   = ViewBag.Clientes as List<dynamic> ?? new List<dynamic>();
    int total      = ViewBag.TotalClientes != null ? (int)ViewBag.TotalClientes : 0;
    var iniciales = ((nombre.Length >= 1 ? nombre.Substring(0, 1) : "") + (apellido.Length >= 1 ? apellido.Substring(0, 1) : "")).ToUpper();
    ViewBag.Iniciales = iniciales;
}
@section Styles {
<style>
    @@keyframes fu{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    .card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:18px;overflow:hidden;box-shadow:var(--sh);animation:fu 0.35s ease both;}
    .card-head{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--sep2);flex-shrink:0;gap:8px;flex-wrap:wrap;}
    .card-title{font-size:15px;font-weight:600;color:var(--label);}
    .tbl-wrap{overflow-x:auto;}
    .tbl{width:100%;border-collapse:collapse;}
    .tbl thead{position:sticky;top:0;z-index:2;background:rgba(255,255,255,0.95);backdrop-filter:blur(10px);}
    .tbl th{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--label3);padding:10px 14px;text-align:left;border-bottom:1px solid var(--sep2);}
    .tbl td{padding:11px 14px;font-size:13px;color:var(--label);border-bottom:1px solid var(--sep2);}
    .tbl tr:last-child td{border-bottom:none;}
    .tbl tr:hover td{background:var(--fill3);}
    .tbl tbody tr{cursor:pointer;}
    .search-wrap{position:relative;max-width:240px;}
    .search-wrap input{width:100%;padding:7px 12px 7px 30px;background:var(--fill3);border:1px solid var(--sep);border-radius:10px;font-size:13px;color:var(--label);outline:none;}
    .search-wrap input:focus{background:white;border-color:var(--blue);}
    .search-ico{position:absolute;left:9px;top:50%;transform:translateY(-50%);font-size:12px;color:var(--label3);pointer-events:none;}
    .av-cli{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--azul),var(--celeste));display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:white;flex-shrink:0;}
    .empty{padding:60px;text-align:center;}
    .empty-ico{font-size:40px;opacity:0.3;margin-bottom:8px;}
    .empty-txt{font-size:15px;font-weight:600;color:var(--label2);}
    @@media(max-width:700px){.tbl{min-width:500px!important;}}
</style>
}

<div class="card">
    <div class="card-head">
        <span class="card-title">&#128100; Clientes registrados <span style="background:rgba(0,118,227,0.1);color:var(--blue);font-size:12px;font-weight:700;padding:3px 10px;border-radius:20px;margin-left:6px">@total</span></span>
        <div class="search-wrap"><span class="search-ico">&#128269;</span><input type="text" id="buscar" placeholder="Buscar nombre, documento, asesor..." oninput="filtrar()"/></div>
    </div>
    @if (clientes.Count > 0) {
        <div class="tbl-wrap">
            <table class="tbl" id="tablaClientes">
                <thead><tr><th></th><th>Nombre</th><th>Documento</th><th>Celular</th><th>Correo</th><th>Compras</th><th>Valor total</th><th>Asesor</th></tr></thead>
                <tbody>
                @foreach (var c in clientes) {
                    var ini = ((c.Nombre?.Length > 0 ? c.Nombre.Substring(0,1) : "") + (c.Apellido?.Length > 0 ? c.Apellido.Substring(0,1) : "")).ToUpper();
                    <tr onclick="window.location='/Clientes/Detalle/@c.Id'">
                        <td><div class="av-cli">@ini</div></td>
                        <td style="font-weight:600">@c.Nombre @c.Apellido</td>
                        <td style="color:var(--label2)">@c.Documento</td>
                        <td style="color:var(--label2)">@c.Celular</td>
                        <td style="color:var(--label2)">@c.Correo</td>
                        <td style="text-align:center;font-weight:600;color:var(--blue)">@c.TotalCompras</td>
                        <td style="font-weight:600;color:var(--azul)">$@string.Format("{0:N0}", c.ValorTotal)</td>
                        <td style="color:var(--label2)">@c.UltimoAsesor</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (ViewBag.TotalPages != null && (int)ViewBag.TotalPages > 1) {
            <div class="paginator" style="padding:12px 16px;">
                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++) {
                    <a href="?page=@i" class="page-btn @(i == (int)(ViewBag.Page ?? 1) ? "active" : "")">@i</a>
                }
            </div>
        }
    } else {
        <div class="empty">
            <div class="empty-ico">&#128100;</div>
            <div class="empty-txt">No hay clientes registrados a&#250;n</div>
        </div>
    }
</div>

@section Scripts {
<script>
    function filtrar(){
        const q=document.getElementById('buscar').value.toLowerCase();
        document.querySelectorAll('#tablaClientes tbody tr').forEach(tr=>{
            tr.style.display=tr.innerText.toLowerCase().includes(q)?'':'none';
        });
    }
</script>
}
