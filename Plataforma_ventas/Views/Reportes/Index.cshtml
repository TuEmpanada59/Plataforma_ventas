<!-- ══════════ PESTAÑA: DASHBOARD ══════════ -->
<div id="paneDashboard">

<!-- INFORME DEL DÍA -->
<div class="hoy-banner">
    <div class="hoy-left">
        <h2>Informe del día</h2>
        <p>@System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(ahoraCol.ToString("dddd, dd 'de' MMMM 'de' yyyy", esCO)) · @proyActivo</p>
    </div>
    <div class="hoy-stats">
        <div class="hoy-stat"><div class="hoy-stat-num">@ventasHoy</div><div class="hoy-stat-lbl">Ventas hoy</div></div>
        <div class="hoy-stat"><div class="hoy-stat-num">$@string.Format("{0:N0}", valorHoy)</div><div class="hoy-stat-lbl">Valor vendido hoy</div></div>
        <div class="hoy-stat"><div class="hoy-stat-num">@vendidos</div><div class="hoy-stat-lbl">Total vendidos</div></div>
        <div class="hoy-stat"><div class="hoy-stat-num">@disponibles</div><div class="hoy-stat-lbl">Disponibles</div></div>
        <div class="hoy-stat"><div class="hoy-stat-num">@string.Format("{0:P0}", total > 0 ? (double)vendidos/total : 0)</div><div class="hoy-stat-lbl">% Avance</div></div>
    </div>
</div>

<!-- KPIs -->
<div class="kpi-row">
    <div class="kpi k1"><div class="kpi-top"><div class="kpi-ico">@Iconos.Edificio("#0076E3", 17)</div><span class="kpi-tag">Total</span></div><div class="kpi-num">@total</div><div class="kpi-lbl">Inmuebles</div></div>
    <div class="kpi k2"><div class="kpi-top"><div class="kpi-ico">@Iconos.Check("#1EA851", 17)</div><span class="kpi-tag">@pctD%</span></div><div class="kpi-num">@disponibles</div><div class="kpi-lbl">Disponibles</div></div>
    <div class="kpi k3"><div class="kpi-top"><div class="kpi-ico">@Iconos.Llave("#E63946", 17)</div><span class="kpi-tag">@pctV%</span></div><div class="kpi-num">@vendidos</div><div class="kpi-lbl">Vendidos</div></div>
    <div class="kpi k4"><div class="kpi-top"><div class="kpi-ico">@Iconos.Candado("#CC7700", 17)</div><span class="kpi-tag">@pctR%</span></div><div class="kpi-num">@reservados</div><div class="kpi-lbl">Reservados</div></div>
    <div class="kpi k5"><div class="kpi-top"><div class="kpi-ico">@Iconos.Dolar("#1EA851", 17)</div><span class="kpi-tag">Total</span></div><div class="kpi-num">$@string.Format("{0:N0}", valorTotal)</div><div class="kpi-lbl">Valor vendido</div></div>
</div>

<!-- PROGRESO + DESTINOS -->
<div class="dos-col">
    <div class="card">
        <div class="card-head"><span class="card-title" style="display:inline-flex;align-items:center;gap:8px">@Iconos.Grafico("#0076E3", 17) Progreso del proyecto</span></div>
        <div class="card-body">
            <div class="prog-row"><div class="prog-meta"><span class="prog-name">Vendidos</span><span class="prog-val" style="color:var(--rojo)">@vendidos / @total</span></div><div class="prog-track"><div class="prog-fill" style="width:@(pctV)%;background:linear-gradient(90deg,var(--rojo),#FF6370)"></div></div></div>
            <div class="prog-row"><div class="prog-meta"><span class="prog-name">Disponibles</span><span class="prog-val" style="color:#1EA851">@disponibles / @total</span></div><div class="prog-track"><div class="prog-fill" style="width:@(pctD)%;background:linear-gradient(90deg,#1EA851,#34C759)"></div></div></div>
            <div class="prog-row"><div class="prog-meta"><span class="prog-name">Reservados</span><span class="prog-val" style="color:#CC7700">@reservados / @total</span></div><div class="prog-track"><div class="prog-fill" style="width:@(pctR)%;background:linear-gradient(90deg,#CC7700,#FF9500)"></div></div></div>
            <div class="prog-row"><div class="prog-meta"><span class="prog-name">En proceso</span><span class="prog-val" style="color:#5A5AC8">@enProceso / @total</span></div><div class="prog-track"><div class="prog-fill" style="width:@(pctP)%;background:linear-gradient(90deg,#5A5AC8,#7878E0)"></div></div></div>
        </div>
    </div>

    <div class="card">
        <div class="card-head"><span class="card-title" style="display:inline-flex;align-items:center;gap:8px">@Iconos.Mapa("#1EA851", 17) Destino de ventas</span></div>
        @if (destinos.Count > 0) {
            <div class="destino-list">
                @{ int maxDest = destinos.Count > 0 ? (int)destinos[0].Total : 1; }
                @foreach (var d in destinos) {
                    var pct = maxDest > 0 ? (double)(int)d.Total / maxDest * 100 : 0;
                    var colores = new[]{ "#0076e3","#1EA851","#FF9500","#5A5AC8" };
                    var ci = destinos.IndexOf(d) % 4;
                    <div class="destino-row">
                        <div class="destino-lbl">@d.Destino</div>
                        <div class="destino-bar-wrap"><div class="destino-bar" style="width:@pct%;background:@colores[ci]"></div></div>
                        <div class="destino-cnt">@d.Total</div>
                    </div>
                }
            </div>
        } else {
            <div class="empty">Sin datos de destino</div>
        }
    </div>
</div>

<!-- TIPOLOGÍAS -->
<div class="card">
    <div class="card-head">
        <span class="card-title" style="display:inline-flex;align-items:center;gap:8px">@Iconos.Etiqueta("#0076E3", 17) Ventas por tipología</span>
        <div style="display:flex;gap:6px;flex-wrap:wrap;" id="tipoFiltros">
            <span class="tipo-chip active" onclick="filtrarTipo('todos',this)">Todas</span>
            @foreach (var t in tipologias) {
                <span class="tipo-chip" onclick="filtrarTipo('@t.Tipo',this)">@t.Tipo <strong style="margin-left:4px">@t.Vendidos</strong></span>
            }
        </div>
    </div>
    <div class="card-body">
        <div style="overflow-x:auto">
            <table class="tbl" id="tblTipo">
                <thead><tr><th>Tipo</th><th>Total</th><th>Vendidos</th><th>Disponibles</th><th>Reservados</th><th>% Vendido</th></tr></thead>
                <tbody>
                @foreach (var t in tipologias) {
                    double pctTipo = t.Total > 0 ? Math.Round((double)t.Vendidos / t.Total * 100, 1) : 0;
                    <tr data-tipo="@t.Tipo">
                        <td style="font-weight:600">@t.Tipo</td>
                        <td>@t.Total</td>
                        <td style="color:var(--rojo);font-weight:600">@t.Vendidos</td>
                        <td style="color:#1EA851">@t.Disponibles</td>
                        <td style="color:#CC7700">@t.Reservados</td>
                        <td>
                            <div style="display:flex;align-items:center;gap:8px;">
                                <div style="flex:1;height:6px;background:var(--fill3);border-radius:20px;overflow:hidden;"><div style="width:@pctTipo%;height:100%;background:var(--rojo);border-radius:20px;"></div></div>
                                <span style="font-size:11px;font-weight:600;color:var(--rojo)">@pctTipo%</span>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MAPA DE VENTAS -->
<div class="card">
    <div class="card-head">
        <span class="card-title" style="display:inline-flex;align-items:center;gap:8px">@Iconos.Edificio("#0076E3", 17) Mapa de inmuebles</span>
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <div style="display:flex;gap:10px;font-size:11px;">
                <span style="display:flex;align-items:center;gap:4px;"><span style="width:8px;height:8px;border-radius:50%;background:#1EA851;display:inline-block;"></span>Disponible</span>
                <span style="display:flex;align-items:center;gap:4px;"><span style="width:8px;height:8px;border-radius:50%;background:var(--rojo);display:inline-block;"></span>Vendido</span>
                <span style="display:flex;align-items:center;gap:4px;"><span style="width:8px;height:8px;border-radius:50%;background:#CC7700;display:inline-block;"></span>Reservado</span>
                <span style="display:flex;align-items:center;gap:4px;"><span style="width:8px;height:8px;border-radius:50%;background:#5A5AC8;display:inline-block;"></span>En proceso</span>
            </div>
            <a href="/Reportes/GenerarMapa" class="ios-btn azul">Excel</a>
            <a href="/Reportes/ReporteAsesores" class="ios-btn verde">Asesores</a>
            <a href="/Reportes/ReportePDF" class="ios-btn" style="background:var(--rojo)">PDF técnico</a>
        </div>
    </div>
    @if (mapa.Count > 0) {
        <div class="mapa-wrap">
            @foreach (var m in mapa) {
                var clsE = m.Estado == "DISPONIBLE" ? "D" : m.Estado == "VENDIDO" ? "V" : m.Estado == "RESERVADO" ? "R" : "P";
                var colE = m.Estado == "DISPONIBLE" ? "#1EA851" : m.Estado == "VENDIDO" ? "var(--rojo)" : m.Estado == "RESERVADO" ? "#CC7700" : "#5A5AC8";
                <div class="mapa-row">
                    <div class="mapa-estado" style="background:@colE"></div>
                    <div class="mapa-apto">@m.Apto</div>
                    <div class="mapa-tipo">@m.Tipo</div>
                    <div class="mapa-area">@m.Metros m²</div>
                    <div class="mapa-torre">@m.Torre</div>
                    <span class="mapa-bdg mapa-@clsE">@m.Estado</span>
                </div>
            }
        </div>
    } else {
        <div class="empty">No hay inmuebles en este proyecto</div>
    }
</div>

<!-- TABLA VENTAS POR ASESOR -->
<div class="card">
    <div class="card-head">
        <span class="card-title" style="display:inline-flex;align-items:center;gap:8px">@Iconos.Lista("#0076E3", 17) Detalle de ventas</span>
        <div style="display:flex;align-items:center;gap:8px;">
            <span style="background:rgba(0,118,227,0.1);color:var(--blue);font-size:12px;font-weight:700;padding:3px 10px;border-radius:20px">@ventas.Count ventas</span>
            <div class="search-wrap"><span class="search-ico"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg></span><input type="text" id="buscar" placeholder="Buscar..." oninput="filtrar()"/></div>
        </div>
    </div>
    @if (ventas.Count > 0) {
        <div class="tbl-wrap">
            <table class="tbl" id="tablaVentas">
                <thead><tr><th>Asesor</th><th>Apto</th><th>Torre</th><th>Tipo</th><th>Área m²</th><th>Cliente</th><th>Destino</th><th>Lista</th><th>Precio venta</th><th>Fecha y hora</th></tr></thead>
                <tbody>
                @{
                    string asesorActual = "";
                    long totalAsesor = 0;
                    int contAsesor = 0;
                }
                @foreach (var v in ventas) {
                    if (v.Asesor != asesorActual) {
                        if (asesorActual != "") {
                            <tr class="asesor-sep">
                                <td colspan="8" style="text-align:right">Subtotal @asesorActual (@contAsesor ventas)</td>
                                <td style="color:var(--azul);font-weight:700">$@string.Format("{0:N0}", totalAsesor)</td>
                                <td></td>
                            </tr>
                        }
                        asesorActual = v.Asesor;
                        totalAsesor = 0;
                        contAsesor = 0;
                    }
                    totalAsesor += v.PrecioVenta;
                    contAsesor++;
                    <tr>
                        <td style="font-weight:600;color:var(--blue)">@v.Asesor</td>
                        <td style="font-weight:600">@v.Apto</td>
                        <td>@v.Torre</td>
                        <td>@v.Tipo</td>
                        <td style="color:var(--label2)">@v.Metros m²</td>
                        <td>@v.Cliente</td>
                        <td>
                            @{
                                var dest = v.Destino as string ?? "—";
                                var destCol = dest == "Vivienda" ? "rgba(0,118,227,0.08);color:var(--blue)" :
                                              dest == "Inversión para reventa" ? "rgba(52,199,89,0.1);color:#1EA851" :
                                              dest == "Inversión para arriendo" ? "rgba(255,149,0,0.1);color:#CC7700" :
                                              dest == "Cesión de derechos" ? "rgba(90,90,200,0.1);color:#5A5AC8" :
                                              "rgba(120,120,128,0.08);color:var(--label3)";
                            }
                            <div style="display:inline-flex;align-items:center;padding:4px 10px;border-radius:20px;background:@destCol;font-size:11px;font-weight:600;white-space:nowrap;">@dest</div>
                        </td>
                        <td style="text-align:center">@v.Lista</td>
                        <td style="font-weight:600;color:var(--azul)">$@string.Format("{0:N0}", v.PrecioVenta)</td>
                        <td style="color:var(--label2);font-size:12px">@v.FechaVenta</td>
                    </tr>
                }
                @if (asesorActual != "") {
                    <tr class="asesor-sep">
                        <td colspan="8" style="text-align:right">Subtotal @asesorActual (@contAsesor ventas)</td>
                        <td style="color:var(--azul);font-weight:700">$@string.Format("{0:N0}", totalAsesor)</td>
                        <td></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    } else {
        <div class="empty">No hay ventas registradas en @proyActivo</div>
    }
</div>

</div><!-- /paneDashboard -->

<!-- ══════════ PESTAÑA: HORAS PICO Y ÁREA ══════════ -->
@{
    var vha = ViewBag.VentasHoraArea as List<dynamic> ?? new List<dynamic>();
    var horas = vha.Select(x => (int)x.Hora).Distinct().OrderBy(h => h).ToList();
    var areas = vha.Select(x => (string)x.Area).Distinct()
                   .OrderBy(a => { int n; return int.TryParse(new string(((string)a).Where(char.IsDigit).ToArray()), out n) ? n : int.MaxValue; })
                   .ThenBy(a => (string)a).ToList();
    var palette = new[]{ "#0076E3","#1EA851","#FF9500","#5A5AC8","#E63946","#00A6A6","#B5179E","#2A9D8F","#F4A261","#8338EC","#3A86FF","#FB5607" };
    var datasets = areas.Select((a, i) => new {
        label = a + " m²",
        data = horas.Select(h => vha.Where(x => (int)x.Hora == h && (string)x.Area == a).Sum(x => (int)x.Num)).ToList(),
        valor = horas.Select(h => vha.Where(x => (int)x.Hora == h && (string)x.Area == a).Sum(x => (long)x.Valor)).ToList(),
        backgroundColor = palette[i % palette.Length]
    }).ToList();
    string FmtHora(int h) => $"{(h % 12 == 0 ? 12 : h % 12)}:00 {(h < 12 ? "a. m." : "p. m.")}";
    var labels = horas.Select(FmtHora).ToList();
    var chartJson = System.Text.Json.JsonSerializer.Serialize(new { labels, datasets });

    int horaPico    = ViewBag.HoraPico     != null ? (int)ViewBag.HoraPico     : -1;
    int horaPicoNum = ViewBag.HoraPicoNum  != null ? (int)ViewBag.HoraPicoNum  : 0;
    long horaPicoVal= ViewBag.HoraPicoValor!= null ? (long)ViewBag.HoraPicoValor: 0;
    string areaTop  = ViewBag.AreaTop as string ?? "—";
    int areaTopNum  = ViewBag.AreaTopNum   != null ? (int)ViewBag.AreaTopNum   : 0;
    string comboArea= ViewBag.ComboArea as string ?? "—";
    int comboHora   = ViewBag.ComboHora    != null ? (int)ViewBag.ComboHora    : -1;
    int comboNum    = ViewBag.ComboNum     != null ? (int)ViewBag.ComboNum     : 0;
}
<div id="panePico" style="display:none;">
    @if (vha.Count > 0)
    {
        <div class="pico-kpis">
            <div class="pico-kpi">
                <div class="pk-lbl">@Iconos.Reloj("#0076E3", 15) Hora pico de ventas</div>
                <div class="pk-num">@FmtHora(horaPico)</div>
                <div class="pk-sub">@horaPicoNum @(horaPicoNum == 1 ? "venta" : "ventas") · $@string.Format("{0:N0}", horaPicoVal)</div>
            </div>
            <div class="pico-kpi">
                <div class="pk-lbl">@Iconos.Etiqueta("#1EA851", 15) Área que más se vende</div>
                <div class="pk-num">@areaTop m²</div>
                <div class="pk-sub">@areaTopNum @(areaTopNum == 1 ? "venta" : "ventas") en total</div>
            </div>
            <div class="pico-kpi">
                <div class="pk-lbl">@Iconos.Grafico("#FF9500", 15) Mejor combinación</div>
                <div class="pk-num">@comboArea m² · @FmtHora(comboHora)</div>
                <div class="pk-sub">@comboNum @(comboNum == 1 ? "venta" : "ventas") en esa franja</div>
            </div>
        </div>

        <div class="card">
            <div class="card-head">
                <span class="card-title" style="display:inline-flex;align-items:center;gap:8px">@Iconos.Grafico("#0076E3", 17) Ventas por hora del día y área (m²)</span>
                <span style="font-size:12px;color:var(--label3)">@proyActivo · hora de Colombia</span>
            </div>
            <div class="card-body">
                <div class="chart-box"><canvas id="chartPico"></canvas></div>
                <p style="font-size:11px;color:var(--label3);margin-top:10px;text-align:center;">
                    Cada barra es una hora del día; los colores muestran el área (m²) de los inmuebles vendidos. Pasa el cursor para ver el valor.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card"><div class="empty">Aún no hay ventas registradas para analizar horas pico en @proyActivo.</div></div>
    }
</div>

@section Scripts {
<script>
    function filtrar(){
        const q=document.getElementById('buscar').value.toLowerCase();
        document.querySelectorAll('#tablaVentas tbody tr:not(.asesor-sep)').forEach(tr=>{
            tr.style.display=tr.innerText.toLowerCase().includes(q)?'':'none';
        });
    }
    function filtrarTipo(tipo, btn){
        document.querySelectorAll('.tipo-chip').forEach(x=>x.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('#tblTipo tbody tr').forEach(tr=>{
            tr.style.display=(tipo==='todos'||tr.dataset.tipo===tipo)?'':'none';
        });
    }

    /* ── Pestañas del dashboard de reportes ── */
    var _picoRender = false;
    function verPestana(cual){
        var esPico = cual === 'pico';
        document.getElementById('paneDashboard').style.display = esPico ? 'none' : '';
        document.getElementById('panePico').style.display = esPico ? '' : 'none';
        document.getElementById('tabDashboard').classList.toggle('rep-tab-on', !esPico);
        document.getElementById('tabPico').classList.toggle('rep-tab-on', esPico);
        if (esPico && !_picoRender) { _picoRender = true; dibujarPico(); }
    }

    /* ── Gráfica de horas pico por área (barras apiladas) ── */
    var CHART_PICO = @Html.Raw(chartJson);
    function dibujarPico(){
        var cv = document.getElementById('chartPico');
        if (!cv || typeof Chart === 'undefined') return;
        new Chart(cv.getContext('2d'), {
            type: 'bar',
            data: {
                labels: CHART_PICO.labels,
                datasets: CHART_PICO.datasets.map(function(d){
                    return { label: d.label, data: d.data, valor: d.valor,
                             backgroundColor: d.backgroundColor, borderRadius: 5, borderSkipped: false };
                })
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                scales: {
                    x: { stacked: true, grid: { display: false }, title: { display: true, text: 'Hora del día' } },
                    y: { stacked: true, beginAtZero: true, ticks: { precision: 0 }, title: { display: true, text: 'N.º de ventas' } }
                },
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12, padding: 12, font: { size: 11 } } },
                    tooltip: {
                        callbacks: {
                            label: function(ctx){
                                var n = ctx.parsed.y || 0;
                                if (n === 0) return null;
                                var ds = ctx.dataset;
                                var val = (ds.valor && ds.valor[ctx.dataIndex]) ? ds.valor[ctx.dataIndex] : 0;
                                var valFmt = '$' + Number(val).toLocaleString('es-CO');
                                return ds.label + ': ' + n + (n === 1 ? ' venta' : ' ventas') + ' · ' + valFmt;
                            }
                        }
                    }
                }
            }
        });
    }
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
}
