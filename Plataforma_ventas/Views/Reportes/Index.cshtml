@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Londoño Gómez — Reportes";
    ViewBag.ActiveNav = "reportes";
    ViewBag.TbBread   = "Reportes";

    var proyActivo = ViewBag.ProyectoActivo as string ?? "Sin proyecto";
    int total      = ViewBag.Total       != null ? (int)ViewBag.Total       : 0;
    int disponibles= ViewBag.Disponibles != null ? (int)ViewBag.Disponibles : 0;
    int vendidos   = ViewBag.Vendidos    != null ? (int)ViewBag.Vendidos    : 0;
    int reservados = ViewBag.Reservados  != null ? (int)ViewBag.Reservados  : 0;
    int enProceso  = ViewBag.EnProceso   != null ? (int)ViewBag.EnProceso   : 0;
    long valorTotal= ViewBag.ValorTotal  != null ? (long)ViewBag.ValorTotal : 0;
    int ventasHoy  = ViewBag.VentasHoy   != null ? (int)ViewBag.VentasHoy   : 0;
    long valorHoy  = ViewBag.ValorHoy    != null ? (long)ViewBag.ValorHoy   : 0;
    var asesores   = ViewBag.Asesores    as List<dynamic> ?? new List<dynamic>();
    var ventas     = ViewBag.Ventas      as List<dynamic> ?? new List<dynamic>();
    var tipologias = ViewBag.Tipologias  as List<dynamic> ?? new List<dynamic>();
    var destinos   = ViewBag.Destinos    as List<dynamic> ?? new List<dynamic>();
    var mapa       = ViewBag.Mapa        as List<dynamic> ?? new List<dynamic>();
    DateTime ahoraCol;
    try {
        ahoraCol = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, TimeZoneInfo.FindSystemTimeZoneById("America/Bogota"));
    } catch {
        try { ahoraCol = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, TimeZoneInfo.FindSystemTimeZoneById("SA Pacific Standard Time")); }
        catch { ahoraCol = DateTime.UtcNow.AddHours(-5); }
    }
    var esCO       = new System.Globalization.CultureInfo("es-CO");
    double pctV    = total > 0 ? Math.Round((double)vendidos    / total * 100, 1) : 0;
    double pctD    = total > 0 ? Math.Round((double)disponibles / total * 100, 1) : 0;
    double pctR    = total > 0 ? Math.Round((double)reservados  / total * 100, 1) : 0;
    double pctP    = total > 0 ? Math.Round((double)enProceso   / total * 100, 1) : 0;
}
@section Styles {
<style>
    @@keyframes fu{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    .kpi-row{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;}
    .kpi{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:18px;padding:14px;box-shadow:var(--sh);animation:fu 0.35s ease both;}
    .kpi-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;}
    .kpi-ico{width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:15px;}
    .kpi-tag{font-size:10px;font-weight:600;padding:2px 7px;border-radius:20px;}
    .kpi-num{font-size:26px;font-weight:300;letter-spacing:-1.5px;line-height:1;margin-bottom:3px;}
    .kpi-lbl{font-size:11px;color:var(--label2);}
    .kpi.k1 .kpi-ico{background:rgba(0,118,227,0.1)}.kpi.k1 .kpi-tag{background:rgba(0,118,227,0.1);color:var(--blue)}.kpi.k1 .kpi-num{color:var(--azul)}
    .kpi.k2 .kpi-ico{background:rgba(52,199,89,0.1)}.kpi.k2 .kpi-tag{background:rgba(52,199,89,0.1);color:#1EA851}.kpi.k2 .kpi-num{color:#1EA851}
    .kpi.k3 .kpi-ico{background:rgba(230,57,70,0.1)}.kpi.k3 .kpi-tag{background:rgba(230,57,70,0.1);color:var(--rojo)}.kpi.k3 .kpi-num{color:var(--rojo)}
    .kpi.k4 .kpi-ico{background:rgba(255,149,0,0.1)}.kpi.k4 .kpi-tag{background:rgba(255,149,0,0.1);color:#CC7700}.kpi.k4 .kpi-num{color:#CC7700}
    .kpi.k5 .kpi-ico{background:rgba(52,199,89,0.1)}.kpi.k5 .kpi-tag{background:rgba(52,199,89,0.1);color:#1EA851}.kpi.k5 .kpi-num{color:#1EA851;font-size:15px;}
    .card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:18px;overflow:hidden;box-shadow:var(--sh);animation:fu 0.35s ease 0.15s both;display:flex;flex-direction:column;}
    .card-head{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--sep2);flex-shrink:0;}
    .card-title{font-size:15px;font-weight:600;color:var(--label);}
    .card-body{padding:16px;}
    .tres-col{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;}
    .dos-col{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
    .prog-row{margin-bottom:12px;}
    .prog-meta{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px;}
    .prog-name{font-size:13px;color:var(--label);font-weight:500;}
    .prog-val{font-size:12px;font-weight:600;}
    .prog-track{height:7px;background:var(--fill3);border-radius:50px;overflow:hidden;}
    .prog-fill{height:100%;border-radius:50px;transition:width 1s ease;}
    .tbl-wrap{overflow-x:auto;}
    .tbl{width:100%;border-collapse:collapse;}
    .tbl thead{position:sticky;top:0;z-index:2;background:rgba(255,255,255,0.95);backdrop-filter:blur(10px);}
    .tbl th{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--label3);padding:9px 14px;text-align:left;border-bottom:1px solid var(--sep2);}
    .tbl td{padding:9px 14px;font-size:13px;color:var(--label);border-bottom:1px solid var(--sep2);}
    .tbl tr:last-child td{border-bottom:none;}
    .tbl tr:hover td{background:var(--fill3);}
    .hoy-banner{background:linear-gradient(135deg,var(--azul),var(--blue));border-radius:18px;padding:18px 22px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 8px 24px rgba(0,118,227,0.25);animation:fu 0.3s ease both;flex-wrap:wrap;gap:16px;}
    .hoy-left h2{font-size:18px;font-weight:700;color:white;letter-spacing:-0.4px;margin-bottom:3px;}
    .hoy-left p{font-size:13px;color:rgba(255,255,255,0.7);}
    .hoy-stats{display:flex;gap:20px;flex-wrap:wrap;}
    .hoy-stat{text-align:center;background:rgba(255,255,255,0.12);border-radius:12px;padding:10px 16px;}
    .hoy-stat-num{font-size:22px;font-weight:300;color:white;letter-spacing:-1px;white-space:nowrap;}
    .hoy-stat-lbl{font-size:10px;color:rgba(255,255,255,0.65);margin-top:1px;font-weight:500;}
    .mapa-wrap{display:flex;flex-direction:column;gap:4px;max-height:320px;overflow-y:auto;padding:14px;}
    .mapa-row{display:flex;align-items:center;gap:10px;padding:7px 10px;border-radius:10px;transition:background 0.15s;}
    .mapa-row:hover{background:var(--fill3);}
    .mapa-estado{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
    .mapa-apto{font-size:13px;font-weight:600;color:var(--label);min-width:60px;}
    .mapa-tipo{font-size:11px;color:var(--label3);min-width:40px;}
    .mapa-area{font-size:11px;color:var(--label2);min-width:60px;}
    .mapa-torre{font-size:11px;color:var(--label2);flex:1;}
    .mapa-bdg{font-size:10px;font-weight:600;padding:2px 8px;border-radius:20px;}
    .mapa-D{background:rgba(52,199,89,0.12);color:#1EA851}.mapa-V{background:rgba(230,57,70,0.12);color:var(--rojo)}
    .mapa-R{background:rgba(255,149,0,0.12);color:#CC7700}.mapa-P{background:rgba(90,90,200,0.12);color:#5A5AC8}
    .destino-list{padding:14px;display:flex;flex-direction:column;gap:8px;}
    .destino-row{display:flex;align-items:center;gap:10px;}
    .destino-bar-wrap{flex:1;height:8px;background:var(--fill3);border-radius:20px;overflow:hidden;}
    .destino-bar{height:100%;border-radius:20px;}
    .destino-lbl{font-size:12px;font-weight:500;color:var(--label);min-width:160px;}
    .destino-cnt{font-size:12px;font-weight:700;color:var(--label2);min-width:30px;text-align:right;}
    .ios-btn{display:inline-flex;align-items:center;gap:6px;color:white;border:none;padding:7px 14px;border-radius:10px;font-size:12px;font-weight:600;cursor:pointer;transition:all 0.2s;text-decoration:none;box-shadow:0 3px 10px rgba(0,118,227,0.2);}
    .ios-btn.azul{background:var(--blue);}.ios-btn.azul:hover{background:var(--mid);}
    .ios-btn.verde{background:#1EA851;}.ios-btn.verde:hover{background:#167A3D;}
    .asesor-row{display:flex;align-items:center;gap:12px;padding:10px 14px;border-bottom:1px solid var(--sep2);}
    .asesor-row:last-child{border-bottom:none;}
    .asesor-av{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--azul),var(--celeste));display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:white;flex-shrink:0;}
    .asesor-name{flex:1;font-size:13px;font-weight:600;color:var(--label);}
    .asesor-ventas{font-size:12px;color:var(--label3);}
    .asesor-valor{font-size:13px;font-weight:600;color:var(--azul);}
    .tipo-chip{display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border-radius:20px;font-size:12px;font-weight:600;cursor:pointer;border:2px solid var(--sep);background:white;transition:all 0.2s;}
    .tipo-chip.active{border-color:var(--blue);background:rgba(0,118,227,0.08);color:var(--blue);}
    .search-wrap{position:relative;max-width:200px;}
    .search-wrap input{width:100%;padding:6px 12px 6px 28px;background:var(--fill3);border:1px solid var(--sep);border-radius:9px;font-size:13px;color:var(--label);outline:none;}
    .search-wrap input:focus{background:white;border-color:var(--blue);}
    .search-ico{position:absolute;left:8px;top:50%;transform:translateY(-50%);font-size:12px;color:var(--label3);pointer-events:none;}
    .asesor-sep{background:rgba(0,118,227,0.05);border-top:2px solid rgba(0,118,227,0.15);}
    .asesor-sep td{font-size:12px;font-weight:700;color:var(--blue);padding:7px 14px;}
    .empty{padding:30px;text-align:center;color:var(--label3);font-size:13px;}
    .rep-tab{padding:7px 18px;border-radius:10px;font-size:13px;font-weight:600;color:var(--label2);background:transparent;border:none;cursor:pointer;transition:all 0.2s;font-family:inherit;}
    .rep-tab.rep-tab-on{background:white;color:var(--label);box-shadow:0 1px 4px rgba(0,0,0,0.1);}
    .pico-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:14px;}
    .pico-kpi{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:16px;padding:16px;box-shadow:var(--sh);animation:fu 0.35s ease both;}
    .pico-kpi .pk-lbl{font-size:11px;color:var(--label2);display:flex;align-items:center;gap:7px;margin-bottom:8px;}
    .pico-kpi .pk-num{font-size:24px;font-weight:300;letter-spacing:-1px;line-height:1.1;color:var(--label);}
    .pico-kpi .pk-sub{font-size:12px;color:var(--label3);margin-top:4px;}
    .chart-box{position:relative;height:420px;width:100%;}
    @@media(max-width:1024px){.pico-kpis{grid-template-columns:1fr!important;}}
    @@media(max-width:1200px){.kpi-row{grid-template-columns:repeat(3,1fr)!important;}.tres-col{grid-template-columns:1fr 1fr!important;}}
    @@media(max-width:1024px){.kpi-row{grid-template-columns:repeat(2,1fr)!important;}.tres-col,.dos-col{grid-template-columns:1fr!important;}}
    @@media(max-width:700px){
        .kpi-row{grid-template-columns:1fr 1fr!important;gap:8px!important;}
        .tres-col,.dos-col{grid-template-columns:1fr!important;}
        .tbl-wrap{overflow-x:auto!important;}
        .tbl{min-width:600px!important;}
        .hoy-banner{flex-direction:column!important;}
    }
</style>
}

