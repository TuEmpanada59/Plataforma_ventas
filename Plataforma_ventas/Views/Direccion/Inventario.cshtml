@{
    Layout = "~/Views/Shared/_DireccionLayout.cshtml";
    ViewData["Title"] = "Mercurio — Inventario";
    var inmuebles = ViewBag.Inmuebles as List<dynamic> ?? new List<dynamic>();
    var torres    = ViewBag.Torres as List<string> ?? new List<string>();
    string fTorre  = ViewBag.FiltroTorre  as string ?? "";
    string fEstado = ViewBag.FiltroEstado as string ?? "";
    int totalSinFiltro = ViewBag.TotalSinFiltro != null ? (int)ViewBag.TotalSinFiltro : 0;
    long valorFiltrado = ViewBag.ValorFiltrado != null ? (long)ViewBag.ValorFiltrado : 0;

    // Columnas que están vacías en todo el proyecto no se dibujan: una tabla con tres
    // columnas en blanco se lee peor que una tabla corta.
    bool hayTorre = ViewBag.HayTorre != null && (bool)ViewBag.HayTorre;
    bool hayEtapa = ViewBag.HayEtapa != null && (bool)ViewBag.HayEtapa;
    bool hayPiso  = ViewBag.HayPiso  != null && (bool)ViewBag.HayPiso;
    bool hayTipo  = ViewBag.HayTipo  != null && (bool)ViewBag.HayTipo;

    // Los filtros son enlaces, no formularios: navegar no es modificar, y así este
    // perfil no tiene un solo control que envíe datos.
    Func<string, string, string> liga = (t, e) =>
        "/Direccion/Inventario?torre=" + Uri.EscapeDataString(t) + "&estado=" + Uri.EscapeDataString(e);

    string rotulo = fEstado switch
    {
        "DISPONIBLE" => "disponibles",
        "VENDIDO"    => "vendidas",
        "RESERVADO"  => "reservadas",
        _            => "unidades",
    };
}
@section Styles {
<partial name="_Estilos" />
<style>
    /* La primera columna se queda fija al desplazar a lo ancho: sin eso, en un
       proyecto con muchas columnas uno pierde de vista qué unidad está leyendo. */
    .d-tabla td.u-apto,.d-tabla th.u-apto{position:sticky;left:0;background:white;z-index:1;font-weight:700;}
    .d-tabla tbody tr:hover td.u-apto{background:#F7FAFF;}
    .d-tabla tfoot td{padding:12px 14px;font-size:13px;font-weight:700;background:rgba(0,118,227,0.04);border-top:1px solid rgba(0,0,0,0.08);}
    .u-num{font-variant-numeric:tabular-nums;}
</style>
}

<div class="d-card">
    <div class="d-head">
        <span class="d-title">Inventario</span>
        <span class="d-nota">@inmuebles.Count de @totalSinFiltro unidades</span>
    </div>

    <div style="padding:14px 18px;border-bottom:1px solid rgba(0,0,0,0.05);display:flex;flex-direction:column;gap:10px">
        @if (torres.Count > 1)
        {
            <div class="d-filtros">
                <a href="@liga("", fEstado)" class="d-chip @(fTorre == "" ? "on" : "")">Todas las torres</a>
                @foreach (var t in torres)
                {
                    <a href="@liga(t, fEstado)" class="d-chip @(fTorre == t ? "on" : "")">@t</a>
                }
            </div>
        }
        <div class="d-filtros">
            <a href="@liga(fTorre, "")" class="d-chip @(fEstado == "" ? "on" : "")">Todos</a>
            <a href="@liga(fTorre, "DISPONIBLE")" class="d-chip @(fEstado == "DISPONIBLE" ? "on" : "")">Disponibles</a>
            <a href="@liga(fTorre, "VENDIDO")" class="d-chip @(fEstado == "VENDIDO" ? "on" : "")">Vendidas</a>
            <a href="@liga(fTorre, "RESERVADO")" class="d-chip @(fEstado == "RESERVADO" ? "on" : "")">Reservadas</a>
        </div>
    </div>

    @if (inmuebles.Count > 0)
    {
        <div class="d-tabla-wrap">
            <table class="d-tabla">
                <thead>
                    <tr>
                        <th class="u-apto">Unidad</th>
                        @if (hayTorre) { <th>Torre</th> }
                        @if (hayEtapa) { <th>Etapa</th> }
                        @if (hayPiso)  { <th class="d-der">Piso</th> }
                        @if (hayTipo)  { <th>Tipo</th> }
                        <th class="d-der">Área</th>
                        <th>Estado</th>
                        <th class="d-der">Lista</th>
                        <th class="d-der">Precio</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var i in inmuebles)
                {
                    string est = Plataforma_ventas.Controllers.DireccionController.EstadoVisible(i.Estado as string);
                    <tr>
                        <td class="u-apto">@i.Apto</td>
                        @if (hayTorre) { <td>@i.Torre</td> }
                        @if (hayEtapa) { <td style="color:var(--label2)">@i.Etapa</td> }
                        @if (hayPiso)  { <td class="d-der u-num">@i.Piso</td> }
                        @if (hayTipo)  { <td>@i.Tipo</td> }
                        <td class="d-der u-num">@i.Metros m²</td>
                        <td><span class="d-est @est">@est</span></td>
                        <td class="d-der u-num" style="color:var(--label2)">@i.Lista</td>
                        <td class="d-der u-num" style="font-weight:600">$@string.Format("{0:N0}", (long)i.Precio)</td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr>
                        <td class="u-apto">@inmuebles.Count @rotulo</td>
                        @{
                            // Las columnas intermedias se saltan con una sola celda: así el
                            // total queda alineado bajo la columna de precio.
                            int intermedias = (hayTorre ? 1 : 0) + (hayEtapa ? 1 : 0)
                                            + (hayPiso ? 1 : 0) + (hayTipo ? 1 : 0) + 3;
                        }
                        <td colspan="@intermedias"></td>
                        <td class="d-der u-num">$@string.Format("{0:N0}", valorFiltrado)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div style="padding:12px 18px" class="d-nota">
            En lo vendido y lo reservado el precio es el que se pactó. En lo disponible, el de la lista vigente para esa área.
        </div>
    }
    else
    {
        <div class="d-vacio">No hay unidades con ese filtro.</div>
    }
</div>
