@{
    string proyActivo = ViewBag.ProyectoActivo as string ?? "Sin proyecto";
    string nombre     = ViewBag.Nombre    as string ?? "";
    string apellido   = ViewBag.Apellido  as string ?? "";
    string iniciales  = ViewBag.Iniciales as string ?? ((nombre.Length >= 1 ? nombre.Substring(0,1) : "") + (apellido.Length >= 1 ? apellido.Substring(0,1) : "")).ToUpper();
    if (string.IsNullOrEmpty(iniciales)) iniciales = "?";
    var proyectos  = ViewBag.Proyectos as List<(int Id, string Nombre)> ?? new List<(int Id, string Nombre)>();
    string activeNav  = ViewBag.ActiveNav as string ?? "";
    string tbBread    = ViewBag.TbBread   as string ?? "Inicio";
    string rolSesion  = Context.Session.GetString("Rol") ?? "";
    string rolLabel   = rolSesion == "SuperAdministrador" ? "Super Admin" : "Administrador";
}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Lanzamientos - Londoño Gómez</title>
  <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true"/>
  <link rel="icon" href="~/favicon.ico" sizes="any"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="~/css/platform.css" asp-append-version="true"/>
  @RenderSection("Styles", required: false)
</head>
<body>
<div id="sbOverlay"></div>
<div class="app">
  <div class="sidebar" id="sidebar">
    <div class="sb-logo-area">
      <img src="~/Images/Logo azul 2.jpg" alt="Londoño Gómez" style="width:100%;max-height:56px;object-fit:contain;display:block;mix-blend-mode:multiply;"/>
    </div>

    <div class="sb-sec">Principal</div>
    <a class="nav-item @(activeNav=="dashboard"?"active":"")" href="/Dashboard">
      <div class="nav-ico"><img src="~/Images/icons/inicio.svg" width="18" height="18" alt=""/></div>Inicio
    </a>
    <a class="nav-item @(activeNav=="inmuebles"?"active":"")" href="/Inmuebles">
      <div class="nav-ico"><img src="~/Images/icons/proyectos.svg" width="18" height="18" alt=""/></div>Inmuebles
    </a>
    <a class="nav-item @(activeNav=="reservas"?"active":"")" href="/Inmuebles/Reservas">
      <div class="nav-ico"><img src="~/Images/icons/reservas.svg" width="18" height="18" alt=""/></div>Reservas
    </a>
    <a class="nav-item @(activeNav=="ventas"?"active":"")" href="/Ventas">
      <div class="nav-ico"><img src="~/Images/icons/ventas.svg" width="18" height="18" alt=""/></div>Ventas
    </a>
    <a class="nav-item @(activeNav=="clientes"?"active":"")" href="/Clientes">
      <div class="nav-ico"><img src="~/Images/icons/clientes.svg" width="18" height="18" alt=""/></div>Clientes
    </a>

    <div class="sb-sec">General</div>
    <a class="nav-item @(activeNav=="reportes"?"active":"")" href="/Reportes">
      <div class="nav-ico"><img src="~/Images/icons/reportes.svg" width="18" height="18" alt=""/></div>Reportes
    </a>
    <a class="nav-item @(activeNav=="carga"?"active":"")" href="/Carga/Index">
      <div class="nav-ico"><img src="~/Images/icons/cargar-excel.svg" width="18" height="18" alt=""/></div>Cargar Excel
    </a>
    <a class="nav-item @(activeNav=="usuarios"?"active":"")" href="/Usuarios">
      <div class="nav-ico"><img src="~/Images/icons/usuarios.svg" width="18" height="18" alt=""/></div>Usuarios
    </a>

    <div class="sb-footer">
      <div class="sb-av">@iniciales</div>
      <div>
        <div style="font-size:12px;font-weight:600">@nombre @apellido</div>
        <div style="font-size:10px;color:var(--label3)">@rolLabel</div>
      </div>
      <a class="sb-logout" href="/Account/Logout" title="Cerrar sesión">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
      </a>
    </div>
  </div>

  <div class="main">
    <div class="topbar">
      <div class="tb-left">
        <button class="hamburger" onclick="toggleSidebar()" aria-label="Menú"><span></span><span></span><span></span></button>
        <span class="tb-bread"><strong>@tbBread</strong></span>
      </div>
      <div class="tb-right">
        <div class="tb-proy">
          <button type="button" class="tb-chip" id="proyBtn" title="Cambiar proyecto">
            <span class="pulse"></span>@proyActivo<span class="tb-chip-caret">&#9660;</span>
          </button>
          <div class="proy-drop" id="proyDrop">
            @if (proyectos.Count > 0) {
              foreach (var p in proyectos) {
                <form asp-action="CambiarProyecto" asp-controller="Dashboard" method="post" style="margin:0">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="idProyecto" value="@p.Id"/>
                  <input type="hidden" name="nombreProyecto" value="@p.Nombre"/>
                  <button type="submit" class="proy-drop-item">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                    @p.Nombre
                  </button>
                </form>
              }
            } else {
              <div style="padding:12px 14px;font-size:13px;color:var(--label2)">No hay proyectos cargados</div>
            }
            <a href="/Carga/Index" class="proy-drop-link">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Cargar nuevo proyecto
            </a>
          </div>
        </div>
        <a class="tb-ibtn" href="/Account/Logout" title="Cerrar sesión">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="view">
      @RenderBody()
    </div>
  </div>
</div>

<!-- Session expiry warning banner -->
<div id="sessionBanner" class="session-banner" style="display:none">
  Tu sesión expira en <span id="sessionCountdown">2:00</span>.
  <button onclick="renewSession()">Renovar</button>
</div>

<script src="~/js/app.js"></script>
@RenderSection("Scripts", required: false)
<script>
// Session expiry countdown (session = 20 min = 1200s; warn at 2 min = 120s left)
(function(){
  var WARN_AT=120,total=1200,start=Date.now();
  var banner=document.getElementById('sessionBanner');
  var cd=document.getElementById('sessionCountdown');
  setInterval(function(){
    var elapsed=Math.floor((Date.now()-start)/1000);
    var left=total-elapsed;
    if(left<=WARN_AT&&left>0){
      banner.style.display='flex';
      var m=Math.floor(left/60),s=left%60;
      cd.textContent=m+':'+(s<10?'0':'')+s;
    }
    if(left<=0){banner.innerHTML='<span>Sesión expirada. <a href="/Account/Login" style="color:#fff;text-decoration:underline">Inicia sesión nuevamente</a></span>';}
  },1000);
  window.renewSession=function(){start=Date.now();banner.style.display='none';fetch('/Dashboard',{method:'GET'}).catch(function(){});};
})();
</script>
</body>
</html>
