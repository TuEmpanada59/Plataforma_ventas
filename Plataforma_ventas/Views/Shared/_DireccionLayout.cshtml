@*
    Armazón del rol Dirección.

    Usa el mismo esqueleto que el administrador y el asesor (barra lateral, barra
    superior, platform.css) para que la plataforma se sienta una sola. La diferencia
    está en lo que NO hay: ningún control que envíe datos, ni selector de proyecto, ni
    accesos a pantallas de gestión. Dirección consulta el lanzamiento que tiene asignado.
*@
@{
    string proyActivo = ViewBag.ProyectoActivo as string ?? "Sin proyecto";
    string nombre     = ViewBag.Nombre   as string ?? "";
    string apellido   = ViewBag.Apellido as string ?? "";
    string iniciales  = ((nombre.Length >= 1 ? nombre.Substring(0,1) : "") +
                         (apellido.Length >= 1 ? apellido.Substring(0,1) : "")).ToUpper();
    if (string.IsNullOrEmpty(iniciales)) iniciales = "D";
    string activeNav = ViewBag.ActiveNav as string ?? "";
    string tbBread   = ViewBag.TbBread   as string ?? "Resumen";
    bool sinProyecto = !(int.TryParse(Context.Session.GetString("ProyectoId"), out int pidLay) && pidLay > 0);
}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>@(ViewData["Title"] as string ?? "Mercurio — Dirección")</title>
  <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true"/>
  <link rel="icon" href="~/favicon.ico" sizes="any"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="~/css/platform.css" asp-append-version="true"/>
  <style>
    .sb-direccion{margin:14px 10px 4px;background:linear-gradient(145deg,var(--azul),var(--celeste));border-radius:16px;padding:14px;position:relative;overflow:hidden;}
    .sb-direccion::before{content:'';position:absolute;top:-20px;right:-20px;width:80px;height:80px;border-radius:50%;background:rgba(255,255,255,0.08);}
    .sd-av{width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,0.2);border:2px solid rgba(255,255,255,0.4);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:white;margin-bottom:8px;position:relative;z-index:1;}
    .sd-nombre{font-size:14px;font-weight:700;color:white;letter-spacing:-0.3px;position:relative;z-index:1;}
    .sd-rol{font-size:10px;color:rgba(255,255,255,0.7);font-weight:500;margin-top:1px;position:relative;z-index:1;}
    .sd-chip{display:inline-block;margin-top:9px;background:rgba(255,255,255,0.18);border-radius:20px;padding:4px 10px;font-size:9.5px;font-weight:700;letter-spacing:.05em;color:white;position:relative;z-index:1;}
  </style>
  @RenderSection("Styles", required: false)
</head>
<body>
<div id="sbOverlay"></div>
<div class="app">
  <div class="sidebar" id="sidebar">
    <div class="sb-logo-area">
      <img src="~/Images/Logo azul 2.jpg" alt="Londoño Gómez" style="width:100%;max-height:56px;object-fit:contain;display:block;mix-blend-mode:multiply;"/>
    </div>

    <div class="sb-direccion">
      <div class="sd-av">@iniciales</div>
      <div class="sd-nombre">@nombre @apellido</div>
      <div class="sd-rol">Dirección comercial</div>
      <span class="sd-chip">SOLO CONSULTA</span>
    </div>

    <div class="sb-sec">Lanzamiento</div>
    @if (sinProyecto)
    {
      <div style="margin:8px 12px;padding:10px 12px;background:rgba(255,149,0,0.08);border:1px solid rgba(255,149,0,0.25);border-radius:10px;font-size:11px;line-height:1.5;color:var(--label2);">
        Tu cuenta no tiene un proyecto asignado. Pídele al administrador que te asigne el
        lanzamiento que vas a seguir.
      </div>
    }
    else
    {
      <a class="nav-item @(activeNav=="resumen"?"active":"")" href="/Direccion">
        <div class="nav-ico"><img src="~/Images/icons/inicio.svg" width="18" height="18" alt=""/></div>Resumen
      </a>
      <a class="nav-item @(activeNav=="mapa"?"active":"")" href="/Direccion/Mapa">
        <div class="nav-ico"><img src="~/Images/icons/reportes.svg" width="18" height="18" alt=""/></div>Mapa de ventas
      </a>
      <a class="nav-item @(activeNav=="inventario"?"active":"")" href="/Direccion/Inventario">
        <div class="nav-ico"><img src="~/Images/icons/proyectos.svg" width="18" height="18" alt=""/></div>Inventario
      </a>
      <a class="nav-item @(activeNav=="ventas"?"active":"")" href="/Direccion/Ventas">
        <div class="nav-ico"><img src="~/Images/icons/ventas.svg" width="18" height="18" alt=""/></div>Ventas
      </a>
      <a class="nav-item @(activeNav=="reservas"?"active":"")" href="/Direccion/Reservas">
        <div class="nav-ico"><img src="~/Images/icons/reservas.svg" width="18" height="18" alt=""/></div>Reservas
      </a>
    }

    <div class="sb-footer">
      <div class="sb-av2">@iniciales</div>
      <div>
        <div style="font-size:12px;font-weight:600">@nombre @apellido</div>
        <div style="font-size:10px;color:var(--label3)">Dirección</div>
      </div>
      <a class="sb-logout" href="/Account/Logout" title="Cerrar sesión">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
      </a>
    </div>
  </div>

  <div class="main">
    <div class="topbar">
      <div class="tb-left">
        <button class="hamburger" onclick="toggleSidebar()" aria-label="Menú"><span></span><span></span><span></span></button>
        <span class="tb-bread"><strong>@tbBread</strong></span>
      </div>
      <div class="tb-right">
        @* Sin desplegable: dirección solo ve el proyecto que tiene asignado. *@
        <div class="tb-chip" style="cursor:default;">
          <span class="pulse"></span>@proyActivo
        </div>
        <a class="tb-ibtn" href="/Account/Logout" title="Cerrar sesión">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="view">
      @if (sinProyecto)
      {
        <div style="background:rgba(255,149,0,0.07);border:1px solid rgba(255,149,0,0.3);border-radius:16px;padding:24px;font-size:13.5px;color:#8a5200;line-height:1.6;">
          Tu cuenta no tiene un proyecto asignado todavía. Pídele al administrador que te
          asigne el lanzamiento que vas a seguir; hasta entonces no hay nada que mostrar.
        </div>
      }
      else
      {
        @RenderBody()
      }
    </div>
  </div>
</div>

<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
