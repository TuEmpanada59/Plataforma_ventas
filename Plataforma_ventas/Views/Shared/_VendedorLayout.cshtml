@{
    string proyActivo = ViewBag.ProyectoActivo as string ?? "Sin proyecto";
    string nombre     = ViewBag.Nombre    as string ?? "";
    string apellido   = ViewBag.Apellido  as string ?? "";
    string iniciales  = ViewBag.Iniciales as string ?? ((nombre.Length >= 1 ? nombre.Substring(0,1) : "") + (apellido.Length >= 1 ? apellido.Substring(0,1) : "")).ToUpper();
    if (string.IsNullOrEmpty(iniciales)) iniciales = "V";
    string activeNav  = ViewBag.ActiveNav as string ?? "";
    string tbBread    = ViewBag.TbBread   as string ?? "Inicio";
    int misVentas     = ViewBag.MisVentas   != null ? (int)ViewBag.MisVentas   : 0;
    int misClientes   = ViewBag.MisClientes != null ? (int)ViewBag.MisClientes : 0;
    // Sin proyecto asignado: se bloquea la navegación (solo queda disponible cerrar sesión).
    bool sinProyecto  = !(int.TryParse(Context.Session.GetString("ProyectoId"), out int pidLay) && pidLay > 0);
}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Lanzamientos - Londoño Gómez</title>
  <link rel="icon" type="image/svg+xml" href="~/favicon.svg"/>
  <link rel="alternate icon" href="~/favicon.ico"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="~/css/platform.css" asp-append-version="true"/>
  <style>
    /* Vendor sidebar card */
    .sb-vendedor{margin:14px 10px 4px;background:linear-gradient(145deg,var(--azul),var(--blue));border-radius:16px;padding:14px;position:relative;overflow:hidden;}
    .sb-vendedor::before{content:'';position:absolute;top:-20px;right:-20px;width:80px;height:80px;border-radius:50%;background:rgba(255,255,255,0.08);}
    .sb-vendedor::after{content:'';position:absolute;bottom:-30px;left:-20px;width:100px;height:100px;border-radius:50%;background:rgba(255,255,255,0.05);}
    .sv-av{width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,0.2);border:2px solid rgba(255,255,255,0.4);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:white;margin-bottom:8px;position:relative;z-index:1;}
    .sv-nombre{font-size:14px;font-weight:700;color:white;letter-spacing:-0.3px;position:relative;z-index:1;}
    .sv-rol{font-size:10px;color:rgba(255,255,255,0.65);font-weight:500;margin-top:1px;position:relative;z-index:1;}
    .sv-stats{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:10px;position:relative;z-index:1;}
    .sv-stat{background:rgba(255,255,255,0.12);border-radius:10px;padding:8px;text-align:center;}
    .sv-num{font-size:18px;font-weight:300;color:white;letter-spacing:-0.5px;}
    .sv-lbl{font-size:9px;color:rgba(255,255,255,0.6);font-weight:500;margin-top:1px;}
  </style>
  @RenderSection("Styles", required: false)
</head>
<body>
<div id="sbOverlay"></div>
<div class="app">
  <div class="sidebar" id="sidebar">
    <div class="sb-logo-area">
      <img src="~/Images/Logo azul 2.jpg" alt="Londoño Gómez" style="width:100%;max-height:56px;object-fit:contain;display:block;mix-blend-mode:multiply;"/>
    </div>

    <div class="sb-vendedor">
      <div class="sv-av">@iniciales</div>
      <div class="sv-nombre">@nombre @apellido</div>
      <div class="sv-rol">Vendedor</div>
      <div class="sv-stats">
        <div class="sv-stat"><div class="sv-num">@misVentas</div><div class="sv-lbl">Mis ventas</div></div>
        <div class="sv-stat"><div class="sv-num">@misClientes</div><div class="sv-lbl">Clientes</div></div>
      </div>
    </div>

    <div class="sb-sec">Mi espacio</div>
    @if (sinProyecto)
    {
      <a class="nav-item active" href="/Vendedor">
        <div class="nav-ico"><img src="~/Images/icons/inicio.svg" width="18" height="18" alt=""/></div>Inicio
      </a>
      <div style="margin:8px 12px;padding:10px 12px;background:rgba(255,149,0,0.08);border:1px solid rgba(255,149,0,0.25);border-radius:10px;font-size:11px;line-height:1.4;color:var(--label2);">
        Sin proyecto asignado. Pídele al Administrador que te asigne uno para habilitar la navegación.
      </div>
    }
    else
    {
      <a class="nav-item @(activeNav=="vendedor-inicio"?"active":"")" href="/Vendedor">
        <div class="nav-ico"><img src="~/Images/icons/inicio.svg" width="18" height="18" alt=""/></div>Inicio
      </a>
      <a class="nav-item @(activeNav=="vendedor-inmuebles"?"active":"")" href="/Vendedor/Inmuebles">
        <div class="nav-ico"><img src="~/Images/icons/proyectos.svg" width="18" height="18" alt=""/></div>Inmuebles
      </a>
      <a class="nav-item @(activeNav=="vendedor-reservas"?"active":"")" href="/Vendedor/MisReservas">
        <div class="nav-ico"><img src="~/Images/icons/reservas.svg" width="18" height="18" alt=""/></div>Mis reservas
      </a>
      <a class="nav-item @(activeNav=="vendedor-ventas"?"active":"")" href="/Vendedor/MisVentas">
        <div class="nav-ico"><img src="~/Images/icons/ventas.svg" width="18" height="18" alt=""/></div>Mis ventas
      </a>
      <a class="nav-item @(activeNav=="vendedor-perfil"?"active":"")" href="/Vendedor/Perfil">
        <div class="nav-ico"><img src="~/Images/icons/clientes.svg" width="18" height="18" alt=""/></div>Mi perfil
      </a>
    }

    <div class="sb-footer">
      <div class="sb-av2">@iniciales</div>
      <div>
        <div style="font-size:12px;font-weight:600">@nombre @apellido</div>
        <div style="font-size:10px;color:var(--label3)">Vendedor</div>
      </div>
      <a class="sb-logout" href="/Account/Logout" title="Cerrar sesión">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
      </a>
    </div>
  </div>

  <div class="main">
    <div class="topbar">
      <div class="tb-left">
        <button class="hamburger" onclick="toggleSidebar()" aria-label="Menú"><span></span><span></span><span></span></button>
        <span class="tb-bread"><strong>@tbBread</strong></span>
      </div>
      <div class="tb-right">
        <!-- Vendor: read-only project chip, no dropdown -->
        <div class="tb-chip" style="cursor:default;">
          <span class="pulse"></span>@proyActivo
        </div>
        <a class="tb-ibtn" href="/Account/Logout" title="Cerrar sesión">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="view">
      @RenderBody()
    </div>
  </div>
</div>

<!-- Session expiry warning banner -->
<div id="sessionBanner" class="session-banner" style="display:none">
  Tu sesión expira en <span id="sessionCountdown">2:00</span>.
  <button onclick="renewSession()">Renovar</button>
</div>

<script src="~/js/app.js"></script>
@RenderSection("Scripts", required: false)
<script>
// Session expiry countdown
(function(){
  var WARN_AT=120,total=1200,start=Date.now();
  var banner=document.getElementById('sessionBanner');
  var cd=document.getElementById('sessionCountdown');
  setInterval(function(){
    var elapsed=Math.floor((Date.now()-start)/1000);
    var left=total-elapsed;
    if(left<=WARN_AT&&left>0){
      banner.style.display='flex';
      var m=Math.floor(left/60),s=left%60;
      cd.textContent=m+':'+(s<10?'0':'')+s;
    }
    if(left<=0){banner.innerHTML='<span>Sesión expirada. <a href="/Account/Login" style="color:#fff;text-decoration:underline">Inicia sesión nuevamente</a></span>';}
  },1000);
  window.renewSession=function(){start=Date.now();banner.style.display='none';fetch('/Vendedor',{method:'GET'}).catch(function(){});};
})();
</script>
</body>
</html>
