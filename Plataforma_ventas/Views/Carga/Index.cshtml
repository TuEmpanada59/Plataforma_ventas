@{
    Layout = null;
    var nombre     = Context.Session.GetString("Nombre") ?? "Admin";
    var apellido    = ViewBag.Apellido as string ?? "";
    var proyActivo = ViewBag.ProyectoActivo as string ?? "Sin proyecto";
    var proyectos  = ViewBag.Proyectos as List<(int Id, string Nombre, string Codigo)> ?? new List<(int, string, string)>();
    var tiposProy = ViewBag.TiposProy as Dictionary<int, string> ?? new Dictionary<int, string>();
    var iniciales = ((nombre.Length >= 1 ? nombre.Substring(0, 1) : "") + (apellido.Length >= 1 ? apellido.Substring(0, 1) : "")).ToUpper();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Cargar Proyecto · Londoño Gómez</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
        :root{--azul:#0076e3;--celeste:#00c9ff;--negro:#1e222b;--plata:#c3cfdb;--menta:#00d4a1;--mid:#0060bb;--blue:#0076e3;--rojo:#E63946;--verde:#34C759;--label:rgba(0,0,0,0.85);--label2:rgba(60,60,67,0.6);--label3:rgba(60,60,67,0.3);--sep:rgba(60,60,67,0.12);--sep2:rgba(60,60,67,0.06);--fill3:rgba(120,120,128,0.08);--fill2:rgba(120,120,128,0.12);--glass:rgba(255,255,255,0.75);--gb:rgba(255,255,255,0.6);--sh:0 8px 32px rgba(0,0,0,0.08);}
        html,body{background:#EEF2F7;}
        *{font-family:'Inter',system-ui,sans-serif;-webkit-font-smoothing:antialiased;}
        body::before{content:'';position:fixed;inset:0;z-index:0;background:radial-gradient(ellipse 80% 60% at 10% 0%,rgba(0,118,227,0.12) 0%,transparent 55%),#EEF2F7;pointer-events:none;}
        .app{display:flex;min-height:100vh;position:relative;z-index:1;}
        .sidebar{width:230px;flex-shrink:0;background:var(--glass);backdrop-filter:blur(40px) saturate(180%);border-right:1px solid var(--gb);display:flex;flex-direction:column;}
        .sb-top{padding:20px 14px 0;}
        .sb-icon{width:42px;height:42px;border-radius:12px;background:linear-gradient(145deg,var(--mid),var(--blue));display:flex;align-items:center;justify-content:center;font-size:18px;margin-bottom:10px;box-shadow:0 4px 12px rgba(0,96,187,0.25);}
        .sb-app{font-size:17px;font-weight:700;color:var(--label);letter-spacing:-0.4px;}
        .sb-sub{font-size:11px;color:var(--label3);margin-top:1px;}
        .sb-proy{margin:14px 10px 4px;background:rgba(0,118,227,0.08);border:1px solid rgba(0,118,227,0.18);border-radius:14px;padding:10px 12px;}
        .sb-proy-lbl{font-size:9px;text-transform:uppercase;letter-spacing:0.1em;color:var(--label3);font-weight:600;margin-bottom:2px;}
        .sb-proy-name{font-size:14px;font-weight:700;color:var(--azul);}
        .pulse{width:5px;height:5px;border-radius:50%;background:#34C759;animation:pring 2.5s ease infinite;display:inline-block;}
        @@keyframes pring{0%{box-shadow:0 0 0 0 rgba(52,199,89,.4)}70%{box-shadow:0 0 0 5px rgba(52,199,89,0)}100%{box-shadow:0 0 0 0 rgba(52,199,89,0)}}
        .sb-sec{padding:16px 16px 4px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:var(--label3);}
        .nav-item{display:flex;align-items:center;gap:10px;padding:9px 12px;margin:1px 6px;border-radius:11px;font-size:14px;color:var(--label2);text-decoration:none;transition:all 0.2s;}
        .nav-item:hover{background:var(--fill3);color:var(--label);}
        .nav-item.active{background:var(--blue);color:white;font-weight:600;box-shadow:0 4px 12px rgba(0,118,227,0.28);}
        .nav-ico{width:26px;height:26px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:13px;background:var(--fill3);flex-shrink:0;}
        .nav-item.active .nav-ico{background:rgba(255,255,255,0.2);}
        .sb-footer{margin-top:auto;padding:10px 12px 20px;border-top:1px solid var(--sep2);display:flex;align-items:center;gap:8px;}
        .sb-av{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,var(--azul),var(--celeste));display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:white;}
        .sb-logout{margin-left:auto;width:26px;height:26px;border-radius:7px;background:var(--fill3);display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--label2);text-decoration:none;transition:background 0.15s;}
        .sb-logout:hover{background:rgba(230,57,70,0.1);color:var(--rojo);}
        .main{flex:1;display:flex;flex-direction:column;min-width:0;}
        .topbar{height:50px;flex-shrink:0;background:var(--glass);backdrop-filter:blur(40px) saturate(180%);border-bottom:1px solid var(--sep);padding:0 18px;display:flex;align-items:center;justify-content:space-between;}
        .tb-bread{font-size:13px;color:var(--label2);}.tb-bread strong{color:var(--label);font-weight:600;}
        .tb-right{display:flex;align-items:center;gap:8px;}
        .tb-chip{display:flex;align-items:center;gap:5px;background:var(--fill3);border:1px solid var(--sep);padding:4px 10px;border-radius:20px;font-size:12px;font-weight:600;color:var(--blue);}
        .tb-ibtn{width:30px;height:30px;border-radius:9px;background:var(--fill3);display:flex;align-items:center;justify-content:center;font-size:14px;text-decoration:none;color:var(--label);}
        .view{flex:1;overflow-y:auto;padding:24px;display:flex;gap:20px;align-items:flex-start;justify-content:center;}
        .view::-webkit-scrollbar{width:0;}
        @@keyframes fu{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
        .upload-card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:22px;padding:32px;width:100%;max-width:480px;box-shadow:var(--sh);animation:fu 0.35s ease both;flex-shrink:0;}
        .upload-icon{width:60px;height:60px;border-radius:16px;background:linear-gradient(145deg,var(--mid),var(--blue));display:flex;align-items:center;justify-content:center;font-size:26px;margin:0 auto 16px;box-shadow:0 6px 18px rgba(0,96,187,0.25);}
        .upload-title{font-size:20px;font-weight:700;color:var(--label);letter-spacing:-0.5px;text-align:center;margin-bottom:6px;}
        .upload-sub{font-size:13px;color:var(--label2);text-align:center;margin-bottom:24px;}
        .campo{margin-bottom:14px;}
        .campo label{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--label2);margin-bottom:5px;}
        .campo input[type=text]{width:100%;padding:11px 14px;background:rgba(255,255,255,0.7);border:1px solid var(--sep);border-radius:12px;font-size:15px;color:var(--label);outline:none;transition:all 0.2s;}
        .campo input[type=text]:focus{border-color:var(--blue);background:white;box-shadow:0 0 0 3px rgba(0,118,227,0.11);}
        .drop-zone{border:2px dashed var(--sep);border-radius:14px;padding:28px;text-align:center;cursor:pointer;transition:all 0.2s;background:var(--fill3);position:relative;margin-bottom:18px;}
        .drop-zone:hover,.drop-zone.dragover{border-color:var(--blue);background:rgba(0,118,227,0.05);}
        .drop-zone input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;}
        .drop-ico{font-size:28px;margin-bottom:8px;}
        .drop-txt{font-size:14px;font-weight:500;color:var(--label2);}
        .drop-sub{font-size:12px;color:var(--label3);margin-top:4px;}
        .drop-name{font-size:13px;font-weight:600;color:var(--blue);margin-top:8px;display:none;}
        .btn-submit{width:100%;padding:14px;background:linear-gradient(135deg,var(--azul),var(--celeste));color:white;border:none;border-radius:14px;font-size:15px;font-weight:600;cursor:pointer;box-shadow:0 4px 16px rgba(0,118,227,0.3);transition:all 0.2s;}
        .btn-submit:hover{background:linear-gradient(135deg,var(--azul),var(--mid));transform:translateY(-1px);}
        .alerta{background:rgba(230,57,70,0.08);border:1px solid rgba(230,57,70,0.18);border-radius:12px;padding:10px 14px;color:var(--rojo);font-size:13px;font-weight:500;margin-bottom:14px;}
        .exito{background:rgba(52,199,89,0.08);border:1px solid rgba(52,199,89,0.2);border-radius:12px;padding:10px 14px;color:#1A7A35;font-size:13px;font-weight:500;margin-bottom:14px;}
        /* Lista proyectos */
        .proyectos-card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:22px;padding:24px;width:100%;max-width:340px;box-shadow:var(--sh);animation:fu 0.35s ease 0.1s both;flex-shrink:0;}
        .proy-card-title{font-size:15px;font-weight:600;color:var(--label);margin-bottom:16px;display:flex;align-items:center;gap:8px;}
        .proy-item{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;background:var(--fill3);border-radius:12px;margin-bottom:8px;gap:8px;}
        .proy-item:last-child{margin-bottom:0;}
        .proy-item-name{font-size:13px;font-weight:600;color:var(--label);flex:1;}
        .proy-item-fecha{font-size:11px;color:var(--label3);margin-top:2px;}
        .btn-eliminar{background:rgba(230,57,70,0.1);color:var(--rojo);border:none;padding:5px 10px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;transition:all 0.2s;white-space:nowrap;}
        .btn-eliminar:hover{background:rgba(230,57,70,0.2);}
        .empty-proy{text-align:center;color:var(--label3);font-size:13px;padding:20px;}

        .tipo-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px;}
        .tipo-btn{padding:12px 8px;border-radius:12px;border:2px solid var(--sep);background:white;font-size:13px;font-weight:600;color:var(--label2);cursor:pointer;text-align:center;transition:all 0.2s;width:100%;}
        .tipo-btn:hover{border-color:var(--blue);color:var(--blue);}
        .tipo-btn.sel{border-color:var(--blue);background:rgba(0,118,227,0.06);color:var(--blue);}
        .tipo-btn-ico{font-size:20px;display:block;margin-bottom:4px;}
        html,body{overflow-x:hidden;}
        .sidebar{position:sticky;top:0;height:100vh;overflow-y:auto;}
        .hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:6px;border-radius:8px;background:var(--fill3);border:none;}
        .hamburger span{display:block;width:18px;height:2px;background:var(--label);border-radius:2px;}
        @@media(max-width:1024px){.view{flex-direction:column!important;align-items:center!important;}}
        @@media(max-width:700px){
            html,body{height:auto!important;overflow:auto!important;}
            .app{flex-direction:column!important;}
            .sidebar{position:fixed!important;top:0!important;left:-270px!important;width:260px!important;height:100vh!important;z-index:100!important;overflow-y:auto!important;transition:left 0.3s!important;}
            .sidebar.open{left:0!important;}
            .main{width:100%!important;}
            .topbar{position:sticky!important;top:0!important;z-index:50!important;}
            .hamburger{display:flex!important;}
            .view{padding:12px!important;flex-direction:column!important;}
            .upload-card,.proyectos-card{max-width:100%!important;}
            .tb-chip{display:none!important;}
        }
    
        /* ── Sidebar blanco corporativo ── */
        .sidebar{background:#fff!important;border-right:1px solid rgba(0,0,0,0.07)!important;backdrop-filter:none!important;box-shadow:2px 0 12px rgba(0,0,0,0.04)!important;}
        .sb-logo-area{padding:16px 14px 12px;border-bottom:1px solid rgba(0,0,0,0.06);margin-bottom:4px;}
        .sb-logo-area img{width:100%;max-height:52px;object-fit:contain;display:block;mix-blend-mode:multiply;filter:contrast(1.05);}
        .sb-app{color:#1e222b!important;font-weight:700!important;}
        .sb-sub{color:rgba(30,34,43,0.45)!important;}
        .sb-proy{background:rgba(0,118,227,0.06)!important;border-color:rgba(0,118,227,0.18)!important;}
        .sb-proy:hover{background:rgba(0,118,227,0.10)!important;}
        .sb-proy-lbl{color:rgba(30,34,43,0.45)!important;font-size:9px!important;}
        .sb-proy-name{color:#0076e3!important;font-weight:700!important;}
        .sb-proy-meta{color:rgba(30,34,43,0.5)!important;}
        .proy-drop{background:#fff!important;border-color:rgba(0,0,0,0.09)!important;box-shadow:0 8px 24px rgba(0,0,0,0.1)!important;}
        .proy-drop-item{color:#1e222b!important;}
        .proy-drop-item:hover{background:rgba(0,118,227,0.06)!important;color:#0076e3!important;}
        .proy-drop-link{color:#0076e3!important;background:rgba(0,118,227,0.04)!important;}
        .sb-sec{color:rgba(30,34,43,0.38)!important;letter-spacing:0.08em!important;}
        .nav-item{color:rgba(30,34,43,0.65)!important;}
        .nav-item:hover{background:rgba(0,118,227,0.07)!important;color:#0076e3!important;}
        .nav-item.active{background:#0076e3!important;color:#fff!important;}
        .nav-item.active .nav-ico{background:rgba(255,255,255,0.22)!important;}
        .nav-ico{background:rgba(30,34,43,0.06)!important;color:inherit!important;}
        .sb-footer{border-top-color:rgba(0,0,0,0.07)!important;}
        .sb-logout{background:rgba(30,34,43,0.05)!important;color:rgba(30,34,43,0.45)!important;}
        .sb-logout:hover{background:rgba(230,57,70,0.08)!important;color:#E63946!important;}
        .nav-item{display:flex!important;align-items:center!important;gap:10px!important;padding:9px 12px!important;margin:1px 6px!important;border-radius:11px!important;font-size:14px!important;min-height:40px!important;text-decoration:none!important;transition:all 0.18s!important;}
        .nav-ico{width:26px!important;height:26px!important;border-radius:8px!important;display:flex!important;align-items:center!important;justify-content:center!important;font-size:14px!important;flex-shrink:0!important;}
        .sb-sec{padding:14px 18px 4px!important;font-size:10px!important;font-weight:600!important;text-transform:uppercase!important;}
    </style>
</head>
<body>
<div class="app">
    <div class="sidebar">
        <div class="sb-logo-area">
            <img src="~/Images/Logo azul 2.jpg" alt="Londoño Gómez" style="width:100%;max-height:56px;object-fit:contain;display:block;mix-blend-mode:multiply;" />
        </div>
        <div class="sb-proy">
            <div class="sb-proy-lbl"><span class="pulse"></span> Proyecto activo</div>
            <div class="sb-proy-name">@proyActivo</div>
        </div>
        <div class="sb-sec">Principal</div>
        <a class="nav-item" href="/Dashboard"><div class="nav-ico">⊞</div>Inicio</a>
        <a class="nav-item" href="/Inmuebles/Proyectos"><div class="nav-ico">🏢</div>Proyectos</a>
        <a class="nav-item" href="/Inmuebles/Reservas"><div class="nav-ico">🔒</div>Reservas</a>
        <a class="nav-item" href="/Ventas"><div class="nav-ico">💲</div>Ventas</a>
        <a class="nav-item" href="/Clientes"><div class="nav-ico">👤</div>Clientes</a>
        <div class="sb-sec">General</div>
        <a class="nav-item" href="/Reportes"><div class="nav-ico">📊</div>Reportes</a>
        <a class="nav-item active" href="/Carga/Index"><div class="nav-ico">📂</div>Cargar Excel</a>
        <a class="nav-item" href="/Usuarios"><div class="nav-ico">👥</div>Usuarios</a>
        <div class="sb-footer">
                <div class="sb-av">@iniciales</div>
            <div><div style="font-size:12px;font-weight:600">@nombre</div><div style="font-size:10px;color:var(--label3)">Administrador</div></div>
            <a class="sb-logout" href="/Account/Logout">↩</a>
        </div>
    </div>

    <div class="main">
        <div class="topbar">
            <div style="display:flex;align-items:center;gap:10px;"><button class="hamburger" onclick="toggleSidebar()"><span></span><span></span><span></span></button><span class="tb-bread"><strong>Cargar proyecto</strong></span></div>
            <div class="tb-right">
                <div class="tb-chip"><span class="pulse"></span>@proyActivo</div>
                <a class="tb-ibtn" href="/Account/Logout">↩</a>
            </div>
        </div>

        <div class="view">
            <!-- Card subir Excel -->
            <div class="upload-card">
                <div class="upload-icon">📊</div>
                <div class="upload-title">Cargar proyecto desde Excel</div>
                <div class="upload-sub">Sube el archivo con los inmuebles del proyecto</div>

                @if (TempData["Error"] != null) { <div class="alerta">⚠ @TempData["Error"]</div> }
                @if (TempData["Exito"] != null) { <div class="exito">✓ @TempData["Exito"]</div> }

                <form asp-action="Subir" asp-controller="Carga" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="campo">
                        <label>Nombre del proyecto</label>
                        <input type="text" name="nombreProyecto" placeholder="Ej: VENTTO" required/>
                    </div>
                    <div class="campo">
                        <label>Tipo de proyecto</label>
                        <div class="tipo-row">
                            <button type="button" class="tipo-btn sel" id="btnApto" onclick="selTipo('APARTAMENTOS')">
                                <span class="tipo-btn-ico">🏢</span>Apartamentos
                            </button>
                            <button type="button" class="tipo-btn" id="btnLote" onclick="selTipo('LOTES')">
                                <span class="tipo-btn-ico">🏕</span>Lotes
                            </button>
                        </div>
                        <input type="hidden" name="tipoProyecto" id="tipoProyecto" value="APARTAMENTOS"/>
                    </div>
                    <div class="drop-zone" id="dropZone">
                        <input type="file" name="archivo" accept=".xlsx,.xls" id="fileInput" required/>
                        <div class="drop-ico">📁</div>
                        <div class="drop-txt">Arrastra el Excel aquí o haz clic</div>
                        <div class="drop-sub">Formatos: .xlsx, .xls</div>
                        <div class="drop-name" id="fileName"></div>
                    </div>
                    <button type="submit" class="btn-submit">Cargar proyecto</button>
                </form>
            </div>

            <!-- Card proyectos cargados -->
            <div class="proyectos-card">
                <div class="proy-card-title">🏗 Proyectos cargados <span style="background:rgba(0,118,227,0.1);color:var(--blue);font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px">@proyectos.Count</span></div>
                @if (proyectos.Count > 0) {
                    foreach (var p in proyectos) {
                        <div class="proy-item" style="flex-direction:column;align-items:flex-start;gap:6px;">
                            <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
                                <div class="proy-item-name">
                                    @p.Nombre
                                    @if (tiposProy.ContainsKey(p.Id)) {
                                        var t = tiposProy[p.Id];
                                        <span style="font-size:10px;font-weight:700;padding:2px 7px;border-radius:20px;margin-left:6px;background:@(t=="LOTES"?"rgba(255,149,0,0.1)":"rgba(0,118,227,0.1)");color:@(t=="LOTES"?"#CC7700":"var(--blue)")">@(t == "LOTES" ? "🏕 Lotes" : "🏢 Aptos")</span>
                                    }
                                </div>
                                <form action="/Carga/EliminarProyecto" method="post" style="margin:0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idProyecto" value="@p.Id"/>
                                    <button type="submit" class="btn-eliminar" onclick="return confirm('¿Eliminar @p.Nombre?')">🗑</button>
                                </form>
                            </div>
                            <div style="display:flex;align-items:center;gap:6px;background:rgba(0,118,227,0.08);border:1px solid rgba(0,118,227,0.2);border-radius:8px;padding:5px 10px;width:100%;">
                                <span style="font-size:13px;font-weight:700;color:var(--azul);letter-spacing:1px;flex:1">@p.Codigo</span>
                                <button onclick="copiar('@p.Codigo')" type="button" style="background:none;border:none;cursor:pointer;color:var(--label2);font-size:12px;font-weight:600;padding:2px 6px;border-radius:5px;">📋 Copiar</button>
                                <form action="/Carga/RegenerarCodigo" method="post" style="margin:0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idProyecto" value="@p.Id"/>
                                    <input type="hidden" name="nombreProyecto" value="@p.Nombre"/>
                                    <button type="submit" style="background:none;border:none;cursor:pointer;color:var(--label2);font-size:12px;font-weight:600;padding:2px 6px;border-radius:5px;" onclick="return confirm('¿Regenerar código?')">🔄 Nuevo</button>
                                </form>
                            </div>
                        </div>
                    }
                } else {
                    <div class="empty-proy">No hay proyectos cargados</div>
                }
            </div>
        </div>
    </div>
</div>
<div id="sbOverlay" onclick="closeSidebar()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:99;backdrop-filter:blur(2px);"></div>
<script>
    function selTipo(t){
        document.getElementById('tipoProyecto').value=t;
        document.getElementById('btnApto').classList.toggle('sel',t==='APARTAMENTOS');
        document.getElementById('btnLote').classList.toggle('sel',t==='LOTES');
    }
    function toggleSidebar(){var sb=document.querySelector('.sidebar'),ov=document.getElementById('sbOverlay');if(!sb)return;var o=sb.classList.toggle('open');if(ov)ov.style.display=o?'block':'none';}
    function closeSidebar(){var sb=document.querySelector('.sidebar'),ov=document.getElementById('sbOverlay');if(sb)sb.classList.remove('open');if(ov)ov.style.display='none';}
    function copiar(txt){navigator.clipboard.writeText(txt).then(function(){alert('Código copiado: '+txt);});}
    const fileInput=document.getElementById('fileInput'),fileName=document.getElementById('fileName'),dropZone=document.getElementById('dropZone');
    fileInput.addEventListener('change',()=>{if(fileInput.files.length>0){fileName.textContent='✓ '+fileInput.files[0].name;fileName.style.display='block';}});
    dropZone.addEventListener('dragover',e=>{e.preventDefault();dropZone.classList.add('dragover');});
    dropZone.addEventListener('dragleave',()=>dropZone.classList.remove('dragover'));
    dropZone.addEventListener('drop',e=>{e.preventDefault();dropZone.classList.remove('dragover');fileInput.files=e.dataTransfer.files;fileName.textContent='✓ '+e.dataTransfer.files[0].name;fileName.style.display='block';});
</script>
</body>
</html>
