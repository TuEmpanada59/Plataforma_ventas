@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Londoño Gómez — Cargar Excel";
    ViewBag.ActiveNav = "carga";
    ViewBag.TbBread   = "Cargar Excel";

    var proyectos  = ViewBag.Proyectos as List<(int Id, string Nombre, string Codigo)> ?? new List<(int, string, string)>();
    var tiposProy = ViewBag.TiposProy as Dictionary<int, string> ?? new Dictionary<int, string>();
}
@section Styles {
<style>
    @@keyframes fu{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    .upload-card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:22px;padding:32px;width:100%;max-width:480px;box-shadow:var(--sh);animation:fu 0.35s ease both;flex-shrink:0;}
    .upload-icon{width:60px;height:60px;border-radius:16px;background:linear-gradient(145deg,var(--mid),var(--blue));display:flex;align-items:center;justify-content:center;font-size:26px;margin:0 auto 16px;box-shadow:0 6px 18px rgba(0,96,187,0.25);}
    .upload-title{font-size:20px;font-weight:700;color:var(--label);letter-spacing:-0.5px;text-align:center;margin-bottom:6px;}
    .upload-sub{font-size:13px;color:var(--label2);text-align:center;margin-bottom:24px;}
    .campo{margin-bottom:14px;}
    .campo label{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--label2);margin-bottom:5px;}
    .campo input[type=text]{width:100%;padding:11px 14px;background:rgba(255,255,255,0.7);border:1px solid var(--sep);border-radius:12px;font-size:15px;color:var(--label);outline:none;transition:all 0.2s;}
    .campo input[type=text]:focus{border-color:var(--blue);background:white;box-shadow:0 0 0 3px rgba(0,118,227,0.11);}
    .drop-zone{border:2px dashed var(--sep);border-radius:14px;padding:28px;text-align:center;cursor:pointer;transition:all 0.2s;background:var(--fill3);position:relative;margin-bottom:18px;}
    .drop-zone:hover,.drop-zone.dragover{border-color:var(--blue);background:rgba(0,118,227,0.05);}
    .drop-zone input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;}
    .drop-ico{font-size:28px;margin-bottom:8px;}
    .drop-txt{font-size:14px;font-weight:500;color:var(--label2);}
    .drop-sub{font-size:12px;color:var(--label3);margin-top:4px;}
    .drop-name{font-size:13px;font-weight:600;color:var(--blue);margin-top:8px;display:none;}
    .btn-submit{width:100%;padding:14px;background:linear-gradient(135deg,var(--azul),var(--celeste));color:white;border:none;border-radius:14px;font-size:15px;font-weight:600;cursor:pointer;box-shadow:0 4px 16px rgba(0,118,227,0.3);transition:all 0.2s;}
    .btn-submit:hover{background:linear-gradient(135deg,var(--azul),var(--mid));transform:translateY(-1px);}
    .alerta{background:rgba(230,57,70,0.08);border:1px solid rgba(230,57,70,0.18);border-radius:12px;padding:10px 14px;color:var(--rojo);font-size:13px;font-weight:500;margin-bottom:14px;}
    .exito{background:rgba(52,199,89,0.08);border:1px solid rgba(52,199,89,0.2);border-radius:12px;padding:10px 14px;color:#1A7A35;font-size:13px;font-weight:500;margin-bottom:14px;}
    .proyectos-card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:22px;padding:24px;width:100%;max-width:340px;box-shadow:var(--sh);animation:fu 0.35s ease 0.1s both;flex-shrink:0;}
    .proy-card-title{font-size:15px;font-weight:600;color:var(--label);margin-bottom:16px;display:flex;align-items:center;gap:8px;}
    .proy-item{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;background:var(--fill3);border-radius:12px;margin-bottom:8px;gap:8px;}
    .proy-item:last-child{margin-bottom:0;}
    .proy-item-name{font-size:13px;font-weight:600;color:var(--label);flex:1;}
    .proy-item-fecha{font-size:11px;color:var(--label3);margin-top:2px;}
    .btn-eliminar{background:rgba(230,57,70,0.1);color:var(--rojo);border:none;padding:5px 10px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;transition:all 0.2s;white-space:nowrap;}
    .btn-eliminar:hover{background:rgba(230,57,70,0.2);}
    .empty-proy{text-align:center;color:var(--label3);font-size:13px;padding:20px;}
    .tipo-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px;}
    .tipo-btn{padding:12px 8px;border-radius:12px;border:2px solid var(--sep);background:white;font-size:13px;font-weight:600;color:var(--label2);cursor:pointer;text-align:center;transition:all 0.2s;width:100%;}
    .tipo-btn:hover{border-color:var(--blue);color:var(--blue);}
    .tipo-btn.sel{border-color:var(--blue);background:rgba(0,118,227,0.06);color:var(--blue);}
    .tipo-btn-ico{font-size:20px;display:block;margin-bottom:4px;}
    .view-inner{display:flex;gap:20px;align-items:flex-start;justify-content:center;flex-wrap:wrap;}
    @@media(max-width:1024px){.view-inner{flex-direction:column!important;align-items:center!important;}}
    @@media(max-width:700px){.upload-card,.proyectos-card{max-width:100%!important;}}
</style>
}

<div class="view-inner">
    <!-- Card subir Excel -->
    <div class="upload-card">
        <div class="upload-icon">📊</div>
        <div class="upload-title">Cargar proyecto desde Excel</div>
        <div class="upload-sub">Sube el archivo con los inmuebles del proyecto</div>

        @if (TempData["Error"] != null) { <div class="alerta">⚠ @TempData["Error"]</div> }
        @if (TempData["Exito"] != null) { <div class="exito">✓ @TempData["Exito"]</div> }

        <form asp-action="Subir" asp-controller="Carga" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="campo">
                <label>Nombre del proyecto</label>
                <input type="text" name="nombreProyecto" placeholder="Ej: VENTTO" required/>
            </div>
            <div class="campo">
                <label>Tipo de proyecto</label>
                <div class="tipo-row">
                    <button type="button" class="tipo-btn sel" id="btnApto" onclick="selTipo('APARTAMENTOS')">
                        <span class="tipo-btn-ico">🏢</span>Apartamentos
                    </button>
                    <button type="button" class="tipo-btn" id="btnLote" onclick="selTipo('LOTES')">
                        <span class="tipo-btn-ico">🏕</span>Lotes
                    </button>
                </div>
                <input type="hidden" name="tipoProyecto" id="tipoProyecto" value="APARTAMENTOS"/>
            </div>
            <div class="drop-zone" id="dropZone">
                <input type="file" name="archivo" accept=".xlsx,.xls" id="fileInput" required/>
                <div class="drop-ico">📁</div>
                <div class="drop-txt">Arrastra el Excel aquí o haz clic</div>
                <div class="drop-sub">Formatos: .xlsx, .xls</div>
                <div class="drop-name" id="fileName"></div>
            </div>
            <button type="submit" class="btn-submit">Cargar proyecto</button>
        </form>
    </div>

    <!-- Card proyectos cargados -->
    <div class="proyectos-card">
        <div class="proy-card-title">🏗 Proyectos cargados <span style="background:rgba(0,118,227,0.1);color:var(--blue);font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px">@proyectos.Count</span></div>
        @if (proyectos.Count > 0) {
            foreach (var p in proyectos) {
                <div class="proy-item" style="flex-direction:column;align-items:flex-start;gap:6px;">
                    <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
                        <div class="proy-item-name">
                            @p.Nombre
                            @if (tiposProy.ContainsKey(p.Id)) {
                                var t = tiposProy[p.Id];
                                <span style="font-size:10px;font-weight:700;padding:2px 7px;border-radius:20px;margin-left:6px;background:@(t=="LOTES"?"rgba(255,149,0,0.1)":"rgba(0,118,227,0.1)");color:@(t=="LOTES"?"#CC7700":"var(--blue)")">@(t == "LOTES" ? "🏕 Lotes" : "🏢 Aptos")</span>
                            }
                        </div>
                        <form action="/Carga/EliminarProyecto" method="post" style="margin:0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idProyecto" value="@p.Id"/>
                            <button type="submit" class="btn-eliminar" onclick="return confirm('¿Eliminar @p.Nombre?')">🗑</button>
                        </form>
                    </div>
                    <div style="display:flex;align-items:center;gap:6px;background:rgba(0,118,227,0.08);border:1px solid rgba(0,118,227,0.2);border-radius:8px;padding:5px 10px;width:100%;">
                        <span style="font-size:13px;font-weight:700;color:var(--azul);letter-spacing:1px;flex:1">@p.Codigo</span>
                        <button onclick="copiar('@p.Codigo')" type="button" style="background:none;border:none;cursor:pointer;color:var(--label2);font-size:12px;font-weight:600;padding:2px 6px;border-radius:5px;">📋 Copiar</button>
                        <form action="/Carga/RegenerarCodigo" method="post" style="margin:0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idProyecto" value="@p.Id"/>
                            <input type="hidden" name="nombreProyecto" value="@p.Nombre"/>
                            <button type="submit" style="background:none;border:none;cursor:pointer;color:var(--label2);font-size:12px;font-weight:600;padding:2px 6px;border-radius:5px;" onclick="return confirm('¿Regenerar código?')">🔄 Nuevo</button>
                        </form>
                    </div>
                </div>
            }
        } else {
            <div class="empty-proy">No hay proyectos cargados</div>
        }
    </div>
</div>

@section Scripts {
<script>
    function selTipo(t){
        document.getElementById('tipoProyecto').value=t;
        document.getElementById('btnApto').classList.toggle('sel',t==='APARTAMENTOS');
        document.getElementById('btnLote').classList.toggle('sel',t==='LOTES');
    }
    function copiar(txt){navigator.clipboard.writeText(txt).then(function(){alert('Código copiado: '+txt);});}
    const fileInput=document.getElementById('fileInput'),fileName=document.getElementById('fileName'),dropZone=document.getElementById('dropZone');
    fileInput.addEventListener('change',()=>{if(fileInput.files.length>0){fileName.textContent='✓ '+fileInput.files[0].name;fileName.style.display='block';}});
    dropZone.addEventListener('dragover',e=>{e.preventDefault();dropZone.classList.add('dragover');});
    dropZone.addEventListener('dragleave',()=>dropZone.classList.remove('dragover'));
    dropZone.addEventListener('drop',e=>{e.preventDefault();dropZone.classList.remove('dragover');fileInput.files=e.dataTransfer.files;fileName.textContent='✓ '+e.dataTransfer.files[0].name;fileName.style.display='block';});
</script>
}
