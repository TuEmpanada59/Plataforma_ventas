@{
    Layout = null;
    var nombre = ViewBag.Nombre as string ?? "";
    var apellido = ViewBag.Apellido as string ?? "";
    var proyActivo = ViewBag.ProyectoActivo as string ?? "Sin proyecto";
    var iniciales = ((nombre.Length >= 1 ? nombre.Substring(0, 1) : "") + (apellido.Length >= 1 ? apellido.Substring(0, 1) : "")).ToUpper();
    int idInmueble = ViewBag.IdInmueble != null ? (int)ViewBag.IdInmueble : 0;
    string apto = ViewBag.Apto as string ?? "";
    string metros = ViewBag.Metros as string ?? "";
    string tipo = ViewBag.Tipo as string ?? "";
    string torre = ViewBag.Torre as string ?? "";
    long precioReserva = ViewBag.PrecioReserva != null ? (long)ViewBag.PrecioReserva : 0;
    string vendedor = ViewBag.Vendedor as string ?? "Sin asignar";
    var clientes = ViewBag.Clientes as List<dynamic> ?? new List<dynamic>();
    var proyectos = ViewBag.Proyectos as List<(int Id, string Nombre)> ?? new List<(int, string)>();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>Continuar venta · Londoño Gómez</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --azul: #003A70;
                --mid: #0055A5;
                --blue: #0077C8;
                --rojo: #E63946;
                --verde: #34C759;
                --oro: #FF9500;
                --label: rgba(0,0,0,0.85);
                --label2: rgba(60,60,67,0.6);
                --label3: rgba(60,60,67,0.3);
                --sep: rgba(60,60,67,0.12);
                --sep2: rgba(60,60,67,0.06);
                --fill3: rgba(120,120,128,0.08);
                --glass: rgba(255,255,255,0.75);
                --gb: rgba(255,255,255,0.6);
                --sh: 0 8px 32px rgba(0,0,0,0.08),0 2px 8px rgba(0,0,0,0.04);
            }

            html, body {
                background: #EEF2F7;
                color: var(--label);
                overflow-x: hidden;
            }

            * {
                font-family: 'Inter',system-ui,sans-serif;
                -webkit-font-smoothing: antialiased;
            }

            body::before {
                content: '';
                position: fixed;
                inset: 0;
                z-index: 0;
                background: radial-gradient(ellipse 80% 60% at 10% 0%,rgba(0,119,200,0.12) 0%,transparent 55%),#EEF2F7;
                pointer-events: none;
            }

            .app {
                display: flex;
                min-height: 100vh;
                position: relative;
                z-index: 1;
            }

            .sidebar {
                width: 230px;
                flex-shrink: 0;
                background: var(--glass);
                backdrop-filter: blur(40px) saturate(180%);
                border-right: 1px solid var(--gb);
                display: flex;
                flex-direction: column;
                position: sticky;
                top: 0;
                height: 100vh;
                overflow-y: auto;
            }

            .sb-app {
                font-size: 17px;
                font-weight: 700;
                color: var(--label);
                letter-spacing: -0.4px;
            }

            .sb-sub {
                font-size: 11px;
                color: var(--label3);
                margin-top: 1px;
            }

            .sb-proy {
                margin: 14px 10px 0;
                background: rgba(0,119,200,0.08);
                border: 1px solid rgba(0,119,200,0.18);
                border-radius: 14px;
                padding: 10px 12px;
                cursor: pointer;
            }

            .sb-proy-lbl {
                font-size: 9px;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                color: var(--label3);
                font-weight: 600;
                margin-bottom: 2px;
            }

            .sb-proy-name {
                font-size: 14px;
                font-weight: 700;
                color: var(--azul);
            }

            .sb-proy-meta {
                display: flex;
                align-items: center;
                gap: 4px;
                margin-top: 3px;
                font-size: 11px;
                color: var(--label2);
            }

            .pulse {
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: #34C759;
                flex-shrink: 0;
                animation: pring 2.5s ease infinite;
                display: inline-block;
            }

            @@keyframes pring {
                0% {
                    box-shadow: 0 0 0 0 rgba(52,199,89,.4)
                }

                70% {
                    box-shadow: 0 0 0 5px rgba(52,199,89,0)
                }

                100% {
                    box-shadow: 0 0 0 0 rgba(52,199,89,0)
                }
            }

            .proy-drop {
                display: none;
                margin: 4px 10px;
                background: white;
                border: 1px solid var(--sep);
                border-radius: 14px;
                overflow: hidden;
                box-shadow: var(--sh);
            }

                .proy-drop.open {
                    display: block;
                }

            .proy-drop-item {
                width: 100%;
                padding: 10px 14px;
                background: none;
                border: none;
                border-bottom: 1px solid var(--sep2);
                text-align: left;
                font-size: 13px;
                font-weight: 500;
                cursor: pointer;
                color: var(--label);
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .proy-drop-item:hover {
                    background: var(--fill3);
                }

            .proy-drop-link {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 10px 14px;
                font-size: 13px;
                font-weight: 600;
                color: var(--blue);
                text-decoration: none;
                background: rgba(0,119,200,0.04);
            }

            .sb-sec {
                padding: 14px 16px 4px;
                font-size: 10px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.07em;
                color: var(--label3);
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 12px;
                margin: 1px 6px;
                border-radius: 11px;
                font-size: 14px;
                color: var(--label2);
                text-decoration: none;
                transition: all 0.2s;
            }

                .nav-item:hover {
                    background: var(--fill3);
                    color: var(--label);
                }

                .nav-item.active {
                    background: var(--blue);
                    color: white;
                    font-weight: 600;
                    box-shadow: 0 4px 12px rgba(0,119,200,0.28);
                }

            .nav-ico {
                width: 26px;
                height: 26px;
                border-radius: 7px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                background: var(--fill3);
                flex-shrink: 0;
            }

            .nav-item.active .nav-ico {
                background: rgba(255,255,255,0.2);
            }

            .sb-footer {
                margin-top: auto;
                padding: 10px 12px 20px;
                border-top: 1px solid var(--sep2);
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .sb-av {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                background: linear-gradient(135deg,var(--mid),var(--blue));
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 11px;
                font-weight: 700;
                color: white;
            }

            .sb-logout {
                margin-left: auto;
                width: 26px;
                height: 26px;
                border-radius: 7px;
                background: var(--fill3);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                color: var(--label2);
                text-decoration: none;
            }

                .sb-logout:hover {
                    background: rgba(230,57,70,0.1);
                    color: var(--rojo);
                }

            .main {
                flex: 1;
                display: flex;
                flex-direction: column;
                min-width: 0;
            }

            .topbar {
                height: 50px;
                flex-shrink: 0;
                background: var(--glass);
                backdrop-filter: blur(40px) saturate(180%);
                border-bottom: 1px solid var(--sep);
                padding: 0 18px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                position: sticky;
                top: 0;
                z-index: 50;
            }

            .tb-bread {
                font-size: 13px;
                color: var(--label2);
            }

                .tb-bread strong {
                    color: var(--label);
                    font-weight: 600;
                }

                .tb-bread a {
                    color: var(--label2);
                    text-decoration: none;
                }

            .tb-right {
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .tb-chip {
                display: flex;
                align-items: center;
                gap: 5px;
                background: var(--fill3);
                border: 1px solid var(--sep);
                padding: 4px 10px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 600;
                color: var(--blue);
            }

            .tb-ibtn {
                width: 30px;
                height: 30px;
                border-radius: 9px;
                background: var(--fill3);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 14px;
                text-decoration: none;
                color: var(--label);
            }

            .view {
                flex: 1;
                padding: 18px;
                display: flex;
                flex-direction: column;
                gap: 14px;
            }

            @@keyframes fu {
                from {
                    opacity: 0;
                    transform: translateY(10px)
                }

                to {
                    opacity: 1;
                    transform: translateY(0)
                }
            }

            .inm-card {
                background: linear-gradient(135deg,var(--azul),var(--blue));
                border-radius: 18px;
                padding: 18px 22px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                box-shadow: 0 8px 24px rgba(0,58,112,0.25);
                animation: fu 0.3s ease both;
                flex-wrap: wrap;
                gap: 12px;
            }

            .inm-info h2 {
                font-size: 22px;
                font-weight: 300;
                color: white;
                letter-spacing: -1px;
            }

            .inm-info p {
                font-size: 13px;
                color: rgba(255,255,255,0.7);
                margin-top: 3px;
            }

            .inm-datos {
                display: flex;
                gap: 16px;
            }

            .inm-dato {
                text-align: center;
            }

            .inm-dato-val {
                font-size: 15px;
                font-weight: 600;
                color: white;
            }

            .inm-dato-lbl {
                font-size: 10px;
                color: rgba(255,255,255,0.6);
            }
            /* Precio bloqueado */
            .precio-lock-card {
                background: linear-gradient(135deg,rgba(52,199,89,0.08),rgba(30,168,81,0.05));
                border: 2px solid rgba(52,199,89,0.3);
                border-radius: 14px;
                padding: 16px 20px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 12px;
                animation: fu 0.3s ease both;
            }

            .pl-left {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .pl-badge {
                width: 48px;
                height: 48px;
                border-radius: 12px;
                background: linear-gradient(135deg,#1EA851,#34C759);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
                flex-shrink: 0;
            }

            .pl-info-lbl {
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: 0.06em;
                color: #1EA851;
                font-weight: 600;
                margin-bottom: 2px;
            }

            .pl-info-val {
                font-size: 15px;
                font-weight: 700;
                color: var(--azul);
            }

            .pl-info-sub {
                font-size: 11px;
                color: var(--label2);
                margin-top: 2px;
            }

            .pl-precio-lbl {
                font-size: 10px;
                color: var(--label3);
                font-weight: 600;
                text-transform: uppercase;
                margin-bottom: 2px;
                text-align: right;
            }

            .pl-precio-val {
                font-size: 26px;
                font-weight: 300;
                color: #1EA851;
                letter-spacing: -1px;
            }

            .form-card {
                background: var(--glass);
                backdrop-filter: blur(20px) saturate(180%);
                border: 1px solid var(--gb);
                border-radius: 18px;
                overflow: hidden;
                box-shadow: var(--sh);
                animation: fu 0.3s ease 0.1s both;
                margin-bottom: 14px;
            }

            .form-card-head {
                padding: 14px 18px;
                border-bottom: 1px solid var(--sep2);
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .form-card-title {
                font-size: 15px;
                font-weight: 600;
                color: var(--label);
            }

            .form-body {
                padding: 18px;
            }

            .destino-grid {
                display: grid;
                grid-template-columns: repeat(2,1fr);
                gap: 10px;
            }

            .destino-opt {
                border: 2px solid var(--sep);
                border-radius: 12px;
                padding: 12px 14px;
                cursor: pointer;
                transition: all 0.2s;
                background: white;
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .destino-opt:hover {
                    border-color: var(--blue);
                    background: rgba(0,119,200,0.03);
                }

                .destino-opt.sel {
                    border-color: var(--blue);
                    background: rgba(0,119,200,0.07);
                }

            .destino-ico {
                font-size: 20px;
                flex-shrink: 0;
            }

            .destino-txt {
                font-size: 13px;
                font-weight: 600;
                color: var(--label);
            }

            .destino-sub {
                font-size: 11px;
                color: var(--label3);
                margin-top: 1px;
            }

            .tab-row {
                display: flex;
                background: var(--fill3);
                border-radius: 11px;
                padding: 3px;
                gap: 2px;
                margin-bottom: 16px;
            }

            .tab-btn {
                flex: 1;
                padding: 8px;
                border-radius: 8px;
                border: none;
                background: none;
                font-size: 13px;
                font-weight: 600;
                color: var(--label2);
                cursor: pointer;
                transition: all 0.2s;
            }

                .tab-btn.active {
                    background: white;
                    color: var(--label);
                    box-shadow: 0 1px 4px rgba(0,0,0,0.1);
                }

            .tab-pane {
                display: none;
            }

                .tab-pane.active {
                    display: block;
                }

            .form-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }

            .field {
                display: flex;
                flex-direction: column;
                gap: 5px;
            }

                .field.full {
                    grid-column: 1/-1;
                }

                .field label {
                    font-size: 11px;
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 0.06em;
                    color: var(--label3);
                }

                .field input, .field select {
                    padding: 9px 12px;
                    background: var(--fill3);
                    border: 1px solid var(--sep);
                    border-radius: 10px;
                    font-size: 14px;
                    color: var(--label);
                    outline: none;
                    transition: all 0.2s;
                }

                    .field input:focus, .field select:focus {
                        background: white;
                        border-color: var(--blue);
                        box-shadow: 0 0 0 3px rgba(0,119,200,0.1);
                    }

            .btn-row {
                display: flex;
                gap: 10px;
                justify-content: flex-end;
            }

            .ios-btn {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                background: var(--blue);
                color: white;
                border: none;
                padding: 10px 20px;
                border-radius: 11px;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
                box-shadow: 0 4px 12px rgba(0,119,200,0.28);
                transition: all 0.2s;
                text-decoration: none;
            }

                .ios-btn:hover {
                    background: var(--mid);
                }

                .ios-btn.ghost {
                    background: var(--fill3);
                    color: var(--label);
                    box-shadow: none;
                    border: 1px solid var(--sep);
                }

                    .ios-btn.ghost:hover {
                        background: rgba(120,120,128,0.14);
                    }

            @@media(max-width:700px) {
                .app {
                    flex-direction: column;
                }

                .sidebar {
                    display: none;
                }

                .destino-grid {
                    grid-template-columns: 1fr !important;
                }

                .form-grid {
                    grid-template-columns: 1fr !important;
                }
        }</style>
    </head>
    <body>
        <div class="app">
            <div class="sidebar">
                <div style="display:flex;align-items:center;gap:10px;padding:18px 14px 0;">
                    <div style="width:42px;height:42px;border-radius:12px;overflow:hidden;flex-shrink:0;">
                        <img src="data:image/png;base64," style="width:100%;height:100%;object-fit:cover;display:block;" alt="LG" />
                    </div>
                    <div><div class="sb-app">Londoño Gómez</div><div class="sb-sub">Sistema de Lanzamientos</div></div>
                </div>
                <div class="sb-proy" id="proyBtn" onclick="toggleDrop()">
                    <div class="sb-proy-lbl">PROYECTO ACTIVO ▾</div>
                    <div class="sb-proy-name">@proyActivo</div>
                    <div class="sb-proy-meta"><span class="pulse"></span>Toca para cambiar</div>
                </div>
                <div class="proy-drop" id="proyDrop">
                    @if (proyectos.Count > 0)
                    {
                        foreach (var p in proyectos)
                        {
                            <form action="/Inmuebles/SeleccionarProyecto" method="post" style="margin:0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idProyecto" value="@p.Id" />
                                <input type="hidden" name="nombreProyecto" value="@p.Nombre" />
                                <button type="submit" class="proy-drop-item">🏗 @p.Nombre</button>
                            </form>
                        }
                    }
                    <a href="/Carga/Index" class="proy-drop-link">＋ Cargar nuevo proyecto</a>
                </div>
                <div class="sb-sec">Principal</div>
                <a class="nav-item" href="/Dashboard"><div class="nav-ico">⊞</div>Inicio</a>
                <a class="nav-item" href="/Inmuebles/Proyectos"><div class="nav-ico">🏢</div>Inmuebles</a>
                <a class="nav-item active" href="/Inmuebles/Reservas"><div class="nav-ico">🔒</div>Reservas</a>
                <a class="nav-item" href="/Ventas"><div class="nav-ico">💲</div>Ventas</a>
                <a class="nav-item" href="/Clientes"><div class="nav-ico">👤</div>Clientes</a>
                <div class="sb-sec">General</div>
                <a class="nav-item" href="/Reportes"><div class="nav-ico">📊</div>Reportes</a>
                <a class="nav-item" href="/Carga/Index"><div class="nav-ico">📂</div>Cargar Excel</a>
                <a class="nav-item" href="/Usuarios"><div class="nav-ico">👥</div>Usuarios</a>
                <div class="sb-footer">
                    <div class="sb-av">@iniciales</div>
                    <div><div style="font-size:12px;font-weight:600">@nombre @apellido</div><div style="font-size:10px;color:var(--label3)">Administrador</div></div>
                    <a class="sb-logout" href="/Account/Logout">↩</a>
                </div>
            </div>
            <div class="main">
                <div class="topbar">
                    <span class="tb-bread">
                        <a href="/Inmuebles/Reservas">Reservas</a> › <strong>Continuar venta · Apto @apto</strong>
                    </span>
                    <div class="tb-right"><div class="tb-chip"><span class="pulse"></span>@proyActivo</div><a class="tb-ibtn" href="/Account/Logout">↩</a></div>
                </div>
                <div class="view">
                    <!-- Info inmueble -->
                    <div class="inm-card">
                        <div class="inm-info">
                            <h2>Apto @apto</h2>
                            <p>Torre @torre · @tipo · @metros m² · Reservado por 👤 @vendedor</p>
                        </div>
                        <div class="inm-datos">
                            <div class="inm-dato"><div class="inm-dato-val">@torre</div><div class="inm-dato-lbl">Torre</div></div>
                            <div class="inm-dato"><div class="inm-dato-val">@metros m²</div><div class="inm-dato-lbl">Área</div></div>
                            <div class="inm-dato"><div class="inm-dato-val">@tipo</div><div class="inm-dato-lbl">Tipo</div></div>
                        </div>
                    </div>

                    <form action="/Inmuebles/ConfirmarVentaReserva" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idInmueble" value="@idInmueble" />
                        <input type="hidden" name="precioVenta" value="@precioReserva" />
                        <input type="hidden" name="tipoCliente" id="tipoCliente" value="existente" />
                        <input type="hidden" name="destino" id="destinoInput" value="Vivienda" />

                        <!-- Precio bloqueado -->
                        <div class="form-card">
                            <div class="form-card-head"><span style="font-size:18px">🔒</span><span class="form-card-title">Precio bloqueado al reservar</span></div>
                            <div class="form-body">
                                <div class="precio-lock-card">
                                    <div class="pl-left">
                                        <div class="pl-badge">🔒</div>
                                        <div>
                                            <div class="pl-info-lbl">Precio garantizado</div>
                                            <div class="pl-info-val">Este precio fue comprometido con el cliente</div>
                                            <div class="pl-info-sub">No puede modificarse — fue bloqueado al momento de la reserva</div>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="pl-precio-lbl">Precio final</div>
                                        <div class="pl-precio-val">$@precioReserva.ToString("N0")</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Destino -->
                        <div class="form-card">
                            <div class="form-card-head"><span style="font-size:18px">🏷️</span><span class="form-card-title">Destino del inmueble</span></div>
                            <div class="form-body">
                                <div class="destino-grid">
                                    <div class="destino-opt sel" onclick="selDestino('Vivienda',this)">
                                        <span class="destino-ico">🏠</span>
                                        <div><div class="destino-txt">Vivienda</div><div class="destino-sub">Para uso habitacional</div></div>
                                    </div>
                                    <div class="destino-opt" onclick="selDestino('Inversión para reventa',this)">
                                        <span class="destino-ico">📈</span>
                                        <div><div class="destino-txt">Inversión para reventa</div><div class="destino-sub">Plusvalía a futuro</div></div>
                                    </div>
                                    <div class="destino-opt" onclick="selDestino('Inversión para arriendo',this)">
                                        <span class="destino-ico">🔑</span>
                                        <div><div class="destino-txt">Inversión para arriendo</div><div class="destino-sub">Renta mensual</div></div>
                                    </div>
                                    <div class="destino-opt" onclick="selDestino('Cesión de derechos',this)">
                                        <span class="destino-ico">📋</span>
                                        <div><div class="destino-txt">Cesión de derechos</div><div class="destino-sub">Transferencia de contrato</div></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Cliente -->
                        <div class="form-card">
                            <div class="form-card-head"><span style="font-size:18px">👤</span><span class="form-card-title">Cliente</span></div>
                            <div class="form-body">
                                <div class="tab-row">
                                    <button type="button" class="tab-btn active"
                                            onclick="document.getElementById('tipoCliente').value='existente';setTab('existente',this)">
                                        Cliente existente
                                    </button>
                                    <button type="button" class="tab-btn"
                                            onclick="document.getElementById('tipoCliente').value='nuevo';setTab('nuevo',this)">
                                        Nuevo cliente
                                    </button>
                                </div>
                                <div class="tab-pane active" id="tab-existente">
                                    <div class="field">
                                        <label>Seleccionar cliente</label>
                                        <select name="idClienteExistente">
                                            <option value="0">— Selecciona un cliente —</option>
                                            @foreach (var c in clientes)
                                            {
                                                <option value="@c.Id">@c.Nombre — @c.Documento</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="tab-pane" id="tab-nuevo">
                                    <div class="form-grid">
                                        <div class="field"><label>Nombre</label><input type="text" name="clienteNombre" placeholder="Nombre" /></div>
                                        <div class="field"><label>Apellido</label><input type="text" name="clienteApellido" placeholder="Apellido" /></div>
                                        <div class="field"><label>Documento</label><input type="text" name="clienteDocumento" placeholder="CC / NIT" /></div>
                                        <div class="field"><label>Celular</label><input type="text" name="clienteCelular" placeholder="Celular" /></div>
                                        <div class="field full"><label>Correo</label><input type="email" name="clienteCorreo" placeholder="correo@email.com" /></div>
                                        <div class="field full"><label>Dirección</label><input type="text" name="clienteDireccion" placeholder="Dirección de residencia" /></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="btn-row">
                            <a href="/Inmuebles/Reservas" class="ios-btn ghost">← Volver</a>
                            <button type="submit" class="ios-btn">✓ Confirmar venta</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <script>
                function selDestino(val,el){
                    document.getElementById('destinoInput').value=val;
                    document.querySelectorAll('.destino-opt').forEach(x=>x.classList.remove('sel'));
                    el.classList.add('sel');
                }
                function setTab(tab,btn){
                    document.querySelectorAll('.tab-btn').forEach(x=>x.classList.remove('active'));
                    document.querySelectorAll('.tab-pane').forEach(x=>x.classList.remove('active'));
                    btn.classList.add('active');
                    document.getElementById('tab-'+tab).classList.add('active');
                }
                function toggleDrop(){document.getElementById('proyDrop').classList.toggle('open');}
                document.addEventListener('click',function(e){
                    var b=document.getElementById('proyBtn'),d=document.getElementById('proyDrop');
                    if(b&&d&&!b.contains(e.target)&&!d.contains(e.target))d.classList.remove('open');
                });
        </script>
    </body>
</html>