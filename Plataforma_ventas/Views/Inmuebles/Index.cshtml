@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Londoño Gómez — Proyectos";
    ViewBag.ActiveNav = "inmuebles";
    ViewBag.TbBread   = "Proyectos";

    var nombre = ViewBag.Nombre as string ?? "Admin";
    var apellido = ViewBag.Apellido as string ?? "";
    var proyActivo = ViewBag.ProyectoActivo as string ?? "Sin proyecto";
    var inmuebles = ViewBag.Inmuebles as List<dynamic> ?? new List<dynamic>();
    int total = ViewBag.Total != null ? (int)ViewBag.Total : 0;
    int disponibles = ViewBag.Disponibles != null ? (int)ViewBag.Disponibles : 0;
    int reservados = ViewBag.Reservados != null ? (int)ViewBag.Reservados : 0;
    int vendidos = ViewBag.Vendidos != null ? (int)ViewBag.Vendidos : 0;
    int enProceso = ViewBag.EnProceso != null ? (int)ViewBag.EnProceso : 0;
    int la = ViewBag.ListaActual != null ? (int)ViewBag.ListaActual : 1;
    int aptsPorLista = ViewBag.AptsPorLista != null ? (int)ViewBag.AptsPorLista : 0;
    int proximaLista = ViewBag.ProximaLista != null ? (int)ViewBag.ProximaLista : 0;
    var torres = ViewBag.Torres as List<string> ?? new List<string>();
    var torreActual = ViewBag.TorreActual as string ?? "";
    var areaActual = ViewBag.AreaActual as string ?? "";
    var grupos = ViewBag.Grupos as List<dynamic> ?? new List<dynamic>();
    var vendedores = ViewBag.Vendedores as Dictionary<int, string> ?? new Dictionary<int, string>();
    var listasXArea = ViewBag.ListasXArea as Dictionary<string, int> ?? new Dictionary<string, int>();
    var aptsXArea   = ViewBag.AptsXArea  as Dictionary<string, int> ?? new Dictionary<string, int>();
    var proyHermanos = ViewBag.ProyectosHermanos as List<(int Id, string Nombre)> ?? new List<(int, string)>();
    var iniciales = ((nombre.Length >= 1 ? nombre.Substring(0, 1) : "") + (apellido.Length >= 1 ? apellido.Substring(0, 1) : "")).ToUpper();
    ViewBag.Iniciales = iniciales;
    int laEstaArea = la;
    if (!string.IsNullOrEmpty(areaActual))
        laEstaArea = listasXArea.ContainsKey(areaActual) ? listasXArea[areaActual] : la;
}
@section Styles {
<style>
    @@keyframes fu{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    .resumen-banner{background:linear-gradient(135deg,var(--azul),var(--blue));border-radius:18px;padding:16px 22px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 8px 24px rgba(0,118,227,0.25);animation:fu 0.3s ease both;flex-wrap:wrap;gap:12px;}
    .rb-title{font-size:18px;font-weight:700;color:white;letter-spacing:-0.5px;}
    .rb-sub{font-size:12px;color:rgba(255,255,255,0.7);margin-top:2px;}
    .rb-stats{display:flex;gap:20px;flex-wrap:wrap;}
    .rb-stat{text-align:center;}
    .rb-stat-num{font-size:20px;font-weight:300;color:white;letter-spacing:-1px;}
    .rb-stat-lbl{font-size:10px;color:rgba(255,255,255,0.6);text-transform:uppercase;letter-spacing:0.05em;}
    .rb-lista{background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.25);border-radius:10px;padding:8px 14px;text-align:center;}
    .rb-lista-num{font-size:22px;font-weight:700;color:white;}
    .rb-lista-lbl{font-size:10px;color:rgba(255,255,255,0.7);}
    .rb-proxima{font-size:11px;color:rgba(255,255,255,0.6);margin-top:2px;}
    .torre-banner{background:linear-gradient(135deg,var(--azul),var(--blue));border-radius:14px;padding:12px 18px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 4px 16px rgba(0,118,227,0.2);}
    .torre-banner-left{display:flex;align-items:center;gap:12px;}
    .torre-banner-btn{background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.3);color:white;padding:6px 14px;border-radius:9px;font-size:12px;font-weight:600;cursor:pointer;text-decoration:none;}
    .torre-select-screen{display:flex;flex-direction:column;align-items:center;gap:24px;padding:48px 0;animation:fu 0.4s ease both;}
    .torres-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;width:100%;max-width:700px;}
    .torre-card{background:var(--glass);border:2px solid var(--gb);border-radius:20px;padding:24px 20px;text-align:center;cursor:pointer;transition:all 0.2s;box-shadow:var(--sh);text-decoration:none;display:flex;flex-direction:column;align-items:center;gap:10px;}
    .torre-card:hover{border-color:var(--blue);transform:translateY(-3px);box-shadow:var(--sh2);}
    .areas-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px;animation:fu 0.35s ease both;}
    .area-card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:2px solid var(--gb);border-radius:20px;padding:20px;transition:all 0.2s;box-shadow:var(--sh);display:block;}
    .area-card:hover{border-color:var(--blue);box-shadow:var(--sh2);}
    .area-card-link{display:block;cursor:pointer;text-decoration:none;}
    .area-card-link:hover .area-metros{color:var(--blue);}
    .area-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;}
    .area-metros{font-size:22px;font-weight:700;color:var(--azul);letter-spacing:-0.5px;transition:color 0.2s;}
    .area-tipo-ext{background:rgba(255,149,0,0.12);color:#CC7700;font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;}
    .area-tipo-int{background:rgba(0,118,227,0.1);color:var(--blue);font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;}
    .area-precio{font-size:17px;font-weight:600;color:var(--azul);margin-bottom:10px;}
    .area-precio-lbl{font-size:10px;color:var(--label3);font-weight:600;text-transform:uppercase;margin-bottom:2px;}
    .area-listas{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px;}
    .area-lista-chip{font-size:10px;font-weight:600;padding:3px 9px;border-radius:10px;background:var(--fill3);color:var(--label2);border:none;cursor:pointer;transition:all 0.2s;}
    .area-lista-chip:hover{background:var(--fill2);color:var(--label);}
    .area-lista-chip.activa{background:linear-gradient(135deg,var(--azul),var(--celeste));color:white;box-shadow:0 2px 8px rgba(0,96,187,0.25);}
    .prog-wrap{margin-bottom:6px;}
    .prog-bar{height:6px;border-radius:10px;background:var(--fill2);overflow:hidden;}
    .prog-fill{height:100%;border-radius:10px;background:linear-gradient(90deg,var(--verde),#1EA851);transition:width 0.4s ease;}
    .prog-fill.naranja{background:linear-gradient(90deg,var(--oro),#CC7700);}
    .prog-fill.rojo{background:linear-gradient(90deg,var(--rojo),#B02030);}
    .prog-lbl{display:flex;justify-content:space-between;font-size:11px;color:var(--label2);margin-top:3px;}
    .card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:18px;overflow:hidden;box-shadow:var(--sh);animation:fu 0.35s ease 0.1s both;}
    .card-head{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--sep2);flex-wrap:wrap;gap:8px;}
    .card-title{font-size:15px;font-weight:600;color:var(--label);}
    .tbl-wrap{overflow-x:auto;}
    .tbl{width:100%;border-collapse:collapse;}
    .tbl thead{position:sticky;top:0;z-index:2;background:rgba(255,255,255,0.95);backdrop-filter:blur(10px);}
    .tbl th{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--label3);padding:10px 16px;text-align:left;border-bottom:1px solid var(--sep2);}
    .tbl td{padding:11px 16px;font-size:13px;color:var(--label);border-bottom:1px solid var(--sep2);}
    .tbl tr:last-child td{border-bottom:none;}
    .tbl tr:hover td{background:var(--fill3);}
    .bdg{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:600;}
    .bdg::before{content:'';width:5px;height:5px;border-radius:50%;flex-shrink:0;}
    .bdg.D{background:rgba(230,57,70,0.12);color:var(--rojo)}.bdg.D::before{background:var(--rojo)}
    .bdg.V{background:rgba(52,199,89,0.12);color:#1EA851}.bdg.V::before{background:#34C759}
    .bdg.R{background:rgba(255,149,0,0.12);color:#CC7700}.bdg.R::before{background:var(--oro)}
    .bdg.EP{background:rgba(90,90,200,0.12);color:#5A5AC8}.bdg.EP::before{background:#5A5AC8}
    .quien{display:inline-block;font-size:11px;font-weight:600;margin-top:3px;}
    .quien::before{content:'';display:inline-block;width:11px;height:11px;margin-right:4px;vertical-align:-2px;border-radius:50%;background:currentColor;opacity:.25;}
    .filter-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
    .search-wrap{position:relative;max-width:220px;}
    .search-wrap input{width:100%;padding:7px 12px 7px 30px;background:var(--fill3);border:1px solid var(--sep);border-radius:10px;font-size:13px;color:var(--label);outline:none;transition:all 0.2s;}
    .search-wrap input:focus{background:white;border-color:var(--blue);}
    .search-ico{position:absolute;left:9px;top:50%;transform:translateY(-50%);font-size:12px;color:var(--label3);pointer-events:none;}
    .seg{display:flex;background:var(--fill3);border-radius:10px;padding:3px;gap:2px;}
    .seg-btn{padding:5px 10px;border-radius:7px;font-size:12px;font-weight:600;color:var(--label2);cursor:pointer;border:none;background:none;transition:all 0.2s;}
    .seg-btn.active{background:white;color:var(--label);box-shadow:0 1px 4px rgba(0,0,0,0.1);}
    .btn-accion{border:none;padding:5px 10px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;transition:all 0.2s;margin-right:3px;}
    .btn-vender{background:rgba(0,118,227,0.1);color:var(--blue);}
    .btn-vender:hover{background:rgba(0,118,227,0.2);}
    .btn-reservar{background:rgba(255,149,0,0.12);color:#CC7700;}
    .btn-reservar:hover{background:rgba(255,149,0,0.22);}
    .btn-liberar{background:rgba(230,57,70,0.1);color:var(--rojo);}
    .btn-liberar:hover{background:rgba(230,57,70,0.2);}
    .alerta-exito{background:rgba(52,199,89,0.1);border:1px solid rgba(52,199,89,0.3);border-radius:12px;padding:10px 16px;font-size:13px;font-weight:600;color:#1EA851;}
    .alerta-error{background:rgba(230,57,70,0.1);border:1px solid rgba(230,57,70,0.3);border-radius:12px;padding:10px 16px;font-size:13px;font-weight:600;color:var(--rojo);}
    .area-volver{display:inline-flex;align-items:center;gap:6px;background:var(--fill3);border:1px solid var(--sep);color:var(--label);padding:7px 14px;border-radius:10px;font-size:13px;font-weight:600;text-decoration:none;transition:background 0.2s;}
    .area-volver:hover{background:var(--fill2);}
    .empty{padding:48px;text-align:center;}
    .empty-ico{font-size:40px;opacity:0.4;margin-bottom:8px;}
    .empty-txt{font-size:15px;font-weight:600;color:var(--label2);}
    .modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:300;backdrop-filter:blur(4px);align-items:center;justify-content:center;}
    .modal-overlay.open{display:flex;}
    .modal-box{background:white;border-radius:20px;padding:28px;width:100%;max-width:400px;margin:16px;box-shadow:0 20px 60px rgba(0,0,0,0.2);animation:fu 0.25s ease both;}
    .modal-title{font-size:17px;font-weight:700;color:var(--azul);margin-bottom:4px;}
    .modal-sub{font-size:13px;color:var(--label2);margin-bottom:20px;}
    .modal-field{margin-bottom:14px;}
    .modal-field label{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--label2);margin-bottom:5px;}
    .modal-field select,.modal-field input[type=number]{width:100%;padding:10px 14px;background:var(--fill3);border:1px solid var(--sep);border-radius:10px;font-size:14px;color:var(--label);outline:none;}
    .modal-field select:focus,.modal-field input:focus{border-color:var(--blue);background:white;}
    .modal-btns{display:flex;gap:8px;justify-content:flex-end;margin-top:20px;}
    .btn-modal-cancel{padding:9px 18px;border-radius:10px;border:1px solid var(--sep);background:var(--fill3);font-size:13px;font-weight:600;cursor:pointer;color:var(--label);}
    .btn-modal-save{padding:9px 18px;border-radius:10px;border:none;background:var(--blue);color:white;font-size:13px;font-weight:600;cursor:pointer;}
    .btn-editar-precio{width:100%;margin-top:8px;padding:7px 10px;background:rgba(0,118,227,0.08);border:1px solid rgba(0,118,227,0.2);color:var(--blue);border-radius:9px;font-size:12px;font-weight:600;cursor:pointer;transition:background 0.2s;}
    .btn-editar-precio:hover{background:rgba(0,118,227,0.16);}
    .auto-area-box{margin-top:8px;padding:10px;background:rgba(52,199,89,0.06);border:1px solid rgba(52,199,89,0.2);border-radius:10px;}
    .auto-area-lbl{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#1EA851;margin-bottom:6px;display:block;}
    .auto-area-row{display:flex;gap:6px;align-items:center;}
    .auto-area-input{flex:1;min-width:0;padding:6px 10px;border-radius:8px;border:1px solid rgba(52,199,89,0.3);background:white;font-size:13px;color:var(--label);outline:none;}
    .auto-area-input:focus{border-color:#34C759;}
    .auto-area-btn{padding:6px 12px;border-radius:8px;border:none;background:#34C759;color:white;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;}
    .auto-area-btn:hover{background:#1EA851;}
    .auto-area-off{padding:6px 10px;border-radius:8px;border:none;background:rgba(230,57,70,0.08);color:var(--rojo);font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;}
    .auto-area-off:hover{background:rgba(230,57,70,0.16);}
    .auto-area-status{font-size:11px;color:#1EA851;margin-top:5px;font-weight:600;}
    @@media(max-width:1200px){.areas-grid{grid-template-columns:repeat(3,1fr)!important;}}
    @@media(max-width:1024px){.areas-grid{grid-template-columns:repeat(2,1fr)!important;}}
    @@media(max-width:700px){
        .areas-grid{grid-template-columns:1fr 1fr!important;}
        .tbl{min-width:600px!important;}
        .resumen-banner{flex-direction:column!important;gap:10px!important;}
        .rb-stats{justify-content:center!important;}
    }
    .modal-fondo{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);backdrop-filter:blur(3px);z-index:9000;align-items:center;justify-content:center;padding:20px;}
    .modal-caja{background:white;border-radius:20px;padding:24px;width:100%;max-width:460px;box-shadow:0 20px 60px rgba(0,0,0,0.25);}
    .modal-titulo{font-size:18px;font-weight:700;color:var(--label);letter-spacing:-0.4px;margin-bottom:8px;}
    .modal-texto{font-size:13px;color:var(--label2);line-height:1.5;margin-bottom:16px;}
    .modal-lbl{display:block;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--label3);margin-bottom:6px;}
    .modal-input{width:100%;padding:10px 12px;border:1px solid var(--sep);border-radius:10px;font-size:13px;font-family:inherit;color:var(--label);background:var(--fill3);outline:none;resize:vertical;}
    .modal-input:focus{border-color:var(--blue);background:white;box-shadow:0 0 0 3px rgba(0,118,227,0.08);}
    .modal-acciones{display:flex;gap:10px;justify-content:flex-end;margin-top:18px;}
    .btn-cancelar{background:var(--fill3);color:var(--label);border:1px solid var(--sep);padding:9px 18px;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;}
    .btn-confirmar-res{background:#CC7700;color:white;border:none;padding:9px 18px;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;}
    .btn-confirmar-res:hover{background:#A66000;}
</style>
}

@if (TempData["Exito"] != null) { <div class="alerta-exito">&#10003; @TempData["Exito"]</div> }
@if (TempData["Error"] != null) { <div class="alerta-error">&#10007; @TempData["Error"]</div> }

@if (string.IsNullOrEmpty(torreActual) && torres.Count > 1)
{
    <div class="torre-select-screen">
        <div style="text-align:center">
            <div style="font-size:22px;font-weight:700;color:var(--azul)">Selecciona una torre</div>
            <div style="font-size:14px;color:var(--label2);margin-top:6px">Proyecto @proyActivo tiene varias torres</div>
        </div>
        <div class="torres-grid">
            @foreach (var p in proyHermanos)
            {
                <a href="/Inmuebles?torre=@Uri.EscapeDataString(p.Nombre)" class="torre-card">
                    <div style="font-size:36px">&#127970;</div>
                    <div style="font-size:16px;font-weight:700;color:var(--azul)">@p.Nombre</div>
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="resumen-banner">
        <div>
            <div class="rb-title">@proyActivo</div>
            <div class="rb-sub">@total inmuebles en total</div>
        </div>
        <div class="rb-stats">
            <div class="rb-stat"><div class="rb-stat-num" id="kpi-disp">@disponibles</div><div class="rb-stat-lbl">Disponibles</div></div>
            <div class="rb-stat"><div class="rb-stat-num" id="kpi-vend">@vendidos</div><div class="rb-stat-lbl">Vendidos</div></div>
            <div class="rb-stat"><div class="rb-stat-num" id="kpi-proc">@enProceso</div><div class="rb-stat-lbl">En proceso</div></div>
            <div class="rb-stat"><div class="rb-stat-num" id="kpi-res">@reservados</div><div class="rb-stat-lbl">Reservados</div></div>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(torreActual) && torres.Count > 1)
    {
        <div class="torre-banner">
            <div class="torre-banner-left">
                <div style="font-size:22px">&#127970;</div>
                <div>
                    <div style="font-size:15px;font-weight:700;color:white">@torreActual</div>
                    <div style="font-size:11px;color:rgba(255,255,255,0.7)">Torre activa</div>
                </div>
            </div>
            <a href="/Inmuebles" class="torre-banner-btn">&#8617; Cambiar torre</a>
        </div>
    }
    @if (string.IsNullOrEmpty(areaActual))
    {
        <div style="font-size:15px;font-weight:600;color:var(--label);margin-bottom:-4px">Selecciona un área para ver los inmuebles</div>
        <div class="areas-grid">
            @foreach (var g in grupos)
            {
                var porcVend = g.Total > 0 ? (int)Math.Round((double)g.Vendidos / g.Total * 100) : 0;
                // Semáforo sobre el % vendido: mucho vendido es buena noticia (verde),
                // poco vendido es inventario por colocar (rojo).
                var fillCls = porcVend >= 80 ? "" : porcVend >= 50 ? "naranja" : "rojo";
                var tipoLabel = g.Tipo?.ToString() ?? "";
                var tipoClass = tipoLabel == "EXT" ? "area-tipo-ext" : "area-tipo-int";
                var metrosStr = g.Metros.ToString();
                var laArea  = listasXArea.ContainsKey(metrosStr) ? listasXArea[metrosStr] : la;
                var aptsArea = aptsXArea.ContainsKey(metrosStr)  ? aptsXArea[metrosStr]  : 0;
                long p1 = (long)g.PrecioL1; long p2 = (long)g.PrecioL2; long p3 = (long)g.PrecioL3;
                long p4 = (long)g.PrecioL4; long p5 = (long)g.PrecioL5;
                long precActArea = laArea == 1 ? p1 : laArea == 2 ? p2 : laArea == 3 ? p3 : laArea == 4 ? p4 : p5;
                if (precActArea == 0) precActArea = (long)g.PrecioActivo;
                <div class="area-card">
                    <div class="area-card-link" onclick="window.location='/Inmuebles?area=@Uri.EscapeDataString(metrosStr)'">
                        <div class="area-top">
                            <div class="area-metros">@g.Metros <span style="font-size:13px;font-weight:400;color:var(--label2)">m²</span></div>
                            <span class="@tipoClass">@tipoLabel</span>
                        </div>
                        <div class="area-precio-lbl">Precio lista @laArea</div>
                        <div class="area-precio">$@string.Format("{0:N0}", precActArea)</div>
                        <div class="area-listas">
                            @for (int ln = 1; ln <= 5; ln++)
                            {
                                long pl = ln == 1 ? p1 : ln == 2 ? p2 : ln == 3 ? p3 : ln == 4 ? p4 : p5;
                                if (pl > 0)
                                {
                                    var chipCls = ln == laArea ? "area-lista-chip activa" : "area-lista-chip";
                                    <form action="/Inmuebles/CambiarListaArea" method="post" style="display:inline;margin:0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="metros" value="@metrosStr"/>
                                        <input type="hidden" name="listaActual" value="@ln"/>
                                        <button type="submit" class="@chipCls"
                                                onclick="event.stopPropagation()@(ln == laArea ? ";return false;" : "")"
                                                title="@(ln == laArea ? "Lista activa" : "Activar Lista " + ln)">
                                            L@(ln): $@string.Format("{0:N0}", pl)
                                        </button>
                                    </form>
                                }
                            }
                        </div>
                        <div class="prog-wrap">
                            <div class="prog-bar"><div class="prog-fill @fillCls" style="width:@(porcVend)%"></div></div>
                            <div class="prog-lbl">
                                <span>@g.Disponibles disp · @g.Vendidos vend</span>
                                <span>@(porcVend)%</span>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-editar-precio" onclick="abrirModal('@metrosStr',@p1,@p2,@p3,@p4,@p5,@laArea)">
                        &#9998; Editar precio de lista
                    </button>
                    <div class="auto-area-box" onclick="event.stopPropagation()">
                        <span class="auto-area-lbl">&#9889; Subida automática</span>
                        <form action="/Inmuebles/ConfigurarAutoArea" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="metros" value="@metrosStr"/>
                            <div class="auto-area-row">
                                <input type="number" name="aptsPorLista" class="auto-area-input" min="0"
                                       value="@(aptsArea > 0 ? aptsArea.ToString() : "")" placeholder="Ej: 5"/>
                                <button type="submit" class="auto-area-btn">&#10003;</button>
                                @if (aptsArea > 0)
                                {
                                    <form action="/Inmuebles/ConfigurarAutoArea" method="post" style="margin:0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="metros" value="@metrosStr"/>
                                        <input type="hidden" name="aptsPorLista" value="0"/>
                                        <button type="submit" class="auto-area-off" title="Desactivar">&#10005;</button>
                                    </form>
                                }
                            </div>
                        </form>
                        @if (aptsArea > 0)
                        {
                            <div class="auto-area-status">&#10003; Sube cada @aptsArea vendidos · Lista @laArea activa</div>
                        }
                        else
                        {
                            <div class="auto-area-status" style="color:var(--label2)">&#128274; Modo manual · Lista @laArea fija</div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
            <a href="/Inmuebles" class="area-volver">&#8592; Todas las áreas</a>
            <span style="font-size:15px;font-weight:600;color:var(--label)">@areaActual m² · @inmuebles.Count inmuebles</span>
        </div>
        <div class="card">
            <div class="card-head">
                <span class="card-title">Lista de inmuebles · @areaActual m² · Lista @laEstaArea</span>
                <div class="filter-bar">
                    <div class="search-wrap"><span class="search-ico">&#128269;</span><input type="text" id="buscar" placeholder="Buscar apto, piso..." oninput="filtrar()"/></div>
                    <div class="seg">
                        <button class="seg-btn active" onclick="setFiltro('todos',this)">Todos</button>
                        <button class="seg-btn" onclick="setFiltro('DISPONIBLE',this)">Disponibles</button>
                        <button class="seg-btn" onclick="setFiltro('RESERVADO',this)">Reservados</button>
                        <button class="seg-btn" onclick="setFiltro('EN PROCESO',this)">En proceso</button>
                        <button class="seg-btn" onclick="setFiltro('VENDIDO',this)">Vendidos</button>
                    </div>
                </div>
            </div>
            @if (inmuebles.Count > 0)
            {
                <div class="tbl-wrap">
                    <table class="tbl" id="tablaInmuebles">
                        <thead>
                            <tr>
                                <th>Apto</th><th>Tipo</th><th>Piso</th><th>Metros</th>
                                <th>Precio Lista @laEstaArea</th><th>Torre</th><th>Estado</th><th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in inmuebles)
                            {
                                var cls = i.Estado == "DISPONIBLE" ? "D" : i.Estado == "VENDIDO" ? "V" : i.Estado == "EN PROCESO" ? "EP" : "R";
                                var precioLista = laEstaArea == 1 ? i.Lista1 : laEstaArea == 2 ? i.Lista2 : laEstaArea == 3 ? i.Lista3 : laEstaArea == 4 ? i.Lista4 : i.Lista5;
                                var plLimpio = (precioLista?.ToString() ?? "0").Replace("$", "").Replace(".", "").Replace(",", "").Replace(" ", "").Trim();
                                <tr data-estado="@i.Estado" data-id="@i.Id">
                                    <td style="font-weight:600">@i.Apto</td>
                                    <td>
                                        @if (i.Tipo == "EXT") {
                                            <span style="background:rgba(255,149,0,0.12);color:#CC7700;font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px">EXT</span>
                                        } else if (i.Tipo == "INT") {
                                            <span style="background:rgba(0,118,227,0.1);color:var(--blue);font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px">INT</span>
                                        } else { <span>@i.Tipo</span> }
                                    </td>
                                    <td>@i.Piso</td>
                                    <td>@i.Metros m²</td>
                                    <td style="font-weight:500;color:var(--azul)">$@(string.Format("{0:N0}", long.TryParse(plLimpio, out long lp) ? lp : 0))</td>
                                    <td>@i.Torre</td>
                                    <td class="estado-td">
                                        <span class="bdg @cls">@i.Estado</span>
                                        @if (i.Estado == "EN PROCESO" && i.IdVendedorEnProceso > 0) {
                                            var nomVend = vendedores.ContainsKey(i.IdVendedorEnProceso) ? vendedores[i.IdVendedorEnProceso] : "Usuario retirado";
                                            <br/><span class="quien" style="color:#5A5AC8">@nomVend</span>
                                        }
                                        else if (i.Estado == "RESERVADO" && i.IdVendedorReserva > 0) {
                                            var nomRes = vendedores.ContainsKey(i.IdVendedorReserva) ? vendedores[i.IdVendedorReserva] : "Usuario retirado";
                                            <br/><span class="quien" style="color:#CC7700">@nomRes</span>
                                        }
                                    </td>
                                    <td class="accion-td">
                                        @if (i.Estado == "DISPONIBLE") {
                                            <form action="/Inmuebles/TomarInmueble" method="post" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idInmueble" value="@i.Id"/>
                                                <button type="submit" class="btn-accion btn-vender">Vender</button>
                                            </form>
                                            <button type="button" class="btn-accion btn-reservar" onclick="abrirReserva(@i.Id, '@i.Apto')">Reservar</button>
                                        } else if (i.Estado == "RESERVADO") {
                                            <form action="/Inmuebles/LiberarReserva" method="post" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idInmueble" value="@i.Id"/>
                                                <button type="submit" class="btn-accion btn-liberar" onclick="return confirm('¿Liberar esta reserva?')">Liberar</button>
                                            </form>
                                        } else if (i.Estado == "EN PROCESO") {
                                            <form action="/Inmuebles/CancelarProceso" method="post" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idInmueble" value="@i.Id"/>
                                                <button type="submit" class="btn-accion btn-liberar" onclick="return confirm('¿Cancelar este proceso?')">Cancelar</button>
                                            </form>
                                        } else {
                                            <span style="color:var(--label3);font-size:12px">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty"><div class="empty-ico">&#127970;</div><div class="empty-txt">No hay inmuebles en esta área</div></div>
            }
        </div>
    }
}

<!-- Edit price modal -->
<div class="modal-overlay" id="modalEditar">
    <div class="modal-box">
        <div class="modal-title">&#9998; Editar precio de lista</div>
        <div class="modal-sub" id="modalSub">Área seleccionada</div>
        <form action="/Inmuebles/EditarPrecioArea" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="metros" id="modalMetros"/>
            <div class="modal-field">
                <label>Lista a modificar</label>
                <select name="numLista" id="modalNumLista"></select>
            </div>
            <div class="modal-field">
                <label>Nuevo precio</label>
                <input type="number" name="nuevoPrecio" id="modalPrecio" placeholder="Ej: 480000000" min="0" required/>
            </div>
            <div class="modal-btns">
                <button type="button" class="btn-modal-cancel" onclick="cerrarModal()">Cancelar</button>
                <button type="submit" class="btn-modal-save">Guardar precio</button>
            </div>
        </form>
    </div>
</div>


<!-- Diálogo de reserva -->
<div class="modal-fondo" id="modalReserva">
    <div class="modal-caja">
        <div class="modal-titulo">Reservar inmueble</div>
        <p class="modal-texto">
            Vas a reservar el apartamento <strong id="resApto"></strong>.
            El precio queda bloqueado con la lista vigente.
        </p>
        <form action="/Inmuebles/ReservarInmueble" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="idInmueble" id="resId"/>
            <label class="modal-lbl" for="observacion">Observaciones <span style="text-transform:none;font-weight:500;color:var(--label3)">(opcional)</span></label>
            <textarea name="observacion" id="observacion" rows="3" maxlength="500" class="modal-input"
                      placeholder="Datos del interesado, condiciones acordadas, hasta cuándo sostener..."></textarea>
            <div class="modal-acciones">
                <button type="button" class="btn-cancelar" onclick="cerrarReserva()">Cancelar</button>
                <button type="submit" class="btn-confirmar-res">Reservar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    /* Reserva con observación opcional */
    function abrirReserva(id, apto){
        document.getElementById('resId').value = id;
        document.getElementById('resApto').textContent = apto;
        document.getElementById('observacion').value = '';
        document.getElementById('modalReserva').style.display = 'flex';
        setTimeout(function(){ document.getElementById('observacion').focus(); }, 50);
    }
    function cerrarReserva(){ document.getElementById('modalReserva').style.display = 'none'; }
    document.getElementById('modalReserva').addEventListener('click', function(e){ if (e.target === this) cerrarReserva(); });
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape') cerrarReserva(); });

    let filtroActual='todos';
    function setFiltro(f,btn){filtroActual=f;document.querySelectorAll('.seg-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active');filtrar();}
    function filtrar(){
        const q=document.getElementById('buscar')?.value.toLowerCase()||'';
        document.querySelectorAll('#tablaInmuebles tbody tr').forEach(tr=>{
            const matchF=filtroActual==='todos'||tr.dataset.estado===filtroActual;
            tr.style.display=matchF&&tr.innerText.toLowerCase().includes(q)?'':'none';
        });
    }
    function abrirModal(metros,p1,p2,p3,p4,p5,laActual){
        document.getElementById('modalMetros').value=metros;
        document.getElementById('modalSub').textContent='Área '+metros+' m² — Lista activa: '+laActual;
        var sel=document.getElementById('modalNumLista');
        sel.innerHTML='';
        [p1,p2,p3,p4,p5].forEach(function(p,i){
            if(p>0){
                var opt=document.createElement('option');
                opt.value=i+1;
                opt.textContent='Lista '+(i+1)+': $'+Number(p).toLocaleString('es-CO');
                if((i+1)===laActual)opt.selected=true;
                sel.appendChild(opt);
            }
        });
        document.getElementById('modalPrecio').value='';
        document.getElementById('modalEditar').classList.add('open');
    }
    function cerrarModal(){document.getElementById('modalEditar').classList.remove('open');}
    document.addEventListener('click',function(e){
        var ov=document.getElementById('modalEditar');
        if(ov&&e.target===ov)cerrarModal();
    });
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    var proyIdSR = @((int)(ViewBag.ProyectoId ?? 0));
    var kpiDisp = @disponibles;
    var kpiProc = @enProceso;
    var kpiRes  = @reservados;
    var kpiVend = @vendidos;

    function getToken() {
        var inp = document.querySelector('input[name="__RequestVerificationToken"]');
        return inp ? inp.value : '';
    }
    function actualizarKpisDOM() {
        var el;
        el = document.getElementById('kpi-disp'); if (el) el.textContent = kpiDisp;
        el = document.getElementById('kpi-proc'); if (el) el.textContent = kpiProc;
        el = document.getElementById('kpi-res');  if (el) el.textContent = kpiRes;
        el = document.getElementById('kpi-vend'); if (el) el.textContent = kpiVend;
    }
    function mostrarToast(msg, tipo) {
        var t = document.createElement('div');
        t.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:9999;background:'+(tipo==='exito'?'#1EA851':'var(--blue)')+';color:white;padding:12px 20px;border-radius:12px;font-size:13px;font-weight:600;box-shadow:0 8px 24px rgba(0,0,0,0.2);transition:opacity 0.3s;';
        t.textContent = msg;
        document.body.appendChild(t);
        setTimeout(function(){ t.style.opacity='0'; setTimeout(function(){ t.remove(); }, 300); }, 3200);
    }

    var connAdmin = new signalR.HubConnectionBuilder().withUrl("/ventasHub").withAutomaticReconnect().build();

    connAdmin.on("InmuebleActualizado", function(proyIdEvt, idInmueble, nuevoEstado, quien) {
        if (proyIdEvt !== proyIdSR) return;

        var tr = document.querySelector('#tablaInmuebles tbody tr[data-id="' + idInmueble + '"]');
        if (tr) {
            var estadoAnterior = tr.dataset.estado;
            if (estadoAnterior === 'DISPONIBLE')  kpiDisp--;
            else if (estadoAnterior === 'EN PROCESO') kpiProc--;
            else if (estadoAnterior === 'RESERVADO')  kpiRes--;
            else if (estadoAnterior === 'VENDIDO')    kpiVend--;
            if (nuevoEstado === 'DISPONIBLE')   kpiDisp++;
            else if (nuevoEstado === 'EN PROCESO') kpiProc++;
            else if (nuevoEstado === 'RESERVADO')  kpiRes++;
            else if (nuevoEstado === 'VENDIDO')    kpiVend++;
            actualizarKpisDOM();

            tr.dataset.estado = nuevoEstado;
            var cls = nuevoEstado==='DISPONIBLE'?'D':nuevoEstado==='VENDIDO'?'V':nuevoEstado==='EN PROCESO'?'EP':'R';

            var estadoTd = tr.querySelector('.estado-td');
            if (estadoTd) {
                var color = nuevoEstado === 'EN PROCESO' ? '#5A5AC8'
                          : nuevoEstado === 'RESERVADO'  ? '#CC7700' : '';
                estadoTd.innerHTML = '<span class="bdg ' + cls + '">' + nuevoEstado + '</span>' +
                    ((quien && color) ? '<br/><span class="quien" style="color:' + color + '">' + quien + '</span>' : '');
            }

            // El apto se lee de la fila: el evento de SignalR no lo trae.
            var celdaApto = tr.querySelector('td');
            var aptoFila = celdaApto ? celdaApto.textContent.trim().replace(/'/g, "") : '';
            var accionTd = tr.querySelector('.accion-td');
            if (accionTd) {
                var tok = getToken();
                if (nuevoEstado === 'DISPONIBLE') {
                    accionTd.innerHTML =
                        '<form action="/Inmuebles/TomarInmueble" method="post" style="display:inline">' +
                        '<input type="hidden" name="__RequestVerificationToken" value="' + tok + '"/>' +
                        '<input type="hidden" name="idInmueble" value="' + idInmueble + '"/>' +
                        '<button type="submit" class="btn-accion btn-vender">Vender</button></form>' +
                        '<button type="button" class="btn-accion btn-reservar" onclick="abrirReserva(' + idInmueble + ', \'' + aptoFila + '\')">Reservar</button>';
                } else if (nuevoEstado === 'EN PROCESO') {
                    accionTd.innerHTML =
                        '<form action="/Inmuebles/CancelarProceso" method="post" style="display:inline">' +
                        '<input type="hidden" name="__RequestVerificationToken" value="' + tok + '"/>' +
                        '<input type="hidden" name="idInmueble" value="' + idInmueble + '"/>' +
                        '<button type="submit" class="btn-accion btn-liberar" onclick="return confirm(\'¿Cancelar este proceso?\')">Cancelar</button></form>';
                } else if (nuevoEstado === 'RESERVADO') {
                    accionTd.innerHTML =
                        '<form action="/Inmuebles/LiberarReserva" method="post" style="display:inline">' +
                        '<input type="hidden" name="__RequestVerificationToken" value="' + tok + '"/>' +
                        '<input type="hidden" name="idInmueble" value="' + idInmueble + '"/>' +
                        '<button type="submit" class="btn-accion btn-liberar" onclick="return confirm(\'¿Liberar esta reserva?\')">Liberar</button></form>';
                } else {
                    accionTd.innerHTML = '<span style="color:var(--label3);font-size:12px">—</span>';
                }
            }

            tr.style.transition = 'background 0.4s';
            tr.style.background = 'rgba(0,118,227,0.07)';
            setTimeout(function(){ tr.style.background = ''; tr.style.transition = ''; }, 1400);
        }

        var ico = nuevoEstado==='DISPONIBLE'?'✅':nuevoEstado==='VENDIDO'?'🔑':nuevoEstado==='EN PROCESO'?'⏳':'🔒';
        mostrarToast(ico + ' Inmueble actualizado: ' + nuevoEstado, 'info');
    });

    connAdmin.on("ListaActualizada", function(proyIdEvt, nuevaLista) {
        if (proyIdEvt !== proyIdSR) return;
        var th = document.querySelector('#tablaInmuebles thead th:nth-child(5)');
        if (th) th.textContent = 'Precio Lista ' + nuevaLista;
        mostrarToast('Lista del proyecto actualizada a ' + nuevaLista, 'info');
    });

    connAdmin.start().catch(function(err){ console.error('SignalR admin:', err); });
</script>
}
