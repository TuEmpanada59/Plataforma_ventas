@{
    Layout = null;
    var nombre = ViewBag.Nombre as string ?? "Admin";
    var apellido = ViewBag.Apellido as string ?? "";
    var proyActivo = ViewBag.ProyectoActivo as string ?? "Sin proyecto";
    var inmuebles = ViewBag.Inmuebles as List<dynamic> ?? new List<dynamic>();
    int total = ViewBag.Total != null ? (int)ViewBag.Total : 0;
    int disponibles = ViewBag.Disponibles != null ? (int)ViewBag.Disponibles : 0;
    int reservados = ViewBag.Reservados != null ? (int)ViewBag.Reservados : 0;
    int vendidos = ViewBag.Vendidos != null ? (int)ViewBag.Vendidos : 0;
    int enProceso = ViewBag.EnProceso != null ? (int)ViewBag.EnProceso : 0;
    int la = ViewBag.ListaActual != null ? (int)ViewBag.ListaActual : 1;
    int aptsPorLista = ViewBag.AptsPorLista != null ? (int)ViewBag.AptsPorLista : 0;
    int proximaLista = ViewBag.ProximaLista != null ? (int)ViewBag.ProximaLista : 0;
    var torres = ViewBag.Torres as List<string> ?? new List<string>();
    var torreActual = ViewBag.TorreActual as string ?? "";
    var areaActual = ViewBag.AreaActual as string ?? "";
    var grupos = ViewBag.Grupos as List<dynamic> ?? new List<dynamic>();
    var vendedores = ViewBag.Vendedores as Dictionary<int, string> ?? new Dictionary<int, string>();
    var listasXArea = ViewBag.ListasXArea as Dictionary<string, int> ?? new Dictionary<string, int>();
    var aptsXArea = ViewBag.AptsXArea as Dictionary<string, int> ?? new Dictionary<string, int>();
    var proyHermanos = ViewBag.ProyectosHermanos as List<(int Id, string Nombre)> ?? new List<(int, string)>();
    var iniciales = ((nombre.Length >= 1 ? nombre.Substring(0, 1) : "") + (apellido.Length >= 1 ? apellido.Substring(0, 1) : "")).ToUpper();
    dynamic grupoActual = null;
    int laEstaArea = la;
    if (!string.IsNullOrEmpty(areaActual))
    {
        foreach (var gg in grupos)
        {
            if (gg.Metros.ToString() == areaActual)
            {
                grupoActual = gg; break;
            }
        }
        laEstaArea = listasXArea.ContainsKey(areaActual) ? listasXArea[areaActual] : la;
    }
}
