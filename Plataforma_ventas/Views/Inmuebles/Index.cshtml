                    background: rgba(230,57,70,0.2);
                }

            .alerta-exito {
                background: rgba(52,199,89,0.1);
                border: 1px solid rgba(52,199,89,0.3);
                border-radius: 12px;
                padding: 10px 16px;
                font-size: 13px;
                font-weight: 600;
                color: #1EA851;
            }

            .alerta-error {
                background: rgba(230,57,70,0.1);
                border: 1px solid rgba(230,57,70,0.3);
                border-radius: 12px;
                padding: 10px 16px;
                font-size: 13px;
                font-weight: 600;
                color: var(--rojo);
            }

            .area-volver {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                background: var(--fill3);
                border: 1px solid var(--sep);
                color: var(--label);
                padding: 7px 14px;
                border-radius: 10px;
                font-size: 13px;
                font-weight: 600;
                text-decoration: none;
                transition: background 0.2s;
            }

                .area-volver:hover {
                    background: var(--fill2);
                }

            .empty {
                padding: 48px;
                text-align: center;
            }

            .empty-ico {
                font-size: 40px;
                opacity: 0.4;
                margin-bottom: 8px;
            }

            .empty-txt {
                font-size: 15px;
                font-weight: 600;
                color: var(--label2);
            }

            .hamburger {
                display: none;
                flex-direction: column;
                gap: 5px;
                cursor: pointer;
                padding: 6px;
                border-radius: 8px;
                background: var(--fill3);
                border: none;
            }

                .hamburger span {
                    display: block;
                    width: 18px;
                    height: 2px;
                    background: var(--label);
                    border-radius: 2px;
                }
            /* Modal */
            .modal-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.55);
                z-index: 300;
                backdrop-filter: blur(4px);
                align-items: center;
                justify-content: center;
            }

                .modal-overlay.open {
                    display: flex;
                }

            .modal-box {
                background: white;
                border-radius: 20px;
                padding: 28px;
                width: 100%;
                max-width: 400px;
                margin: 16px;
                box-shadow: 0 20px 60px rgba(0,0,0,0.2);
                animation: fu 0.25s ease both;
            }

            .modal-title {
                font-size: 17px;
                font-weight: 700;
                color: var(--azul);
                margin-bottom: 4px;
            }

            .modal-sub {
                font-size: 13px;
                color: var(--label2);
                margin-bottom: 20px;
            }

            .modal-field {
                margin-bottom: 14px;
            }

                .modal-field label {
                    display: block;
                    font-size: 11px;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.06em;
                    color: var(--label2);
                    margin-bottom: 5px;
                }

                .modal-field select, .modal-field input[type=number] {
                    width: 100%;
                    padding: 10px 14px;
                    background: var(--fill3);
                    border: 1px solid var(--sep);
                    border-radius: 10px;
                    font-size: 14px;
                    color: var(--label);
                    outline: none;
                }

                    .modal-field select:focus, .modal-field input:focus {
                        border-color: var(--blue);
                        background: white;
                    }

            .modal-btns {
                display: flex;
                gap: 8px;
                justify-content: flex-end;
                margin-top: 20px;
            }

            .btn-modal-cancel {
                padding: 9px 18px;
                border-radius: 10px;
                border: 1px solid var(--sep);
                background: var(--fill3);
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                color: var(--label);
            }

            .btn-modal-save {
                padding: 9px 18px;
                border-radius: 10px;
                border: none;
                background: var(--blue);
                color: white;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
            }
            /* Botones tarjeta */
            .btn-editar-precio {
                width: 100%;
                margin-top: 8px;
                padding: 7px 10px;
                background: rgba(0,118,227,0.08);
                border: 1px solid rgba(0,118,227,0.2);
                color: var(--blue);
                border-radius: 9px;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                transition: background 0.2s;
            }

                .btn-editar-precio:hover {
                    background: rgba(0,118,227,0.16);
                }
            /* Auto por área */
            .auto-area-box {
                margin-top: 8px;
                padding: 10px;
                background: rgba(52,199,89,0.06);
                border: 1px solid rgba(52,199,89,0.2);
                border-radius: 10px;
            }

            .auto-area-lbl {
                font-size: 10px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.06em;
                color: #1EA851;
                margin-bottom: 6px;
                display: block;
            }

            .auto-area-row {
                display: flex;
                gap: 6px;
                align-items: center;
            }

            .auto-area-input {
                flex: 1;
                min-width: 0;
                padding: 6px 10px;
                border-radius: 8px;
                border: 1px solid rgba(52,199,89,0.3);
                background: white;
                font-size: 13px;
                color: var(--label);
                outline: none;
            }

                .auto-area-input:focus {
                    border-color: #34C759;
                }

            .auto-area-btn {
                padding: 6px 12px;
                border-radius: 8px;
                border: none;
                background: #34C759;
                color: white;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                white-space: nowrap;
            }

                .auto-area-btn:hover {
                    background: #1EA851;
                }

            .auto-area-off {
                padding: 6px 10px;
                border-radius: 8px;
                border: none;
                background: rgba(230,57,70,0.08);
                color: var(--rojo);
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                white-space: nowrap;
            }

                .auto-area-off:hover {
                    background: rgba(230,57,70,0.16);
                }

            .auto-area-status {
                font-size: 11px;
                color: #1EA851;
                margin-top: 5px;
                font-weight: 600;
            }

            @@media(max-width:1200px) {
                .sidebar {
                    width: 185px !important;
                }

                .areas-grid {
                    grid-template-columns: repeat(3,1fr) !important;
                }
            }

            @@media(max-width:1024px) {
                .areas-grid {
                    grid-template-columns: repeat(2,1fr) !important;
                }
            }

            @@media(max-width:700px) {
                html, body {
                    height: auto !important;
                    overflow: auto !important;
                }

                .app {
                    flex-direction: column !important;
                }

                .sidebar {
                    position: fixed !important;
                    top: 0 !important;
                    left: -270px !important;
                    width: 260px !important;
                    height: 100vh !important;
                    z-index: 100 !important;
                    overflow-y: auto !important;
                    transition: left 0.3s !important;
                }

                    .sidebar.open {
                        left: 0 !important;
                    }

                .main {
                    width: 100% !important;
                }

                .hamburger {
                    display: flex !important;
                }

                .tb-chip {
                    display: none !important;
                }

                .areas-grid {
                    grid-template-columns: 1fr 1fr !important;
                }

                .tbl {
                    min-width: 600px !important;
                }

                .resumen-banner {
                    flex-direction: column !important;
                    gap: 10px !important;
                }

                .rb-stats {
                    justify-content: center !important;
                }
            }
    
        /* ── Sidebar blanco corporativo ── */
        .sidebar{background:#fff!important;border-right:1px solid rgba(0,0,0,0.07)!important;backdrop-filter:none!important;box-shadow:2px 0 12px rgba(0,0,0,0.04)!important;}
        .sb-logo-area{padding:16px 14px 12px;border-bottom:1px solid rgba(0,0,0,0.06);margin-bottom:4px;}
        .sb-logo-area img{width:100%;max-height:52px;object-fit:contain;display:block;mix-blend-mode:multiply;filter:contrast(1.05);}
        .sb-app{color:#1e222b!important;font-weight:700!important;}
        .sb-sub{color:rgba(30,34,43,0.45)!important;}
        .sb-proy{background:rgba(0,118,227,0.06)!important;border-color:rgba(0,118,227,0.18)!important;}
        .sb-proy:hover{background:rgba(0,118,227,0.10)!important;}
        .sb-proy-lbl{color:rgba(30,34,43,0.45)!important;font-size:9px!important;}
        .sb-proy-name{color:#0076e3!important;font-weight:700!important;}
        .sb-proy-meta{color:rgba(30,34,43,0.5)!important;}
        .proy-drop{background:#fff!important;border-color:rgba(0,0,0,0.09)!important;box-shadow:0 8px 24px rgba(0,0,0,0.1)!important;}
        .proy-drop-item{color:#1e222b!important;}
        .proy-drop-item:hover{background:rgba(0,118,227,0.06)!important;color:#0076e3!important;}
        .proy-drop-link{color:#0076e3!important;background:rgba(0,118,227,0.04)!important;}
        .sb-sec{color:rgba(30,34,43,0.38)!important;letter-spacing:0.08em!important;}
        .nav-item{color:rgba(30,34,43,0.65)!important;}
        .nav-item:hover{background:rgba(0,118,227,0.07)!important;color:#0076e3!important;}
        .nav-item.active{background:#0076e3!important;color:#fff!important;}
        .nav-item.active .nav-ico{background:rgba(255,255,255,0.22)!important;}
        .nav-ico{background:rgba(30,34,43,0.06)!important;color:inherit!important;}
        .sb-footer{border-top-color:rgba(0,0,0,0.07)!important;}
        .sb-logout{background:rgba(30,34,43,0.05)!important;color:rgba(30,34,43,0.45)!important;}
        .sb-logout:hover{background:rgba(230,57,70,0.08)!important;color:#E63946!important;}
        .nav-item{display:flex!important;align-items:center!important;gap:10px!important;padding:9px 12px!important;margin:1px 6px!important;border-radius:11px!important;font-size:14px!important;min-height:40px!important;text-decoration:none!important;transition:all 0.18s!important;}
        .nav-ico{width:26px!important;height:26px!important;border-radius:8px!important;display:flex!important;align-items:center!important;justify-content:center!important;font-size:14px!important;flex-shrink:0!important;}
        .sb-sec{padding:14px 18px 4px!important;font-size:10px!important;font-weight:600!important;text-transform:uppercase!important;}
    </style>
</head>
<body>
    <div class="app">
        <div class="sidebar" id="sidebar">
            <div style="display:flex;align-items:center;gap:10px;padding:18px 14px 0;">
                <div style="width:42px;height:42px;border-radius:12px;overflow:hidden;flex-shrink:0;box-shadow:0 4px 12px rgba(0,96,187,0.25);">
                    <img src="data:image/png;base64," style="width:100%;height:100%;object-fit:cover;display:block;" alt="LG" />
                </div>
                <div><div class="sb-app">Londoño Gómez</div><div class="sb-sub">Sistema de Lanzamientos</div></div>
            </div>
            <div class="sb-proy" id="proyBtn" onclick="toggleDrop()">
                <div class="sb-proy-lbl">PROYECTO ACTIVO ▾</div>
                <div class="sb-proy-name">@proyActivo</div>
                <div class="sb-proy-meta"><span class="pulse"></span>Toca para cambiar</div>
            </div>
            <div class="proy-drop" id="proyDrop">
                @{
                    var proyectos = ViewBag.Proyectos as List<(int Id, string Nombre)>;
                }
                @if (proyectos != null)
                {
                    foreach (var p in proyectos)
                    {
                        <form action="/Inmuebles/SeleccionarProyecto" method="post" style="margin:0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idProyecto" value="@p.Id" />
                            <input type="hidden" name="nombreProyecto" value="@p.Nombre" />
                            <button type="submit" class="proy-drop-item">🏗 @p.Nombre</button>
                        </form>
                    }
                }
                <a href="/Inmuebles/Proyectos" class="proy-drop-link">← Ver todos los proyectos</a>
                <a href="/Carga/Index" class="proy-drop-link">＋ Cargar nuevo proyecto</a>
            </div>
            <div class="sb-sec">Principal</div>
            <a class="nav-item" href="/Dashboard"><div class="nav-ico">⊞</div>Inicio</a>
            <a class="nav-item active" href="/Inmuebles/Proyectos"><div class="nav-ico">🏢</div>Inmuebles</a>
            <a class="nav-item" href="/Inmuebles/Reservas"><div class="nav-ico">🔒</div>Reservas</a>
            <a class="nav-item" href="/Ventas"><div class="nav-ico">💲</div>Ventas</a>
            <a class="nav-item" href="/Clientes"><div class="nav-ico">👤</div>Clientes</a>
            <div class="sb-sec">General</div>
            <a class="nav-item" href="/Reportes"><div class="nav-ico">📊</div>Reportes</a>
            <a class="nav-item" href="/Carga/Index"><div class="nav-ico">📂</div>Cargar Excel</a>
            <a class="nav-item" href="/Usuarios"><div class="nav-ico">👥</div>Usuarios</a>
            <div class="sb-footer">
                <div class="sb-av">@iniciales</div>
                <div><div style="font-size:12px;font-weight:600">@nombre @apellido</div><div style="font-size:10px;color:var(--label3)">Administrador</div></div>
                <a class="sb-logout" href="/Account/Logout">↩</a>
            </div>
        </div>
        <div class="main">
            <div class="topbar">
                <div style="display:flex;align-items:center;gap:10px;">
                    <button class="hamburger" onclick="toggleSidebar()"><span></span><span></span><span></span></button>
                    <span class="tb-bread">
                        <a href="/Inmuebles/Proyectos">Proyectos</a>
                        <span style="margin:0 4px;color:var(--label3)">›</span>
                        <strong>@proyActivo</strong>
                        @if (!string.IsNullOrEmpty(areaActual))
                        {
                            <span> · @areaActual m²</span>
                        }
                    </span>
                </div>
                <div class="tb-right"><div class="tb-chip"><span class="pulse"></span>@proyActivo</div><a class="tb-ibtn" href="/Account/Logout">↩</a></div>
            </div>
            <div class="view">
                @if (TempData["Exito"] != null)
                {
                    <div class="alerta-exito">✅ @TempData["Exito"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alerta-error">❌ @TempData["Error"]</div>
                }
                @if (string.IsNullOrEmpty(torreActual) && torres.Count > 1)
                {
                    <div class="torre-select-screen">
                        <div style="text-align:center">
                            <div style="font-size:22px;font-weight:700;color:var(--azul)">🏗 Selecciona una torre</div>
                            <div style="font-size:14px;color:var(--label2);margin-top:6px">Proyecto @proyActivo tiene varias torres</div>
                        </div>
                        <div class="torres-grid">
                            @foreach (var p in proyHermanos)
                            {
                                <a href="/Inmuebles?torre=@Uri.EscapeDataString(p.Nombre)" class="torre-card">
                                    <div style="font-size:36px">🏢</div>
                                    <div style="font-size:16px;font-weight:700;color:var(--azul)">@p.Nombre</div>
                                </a>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="resumen-banner">
                        <div>
                            <div class="rb-title">@proyActivo</div>
                            <div class="rb-sub">@total inmuebles en total</div>
                        </div>
                        <div class="rb-stats">
                            <div class="rb-stat"><div class="rb-stat-num">@disponibles</div><div class="rb-stat-lbl">Disponibles</div></div>
                            <div class="rb-stat"><div class="rb-stat-num" style="color:var(--rojo)">@vendidos</div><div class="rb-stat-lbl">Vendidos</div></div>
                            <div class="rb-stat"><div class="rb-stat-num" style="color:#5A5AC8">@enProceso</div><div class="rb-stat-lbl">En proceso</div></div>
                            <div class="rb-stat"><div class="rb-stat-num" style="color:#CC7700">@reservados</div><div class="rb-stat-lbl">Reservados</div></div>
                        </div>
                        <div>
                            <div class="rb-lista">
                                <div class="rb-lista-num">@la</div>
                                <div class="rb-lista-lbl">Lista activa</div>
                            </div>
                            @if (aptsPorLista > 0)
                            {
                                <div class="rb-proxima">Próxima en @proximaLista ventas</div>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(torreActual) && torres.Count > 1)
                    {
                        <div class="torre-banner">
                            <div class="torre-banner-left">
                                <div style="font-size:22px">🏢</div>
                                <div>
                                    <div style="font-size:15px;font-weight:700;color:white">@torreActual</div>
                                    <div style="font-size:11px;color:rgba(255,255,255,0.7)">Torre activa</div>
                                </div>
                            </div>
                            <a href="/Inmuebles" class="torre-banner-btn">↩ Cambiar torre</a>
                        </div>
                    }
                    @if (string.IsNullOrEmpty(areaActual))
                    {
                        <div style="font-size:15px;font-weight:600;color:var(--label);margin-bottom:-4px">Selecciona un área para ver los inmuebles</div>
                        <div class="areas-grid">
                            @foreach (var g in grupos)
                            {
                                var porcVend = g.Total > 0 ? (int)Math.Round((double)g.Vendidos / g.Total * 100) : 0;
                                var fillCls = porcVend >= 80 ? "rojo" : porcVend >= 50 ? "naranja" : "";
                                var tipoLabel = g.Tipo?.ToString() ?? "";
                                var tipoClass = tipoLabel == "EXT" ? "area-tipo-ext" : "area-tipo-int";
                                var metrosStr = g.Metros.ToString();
                                var laArea = listasXArea.ContainsKey(metrosStr) ? listasXArea[metrosStr] : la;
                                var aptsArea = aptsXArea.ContainsKey(metrosStr) ? aptsXArea[metrosStr] : 0;
                                long p1 = (long)g.PrecioL1; long p2 = (long)g.PrecioL2; long p3 = (long)g.PrecioL3;
                                long p4 = (long)g.PrecioL4; long p5 = (long)g.PrecioL5;
                                long precActArea = laArea == 1 ? p1 : laArea == 2 ? p2 : laArea == 3 ? p3 : laArea == 4 ? p4 : p5;
                                if (precActArea == 0) precActArea = (long)g.PrecioActivo;
                                <div class="area-card">
                                    <div class="area-card-link" onclick="window.location='/Inmuebles?area=@Uri.EscapeDataString(metrosStr)'">
                                        <div class="area-top">
                                            <div class="area-metros">@g.Metros <span style="font-size:13px;font-weight:400;color:var(--label2)">m²</span></div>
                                            <span class="@tipoClass">@tipoLabel</span>
                                        </div>
                                        <div class="area-precio-lbl">Precio lista @laArea</div>
                                        <div class="area-precio">$@string.Format("{0:N0}", precActArea)</div>
                                        <div class="area-listas">
                                            @for (int ln = 1; ln <= 5; ln++)
                                            {
                                                long pl = ln == 1 ? p1 : ln == 2 ? p2 : ln == 3 ? p3 : ln == 4 ? p4 : p5;
                                                if (pl > 0)
                                                {
                                                    var chipCls = ln == laArea ? "area-lista-chip activa" : "area-lista-chip";
                                                    <form action="/Inmuebles/CambiarListaArea" method="post" style="display:inline;margin:0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="metros" value="@metrosStr" />
                                                        <input type="hidden" name="listaActual" value="@ln" />
                                                        <button type="submit" class="@chipCls"
                                                                onclick="event.stopPropagation()@(ln == laArea ? ";return false;" : "")"
                                                                title="@(ln == laArea ? "Lista activa" : "Activar Lista " + ln)">
                                                            L@(ln): $@string.Format("{0:N0}", pl)
                                                        </button>
                                                    </form>
                                                }
                                            }
                                        </div>
                                        <div class="prog-wrap">
                                            <div class="prog-bar"><div class="prog-fill @fillCls" style="width:@(porcVend)%"></div></div>
                                            <div class="prog-lbl">
                                                <span>@g.Disponibles disp · @g.Vendidos vend</span>
                                                <span>@(porcVend)%</span>
                                            </div>
                                        </div>
                                    </div>
                                    <button type="button" class="btn-editar-precio"
                                            onclick="abrirModal('@metrosStr',@p1,@p2,@p3,@p4,@p5,@laArea)">
                                        ✏️ Editar precio de lista
                                    </button>
                                    <div class="auto-area-box" onclick="event.stopPropagation()">
                                        <span class="auto-area-lbl">⚡ Subida automática</span>
                                        <form action="/Inmuebles/ConfigurarAutoArea" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="metros" value="@metrosStr" />
                                            <div class="auto-area-row">
                                                <input type="number" name="aptsPorLista" class="auto-area-input" min="0"
                                                       value="@(aptsArea > 0 ? aptsArea.ToString() : "")"
                                                       placeholder="Ej: 5" />
                                                <button type="submit" class="auto-area-btn">✓</button>
                                                @if (aptsArea > 0)
                                                {
                                                    <form action="/Inmuebles/ConfigurarAutoArea" method="post" style="margin:0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="metros" value="@metrosStr" />
                                                        <input type="hidden" name="aptsPorLista" value="0" />
                                                        <button type="submit" class="auto-area-off" title="Desactivar">✕</button>
                                                    </form>
                                                }
                                            </div>
                                        </form>
                                        @if (aptsArea > 0)
                                        {
                                            <div class="auto-area-status">✅ Sube cada @aptsArea vendidos · Lista @laArea activa</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                            <a href="/Inmuebles" class="area-volver">← Todas las áreas</a>
                            <span style="font-size:15px;font-weight:600;color:var(--label)">@areaActual m² · @inmuebles.Count inmuebles</span>
                        </div>
                        <div class="card">
                            <div class="card-head">
                                <span class="card-title">Lista de inmuebles · @areaActual m² · Lista @laEstaArea</span>
                                <div class="filter-bar">
                                    <div class="search-wrap"><span class="search-ico">🔍</span><input type="text" id="buscar" placeholder="Buscar apto, piso..." oninput="filtrar()" /></div>
                                    <div class="seg">
                                        <button class="seg-btn active" onclick="setFiltro('todos',this)">Todos</button>
                                        <button class="seg-btn" onclick="setFiltro('DISPONIBLE',this)">Disponibles</button>
                                        <button class="seg-btn" onclick="setFiltro('RESERVADO',this)">Reservados</button>
                                        <button class="seg-btn" onclick="setFiltro('EN PROCESO',this)">En proceso</button>
                                        <button class="seg-btn" onclick="setFiltro('VENDIDO',this)">Vendidos</button>
                                    </div>
                                </div>
                            </div>
                            @if (inmuebles.Count > 0)
                            {
                                <div class="tbl-wrap">
                                    <table class="tbl" id="tablaInmuebles">
                                        <thead>
                                            <tr>
                                                <th>Apto</th>
                                                <th>Tipo</th>
                                                <th>Piso</th>
                                                <th>Metros</th>
                                                <th>Precio Lista @laEstaArea</th>
                                                <th>Torre</th>
                                                <th>Estado</th>
                                                <th>Acción</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var i in inmuebles)
                                            {
                                                var cls = i.Estado == "DISPONIBLE" ? "D" : i.Estado == "VENDIDO" ? "V" : i.Estado == "EN PROCESO" ? "EP" : "R";
                                                var precioLista = laEstaArea == 1 ? i.Lista1 : laEstaArea == 2 ? i.Lista2 : laEstaArea == 3 ? i.Lista3 : laEstaArea == 4 ? i.Lista4 : i.Lista5;
                                                var plLimpio = (precioLista?.ToString() ?? "0").Replace("$", "").Replace(".", "").Replace(",", "").Replace(" ", "").Trim();
                                                <tr data-estado="@i.Estado">
                                                    <td style="font-weight:600">@i.Apto</td>
                                                    <td>
                                                        @if (i.Tipo == "EXT")
                                                        {
                                                            <span style="background:rgba(255,149,0,0.12);color:#CC7700;font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px">EXT</span>
                                                        }
                                                        else if (i.Tipo == "INT")
                                                        {
                                                            <span style="background:rgba(0,118,227,0.1);color:var(--blue);font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px">INT</span>
                                                        }
                                                        else
                                                        {

                                                            <span>@i.Tipo</span>
                                                        }
                                                    </td>
                                                    <td>@i.Piso</td>
                                                    <td>@i.Metros m²</td>
                                                    <td style="font-weight:500;color:var(--azul)">$@(string.Format("{0:N0}", long.TryParse(plLimpio, out long lp) ? lp : 0))</td>
                                                    <td>@i.Torre</td>
                                                    <td>
                                                        <span class="bdg @cls">@i.Estado</span>
                                                        @if (i.Estado == "EN PROCESO" && i.IdVendedorEnProceso > 0)
                                                        {
                                                            var nomVend = vendedores.ContainsKey(i.IdVendedorEnProceso) ? vendedores[i.IdVendedorEnProceso] : "Vendedor";
                                                            <br /><span style="font-size:11px;color:#5A5AC8;font-weight:600">👤 @nomVend</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (i.Estado == "DISPONIBLE")
                                                        {
                                                            <form action="/Inmuebles/TomarInmueble" method="post" style="display:inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="idInmueble" value="@i.Id" />
                                                                <button type="submit" class="btn-accion btn-vender">Vender</button>
                                                            </form>
                                                            <form action="/Inmuebles/ReservarInmueble" method="post" style="display:inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="idInmueble" value="@i.Id" />
                                                                <button type="submit" class="btn-accion btn-reservar" onclick="return confirm('¿Reservar este inmueble?')">Reservar</button>
                                                            </form>
                                                        }
                                                        else if (i.Estado == "RESERVADO")
                                                        {
                                                            <form action="/Inmuebles/LiberarReserva" method="post" style="display:inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="idInmueble" value="@i.Id" />
                                                                <button type="submit" class="btn-accion btn-liberar" onclick="return confirm('¿Liberar esta reserva?')">Liberar</button>
                                                            </form>
                                                        }
                                                        else if (i.Estado == "EN PROCESO")
                                                        {
                                                            <form action="/Inmuebles/CancelarProceso" method="post" style="display:inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="idInmueble" value="@i.Id" />
                                                                <button type="submit" class="btn-accion btn-liberar" onclick="return confirm('¿Cancelar este proceso?')">Cancelar</button>
                                                            </form>
                                                        }
                                                        else
                                                        {
                                                            <span style="color:var(--label3);font-size:12px">—</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="empty"><div class="empty-ico">🏢</div><div class="empty-txt">No hay inmuebles en esta área</div></div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    <div class="modal-overlay" id="modalEditar">
        <div class="modal-box">
            <div class="modal-title">✏️ Editar precio de lista</div>
            <div class="modal-sub" id="modalSub">Área seleccionada</div>
            <form action="/Inmuebles/EditarPrecioArea" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="metros" id="modalMetros" />
                <div class="modal-field">
                    <label>Lista a modificar</label>
                    <select name="numLista" id="modalNumLista"></select>
                </div>
                <div class="modal-field">
                    <label>Nuevo precio</label>
                    <input type="number" name="nuevoPrecio" id="modalPrecio" placeholder="Ej: 480000000" min="0" required />
                </div>
                <div class="modal-btns">
                    <button type="button" class="btn-modal-cancel" onclick="cerrarModal()">Cancelar</button>
                    <button type="submit" class="btn-modal-save">💾 Guardar precio</button>
                </div>
            </form>
        </div>
    </div>
    <div id="sbOverlay" onclick="closeSidebar()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:99;backdrop-filter:blur(2px);"></div>
    <script>
            let filtroActual='todos';
            function setFiltro(f,btn){filtroActual=f;document.querySelectorAll('.seg-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active');filtrar();}
            function filtrar(){
                const q=document.getElementById('buscar')?.value.toLowerCase()||'';
                document.querySelectorAll('#tablaInmuebles tbody tr').forEach(tr=>{
                    const matchF=filtroActual==='todos'||tr.dataset.estado===filtroActual;
                    tr.style.display=matchF&&tr.innerText.toLowerCase().includes(q)?'':'none';
                });
            }
            function abrirModal(metros,p1,p2,p3,p4,p5,laActual){
                document.getElementById('modalMetros').value=metros;
                document.getElementById('modalSub').textContent='Área '+metros+' m² — Lista activa: '+laActual;
                var sel=document.getElementById('modalNumLista');
                sel.innerHTML='';
                [p1,p2,p3,p4,p5].forEach(function(p,i){
                    if(p>0){
                        var opt=document.createElement('option');
                        opt.value=i+1;
                        opt.textContent='Lista '+(i+1)+': $'+Number(p).toLocaleString('es-CO');
                        if((i+1)===laActual)opt.selected=true;
                        sel.appendChild(opt);
                    }
                });
                document.getElementById('modalPrecio').value='';
                document.getElementById('modalEditar').classList.add('open');
            }
            function cerrarModal(){document.getElementById('modalEditar').classList.remove('open');}
            document.addEventListener('click',function(e){
                var ov=document.getElementById('modalEditar');
                if(ov&&e.target===ov)cerrarModal();
                var b=document.getElementById('proyBtn'),d=document.getElementById('proyDrop');
                if(b&&d&&!b.contains(e.target)&&!d.contains(e.target))d.classList.remove('open');
            });
            function toggleDrop(){document.getElementById('proyDrop').classList.toggle('open');}
            function toggleSidebar(){var sb=document.getElementById('sidebar'),ov=document.getElementById('sbOverlay');if(!sb)return;var o=sb.classList.toggle('open');if(ov)ov.style.display=o?'block':'none';}
            function closeSidebar(){var sb=document.getElementById('sidebar'),ov=document.getElementById('sbOverlay');if(sb)sb.classList.remove('open');if(ov)ov.style.display='none';}
    </script>
</body>
</html>