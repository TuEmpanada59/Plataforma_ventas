@{
    Layout = null;
    var nombre = ViewBag.Nombre as string ?? "Admin";
    var apellido = ViewBag.Apellido as string ?? "";
    var proyActivo = ViewBag.ProyectoActivo as string ?? "Sin proyecto";
    var proyectosGrid = ViewBag.ProyectosGrid as List<dynamic> ?? new List<dynamic>();
    var iniciales = ((nombre.Length >= 1 ? nombre.Substring(0, 1) : "") + (apellido.Length >= 1 ? apellido.Substring(0, 1) : "")).ToUpper();
    var proyectos = ViewBag.Proyectos as List<(int Id, string Nombre)>;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>Proyectos · Londoño Gómez</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --azul: #0076e3; --celeste: #00c9ff; --negro: #1e222b; --plata: #c3cfdb; --menta: #00d4a1; --mid: #0060bb; --blue: #0076e3;
            --rojo: #E63946; --verde: #34C759; --oro: #FF9500;
            --label: rgba(0,0,0,0.85); --label2: rgba(60,60,67,0.6);
            --label3: rgba(60,60,67,0.3); --sep: rgba(60,60,67,0.12);
            --sep2: rgba(60,60,67,0.06); --fill2: rgba(120,120,128,0.12);
            --fill3: rgba(120,120,128,0.08); --glass: rgba(255,255,255,0.75);
            --gb: rgba(255,255,255,0.6); --sh: 0 8px 32px rgba(0,0,0,0.08),0 2px 8px rgba(0,0,0,0.04);
            --sh2: 0 20px 60px rgba(0,0,0,0.10),0 4px 20px rgba(0,0,0,0.06);
        }
        html,body { background:#EEF2F7; color:var(--label); overflow-x:hidden; }
        * { font-family:'Inter',system-ui,sans-serif; -webkit-font-smoothing:antialiased; }
        body::before { content:''; position:fixed; inset:0; z-index:0;
            background:radial-gradient(ellipse 80% 60% at 10% 0%,rgba(0,118,227,0.12) 0%,transparent 55%),#EEF2F7;
            pointer-events:none; }
        .app { display:flex; min-height:100vh; position:relative; z-index:1; }
        .sidebar { width:230px; flex-shrink:0; background:var(--glass); backdrop-filter:blur(40px) saturate(180%);
            border-right:1px solid var(--gb); display:flex; flex-direction:column;
            position:sticky; top:0; height:100vh; overflow-y:auto; }
        .sb-app { font-size:17px; font-weight:700; color:var(--label); letter-spacing:-0.4px; }
        .sb-sub { font-size:11px; color:var(--label3); margin-top:1px; }
        .pulse { width:5px; height:5px; border-radius:50%; background:#34C759; flex-shrink:0;
            animation:pring 2.5s ease infinite; display:inline-block; }
        @@keyframes pring { 0%{box-shadow:0 0 0 0 rgba(52,199,89,.4)} 70%{box-shadow:0 0 0 5px rgba(52,199,89,0)} 100%{box-shadow:0 0 0 0 rgba(52,199,89,0)} }
        .proy-drop { display:none; position:absolute; top:calc(100% + 8px); right:0; min-width:240px; z-index:120; background:white; border:1px solid var(--sep);
            border-radius:14px; overflow:hidden; box-shadow:var(--sh); }
        .proy-drop.open { display:block; }
        .proy-drop-item { width:100%; padding:10px 14px; background:none; border:none;
            border-bottom:1px solid var(--sep2); text-align:left; font-size:13px; font-weight:500;
            cursor:pointer; color:var(--label); display:flex; align-items:center; gap:8px; transition:background 0.15s; }
        .proy-drop-item:hover { background:var(--fill3); }
        .proy-drop-link { display:flex; align-items:center; gap:8px; padding:10px 14px; font-size:13px;
            font-weight:600; color:var(--blue); text-decoration:none; background:rgba(0,118,227,0.04); }
        .sb-sec { padding:16px 16px 4px; font-size:10px; font-weight:600; text-transform:uppercase;
            letter-spacing:0.07em; color:var(--label3); }
        .nav-item { display:flex; align-items:center; gap:10px; padding:9px 12px; margin:1px 6px;
            border-radius:11px; font-size:14px; color:var(--label2); text-decoration:none; transition:all 0.2s; }
        .nav-item:hover { background:var(--fill3); color:var(--label); }
        .nav-item.active { background:var(--blue); color:white; font-weight:600; box-shadow:0 4px 12px rgba(0,118,227,0.28); }
        .nav-ico { width:26px; height:26px; border-radius:7px; display:flex; align-items:center;
            justify-content:center; font-size:13px; background:var(--fill3); flex-shrink:0; }
        .nav-item.active .nav-ico { background:rgba(255,255,255,0.2); }
        .sb-footer { margin-top:auto; padding:10px 12px 20px; border-top:1px solid var(--sep2);
            display:flex; align-items:center; gap:8px; }
        .sb-av { width:30px; height:30px; border-radius:50%; background:linear-gradient(135deg,var(--azul),var(--celeste));
            display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; color:white; }
        .sb-logout { margin-left:auto; width:26px; height:26px; border-radius:7px; background:var(--fill3);
            display:flex; align-items:center; justify-content:center; font-size:13px; color:var(--label2); text-decoration:none; }
        .sb-logout:hover { background:rgba(230,57,70,0.1); color:var(--rojo); }
        .main { flex:1; display:flex; flex-direction:column; min-width:0; }
        .topbar { height:50px; flex-shrink:0; background:var(--glass); backdrop-filter:blur(40px) saturate(180%);
            border-bottom:1px solid var(--sep); padding:0 18px; display:flex; align-items:center;
            justify-content:space-between; position:sticky; top:0; z-index:50; }
        .tb-bread { font-size:13px; color:var(--label2); }
        .tb-bread strong { color:var(--label); font-weight:600; }
        .tb-bread a { color:var(--blue); text-decoration:none; font-weight:500; }
        .tb-right { display:flex; align-items:center; gap:8px; }
        .tb-proy { position:relative; }
        .tb-chip { display:flex; align-items:center; gap:5px; background:var(--fill3); border:1px solid var(--sep);
            padding:4px 10px; border-radius:20px; font-size:12px; font-weight:600; color:var(--blue); cursor:pointer; font-family:inherit; }
        .tb-chip-caret { font-size:9px; margin-left:5px; opacity:.7; }
        .tb-ibtn { width:30px; height:30px; border-radius:9px; background:var(--fill3); display:flex;
            align-items:center; justify-content:center; font-size:14px; text-decoration:none; color:var(--label); }
        .view { flex:1; padding:18px; display:flex; flex-direction:column; gap:14px; }
        @@keyframes fu { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }
        /* Project grid */
        .proj-header { animation:fu 0.3s ease both; }
        .proj-title { font-size:22px; font-weight:700; color:var(--azul); letter-spacing:-0.5px; }
        .proj-sub { font-size:13px; color:var(--label2); margin-top:4px; }
        .proj-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr));
            gap:16px; animation:fu 0.35s ease 0.05s both; }
        .proj-card-form { margin:0; }
        .proj-card { width:100%; background:var(--glass); backdrop-filter:blur(20px) saturate(180%);
            border:2px solid var(--gb); border-radius:20px; padding:20px; text-align:left;
            cursor:pointer; transition:all 0.2s; box-shadow:var(--sh); }
        .proj-card:hover { border-color:var(--blue); transform:translateY(-3px); box-shadow:var(--sh2); }
        .proj-card-top { display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:12px; gap:8px; }
        .proj-nombre { font-size:16px; font-weight:700; color:var(--azul); letter-spacing:-0.3px; line-height:1.3; }
        .proj-tipo { font-size:10px; font-weight:700; padding:3px 9px; border-radius:20px; flex-shrink:0;
            background:rgba(0,118,227,0.1); color:var(--blue); }
        .proj-tipo.lotes { background:rgba(255,149,0,0.12); color:#CC7700; }
        .proj-admin { font-size:11px; color:var(--label2); margin-bottom:14px; }
        .proj-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-bottom:14px; }
        .proj-stat { text-align:center; background:var(--fill3); border-radius:10px; padding:8px 4px; }
        .proj-stat-num { font-size:18px; font-weight:300; color:var(--azul); letter-spacing:-0.5px; }
        .proj-stat-num.disp { color:#1EA851; }
        .proj-stat-num.vend { color:var(--rojo); }
        .proj-stat-num.proc { color:#5A5AC8; }
        .proj-stat-lbl { font-size:9px; color:var(--label3); text-transform:uppercase; letter-spacing:0.05em; font-weight:600; margin-top:1px; }
        .proj-prog { margin-bottom:14px; }
        .proj-prog-bar { height:5px; border-radius:10px; background:var(--fill2); overflow:hidden; }
        .proj-prog-fill { height:100%; border-radius:10px; background:linear-gradient(90deg,var(--verde),#1EA851); }
        .proj-prog-fill.naranja { background:linear-gradient(90deg,var(--oro),#CC7700); }
        .proj-prog-fill.rojo { background:linear-gradient(90deg,var(--rojo),#B02030); }
        .proj-prog-lbl { display:flex; justify-content:space-between; font-size:10px; color:var(--label3); margin-top:3px; }
        .proj-btn { width:100%; padding:9px; border-radius:11px; border:none;
            background:linear-gradient(135deg,var(--azul),var(--celeste)); color:white;
            font-size:13px; font-weight:600; cursor:pointer; transition:opacity 0.2s; }
        .proj-btn:hover { opacity:0.88; }
        .proj-empty { padding:60px; text-align:center; animation:fu 0.3s ease both; }
        .proj-empty-ico { font-size:44px; opacity:0.35; margin-bottom:10px; }
        .proj-empty-txt { font-size:15px; font-weight:600; color:var(--label2); }
        .hamburger { display:none; flex-direction:column; gap:5px; cursor:pointer; padding:6px;
            border-radius:8px; background:var(--fill3); border:none; }
        .hamburger span { display:block; width:18px; height:2px; background:var(--label); border-radius:2px; }
        @@media(max-width:1200px){ .sidebar{width:185px!important} }
        @@media(max-width:700px){
            html,body{height:auto!important;overflow:auto!important}
            .app{flex-direction:column!important}
            .sidebar{position:fixed!important;top:0!important;left:-270px!important;width:260px!important;
                height:100vh!important;z-index:100!important;overflow-y:auto!important;transition:left 0.3s!important}
            .sidebar.open{left:0!important}
            .main{width:100%!important}
            .hamburger{display:flex!important}
            .tb-chip{max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
            .proj-grid{grid-template-columns:1fr!important}
        }
    
        /* ── Sidebar blanco corporativo ── */
        .sidebar{background:#fff!important;border-right:1px solid rgba(0,0,0,0.07)!important;backdrop-filter:none!important;box-shadow:2px 0 12px rgba(0,0,0,0.04)!important;}
        .sb-logo-area{padding:16px 14px 12px;border-bottom:1px solid rgba(0,0,0,0.06);margin-bottom:4px;}
        .sb-logo-area img{width:100%;max-height:52px;object-fit:contain;display:block;mix-blend-mode:multiply;filter:contrast(1.05);}
        .sb-app{color:#1e222b!important;font-weight:700!important;}
        .sb-sub{color:rgba(30,34,43,0.45)!important;}
        .proy-drop{background:#fff!important;border-color:rgba(0,0,0,0.09)!important;box-shadow:0 8px 24px rgba(0,0,0,0.1)!important;}
        .proy-drop-item{color:#1e222b!important;}
        .proy-drop-item:hover{background:rgba(0,118,227,0.06)!important;color:#0076e3!important;}
        .proy-drop-link{color:#0076e3!important;background:rgba(0,118,227,0.04)!important;}
        .sb-sec{color:rgba(30,34,43,0.38)!important;letter-spacing:0.08em!important;}
        .nav-item{color:rgba(30,34,43,0.65)!important;}
        .nav-item:hover{background:rgba(0,118,227,0.07)!important;color:#0076e3!important;}
        .nav-item.active{background:#0076e3!important;color:#fff!important;}
        .nav-item.active .nav-ico{background:rgba(255,255,255,0.22)!important;}
        .nav-ico{background:rgba(30,34,43,0.06)!important;color:inherit!important;}
        .sb-footer{border-top-color:rgba(0,0,0,0.07)!important;}
        .sb-logout{background:rgba(30,34,43,0.05)!important;color:rgba(30,34,43,0.45)!important;}
        .sb-logout:hover{background:rgba(230,57,70,0.08)!important;color:#E63946!important;}
        .nav-item{display:flex!important;align-items:center!important;gap:10px!important;padding:9px 12px!important;margin:1px 6px!important;border-radius:11px!important;font-size:14px!important;min-height:40px!important;text-decoration:none!important;transition:all 0.18s!important;}
        .nav-ico{width:26px!important;height:26px!important;border-radius:8px!important;display:flex!important;align-items:center!important;justify-content:center!important;font-size:14px!important;flex-shrink:0!important;}
        .sb-sec{padding:14px 18px 4px!important;font-size:10px!important;font-weight:600!important;text-transform:uppercase!important;}
    </style>
</head>
<body>
<div class="app">
    <div class="sidebar" id="sidebar">
        <div class="sb-logo-area">
            <img src="~/Images/Logo azul 2.jpg" alt="Londoño Gómez" style="width:100%;max-height:56px;object-fit:contain;display:block;mix-blend-mode:multiply;" />
        </div>
        <div class="sb-sec">Principal</div>
        <a class="nav-item" href="/Dashboard"><div class="nav-ico">⊞</div>Inicio</a>
        <a class="nav-item active" href="/Inmuebles"><div class="nav-ico">🏢</div>Inmuebles</a>
        <a class="nav-item" href="/Inmuebles/Reservas"><div class="nav-ico">🔒</div>Reservas</a>
        <a class="nav-item" href="/Ventas"><div class="nav-ico">💲</div>Ventas</a>
        <a class="nav-item" href="/Clientes"><div class="nav-ico">👤</div>Clientes</a>
        <div class="sb-sec">General</div>
        <a class="nav-item" href="/Reportes"><div class="nav-ico">📊</div>Reportes</a>
        <a class="nav-item" href="/Carga/Index"><div class="nav-ico">📂</div>Cargar Excel</a>
        <a class="nav-item" href="/Usuarios"><div class="nav-ico">👥</div>Usuarios</a>
        <div class="sb-footer">
            <div class="sb-av">@iniciales</div>
            <div><div style="font-size:12px;font-weight:600">@nombre @apellido</div><div style="font-size:10px;color:var(--label3)">Administrador</div></div>
            <a class="sb-logout" href="/Account/Logout">↩</a>
        </div>
    </div>
    <div class="main">
        <div class="topbar">
            <div style="display:flex;align-items:center;gap:10px;">
                <button class="hamburger" onclick="toggleSidebar()"><span></span><span></span><span></span></button>
                <span class="tb-bread"><strong>Proyectos</strong></span>
            </div>
            <div class="tb-right">
                <div class="tb-proy">
                    <button type="button" class="tb-chip" id="proyBtn" onclick="toggleDrop()" title="Cambiar proyecto">
                        <span class="pulse"></span>@proyectosGrid.Count proyectos<span class="tb-chip-caret">▾</span>
                    </button>
                    <div class="proy-drop" id="proyDrop">
            @if (proyectos != null)
            {
                foreach (var p in proyectos)
                {
                    <form action="/Inmuebles/SeleccionarProyecto" method="post" style="margin:0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idProyecto" value="@p.Id" />
                        <input type="hidden" name="nombreProyecto" value="@p.Nombre" />
                        <button type="submit" class="proy-drop-item">🏗 @p.Nombre</button>
                    </form>
                }
            }
            <a href="/Carga/Index" class="proy-drop-link">＋ Cargar nuevo proyecto</a>
                    </div>
                </div>
                <a class="tb-ibtn" href="/Account/Logout">↩</a>
            </div>
        </div>
        <div class="view">
            @if (TempData["Exito"] != null)
            {
                <div style="background:rgba(52,199,89,0.1);border:1px solid rgba(52,199,89,0.3);border-radius:12px;padding:10px 16px;font-size:13px;font-weight:600;color:#1EA851;">✅ @TempData["Exito"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div style="background:rgba(230,57,70,0.1);border:1px solid rgba(230,57,70,0.3);border-radius:12px;padding:10px 16px;font-size:13px;font-weight:600;color:#E63946;">❌ @TempData["Error"]</div>
            }
            <div class="proj-header">
                <div class="proj-title">Selecciona un proyecto</div>
                <div class="proj-sub">@proyectosGrid.Count proyecto(s) activo(s) · Haz clic para ver los inmuebles</div>
            </div>
            @if (proyectosGrid.Count > 0)
            {
                <div class="proj-grid">
                    @foreach (var p in proyectosGrid)
                    {
                        int total = (int)p.Total;
                        int disp = (int)p.Disponibles;
                        int vend = (int)p.Vendidos;
                        int res = (int)p.Reservados;
                        int proc = (int)p.EnProceso;
                        int pctVend = total > 0 ? (int)Math.Round((double)vend / total * 100) : 0;
                        string fillCls = pctVend >= 80 ? "rojo" : pctVend >= 50 ? "naranja" : "";
                        string tipoClass = p.Tipo == "LOTES" ? "proj-tipo lotes" : "proj-tipo";
                        <form action="/Inmuebles/SeleccionarProyecto" method="post" class="proj-card-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idProyecto" value="@p.Id" />
                            <input type="hidden" name="nombreProyecto" value="@p.Nombre" />
                            <button type="submit" class="proj-card">
                                <div class="proj-card-top">
                                    <div class="proj-nombre">@p.Nombre</div>
                                    <span class="@tipoClass">@p.Tipo</span>
                                </div>
                                <div class="proj-admin">👤 @p.Admin</div>
                                <div class="proj-stats">
                                    <div class="proj-stat">
                                        <div class="proj-stat-num">@total</div>
                                        <div class="proj-stat-lbl">Total</div>
                                    </div>
                                    <div class="proj-stat">
                                        <div class="proj-stat-num disp">@disp</div>
                                        <div class="proj-stat-lbl">Disp.</div>
                                    </div>
                                    <div class="proj-stat">
                                        <div class="proj-stat-num vend">@vend</div>
                                        <div class="proj-stat-lbl">Vendidos</div>
                                    </div>
                                    <div class="proj-stat">
                                        <div class="proj-stat-num proc">@(res + proc)</div>
                                        <div class="proj-stat-lbl">Gestion</div>
                                    </div>
                                </div>
                                <div class="proj-prog">
                                    <div class="proj-prog-bar">
                                        <div class="proj-prog-fill @fillCls" style="width:@(pctVend)%"></div>
                                    </div>
                                    <div class="proj-prog-lbl">
                                        <span>@disp disponibles · @vend vendidos</span>
                                        <span>@(pctVend)% vendido</span>
                                    </div>
                                </div>
                                <div class="proj-btn">Ver inmuebles →</div>
                            </button>
                        </form>
                    }
                </div>
            }
            else
            {
                <div class="proj-empty">
                    <div class="proj-empty-ico">🏗</div>
                    <div class="proj-empty-txt">No hay proyectos activos</div>
                    <div style="margin-top:10px;font-size:13px;color:var(--label3)">
                        <a href="/Carga/Index" style="color:var(--blue);text-decoration:none;font-weight:600">Cargar un proyecto →</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<div id="sbOverlay" onclick="closeSidebar()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:99;backdrop-filter:blur(2px);"></div>
<script>
    document.addEventListener('click', function(e) {
        var b = document.getElementById('proyBtn'), d = document.getElementById('proyDrop');
        if (b && d && !b.contains(e.target) && !d.contains(e.target)) d.classList.remove('open');
    });
    function toggleDrop() { document.getElementById('proyDrop').classList.toggle('open'); }
    function toggleSidebar() {
        var sb = document.getElementById('sidebar'), ov = document.getElementById('sbOverlay');
        if (!sb) return; var o = sb.classList.toggle('open');
        if (ov) ov.style.display = o ? 'block' : 'none';
    }
    function closeSidebar() {
        var sb = document.getElementById('sidebar'), ov = document.getElementById('sbOverlay');
        if (sb) sb.classList.remove('open'); if (ov) ov.style.display = 'none';
    }
</script>
</body>
</html>
