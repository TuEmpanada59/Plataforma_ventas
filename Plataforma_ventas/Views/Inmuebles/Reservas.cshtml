@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Londoño Gómez — Reservas";
    ViewBag.ActiveNav = "reservas";
    ViewBag.TbBread   = "Reservas";

    var nombre     = ViewBag.Nombre   as string ?? "";
    var apellido   = ViewBag.Apellido as string ?? "";
    var proyActivo = ViewBag.ProyectoActivo as string ?? "Sin proyecto";
    var reservas   = ViewBag.Reservas as List<dynamic> ?? new List<dynamic>();
    var iniciales  = ((nombre.Length >= 1 ? nombre.Substring(0, 1) : "") + (apellido.Length >= 1 ? apellido.Substring(0, 1) : "")).ToUpper();
    ViewBag.Iniciales = iniciales;
}
@section Styles {
<style>
    @@keyframes fu{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    .alerta-exito{background:rgba(52,199,89,0.1);border:1px solid rgba(52,199,89,0.3);border-radius:12px;padding:10px 16px;font-size:13px;font-weight:600;color:#1EA851;}
    .alerta-error{background:rgba(230,57,70,0.1);border:1px solid rgba(230,57,70,0.3);border-radius:12px;padding:10px 16px;font-size:13px;font-weight:600;color:var(--rojo);}
    .card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:18px;overflow:hidden;box-shadow:var(--sh);animation:fu 0.35s ease both;}
    .card-head{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--sep2);flex-wrap:wrap;gap:8px;}
    .card-title{font-size:15px;font-weight:600;color:var(--label);}
    .tbl-wrap{overflow-x:auto;}
    .tbl{width:100%;border-collapse:collapse;}
    .tbl th{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--label3);padding:10px 16px;text-align:left;border-bottom:1px solid var(--sep2);}
    .tbl td{padding:11px 16px;font-size:13px;color:var(--label);border-bottom:1px solid var(--sep2);}
    .tbl tr:last-child td{border-bottom:none;}
    .tbl tr:hover td{background:var(--fill3);}
    .bdg{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:600;}
    .ios-btn{display:inline-flex;align-items:center;gap:6px;background:var(--blue);color:white;border:none;padding:9px 18px;border-radius:11px;font-size:13px;font-weight:600;cursor:pointer;box-shadow:0 4px 12px rgba(0,118,227,0.28);transition:all 0.2s;text-decoration:none;}
    .ios-btn:hover{background:var(--mid);}
    .ios-btn.ghost{background:var(--fill3);color:var(--label);box-shadow:none;border:1px solid var(--sep);}
    .ios-btn.rojo{background:rgba(230,57,70,0.1);color:var(--rojo);box-shadow:none;border:1px solid rgba(230,57,70,0.2);}
    .ios-btn.rojo:hover{background:rgba(230,57,70,0.2);}
    .res-banner{background:linear-gradient(135deg,var(--azul),var(--blue));border-radius:18px;padding:16px 22px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 8px 24px rgba(0,118,227,0.25);animation:fu 0.3s ease both;flex-wrap:wrap;gap:12px;}
    .res-banner-title{font-size:20px;font-weight:700;color:white;letter-spacing:-0.5px;}
    .res-banner-sub{font-size:12px;color:rgba(255,255,255,0.7);margin-top:2px;}
    .res-count{background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.25);border-radius:10px;padding:8px 18px;text-align:center;}
    .res-count-num{font-size:24px;font-weight:300;color:white;letter-spacing:-1px;}
    .res-count-lbl{font-size:10px;color:rgba(255,255,255,0.7);}
    .precio-blq{display:inline-block;background:rgba(52,199,89,0.12);color:#1EA851;font-size:13px;font-weight:700;padding:4px 10px;border-radius:8px;}
    .vendedor-tag{font-size:11px;color:#5A5AC8;font-weight:600;}
    .fecha-tag{font-size:11px;color:var(--label3);}
    .empty{padding:48px;text-align:center;}
    .empty-ico{font-size:48px;opacity:0.35;margin-bottom:10px;}
    .empty-txt{font-size:16px;font-weight:600;color:var(--label2);}
    .empty-sub{font-size:13px;color:var(--label3);margin-top:4px;}
    @@media(max-width:700px){.tbl{min-width:700px!important;}}
</style>
}

@if (TempData["Exito"] != null) { <div class="alerta-exito">&#10003; @TempData["Exito"]</div> }
@if (TempData["Error"] != null) { <div class="alerta-error">&#10007; @TempData["Error"]</div> }

<div class="res-banner">
    <div>
        <div class="res-banner-title">Reservas activas</div>
        <div class="res-banner-sub">@proyActivo · Inmuebles con precio bloqueado</div>
    </div>
    <div class="res-count">
        <div class="res-count-num">@reservas.Count</div>
        <div class="res-count-lbl">Reservadas</div>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <span class="card-title">Lista de reservas</span>
        <a href="/Inmuebles" class="ios-btn ghost" style="font-size:12px;padding:6px 14px;">&#8592; Volver a inmuebles</a>
    </div>
    @if (reservas.Count > 0)
    {
        <div class="tbl-wrap">
            <table class="tbl">
                <thead>
                    <tr>
                        <th>Apto</th><th>Área / Tipo</th><th>Torre · Piso</th>
                        <th>Precio bloqueado</th><th>Reservado por</th><th>Fecha reserva</th><th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in reservas) {
                        <tr>
                            <td style="font-weight:700;font-size:14px">@r.Apto</td>
                            <td><div style="font-weight:600">@r.Metros m²</div><div style="font-size:11px;color:var(--label3)">@r.Tipo</div></td>
                            <td><div>@r.Torre</div><div style="font-size:11px;color:var(--label3)">Piso @r.Piso</div></td>
                            <td><span class="precio-blq">$@string.Format("{0:N0}", r.PrecioReserva)</span></td>
                            <td><span class="vendedor-tag">@r.NombreVendedor</span></td>
                            <td><span class="fecha-tag">@r.FechaReserva</span></td>
                            <td style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;">
                                <a href="/Inmuebles/ContinuarVenta?idInmueble=@r.Id" class="ios-btn" style="font-size:12px;padding:6px 14px;">&#10003; Continuar venta</a>
                                <form action="/Inmuebles/LiberarReserva" method="post" style="margin:0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idInmueble" value="@r.Id"/>
                                    <button type="submit" class="ios-btn rojo" style="font-size:12px;padding:6px 12px;" onclick="return confirm('¿Liberar la reserva del apto @r.Apto?')">&#10005; Liberar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty">
            <div class="empty-ico">&#128274;</div>
            <div class="empty-txt">No hay reservas activas</div>
            <div class="empty-sub">Cuando un vendedor reserve un inmueble aparecerá aquí</div>
        </div>
    }
</div>
