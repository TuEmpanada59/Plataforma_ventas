@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Londoño Gómez — Inicio";
    ViewBag.ActiveNav = "dashboard";
    ViewBag.TbBread   = "Inicio";

    var nombre      = ViewBag.Nombre      as string ?? "Admin";
    var apellido    = ViewBag.Apellido    as string ?? "";
    var proyActivo  = ViewBag.ProyectoActivo as string ?? "Sin proyecto";
    int disponibles = ViewBag.Disponibles != null && !(ViewBag.Disponibles is DBNull) ? (int)ViewBag.Disponibles : 0;
    int reservados  = ViewBag.Reservados  != null && !(ViewBag.Reservados  is DBNull) ? (int)ViewBag.Reservados  : 0;
    int total       = ViewBag.Total       != null && !(ViewBag.Total       is DBNull) ? (int)ViewBag.Total       : 0;
    int vendidos    = ViewBag.Vendidos    != null && !(ViewBag.Vendidos    is DBNull) ? (int)ViewBag.Vendidos    : 0;
    int enProceso   = ViewBag.EnProceso   != null && !(ViewBag.EnProceso   is DBNull) ? (int)ViewBag.EnProceso   : 0;
    double pctV = ViewBag.PctVendidos    != null ? (double)ViewBag.PctVendidos    : 0;
    double pctD = ViewBag.PctDisponibles != null ? (double)ViewBag.PctDisponibles : 0;
    double pctR = ViewBag.PctReservados  != null ? (double)ViewBag.PctReservados  : 0;
    int listaActual  = ViewBag.ListaActual         != null ? (int)ViewBag.ListaActual         : 1;
    int aptsPorLista = ViewBag.ApartamentosPorLista != null ? (int)ViewBag.ApartamentosPorLista : 0;
    string modoLista = ViewBag.ModoLista  as string ?? "MANUAL";
    int totalListas  = ViewBag.TotalListas != null ? (int)ViewBag.TotalListas : 5;
    var iniciales = ((nombre.Length >= 1 ? nombre.Substring(0, 1) : "") + (apellido.Length >= 1 ? apellido.Substring(0, 1) : "")).ToUpper();
    // Pass iniciales to layout
    ViewBag.Iniciales = iniciales;
}
@section Styles {
<style>
    @@keyframes fu{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    .kpi-row{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;}
    .kpi{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:18px;padding:14px;box-shadow:var(--sh);transition:transform 0.2s,box-shadow 0.2s;animation:fu 0.35s ease both;}
    .kpi:nth-child(1){animation-delay:.05s}.kpi:nth-child(2){animation-delay:.1s}.kpi:nth-child(3){animation-delay:.15s}.kpi:nth-child(4){animation-delay:.2s}.kpi:nth-child(5){animation-delay:.25s}
    .kpi:hover{transform:translateY(-2px);box-shadow:var(--sh2);}
    .kpi-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;}
    .kpi-ico{width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:15px;}
    .kpi-tag{font-size:10px;font-weight:600;padding:2px 7px;border-radius:20px;}
    .kpi-num{font-size:28px;font-weight:300;letter-spacing:-1.5px;line-height:1;margin-bottom:3px;}
    .kpi-lbl{font-size:11px;color:var(--label2);}
    .kpi.k1 .kpi-ico{background:rgba(0,118,227,0.1)}.kpi.k1 .kpi-tag{background:rgba(0,118,227,0.1);color:var(--blue)}.kpi.k1 .kpi-num{color:var(--azul)}
    .kpi.k2 .kpi-ico{background:rgba(52,199,89,0.1)}.kpi.k2 .kpi-tag{background:rgba(52,199,89,0.1);color:#1EA851}.kpi.k2 .kpi-num{color:#1EA851}
    .kpi.k3 .kpi-ico{background:rgba(90,90,200,0.1)}.kpi.k3 .kpi-tag{background:rgba(90,90,200,0.1);color:#5A5AC8}.kpi.k3 .kpi-num{color:#5A5AC8}
    .kpi.k4 .kpi-ico{background:rgba(255,149,0,0.1)}.kpi.k4 .kpi-tag{background:rgba(255,149,0,0.1);color:#CC7700}.kpi.k4 .kpi-num{color:#CC7700}
    .kpi.k5 .kpi-ico{background:rgba(230,57,70,0.1)}.kpi.k5 .kpi-tag{background:rgba(230,57,70,0.1);color:var(--rojo)}.kpi.k5 .kpi-num{color:var(--rojo)}
    .card{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:18px;overflow:hidden;box-shadow:var(--sh);animation:fu 0.35s ease 0.25s both;}
    .card-head{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--sep2);}
    .card-title{font-size:15px;font-weight:600;color:var(--label);letter-spacing:-0.2px;}
    .dash-row{display:grid;grid-template-columns:1fr 1fr minmax(200px,260px);gap:12px;}
    .prog-body{padding:16px;}
    .prog-row{margin-bottom:14px;}
    .prog-meta{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:5px;}
    .prog-name{font-size:14px;color:var(--label);font-weight:500;}
    .prog-val{font-size:13px;font-weight:600;}
    .prog-track{height:6px;background:var(--fill3);border-radius:50px;overflow:hidden;}
    .prog-fill{height:100%;border-radius:50px;}
    .prog-pair{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px;padding-top:12px;border-top:1px solid var(--sep2);}
    .prog-item{background:var(--fill3);border-radius:12px;padding:11px;text-align:center;}
    .prog-num{font-size:20px;font-weight:300;letter-spacing:-0.8px;color:var(--azul);}
    .prog-lbl{font-size:11px;color:var(--label3);margin-top:2px;font-weight:500;}
    .donut-body{padding:16px;display:flex;align-items:center;justify-content:center;flex:1;}
    .donut-row{display:flex;align-items:center;gap:14px;width:100%;}
    .donut-wrap{width:88px;height:88px;flex-shrink:0;position:relative;}
    .donut-wrap svg{transform:rotate(-90deg);}
    .donut-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;}
    .donut-pct{font-size:20px;font-weight:300;letter-spacing:-0.8px;color:var(--label);}
    .donut-sub{font-size:10px;font-weight:600;color:var(--label3);text-transform:uppercase;letter-spacing:0.04em;margin-top:1px;}
    .legend{flex:1;display:flex;flex-direction:column;gap:10px;}
    .leg-row{display:flex;align-items:center;gap:7px;font-size:13px;color:var(--label2);}
    .leg-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
    .leg-num{margin-left:auto;font-weight:600;font-size:14px;color:var(--label);}
    .ios-btn{display:inline-flex;align-items:center;gap:6px;background:var(--blue);color:white;border:none;padding:8px 14px;border-radius:11px;font-size:13px;font-weight:600;cursor:pointer;box-shadow:0 4px 12px rgba(0,118,227,0.28);transition:all 0.2s;text-decoration:none;}
    .ios-btn:hover{background:var(--mid);transform:scale(0.98);}
    .ios-btn.ghost{background:var(--fill3);color:var(--label);box-shadow:none;border:1px solid var(--sep);}
    .listas-panel{background:var(--glass);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--gb);border-radius:18px;overflow:hidden;box-shadow:var(--sh);animation:fu 0.35s ease 0.3s both;}
    .listas-body{padding:18px;display:grid;grid-template-columns:1fr 1fr;gap:16px;}
    .lista-section{background:var(--fill3);border-radius:14px;padding:16px;transition:all 0.3s;}
    .lista-section.activo{background:rgba(0,118,227,0.06);border:2px solid rgba(0,118,227,0.25);}
    .lista-section.inactivo{opacity:0.5;pointer-events:none;}
    .ls-title{font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--label3);margin-bottom:12px;}
    .lista-btns{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px;}
    .lista-btn{flex:1;min-width:44px;padding:8px 6px;border-radius:10px;border:2px solid var(--sep);background:white;font-size:13px;font-weight:600;color:var(--label2);cursor:pointer;text-align:center;transition:all 0.2s;}
    .lista-btn:hover{border-color:var(--blue);color:var(--blue);}
    .lista-btn.current{border-color:var(--blue);background:var(--blue);color:white;box-shadow:0 3px 10px rgba(0,118,227,0.25);}
    .lista-btn-lbl{font-size:9px;font-weight:500;color:inherit;opacity:0.7;display:block;margin-top:1px;}
    .field-inline{display:flex;gap:8px;align-items:flex-end;}
    .field-inline input{flex:1;padding:8px 12px;background:white;border:1px solid var(--sep);border-radius:10px;font-size:14px;color:var(--label);outline:none;}
    .field-inline input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(0,118,227,0.1);}
    .ls-desc{font-size:12px;color:var(--label2);margin-top:8px;}
    .alerta-lista{padding:8px 12px;background:rgba(255,149,0,0.1);border:1px solid rgba(255,149,0,0.3);border-radius:10px;font-size:12px;color:#CC7700;font-weight:500;margin-top:8px;}
    .modo-badge{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;margin-bottom:10px;}
    .modo-badge.manual{background:rgba(0,118,227,0.1);color:var(--blue);}
    .modo-badge.auto{background:rgba(52,199,89,0.1);color:#1EA851;}
    @@media(max-width:1400px){
        .dash-row{grid-template-columns:1fr 1fr;}
        .dash-row>.card:last-child{grid-column:1/-1;width:100%;}
    }
    @@media(max-width:1024px){
        .kpi-row{grid-template-columns:repeat(3,1fr);}
        .dash-row{grid-template-columns:1fr;}
        .dash-row>.card:last-child{max-width:100%;}
        .listas-body{grid-template-columns:1fr;}
    }
    @@media(max-width:700px){
        .kpi-row{grid-template-columns:1fr 1fr;gap:8px;}
        .dash-row{grid-template-columns:1fr;}
        .listas-body{grid-template-columns:1fr;gap:10px;}
    }
</style>
}

@if (TempData["Exito"] != null) {
    <div style="background:rgba(52,199,89,0.1);border:1px solid rgba(52,199,89,0.3);border-radius:12px;padding:10px 16px;font-size:13px;font-weight:600;color:#1EA851">&#10003; @TempData["Exito"]</div>
}

<!-- KPIs -->
<div class="kpi-row">
    <div class="kpi k1"><div class="kpi-top"><div class="kpi-ico">&#127968;</div><span class="kpi-tag">Total</span></div><div class="kpi-num">@total</div><div class="kpi-lbl">Inmuebles</div></div>
    <div class="kpi k2"><div class="kpi-top"><div class="kpi-ico">&#10003;</div><span class="kpi-tag">@pctD%</span></div><div class="kpi-num">@disponibles</div><div class="kpi-lbl">Disponibles</div></div>
    <div class="kpi k3"><div class="kpi-top"><div class="kpi-ico">&#8987;</div><span class="kpi-tag">En proceso</span></div><div class="kpi-num">@enProceso</div><div class="kpi-lbl">Gestionando</div></div>
    <div class="kpi k4"><div class="kpi-top"><div class="kpi-ico">&#128274;</div><span class="kpi-tag">@pctR%</span></div><div class="kpi-num">@reservados</div><div class="kpi-lbl">Reservados</div></div>
    <div class="kpi k5"><div class="kpi-top"><div class="kpi-ico">&#128273;</div><span class="kpi-tag">@pctV%</span></div><div class="kpi-num">@vendidos</div><div class="kpi-lbl">Vendidos</div></div>
</div>

<!-- Charts -->
<div class="dash-row">
    <div class="card">
        <div class="card-head"><span class="card-title">Progreso de ventas</span><span style="font-size:11px;color:var(--label3)">@proyActivo</span></div>
        <div class="prog-body">
            <div class="prog-row"><div class="prog-meta"><span class="prog-name">Vendidos</span><span class="prog-val" style="color:var(--rojo)">@vendidos / @total</span></div><div class="prog-track"><div class="prog-fill" style="width:@(pctV)%;background:linear-gradient(90deg,var(--rojo),#FF6370)"></div></div></div>
            <div class="prog-row"><div class="prog-meta"><span class="prog-name">Disponibles</span><span class="prog-val" style="color:#1EA851">@disponibles / @total</span></div><div class="prog-track"><div class="prog-fill" style="width:@(pctD)%;background:linear-gradient(90deg,#1EA851,#34C759)"></div></div></div>
            <div class="prog-row"><div class="prog-meta"><span class="prog-name">Reservados</span><span class="prog-val" style="color:#CC7700">@reservados / @total</span></div><div class="prog-track"><div class="prog-fill" style="width:@(pctR)%;background:linear-gradient(90deg,#CC7700,#FF9500)"></div></div></div>
            <div class="prog-pair">
                <div class="prog-item"><div class="prog-num">@vendidos</div><div class="prog-lbl">Vendidos</div></div>
                <div class="prog-item"><div class="prog-num" style="color:#1EA851">@disponibles</div><div class="prog-lbl">Disponibles</div></div>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-head"><span class="card-title">Resumen del proyecto</span></div>
        <div style="padding:20px;text-align:center">
            <div style="font-size:48px;font-weight:200;letter-spacing:-2px;color:var(--azul)">@total</div>
            <div style="font-size:13px;color:var(--label2);margin-top:4px">inmuebles en <strong>@proyActivo</strong></div>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px">
                <div style="background:rgba(52,199,89,0.08);border-radius:12px;padding:12px"><div style="font-size:22px;font-weight:300;color:#1EA851">@disponibles</div><div style="font-size:11px;color:var(--label3);margin-top:2px">Disponibles</div></div>
                <div style="background:rgba(255,149,0,0.08);border-radius:12px;padding:12px"><div style="font-size:22px;font-weight:300;color:#CC7700">@reservados</div><div style="font-size:11px;color:var(--label3);margin-top:2px">Reservados</div></div>
                <div style="background:rgba(230,57,70,0.08);border-radius:12px;padding:12px"><div style="font-size:22px;font-weight:300;color:var(--rojo)">@vendidos</div><div style="font-size:11px;color:var(--label3);margin-top:2px">Vendidos</div></div>
            </div>
        </div>
    </div>
    <div class="card" style="display:flex;flex-direction:column;">
        <div class="card-head"><span class="card-title">Distribución</span></div>
        <div class="donut-body">
            <div class="donut-row">
                <div class="donut-wrap">
                    <svg width="88" height="88" viewBox="0 0 36 36">
                        <circle cx="18" cy="18" r="14" fill="none" stroke="var(--fill3)" stroke-width="3.5"/>
                        @{double circ=87.96;}
                        <circle cx="18" cy="18" r="14" fill="none" stroke="#E63946" stroke-width="3.5" stroke-dasharray="@(circ*pctV/100) @(circ*(1-pctV/100))" stroke-dashoffset="0" stroke-linecap="round"/>
                        <circle cx="18" cy="18" r="14" fill="none" stroke="#34C759" stroke-width="3.5" stroke-dasharray="@(circ*pctD/100) @(circ*(1-pctD/100))" stroke-dashoffset="@(-(circ*pctV/100))" stroke-linecap="round"/>
                        <circle cx="18" cy="18" r="14" fill="none" stroke="#FF9500" stroke-width="3.5" stroke-dasharray="@(circ*pctR/100) @(circ*(1-pctR/100))" stroke-dashoffset="@(-(circ*pctV/100+circ*pctD/100))" stroke-linecap="round"/>
                    </svg>
                    <div class="donut-center"><div class="donut-pct">@pctV%</div><div class="donut-sub">Vendido</div></div>
                </div>
                <div class="legend">
                    <div class="leg-row"><div class="leg-dot" style="background:var(--rojo)"></div>Vendidos<span class="leg-num" style="color:var(--rojo)">@vendidos</span></div>
                    <div class="leg-row"><div class="leg-dot" style="background:#34C759"></div>Disponibles<span class="leg-num" style="color:#1EA851">@disponibles</span></div>
                    <div class="leg-row"><div class="leg-dot" style="background:#FF9500"></div>Reservados<span class="leg-num" style="color:#CC7700">@reservados</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
var connection = new signalR.HubConnectionBuilder().withUrl("/ventasHub").withAutomaticReconnect().build();
connection.on("ListaActualizada", function(idProyecto, nuevaLista) {
    console.log("Lista actualizada:", idProyecto, nuevaLista);
    showToast("Lista escalada a " + nuevaLista + " en proyecto " + idProyecto);
});
connection.on("InmuebleActualizado", function(idProyecto, idInmueble, estado) {
    console.log("Inmueble", idInmueble, "->", estado);
});
connection.start().catch(function(err){ console.error("SignalR error:", err); });
function showToast(msg){
    var t=document.createElement('div');
    t.style.cssText='position:fixed;bottom:60px;right:20px;background:#1e222b;color:white;padding:12px 18px;border-radius:12px;font-size:13px;font-weight:600;z-index:9000;box-shadow:0 4px 16px rgba(0,0,0,0.2);';
    t.textContent=msg;
    document.body.appendChild(t);
    setTimeout(function(){t.remove();},4000);
}
function cambiarLista(num){
    if(!confirm('¿Cambiar a Lista '+num+'?'))return;
    document.getElementById('listaInput').value=num;
    document.getElementById('formCambiarLista').submit();
}
</script>
}
