# ════════════════════════════════════════════════════════════════════════════
#  Mercurio — configuración local
#
#  Cópialo como .env (sin .example) y llena los valores. El .env está en
#  .gitignore; ESTE archivo sí se versiona, así que nunca escribas aquí una
#  credencial real.
#
#  Los dos guiones bajos separan niveles. No es un capricho: son exactamente
#  los mismos nombres que se escriben en Azure, en App Service >
#  Configuration > Application settings. Lo que pruebas en local y lo que
#  configuras en producción se llaman igual.
#
#  Todo es opcional. Sin .env la aplicación arranca contra LocalDB y sin
#  correo, que es lo normal para desarrollar.
# ════════════════════════════════════════════════════════════════════════════

# ── Base de datos ───────────────────────────────────────────────────────────
# Solo si quieres apuntar a OTRA base. Para tu LocalDB no hace falta: el valor
# por defecto ya está en appsettings.json.
# La cadena de pruebas está en el portal: App Service PruebasLanzamientos >
# Configuration > Connection strings. Cópiala de ahí.
# ConnectionStrings__DefaultConnection=Server=tcp:SERVIDOR.database.windows.net,1433;Initial Catalog=BASE;User ID=USUARIO;Password=CONTRASEÑA;Encrypt=True;MultipleActiveResultSets=True;

# ── Operación ───────────────────────────────────────────────────────────────
# Minutos que un inmueble puede estar EN PROCESO antes de que el panel lo
# marque como estancado. Bájalo a 2 o 3 para probar esa alerta sin esperar.
Operacion__MinutosProcesoEstancado=45

# ── Correo: Microsoft Graph ─────────────────────────────────────────────────
# TODAVÍA NO FUNCIONA: falta implementar GraphEmailService. Las claves están
# aquí para ir llenándolas a medida que TI entregue los datos.
#
# Enabled en false hasta que TI cargue el .cer en el registro de Entra ID Y
# otorgue el consentimiento de administrador sobre Mail.Send (Application).
# Sin eso el token nunca se emite.
Graph__Enabled=false

# ID de directorio de Londoño Gómez. Es el mismo para toda la organización.
# Confírmalo con TI: el documento de Andrómeda lo trae escrito de dos formas.
Graph__TenantId=

# ID de la aplicación. Este SÍ es propio de Mercurio: el de Andrómeda no sirve,
# su acceso está restringido al buzón de arrendamientos.
Graph__ClientId=

# Buzón de servicio desde el que sale el correo. Con Graph el remitente lo
# determina este valor; no hay un "From" editable como en SMTP.
Graph__MailboxUpn=

# Rutas del certificado, relativas a la carpeta del proyecto. Solo para
# desarrollo: en Azure el certificado se carga desde el almacén del App Service
# y se identifica por su huella.
Graph__CertPath=./public_cert.pem
Graph__KeyPath=./private.key
Graph__CertThumbprint=

# ── Correo: SMTP (en retirada) ──────────────────────────────────────────────
# El esquema anterior. Se mantiene mientras Graph no esté andando. Vacío, la
# aplicación funciona igual: los enlaces de recuperación se escriben en el log
# en vez de enviarse, que para desarrollar suele ser más cómodo.
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__From=
